{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orthros game folder manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "defaultVersion", "versions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "defaultVersion": { "$ref": "#/$defs/id" },
    "defaults": { "type": "object", "description": "Champs communs aux versions : mount, display, cover, registry, cdrom, profileSeed, glWorker (false ou 0 : rendu Direct3D dans le fil de l'émulateur au lieu du worker de rendu, docs/render-worker.md), etc." },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "dir", "version", "exe"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "dir": { "$ref": "#/$defs/id" },
          "version": { "type": "string", "minLength": 1 },
          "versionOrder": { "type": "number" },
          "exe": { "type": "string", "minLength": 1 },
          "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" } },
          "profileSeed": { "type": "boolean", "description": "false : aucun profil de premier lancement partagé pour ce jeu (src/host/profile-seed.js) — ni proposé à un profil vide, ni appris. Aussi dans defaults." },
          "cdrom": {
            "description": "Les fichiers du jeu servent aussi de lecteur de CD-ROM (jeux qui vérifient leur disque) : une lettre, ou { drive, label, serial }. Aussi dans defaults.",
            "oneOf": [
              { "type": "string", "pattern": "^[D-Zd-z]:?$" },
              { "type": "object", "properties": { "drive": { "type": "string", "pattern": "^[D-Zd-z]:?$" }, "label": { "type": "string", "maxLength": 32 }, "serial": { "type": "integer", "minimum": 0 } } }
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["game", "version", "mount"],
              "properties": {
                "game": { "$ref": "#/$defs/id" },
                "version": { "$ref": "#/$defs/id" },
                "mount": { "type": "string", "pattern": "^[A-Za-z]:\\\\" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" } }
}
