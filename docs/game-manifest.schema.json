{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orthros game folder manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "defaultVersion", "versions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "defaultVersion": { "$ref": "#/$defs/id" },
    "defaults": { "type": "object", "description": "Champs communs aux versions : mount, display, cover, registry, etc." },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "dir", "version", "exe"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "dir": { "$ref": "#/$defs/id" },
          "version": { "type": "string", "minLength": 1 },
          "versionOrder": { "type": "number" },
          "exe": { "type": "string", "minLength": 1 },
          "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" } },
          "requires": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["game", "version", "mount"],
              "properties": {
                "game": { "$ref": "#/$defs/id" },
                "version": { "$ref": "#/$defs/id" },
                "mount": { "type": "string", "pattern": "^[A-Za-z]:\\\\" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" } }
}
