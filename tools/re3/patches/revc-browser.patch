diff --git a/src/skel/orthros_web.cpp b/src/skel/orthros_web.cpp
new file mode 100644
index 00000000..8cf88b5f
--- /dev/null
+++ b/src/skel/orthros_web.cpp
@@ -0,0 +1,36 @@
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#include "orthros_web.h"
+
+EM_ASYNC_JS(void, OrthrosFrameYield, (), {
+	await new Promise((resolve) => requestAnimationFrame(resolve));
+});
+
+EM_ASYNC_JS(void, OrthrosYieldNow, (), {
+	await new Promise((resolve) => setTimeout(resolve, 0));
+});
+
+EM_JS(int, OrthrosCanvasWidth, (), { return Module.canvas && Module.canvas.clientWidth || 1024; });
+EM_JS(int, OrthrosCanvasHeight, (), { return Module.canvas && Module.canvas.clientHeight || 768; });
+
+void
+OrthrosCanvasSize(int *width, int *height)
+{
+	*width = OrthrosCanvasWidth();
+	*height = OrthrosCanvasHeight();
+}
+
+EM_JS(void, OrthrosMouseMode, (int relative), { if (Module.orthrosMouse) Module.orthrosMouse(!!relative); });
+
+static double lastLoadingYield;
+
+void
+OrthrosLoadingYield(void)
+{
+	double now = emscripten_get_now();
+	if(now - lastLoadingYield < 50.0)
+		return;
+	OrthrosYieldNow();
+	lastLoadingYield = emscripten_get_now();
+}
+#endif
diff --git a/src/skel/orthros_web.h b/src/skel/orthros_web.h
new file mode 100644
index 00000000..cedeb55f
--- /dev/null
+++ b/src/skel/orthros_web.h
@@ -0,0 +1,21 @@
+#pragma once
+
+// Orthros (the browser): the game's main loop and its long loads give the browser its turn. The engine runs on the
+// page's thread; with JSPI its WebAssembly stack is suspended while the page handles events, paints and fetches,
+// then resumed where it stopped.
+#ifdef __EMSCRIPTEN__
+#ifdef __cplusplus
+extern "C" {
+#endif
+// Once per main loop iteration: wait for the browser's next frame (the swap of a vsynced window).
+void OrthrosFrameYield(void);
+// During a load: the browser's turn, at most every 50 ms.
+void OrthrosLoadingYield(void);
+// The game takes the mouse (relative motion: the page captures it) or frees it (its menus, its own cursor drawn).
+void OrthrosMouseMode(int relative);
+// The size the page gives the game (its canvas' box, CSS pixels): the window's, whatever video mode the game chose.
+void OrthrosCanvasSize(int *width, int *height);
+#ifdef __cplusplus
+}
+#endif
+#endif
