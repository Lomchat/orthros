+#ifdef ORTHROS_LAZY_SFX
+bool8
+cSampleManager::EnsureSample(uint32 nSfx)
+{
+	if ( gSampleHere[nSfx >> 3] & (1 << (nSfx & 7)) )
+		return TRUE;
+	if ( gBankLoaded[SFX_BANK_0] != LOADING_STATUS_LOADED || nSfx >= BankStartOffset[SFX_BANK_PED_COMMENTS] )
+		return FALSE;
+	// (pread, exactly its range: stdio's buffer would read past it, a wait for bytes not asked for)
+	int fd = fileno(fpSampleDataHandle);
+	uint32 size = m_aSamples[nSfx].nSize;
+	if ( !OrthrosFileReady(fd, m_aSamples[nSfx].nOffset, size) )
+	{
+		OrthrosSampleCount(0, 0);
+		return FALSE;
+	}
+	uintptr addr = nSampleBankMemoryStartAddress[SFX_BANK_0] + m_aSamples[nSfx].nOffset - m_aSamples[BankStartOffset[SFX_BANK_0]].nOffset;
+	if ( pread(fd, (void *)addr, size, m_aSamples[nSfx].nOffset) != (ssize_t)size )
+		return FALSE;
+	gSampleHere[nSfx >> 3] |= 1 << (nSfx & 7);
+	OrthrosSampleCount(1, size / 2);
+	return TRUE;
+}
+#endif
