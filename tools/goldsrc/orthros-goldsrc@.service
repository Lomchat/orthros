# The native dedicated servers of a GoldSrc version — its permanent one and the rooms players create (docs/browser-ports.md);
# the instance is the manifest id:
#   install -m 644 tools/goldsrc/orthros-goldsrc@.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now orthros-goldsrc@half-life-original-en
[Unit]
Description=Orthros GoldSrc dedicated servers (%i)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/node /srv/orthros/tools/goldsrc/server.mjs %i
WorkingDirectory=/srv/orthros
DynamicUser=yes
StateDirectory=orthros-goldsrc/%i
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5
# (the permanent server and up to 8 rooms, ~150 MB and a few threads each)
TasksMax=192
CPUQuota=300%
MemoryMax=1600M
# (a room the kernel kills for memory goes alone: the other servers stay)
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
