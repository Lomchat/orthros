 update_appversion()
 {
-	day=$(date +%d)
-	year=$(date +%Y)
-	hours=$(date +%H:%M:%S)
-	month=$(LANG=en_us_88591; date +"%b")
+	# (SOURCE_DATE_EPOCH, when set, instead of the current time: a reproducible build)
+	stamp=${SOURCE_DATE_EPOCH:+-u -d @$SOURCE_DATE_EPOCH}
+	day=$(date $stamp +%d)
+	year=$(date $stamp +%Y)
+	hours=$(date $stamp +%H:%M:%S)
+	month=$(LANG=en_us_88591; date $stamp +"%b")
 
 	# Write appversion.h
 	echo Updating appversion.h, new version is '"'$NEW_VERSION'"', the old one was $OLD_VERSION
