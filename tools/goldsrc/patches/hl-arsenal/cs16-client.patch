+static const char *BuildReasonText( int reason )
+{
+	switch ( reason )
+	{
+	case BUILD_NO_BRICKS: return L( "Not enough bricks", "Pas assez de briques" );
+	case BUILD_BLOCKED: return L( "Blocked", "Bloqu\xC3\xA9" );
+	case BUILD_TOO_FAR: return L( "Too far", "Trop loin" );
+	case BUILD_MY_CAP: return L( "You have built too many pieces", "Tu as construit trop de pi\xC3\xA8" "ces" );
+	case BUILD_ALL_CAP: return L( "Too many pieces in this game", "Trop de pi\xC3\xA8" "ces dans cette partie" );
+	case BUILD_DISABLED: return L( "Building is off in this game", "Construction d\xC3\xA9sactiv\xC3\xA9" "e dans cette partie" );
+	case BUILD_CANNOT: return L( "You can't build now", "Impossible de construire maintenant" );
+	}
+	return "";
+}
