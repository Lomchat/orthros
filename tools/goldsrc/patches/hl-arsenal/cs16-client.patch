+}
+
+// a centre message drawn by the mod (ArsUI_CenterPrint): its lines centred, as the engine's, for a moment
+static void DrawCenterMessage( void )
+{
+	const float now = Now(), t = now - g_flCenter;
+	if ( g_flCenter < 0 || t < 0 || t > 2.5f || !g_szCenter[0] )
+	{
+		g_flCenter = -1;
+		return;
+	}
+	const int lh = LineHeight();
+	const Col c = Alpha( C_WHITE, 1 - Clamp01(( t - 2.0f ) / 0.5f ));
+	float y = ScreenHeight / 3; // (the engine's own centre messages' height)
+	for ( const char *p = g_szCenter; *p; )
+	{
+		char line[WRAP_LEN];
+		int len = 0;
+		while ( p[len] && p[len] != '\n' )
+			len++;
+		const int n = CutAt( p, min( len, WRAP_LEN - 1 ));
+		memcpy( line, p, n );
+		line[n] = 0;
+		y += TextWrap( ScreenWidth / 2, y, line, ScreenWidth - 40, c, 3, lh * 1.2f, 2 ) * lh * 1.2f;
+		p += len;
+		if ( *p == '\n' )
+			p++;
+	}
+}
+
+// the server's text menus: a panel on the left, its title in gold, its keys as badges
+bool ArsUI_DrawTextMenu( const char *pszMenu )
+{
+	if ( g_iPanel != P_NONE )
+		return true;
+	char lines[24][128];
+	int n = 0;
+	for ( const char *p = pszMenu; *p && n < 24; )
+	{
+		int len = 0;
+		while ( p[len] && p[len] != '\n' )
+			len++;
+		int copy = min( len, 127 );
+		memcpy( lines[n], p, copy );
+		lines[n][copy] = 0;
+		n++;
+		p += len;
+		if ( *p == '\n' )
+			p++;
+	}
+	while ( n > 0 && !lines[n - 1][0] )
+		n--;
+	if ( !n )
+		return true;
+	int lh = LineHeight(), rowH = (int)( lh * 1.55f );
+	float w = 0;
+	for ( int i = 0; i < n; i++ )
+		w = max( w, (float)TextWidth( lines[i] ));
+	w = max( w + 70, 240.0f );
+	float h = n * rowH + 24;
+	float x = 18, y = ScreenHeight / 2 - h / 2 - 30;
+	Fill( x, y, w, h, Alpha( C_PANEL, 0.86f ));
+	Fill( x, y, 3, h, C_GOLD );
+	Frame( x, y, w, h, C_SOFT );
+	float ty = y + 12;
+	for ( int i = 0; i < n; i++ )
+	{
+		const char *s = lines[i];
+		Col c = i == 0 ? C_GOLDT : C_TEXT;
+		// (codes of a whole line: \y title, \w normal, \d disabled, \r red)
+		while ( s[0] == '\\' && s[1] )
+		{
+			if ( s[1] == 'y' ) c = C_GOLDT;
+			else if ( s[1] == 'w' ) c = C_TEXT;
+			else if ( s[1] == 'd' ) c = C_FAINT;
+			else if ( s[1] == 'r' ) c = C_RED;
+			else break;
+			s += 2;
+		}
+		if ( s[0] >= '0' && s[0] <= '9' && s[1] == '.' )
+		{
+			char key[2] = { s[0], 0 };
+			KeyBadge( x + 14, ty + ( rowH - lh ) / 2, key, false );
+			s += 2;
+			while ( *s == ' ' )
+				s++;
+			TextClip( x + 40, ty + ( rowH - lh ) / 2, x + w - 10, s, c );
+		}
+		else if ( s[0] )
+			TextClip( x + 14, ty + ( rowH - lh ) / 2, x + w - 10, s, c );
+		if ( i == 0 && n > 1 )
+			Fill( x + 14, ty + rowH - 2, w - 28, 1, C_LINE );
+		ty += rowH;
+	}
+	FlushShapes();
+	FlushTexts();
+	return true;
+}
