+//
+// Half Strike's Pokemon: a health bar over each one in sight
+//
+#define POKE_BAR_RANGE 1500.0f // (further: hidden)
+#define POKE_BAR_FADE 400.0f   // (fading out over the last of it)
+#define POKE_MIN_AMBIENT 32     // (a Pokemon's light in the darkest shade: its unlit side...)
+#define POKE_MIN_SHADE 64       // (...and its lit side over it)
+#define POKE_BAR_LIFT 3.0f     // (over its model's top, in units: the same for all)
+#define LEM_BAR_AFTER 0.55f    // (Le M's bar shown once he is past his hologram: the server's LEM_HOLO_END)
+#define POKE_BAR_GAP 6.0f      // (and that far on the screen)
+
+// whether the point is seen from the view: the world and the brush entities in between (not the studio models — the
+// Pokemon itself, players —, not glass)
+static bool SeenFromView( const float *point )
+{
+	pmtrace_t tr;
+	gEngfuncs.pEventAPI->EV_PlayerTrace( g_vViewOrg, (float *)point, PM_STUDIO_IGNORE | PM_GLASS_IGNORE, -1, &tr );
+	return tr.fraction >= 0.99f || ( !tr.startsolid && fabs( tr.endpos[0] - point[0] ) + fabs( tr.endpos[1] - point[1] ) + fabs( tr.endpos[2] - point[2] ) < 4 );
+}
+
+static float Approach( float v, float target, float speed, float dt )
+{
+	if ( v < target ) return min( target, v + speed * dt );
+	return max( target, v - speed * dt );
+}
+
+struct BarDraw
+{
+	Pokemon *p;
+	float sx, sy, dist, alpha, size; // (sy: the bar's bottom)
+	char owner[48];                  // (its player's name, cut to fit)
+	float wName, wOwner, total;      // (the label's widths)
+	float bw, bh, halfW, above;      // (the bar's size; its box around sx and above sy, the label included)
+};
+
+#define POKE_BAR_SMALL 0.78f // (the owner's name)
+#define POKE_BAR_EDGE 4.0f   // (kept that far inside the screen's edges)
+
+// the bar's and its label's sizes
+static void BarLayout( BarDraw &d )
+{
+	const Pokemon &p = *d.p;
+	const float k = d.size;
+	d.owner[0] = 0;
+	if ( p.owner > 0 && p.owner <= MAX_PLAYERS && g_PlayerInfoList[p.owner].name )
+	{
+		strncpy( d.owner, g_PlayerInfoList[p.owner].name, sizeof( d.owner ) - 1 );
+		d.owner[sizeof( d.owner ) - 1] = 0;
+		for ( int len = strlen( d.owner ); len > 3 && TextW( d.owner, POKE_BAR_SMALL ) > 110; len-- ) // (a long name cut)
+			strcpy( d.owner + len - 3, ".." );
+	}
+	const float gap = 5, dot = 3;
+	d.wName = TextWidth( g_Species[p.species].name );
+	d.wOwner = d.owner[0] ? TextW( d.owner, POKE_BAR_SMALL ) : 0;
+	d.total = d.wName + ( d.wOwner > 0 ? gap * 2 + dot + d.wOwner : 0 );
+	d.bw = 72 * k;
+	d.bh = max( 4.0f, 7 * k );
+	d.halfW = max( d.bw / 2 + 2, d.total / 2 );
+	d.above = d.bh + 3 + LineHeight();
+}
+
+// the radar's box on the screen (HUD units), when it is drawn: false otherwise
+static bool RadarBox( float *w, float *h )
+{
+	if ( !( gHUD.m_Radar.m_iFlags & HUD_DRAW ) || ( gHUD.m_iHideHUDDisplay & HIDEHUD_HEALTH ) ||
+		gEngfuncs.IsSpectateOnly() || !( gHUD.m_iWeaponBits & ( 1 << WEAPON_SUIT )) || gHUD.m_fPlayerDead )
+		return false;
+	const wrect_t &r = gHUD.m_Radar.m_hRadarOpaque.rect;
+	*w = r.right - r.left;
+	*h = r.bottom - r.top;
+	return *w > 0 && *h > 0;
+}
+
+static void DrawPokemonBar( const BarDraw &d, float now )
+{
+	const Pokemon &p = *d.p;
+	const float k = d.size, a = d.alpha;
+	const int me = LocalIndex(), myTeam = LocalTeam();
+	const bool own = p.owner == me && me > 0;
+	Col c;
+	if ( own || ( p.team && p.team == myTeam && ( myTeam == TEAM_TERRORIST || myTeam == TEAM_CT )))
+		c = C_GREEN; // (one's own, whatever the team known: a teammate's)
+	else if ( g_iUser1 || myTeam == TEAM_SPECTATOR ) // (a spectator: the sides' colours)
+		c = p.team == TEAM_TERRORIST ? C_TCOL : p.team == TEAM_CT ? C_CTCOL : C_TEXT;
+	else if ( myTeam == TEAM_TERRORIST || myTeam == TEAM_CT )
+		c = C_RED;
+	else
+		c = C_TEXT; // (one's team not known yet: neither friend nor foe)
+
+	const float bw = d.bw, bh = d.bh;
+	const float x = (int)( d.sx - bw / 2 ), y = (int)( d.sy - bh );
+	// (the backing and its shadow)
+	Fill( x - 2, y - 2, bw + 4, bh + 4, Alpha( C_SHADE, a * 0.85f ));
+	Fill( x, y, bw, bh, Alpha( C_PANEL2, a ));
+	// (the health just lost, then the health)
+	if ( p.trail > p.shown )
+		Fill( x + bw * p.shown, y, bw * ( p.trail - p.shown ), bh, Alpha( Mix( c, C_WHITE, 0.6f ), a * 0.75f ));
+	if ( p.shown > 0 )
+	{
+		Col fill = c;
+		if ( p.hp > 0 && p.hp < 0.3f ) // (low: a slow pulse)
+			fill = Mix( c, C_WHITE, 0.22f * ( 0.5f + 0.5f * sinf( now * 7.0f )));
+		Grad( x, y, bw * p.shown, bh, Alpha( Mix( fill, C_WHITE, 0.28f ), a ), Alpha( Mix( fill, C_SHADE, 0.18f ), a ));
+		Fill( x, y, bw * p.shown, max( 1.0f, bh * 0.18f ), Alpha( C_WHITE, a * 0.22f )); // (its gloss)
+	}
+	// (quarters)
+	for ( int q = 1; q < 4; q++ )
+		Fill( x + (int)( bw * q / 4 ), y, 1, bh, Alpha( C_SHADE, a * 0.55f ));
+	// (its frame: gold around one's own)
+	if ( own )
+		Frame( x - 2, y - 2, bw + 4, bh + 4, Alpha( C_GOLD, a ), max( 1.0f, 1.5f * k ));
+	else
+		Frame( x - 1, y - 1, bw + 2, bh + 2, Alpha( C_EDGE, a ));
+
+	// (its name, and its player's, small)
+	const int lh = LineHeight(), lhs = Scaled( POKE_BAR_SMALL ) ? LineHeight( POKE_BAR_SMALL ) : lh;
+	const float gap = 5, dot = 3;
+	float tx = (int)( d.sx - d.total / 2 ), ty = y - 3 - lh;
+	Text( tx, ty, g_Species[p.species].name, Alpha( own ? C_GOLDT : C_TEXT, a ));
+	if ( d.wOwner > 0 )
+	{
+		float dx = tx + d.wName + gap;
+		Fill( dx, ty + lh * 0.55f - dot / 2, dot, dot, Alpha( C_DIM, a ));
+		Text( dx + dot + gap, ty + lh - lhs, d.owner, Alpha( C_DIM, a ), POKE_BAR_SMALL );
+	}
+}
+
+// the Pokemon's highest bone, each time its model is set up (its bar follows it down when it crouches, lies...)
+void ArsUI_StudioBones( cl_entity_t *ent, float bones[][3][4], int count )
+{
+	if ( !ent || ent->index <= 0 || count <= 0 || !ent->model || !CompanionModel( ent->model->name ))
+		return;
+	Pokemon *p = PokemonSlot( ent->index, false );
+	if ( !p )
+		return;
+	float top = bones[0][2][3];
+	for ( int i = 1; i < count; i++ )
+		top = max( top, bones[i][2][3] );
+	p->boneTop = top - ent->origin[2];
+	p->boneSeq = ent->curstate.sequence;
+	p->boneTime = Now();
+}
+
+// a Pokemon's light from the map, before it is set up: kept over a floor so that it reads in the shade (the map's light
+// there can be next to nothing — ambient 3, shade 25 under dust2's arches —, where its colours went black and only its
+// bar showed); full light, dynamic lights untouched
+void ArsUI_StudioLighting( cl_entity_t *ent, alight_t *lighting )
+{
+	if ( !ent || !ent->model || !lighting || !CompanionModel( ent->model->name ) || strstr( ent->model->name, "pokeball" ))
+		return;
+	lighting->ambientlight = max( lighting->ambientlight, POKE_MIN_AMBIENT );
+	lighting->shadelight = max( lighting->shadelight, POKE_MIN_SHADE );
+}
+
+// the bar's height over the Pokemon's origin: its model's standing height (its idle sequence's box), lower while its
+// bones are (crouched coming out, lying dead), eased
+static float BarHeight( Pokemon &p, cl_entity_t *e, float now, float dt )
+{
+	float stand = g_Species[p.species].height;
+	studiohdr_t *hdr = (studiohdr_t *)IEngineStudio.Mod_Extradata( e->model );
+	if ( hdr && hdr->numseq > 0 )
+	{
+		const mstudioseqdesc_t *seq = (const mstudioseqdesc_t *)( (byte *)hdr + hdr->seqindex );
+		if ( seq[0].bbmax[2] > 4 && seq[0].bbmax[2] < 400 )
+			stand = seq[0].bbmax[2];
+	}
+	float target = stand;
+	if ( p.boneTime > 0 && now >= p.boneTime && now - p.boneTime < 0.5f )
+	{
+		// (standing — idle, sequence 0 —, its box's top over its highest bone: an ear's tip over the ear's bone...;
+		// the same gap kept over that bone when it crouches, lies)
+		if ( p.boneSeq == 0 && p.boneTop > 0 && p.boneTop < stand )
+			p.topGap = min( stand * 0.5f, max( 0.5f, stand - p.boneTop ));
+		const float gap = p.topGap > 0 ? p.topGap : stand * 0.12f;
+		target = min( stand, max( stand * 0.25f, p.boneTop + gap ));
+	}
+	if ( p.barTop <= 0 )
+		p.barTop = target;
+	else
+		p.barTop = Approach( p.barTop, target, stand * 3.0f, dt );
+	return p.barTop;
+}
+
+void ArsUI_DrawPokemonBars( float flTime )
+{
+	static float s_flLast, s_flInfo;
+	const float now = Now(), dt = Clamp01( now - s_flLast ) ; s_flLast = now;
+	PokemonPurge();
+	{
+		const int id = gHUD.m_Ammo.CurrentWeaponId(); // (the ball in hand, for ArsUI_WeaponBits)
+		if ( IsCompanionItem( id ))
+		{
+			g_iBallHeld = id;
+			g_flBallHeld = now;
+		}
+	}
+	if ( !g_bView || g_iPanel != P_NONE )
+		return;
+	cl_entity_t *local = gEngfuncs.GetLocalPlayer();
+	if ( !local )
+		return;
+
+	// (the players' names, now and then)
+	if ( now - s_flInfo > 0.5f || now < s_flInfo )
+	{
+		for ( int i = 0; i < MAX_POKEMON; i++ )
+			if ( g_Pokemon[i].ent )
+			{
+				gHUD.m_Scoreboard.GetAllPlayersInfo();
+				s_flInfo = now;
+				break;
+			}
+	}
+
+	float radarW = 0, radarH = 0;
+	const bool radar = RadarBox( &radarW, &radarH );
+	const float lh = LineHeight();
+
+	BarDraw draws[MAX_POKEMON];
+	int n = 0;
+	bool traced = false;
+	for ( int i = 0; i < MAX_POKEMON; i++ )
+	{
+		Pokemon &p = g_Pokemon[i];
+		if ( !p.ent || p.stale >= 0 )
+			continue;
+		// (the bar eased toward the health, the lost part held a moment then drained)
+		p.shown = Approach( p.shown, p.hp, 2.5f, dt );
+		if ( p.trail > p.shown && now - p.lastHit > 0.45f )
+			p.trail = Approach( p.trail, p.shown, 0.9f, dt );
+		float life = 1;
+		if ( p.gone >= 0 )
+		{
+			life = 1 - Clamp01(( now - p.gone - 0.35f ) / 0.4f );
+			if ( life <= 0 || now < p.gone )
+			{
+				p.ent = 0; // (faded out: the slot freed)
+				continue;
+			}
+		}
+		// (in this frame's packet — in the PVS —, drawn, shown)
+		cl_entity_t *e = gEngfuncs.GetEntityByIndex( p.ent );
+		if ( !e || !e->model || e->curstate.messagenum != local->curstate.messagenum || ( e->curstate.effects & EF_NODRAW ))
+		{
+			p.vis = 0;
+			continue;
+		}
+		if ( e->curstate.rendermode != kRenderNormal && e->curstate.renderamt < 40 )
+			continue;
+		// (Le M still a hologram — his first 0.55 s, the server's LEM_HOLO_END —: his bar once he compiles)
+		if ( p.species == SPECIES_LEM && p.gone < 0 && now - p.born < LEM_BAR_AFTER && now >= p.born )
+			continue;
+		const float height = BarHeight( p, e, now, dt );
+		vec3_t top, mid, d;
+		VectorCopy( e->origin, top ); top[2] += height + POKE_BAR_LIFT;
+		VectorCopy( e->origin, mid ); mid[2] += height * 0.6f;
+		VectorSubtract( mid, g_vViewOrg, d );
+		const float dist = sqrtf( DotProduct( d, d ));
+		if ( dist > POKE_BAR_RANGE )
+		{
+			p.vis = 0;
+			continue;
+		}
+		// (hidden behind the walls: traced from the view a few times a second, each in its turn)
+		if ( now >= p.nextTrace || now < p.nextTrace - 1 )
+		{
+			if ( !traced )
+			{
+				gEngfuncs.pEventAPI->EV_SetUpPlayerPrediction( false, true );
+				gEngfuncs.pEventAPI->EV_PushPMStates();
+				gEngfuncs.pEventAPI->EV_SetSolidPlayers( -1 );
+				gEngfuncs.pEventAPI->EV_SetTraceHull( 2 );
+				traced = true;
+			}
+			p.clear = SeenFromView( mid ) || SeenFromView( top );
+			p.nextTrace = now + 0.1f + ( i & 3 ) * 0.015f;
+		}
+		p.vis = Approach( p.vis, p.clear ? 1.0f : 0.0f, p.clear ? 6.0f : 9.0f, dt );
+		if ( p.vis <= 0 )
+			continue;
+		// (placed over its top; its top off the screen but its body in sight: held at the screen's top edge over it)
+		float screen[3], body[3];
+		const bool topIn = !gEngfuncs.pTriAPI->WorldToScreen( top, screen ) && fabs( screen[0] ) <= 1.2f && fabs( screen[1] ) <= 1.2f;
+		vec3_t low;
+		VectorCopy( e->origin, low ); low[2] += height * 0.3f;
+		const bool bodyIn = !gEngfuncs.pTriAPI->WorldToScreen( low, body ) && fabs( body[0] ) <= 1.0f && fabs( body[1] ) <= 1.0f;
+		if ( !topIn && !bodyIn )
+			continue; // (behind the view, or off the screen)
+		BarDraw &b = draws[n++];
+		b.p = &p;
+		b.sx = ( 1 + ( topIn ? screen[0] : body[0] )) * ScreenWidth / 2;
+		b.sy = topIn ? ( 1 - screen[1] ) * ScreenHeight / 2 - POKE_BAR_GAP : 0;
+		b.dist = dist;
+		b.size = 1.0f - 0.25f * Clamp01(( dist - 250 ) / 1000 ); // (a little smaller far away)
+		b.alpha = p.vis * life * Clamp01(( POKE_BAR_RANGE - dist ) / POKE_BAR_FADE ) * Clamp01(( now - p.born ) / 0.3f );
+		BarLayout( b );
+
+		// (kept inside the screen, the label whole: held at the edge a little past it, faded out further)
+		float push = 0;
+		const float minX = POKE_BAR_EDGE + b.halfW, maxX = ScreenWidth - POKE_BAR_EDGE - b.halfW;
+		const float minY = POKE_BAR_EDGE + b.above, maxY = ScreenHeight - POKE_BAR_EDGE - 2;
+		if ( minX <= maxX )
+		{
+			if ( b.sx < minX ) { push = max( push, minX - b.sx ); b.sx = minX; }
+			if ( b.sx > maxX ) { push = max( push, b.sx - maxX ); b.sx = maxX; }
+		}
+		if ( b.sy < minY ) { push = max( push, minY - b.sy ); b.sy = minY; }
+		if ( b.sy > maxY ) { push = max( push, b.sy - maxY ); b.sy = maxY; }
+		if ( !bodyIn )
+			b.alpha *= 1 - Clamp01(( push - lh ) / ( lh * 4 ));
+		// (not over the radar, in the top left corner: faded out as it nears it)
+		if ( radar )
+		{
+			const float out = max( b.sx - b.halfW - radarW, b.sy - b.above - radarH );
+			b.alpha *= Clamp01( out / 12 );
+		}
+	}
+	if ( traced )
+		gEngfuncs.pEventAPI->EV_PopPMStates();
+	if ( !n )
+		return;
+
+	// (the furthest first: the nearer over them)
+	for ( int i = 1; i < n; i++ )
+		for ( int j = i; j > 0 && draws[j].dist > draws[j - 1].dist; j-- )
+		{
+			BarDraw t = draws[j]; draws[j] = draws[j - 1]; draws[j - 1] = t;
+		}
+	for ( int i = 0; i < n; i++ )
+	{
+		if ( draws[i].alpha <= 0.01f )
+			continue;
+		DrawPokemonBar( draws[i], now );
+		FlushShapes(); // (each over the ones behind it, its name too)
+		FlushTexts();
+	}
+}
+
+// The Poke Ball in hand: its skin the ball's (0 Pikachu, 1 Charizard, 2 Blastoise)
+// The Poke Ball held in third person (p_pokeball): its skin is the holder's (the server sets the holder's skin to the
+// ball's species, 0 to 2, while one is in hand); -1 for any other weapon model, the holder then drawn as it is
+int ArsUI_HeldBallSkin( int weaponModelIndex, int holderSkin )
+{
+	model_t *m = weaponModelIndex ? gEngfuncs.hudGetModelByIndex( weaponModelIndex ) : NULL;
+	if ( !m || !strstr( m->name, "pokemon/p_pokeball" ))
