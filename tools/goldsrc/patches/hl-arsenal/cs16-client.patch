+// why the server refuses an item, or would (the row flashed red)
+static const char *RefusalText( const BuyItem &it )
+{
+	if ( Full( it ))
+		return L( "Already have it", "Tu l'as d\xC3\xA9j\xC3\xA0" );
+	if ( IsCompanionItem( it.id ))
+	{
+		const int out = PokemonOut();
+		if ( out == SPECIES_LEM )
+			return L( "Le M is already out: one companion at a time", "Le M est d\xC3\xA9j\xC3\xA0 sorti : un compagnon \xC3\xA0 la fois" );
+		if ( out >= 0 )
+			return L( "Your Pok\xC3\xA9mon is already out: one companion at a time", "Ton Pok\xC3\xA9mon est d\xC3\xA9j\xC3\xA0 sorti : un compagnon \xC3\xA0 la fois" );
+		if ( Owned( LEM_LAPTOP ))
+			return it.id == LEM_LAPTOP ? L( "You already carry the laptop", "Tu portes d\xC3\xA9j\xC3\xA0 l'ordinateur" ) :
+				L( "You carry the laptop: one companion at a time", "Tu portes l'ordinateur : un compagnon \xC3\xA0 la fois" );
+		if ( OwnsCompanionItem())
+			return IsBall( it.id ) ? L( "You already carry a Pok\xC3\xA9 Ball", "Tu portes d\xC3\xA9j\xC3\xA0 une Pok\xC3\xA9 Ball" ) :
+				L( "You carry a Pok\xC3\xA9 Ball: one companion at a time", "Tu portes une Pok\xC3\xA9 Ball : un compagnon \xC3\xA0 la fois" );
+	}
+	if ( !Refused( it ))
+		return L( "Not enough money", "Pas assez d'argent" );
+	return strcmp( it.cmd, "shield" ) ? L( "Not with the shield", "Pas avec le bouclier" ) :
+		L( "Not with a Half-Life pistol or look", "Pas avec un pistolet ou une apparence Half-Life" );
+}
