+static const model_t *BuildHudSprite( void )
+{
+	if ( !g_hBuildHud && !g_bBuildHudTried )
+	{
+		g_bBuildHudTried = true;
+		g_hBuildHud = SPR_Load( BUILD_HUD_SPRITE );
+	}
+	if ( !g_hBuildHud )
