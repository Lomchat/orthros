+// a decimal number as the language writes it: 1.5, 1,5
+static void Decimal( char *buf, int size, const char *fmt, float v )
+{
+	snprintf( buf, size, fmt, v );
+	if ( French())
+		for ( char *c = buf; *c; c++ )
+			if ( *c == '.' && c > buf && c[-1] >= '0' && c[-1] <= '9' )
+				*c = ',';
+}
+
+// (the lines of a text, lineH apart, that fit from y to bottom)
+static int LinesFit( float y, float bottom, float lineH )
+{
+	const float room = bottom - y, lh = LineHeight();
+	return room < lh ? 0 : 1 + (int)(( room - lh ) / lineH );
+}
+
+// (the figures from y down, to bottom at most: the notes wrapped in the room left)
+static void ItemFigures( float x, float y, float w, float bottom, const BuyItem &it )
+{
+	int lh = LineHeight();
+	char text[48];
+	// (the rows closer on a short screen: the note's first line kept in the panel)
+	const int rows = it.health > 0 ? 5 : !it.damage ? 0 : 1 + ( it.cycle > 0 ) + ( it.armor > 0 && it.speed > 0 ) + ( it.range > 0 ) + ( it.speed > 0 ) + ( it.clip > 0 || it.reserve > 0 );
+	float row = lh * 1.55f;
+	// (a companion's two notes — its own, how it follows —, an item's one: their room kept first)
+	const float notes = it.health > 0 ? lh * 2.6f : lh * 1.3f;
+	if ( rows && y + rows * row + notes > bottom )
+		row = max( lh * 1.05f, ( bottom - y - notes ) / rows );
+	if ( it.health > 0 )
+	{
+		// (a Pokemon: its health, its attack's damage and pace, its reach, its speed)
+		snprintf( text, sizeof( text ), "%d", it.health );
+		StatRow( x, y, w, L( "HP", "PV" ), it.health / 240.0f, text, C_GREEN );
+		y += row;
+		if ( it.pellets > 1 )
+			snprintf( text, sizeof( text ), "%d x %d", (int)it.damage, it.pellets );
+		else
+			snprintf( text, sizeof( text ), "%d", (int)it.damage );
+		StatRow( x, y, w, L( "Damage", "D\xC3\xA9g\xC3\xA2ts" ), it.damage * it.pellets / 60.0f, text, C_RED );
+		y += row;
+		Decimal( text, sizeof( text ), L( "every %.1f s", "toutes les %.1f s" ), it.cycle );
+		StatRow( x, y, w, L( "Attack", "Attaque" ), 1.0f / it.cycle, text, C_GOLD );
+		y += row;
+		snprintf( text, sizeof( text ), "%d m", (int)( it.range * 0.0254f + 0.5f )); // (inches)
+		StatRow( x, y, w, L( "Range", "Port\xC3\xA9" "e" ), it.range / 800.0f, text, C_CTCOL );
+		y += row;
+		snprintf( text, sizeof( text ), "%d", (int)it.speed );
+		StatRow( x, y, w, L( "Speed", "Vitesse" ), ( it.speed - 180 ) / 140.0f, text, C_TEXT );
+		y += row;
+		const float noteH = lh * 1.25f;
+		const int room = LinesFit( y + 2, bottom, noteH );
+		y += TextWrap( x, y + 2, L( it.note ), w, C_TEXT, room > 0 ? min( 2, max( 1, room - 1 )) : 0, noteH ) * noteH;
+		const int left = LinesFit( y + 2, bottom, noteH );
+		if ( left > 0 )
+			TextWrap( x, y + 2, L( "Follows you, charges whoever you shoot or who hurts you", "Te suit, attaque ta cible ou qui te blesse" ), w, C_FAINT, min( 2, left ), noteH );
+		return;
+	}
+	if ( !it.damage )
+	{
+		TextWrap( x, y, L( it.note ), w, C_TEXT, min( 3, LinesFit( y, bottom, lh * 1.35f )), lh * 1.35f );
+		return;
+	}
+	if ( it.pellets > 1 )
+		snprintf( text, sizeof( text ), "%d x %d", (int)it.damage, it.pellets );
+	else
+		snprintf( text, sizeof( text ), "%d", (int)it.damage );
+	StatRow( x, y, w, L( "Damage", "D\xC3\xA9g\xC3\xA2ts" ), it.damage * it.pellets / 120.0f, text, C_RED );
+	y += row;
+	if ( it.cycle > 0 )
+	{
+		snprintf( text, sizeof( text ), L( "%d rpm", "%d coups/min" ), (int)( 60 / it.cycle + 0.5f ));
+		StatRow( x, y, w, L( "Fire rate", "Cadence" ), 60 / it.cycle / 900.0f, text, C_GOLD );
+		y += row;
+	}
+	if ( it.armor > 0 && it.speed > 0 )
+	{
+		float pen = min( 1.0f, it.armor * 0.5f );
+		snprintf( text, sizeof( text ), "%d%%", (int)( pen * 100 + 0.5f ));
+		StatRow( x, y, w, L( "Armor piercing", "Perforation" ), pen, text, C_CTCOL );
+		y += row;
+	}
+	if ( it.range > 0 )
+	{
+		float kept = it.range * it.range; // (damage kept at 1000 units)
+		snprintf( text, sizeof( text ), "%d%%", (int)( kept * 100 + 0.5f ));
+		StatRow( x, y, w, L( "Range", "Port\xC3\xA9" "e" ), kept, text, C_GREEN );
+		y += row;
+	}
+	if ( it.speed > 0 )
+	{
+		snprintf( text, sizeof( text ), "%d", (int)it.speed );
+		StatRow( x, y, w, L( "Mobility", "Mobilit\xC3\xA9" ), ( it.speed - 180 ) / 80.0f, text, C_TEXT );
+		y += row;
+	}
+	if ( it.clip > 0 || it.reserve > 0 )
+	{
+		if ( it.clip > 0 )
+			snprintf( text, sizeof( text ), "%d / %d", it.clip, it.reserve );
+		else
+			snprintf( text, sizeof( text ), "%d", it.reserve );
+		Text( x, y, it.clip > 0 ? L( "Magazine", "Chargeur" ) : L( "Carried", "En r\xC3\xA9serve" ), C_DIM );
+		TextRight( x + w, y, text, C_TEXT );
+		y += row;
+	}
+	TextWrap( x, y + 2, L( it.note ), w, C_FAINT, min( 2, LinesFit( y + 2, bottom, lh * 1.25f )), lh * 1.25f );
+}
+
+// the buy panel: the categories, their items, the hovered one turning with its figures
+static void DrawBuy( void )
+{
+	float fade = Fade();
+	float sw = ScreenWidth, sh = ScreenHeight;
+	int lh = LineHeight();
+	float W = min( 1120.0f, sw - 40 ), H = min( 640.0f, sh - 40 );
+	float x0 = (int)( sw - W ) / 2, y0 = (int)( sh - H ) / 2;
+	float headH = lh * 3.4f, footH = lh * 3.0f;
+	float tabsW = min( 200.0f, W * 0.2f ), listW = min( 380.0f, W * 0.36f );
+	float bodyY = y0 + headH, bodyH = H - headH - footH;
+	float dx = x0 + tabsW + listW, dw = W - tabsW - listW;
+	float px = dx + 1, py = bodyY + 1, pw = dw - 2, ph = bodyH * 0.46f; // (the model's hole)
+	int money = gHUD.m_Money.Money();
+
+	// panel, its hole
+	BackdropAdd( px, py, pw, ph, Alpha( C_PANEL, fade ));
+	Grad( px, py + ph * 0.6f, pw, ph * 0.4f, Alpha( C_GOLD, 0 ), Alpha( C_GOLD, 0.07f * fade ));
+	FillAround( x0, y0, W, H, px, py, pw, ph, Alpha( C_PANEL, fade ));
+	Grad( x0, y0, W, headH, Alpha( C_PANEL2, fade ), Alpha( C_PANEL, fade ));
+	Fill( x0, y0 + headH - 1, W, 1, Alpha( C_LINE, fade ));
+	Fill( x0, y0 + H - footH, W, 1, Alpha( C_LINE, fade ));
+	Fill( x0 + tabsW, bodyY, 1, bodyH, Alpha( C_SOFT, fade ));
+	Fill( dx, bodyY, 1, bodyH, Alpha( C_SOFT, fade ));
+	Frame( x0, y0, W, H, Alpha( C_LINE, fade ));
+	Fill( x0, y0, W, 2, Alpha( C_GOLD, fade ));
+
+	// header
+	float hy = y0 + ( headH - LineHeight( Scaled( 1.7f ) ? 1.7f : 1 )) / 2;
+	const char *buy = L( "BUY", "ACHAT" );
+	Text( x0 + 18, hy, buy, Alpha( C_GOLDT, fade ), 1.7f );
+	char sz[48];
+	snprintf( sz, sizeof( sz ), "$ %d", money );
+	TextRight( x0 + W - 18, hy, sz, Alpha( C_GREEN, fade ), 1.7f );
+	const float subX = x0 + 22 + TextW( buy, 1.7f ) + 10;
+	TextFit( subX, hy + LineHeight( Scaled( 1.7f ) ? 1.7f : 1 ) - lh - 1, L( "Anywhere, anytime  -  B, Esc or right click closes",
+		"Partout, \xC3\xA0 tout moment  -  B, \xC3\x89" "chap ou clic droit pour fermer" ), x0 + W - 18 - TextW( sz, 1.7f ) - 20 - subX, Alpha( C_DIM, fade ));
+
+	// tabs
+	float ty = bodyY + 8, tabH = min( lh * 2.25f, ( bodyH - 16 ) / NUM_TABS - 2 ); // (ten: fitted to a short screen)
+	for ( int t = 0; t < NUM_TABS; t++ )
+	{
+		int items[16], n = TabItems( t, items );
+		bool sel = t == g_iTab, hover = Hover( x0, ty, tabsW, tabH );
+		if ( sel || hover )
+			Fill( x0 + 1, ty, tabsW - 1, tabH, sel ? C_SEL : C_HOVER );
+		if ( sel )
+			Fill( x0 + 1, ty, 3, tabH, C_GOLD );
+		char key[4];
+		snprintf( key, sizeof( key ), "%d", ( t + 1 ) % 10 ); // (the tenth: 0)
+		KeyBadge( x0 + 14, ty + ( tabH - lh ) / 2, key, sel && g_iKeyLevel == 0 );
+		snprintf( key, sizeof( key ), "%d", n );
+		TextFit( x0 + 40, ty + ( tabH - lh ) / 2, L( g_Tabs[t].title ), tabsW - 40 - 12 - TextWidth( key ) - 6, Alpha( sel ? C_GOLDT : hover ? C_TEXT : C_DIM, fade ));
+		TextRight( x0 + tabsW - 12, ty + ( tabH - lh ) / 2, key, Alpha( C_FAINT, fade ));
+		if ( Clicked( x0, ty, tabsW, tabH ) && t != g_iTab )
+		{
+			g_iTab = t;
+			g_iFocus = -1;
+			g_iKeyLevel = 1;
+		}
+		ty += tabH + 2;
+	}
+
+	// items
+	int items[16], n = TabItems( g_iTab, items );
+	float lx = x0 + tabsW + 1, ly = bodyY + 8, rowH = lh * 2.4f;
+	TextFit( lx + 14, ly + 2, L( g_Tabs[g_iTab].menuTitle ), listW - 28, Alpha( C_GOLDT, fade ));
+	ly += lh * 1.8f;
+	int hovered = -1;
+	for ( int i = 0; i < n; i++ )
+	{
+		const BuyItem &it = g_Items[items[i]];
+		bool hover = Hover( lx, ly, listW - 1, rowH );
+		bool focus = items[i] == g_iFocus;
+		bool refused = Refused( it ) || Full( it ), afford = !refused && Price( it ) <= money, owned = Owned( it.id ) || Full( it );
+		if ( hover )
+			hovered = items[i];
+		float flash = items[i] == g_iFlashItem ? Clamp01( 1 - ( Now() - g_flFlash ) / 0.5f ) : 0;
+		Fill( lx + 6, ly + 1, listW - 13, rowH - 2, ( hover || focus ) ? C_HOVER : C_ROW );
+		if ( flash > 0 )
+			Fill( lx + 6, ly + 1, listW - 13, rowH - 2, Alpha( g_bFlashBad ? C_RED : C_GREEN, flash * 0.35f ));
+		if ( hover || focus )
+			Fill( lx + 6, ly + 1, 2, rowH - 2, C_GOLD );
+		char key[4];
+		snprintf( key, sizeof( key ), "%d", i + 1 );
+		float cy = ly + ( rowH - lh ) / 2;
+		KeyBadge( lx + 16, cy, key, ( hover || focus ) && g_iKeyLevel == 1 );
+		// (red only for the money; refused for another reason: dimmed, with why in a word)
+		snprintf( sz, sizeof( sz ), "$%d", Price( it ));
+		TextRight( lx + listW - 18, cy, sz, Alpha( afford ? C_GREEN : refused ? C_DIM : C_RED, fade ));
+		const char *tag = ( refused || owned ) ? RefusalTag( it ) : 0;
+		float nameRight = lx + listW - 26 - TextWidth( sz );
+		if ( tag )
+		{
+			TextRight( nameRight, cy, tag, Alpha( CompanionOut( it ) ? C_GOLD : C_DIM, fade ));
+			nameRight -= TextWidth( tag ) + 10;
+		}
+		TextFit( lx + 42, cy, L( it.name ), nameRight - lx - 42, Alpha( afford ? (( hover || focus ) ? C_GOLDT : C_TEXT ) : refused ? C_DIM : C_FAINT, fade ));
+		if ( hover && g_bClick )
+			Buy( items[i] );
+		ly += rowH + 3;
+	}
+	if ( hovered >= 0 && hovered != g_iHover )
+	{
+		g_iHover = hovered;
+		g_flHoverSince = Now();
+		g_flDragYaw = 0;
+	}
+	int shown = hovered >= 0 ? hovered : g_iFocus >= 0 ? g_iFocus : ( g_iHover >= 0 && g_iHover >= g_Tabs[g_iTab].first && g_iHover < g_Tabs[g_iTab].first + g_Tabs[g_iTab].count ) ? g_iHover : ( n ? items[0] : -1 );
+
+	// the shown item: its model, its figures
+	if ( shown >= 0 )
+	{
+		const BuyItem &it = g_Items[shown];
+		if ( it.model[0] )
+			PreviewAdd( 0, it.model, px + 10, py + 10, pw - 20, ph - 20, it.pose, 0 );
+		else
+			TextCenter( px + pw / 2, py + ph / 2 - lh / 2, L( "no model to show", "aucun mod\xC3\xA8le \xC3\xA0 afficher" ), Alpha( C_FAINT, fade ));
+		if ( Hover( px, py, pw, ph ))
+			TextRight( px + pw - 10, py + ph - lh - 8, L( "drag to turn", "glisser pour tourner" ), Alpha( C_FAINT, fade ));
+		float ix = dx + 22, iy = py + ph + 12, iw = dw - 44;
+		Text( ix, iy, L( it.name ), Alpha( C_GOLDT, fade ), 1.45f );
+		snprintf( sz, sizeof( sz ), "$%d", Price( it ));
+		bool refused = Refused( it ) || Full( it ), afford = !refused && Price( it ) <= money;
+		TextRight( ix + iw, iy, sz, Alpha( afford ? C_GREEN : refused ? C_DIM : C_RED, fade ), 1.45f );
+		iy += LineHeight( Scaled( 1.45f ) ? 1.45f : 1 ) + 4;
+		// (its kind and the side it is for: on one line, or two when that is too long)
+		const char *side = it.team == ONLY_T ? L( "Terrorists only", "Terroristes uniquement" ) :
+			it.team == ONLY_CT ? L( "Counter-Terrorists only", "Anti-terroristes uniquement" ) : NULL;
+		char kind[160];
+		snprintf( kind, sizeof( kind ), "%s%s%s", L( it.kind ), side ? "  -  " : "", side ? side : "" );
+		if ( side && TextWidth( kind ) > iw )
+		{
+			TextFit( ix, iy, L( it.kind ), iw, Alpha( C_DIM, fade ));
+			iy += lh * 1.25f;
+			TextFit( ix, iy, side, iw, Alpha( C_DIM, fade ));
+		}
+		else
+			TextFit( ix, iy, kind, iw, Alpha( C_DIM, fade ));
+		iy += lh * 1.9f;
+		ItemFigures( ix, iy, iw, y0 + H - footH - 4, it );
+	}
+
+	// footer: ammo, close
+	float fy = y0 + H - footH + ( footH - lh * 2.1f ) / 2, bh = lh * 2.1f;
+	// (the buttons as wide as their labels need, at least their usual widths)
+	const char *prim = L( "Primary ammo", "Munitions principales" ), *sec = L( "Secondary ammo", "Munitions secondaires" ), *close = L( "Close", "Fermer" );
+	const float pw1 = max( 190.0f, TextWidth( prim ) + TextWidth( "," ) + 46.0f ), pw2 = max( 200.0f, TextWidth( sec ) + TextWidth( "." ) + 46.0f );
+	const float cw1 = max( 130.0f, TextWidth( close ) + TextWidth( "B" ) + 46.0f );
+	float bx = x0 + 14;
+	if ( Button( bx, fy, pw1, bh, ",", prim, true, C_GOLD ))
+		ClientCmd( "primammo" );
+	bx += pw1 + 10;
+	if ( Button( bx, fy, pw2, bh, ".", sec, true, C_GOLD ))
+		ClientCmd( "secammo" );
+	if ( Button( x0 + W - 14 - cw1, fy, cw1, bh, "B", close, true, C_GOLD ))
+		Close();
+
+	// (the keys, or why a purchase failed: the server's word when it sent one, else what it would say; a centre
+	// message of the server that came while the panel is open — on two lines when one is not enough)
+	const float noteRight = x0 + W - 14 - cw1 - 16, noteLeft = bx + pw2 + 14, noteW = noteRight - noteLeft;
+	const char *note = NULL; Col noteCol = C_FAINT;
+	char hint[96];
+	if ( g_flNote >= 0 && Now() >= g_flNote && Now() - g_flNote < 2.5f && g_szNote[0] )
+	{
+		note = g_szNote;
+		noteCol = g_bNoteBad ? C_RED : C_GOLDT;
+	}
+	else if ( g_iFlashItem >= 0 && g_bFlashBad && Now() - g_flFlash < 1.5f )
+	{
+		note = RefusalText( g_Items[g_iFlashItem] );
+		noteCol = C_RED;
+	}
+	else
+	{
+		// (the hint, shorter when the whole one does not fit)
+		const int keys = min( max( n, 1 ), 9 );
+		for ( int shorter = 0; shorter < 2; shorter++ )
+		{
+			const char *more = shorter ? "" : L( "    wheel, arrows: category", "    molette, fl\xC3\xA8" "ches : cat\xC3\xA9gorie" );
+			if ( g_iKeyLevel )
+				snprintf( hint, sizeof( hint ), n > 1 ? L( "1-%d: buy    0: categories%s", "1-%d : acheter    0 : cat\xC3\xA9gories%s" ) : L( "%d: buy    0: categories%s", "%d : acheter    0 : cat\xC3\xA9gories%s" ), keys, more );
+			else if ( NUM_TABS >= 10 )
+				snprintf( hint, sizeof( hint ), L( "1-9, 0 category%s", "1-9, 0 cat\xC3\xA9gorie%s" ), more );
+			else
+				snprintf( hint, sizeof( hint ), L( "1-%d category%s", "1-%d cat\xC3\xA9gorie%s" ), NUM_TABS, more );
+			if ( TextWidth( hint ) <= noteW )
+				break;
+		}
+		note = hint;
+		noteCol = Alpha( C_FAINT, fade );
+	}
+	if ( note && noteW > 0 )
+	{
+		char lines[2][WRAP_LEN];
+		const int nl = WrapLines( note, noteW, lines, 2 );
+		const float lineH = lh * 1.1f, top = fy + ( bh - lh - ( nl - 1 ) * lineH ) / 2;
+		for ( int i = 0; i < nl; i++ )
+			TextRight( noteRight, top + i * lineH, lines[i], noteCol );
+	}
+
+	// dragging the model turns it
+	if ( g_bMouseDown && ( g_bDragging || Hover( px, py, pw, ph )))
+	{
+		if ( g_bDragging )
+			g_flDragYaw += ( g_cx - g_flDragLastX ) * 0.02f;
+		g_bDragging = true;
+		g_flDragLastX = g_cx;
+	}
+	else
+		g_bDragging = false;
+}
