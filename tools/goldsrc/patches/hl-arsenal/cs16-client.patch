+// The local player's weapons changed (HLWeapons, bit 0 for id 32): a ball gone from the hand that held it was thrown,
+// the laptop gone from it has typed Le M out
+void ArsUI_WeaponBits( int oldBits, int newBits )
+{
+	const float now = Now();
+	int balls = 0;
+	for ( int id = PK_PIKACHU; id <= LEM_LAPTOP; id++ )
+	{
+		const int bit = 1 << ( id - 32 );
+		balls |= newBits & bit;
+		const bool held = gHUD.m_Ammo.CurrentWeaponId() == id ||
+			( g_iBallHeld == id && g_flBallHeld >= 0 && now - g_flBallHeld < 1.0f && now >= g_flBallHeld );
+		if (( oldBits & bit ) && !( newBits & bit ) && held && gHUD.m_Health.m_iHealth > 0 )
+		{
+			g_flBallThrown = now;
+			g_iBallThrown = id;
+		}
+	}
+	if ( balls )
+		g_flBallThrown = -1; // (a ball carried again: it came back, no room to come out)
+	// (the laptop goes 0.5 s after Le M came — his PokeHP before it —: the one out already said so)
+	if ( g_flBallThrown >= 0 )
+	{
+		const int me = LocalIndex();
+		for ( int i = 0; i < MAX_POKEMON; i++ )
+			if ( g_Pokemon[i].ent && g_Pokemon[i].gone < 0 && g_Pokemon[i].stale < 0 && g_Pokemon[i].owner == me )
+				g_flBallThrown = -1;
+	}
+}
