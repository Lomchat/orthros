+// whether CL_CreateMove takes the fire buttons out of the commands sent: in build mode (fire builds, through BuildThink)
+bool ArsUI_BuildMasksAttack( void ) { return g_bBuild; }
+
+static int Bricks_Msg( const char *pszName, int iSize, void *pbuf )
+{
+	BufferReader reader( pszName, pbuf, iSize );
+	const int count = reader.ReadShort();
+	const int picked = iSize >= 3 ? reader.ReadByte() : 0;
+	g_iBricks = count < 0 ? 0 : count > BUILD_MAX_BRICKS ? BUILD_MAX_BRICKS : count;
+	if ( g_iBricks < g_iBuildBricksAtPlace )
+		g_bBuildPlaceAnswered = true; // (bricks spent: the piece sent last built)
+	g_bBricksKnown = true;
+	g_flBricksChanged = Now();
+	if ( picked > 0 )
+	{
+		const float now = Now();
+		int slot = -1;
+		for ( int i = 0; i < MAX_BRICK_POPUPS; i++ ) // (one picked a moment ago, still rising: added to it)
+			if ( g_BrickPopups[i].amount > 0 && now >= g_BrickPopups[i].t && now - g_BrickPopups[i].t < 0.3f )
+				slot = i;
+		if ( slot >= 0 )
+			g_BrickPopups[slot].amount += picked;
+		else
+		{
+			slot = 0; // (a free one, or the oldest)
+			for ( int i = 1; i < MAX_BRICK_POPUPS && g_BrickPopups[slot].amount; i++ )
+				if ( !g_BrickPopups[i].amount || g_BrickPopups[i].t < g_BrickPopups[slot].t )
+					slot = i;
+			g_BrickPopups[slot].amount = picked;
+		}
+		g_BrickPopups[slot].t = now;
+	}
+	return 1;
+}
+
+static int BuildMode_Msg( const char *pszName, int iSize, void *pbuf )
+{
+	BufferReader reader( pszName, pbuf, iSize );
+	const int flags = reader.ReadByte();
+	g_bBuildKnown = true;
+	g_bBuildEnabled = !!( flags & 2 );
+	g_bBuildServer = ( flags & 1 ) && g_bBuildEnabled;
+	// (the server's state, sent when it changes — not once per command of ours: right after a toggle of ours it may
+	// be older than the toggle; then, if it disagrees, BuildThink takes it once the grace is over. Building turned
+	// off: at once)
+	if ( !g_bBuildEnabled || BuildGraceOver( Now()) || g_bBuildServer == g_bBuild )
+		BuildSet( g_bBuildServer, false );
+	return 1;
+}
+
+static int BuildDeny_Msg( const char *pszName, int iSize, void *pbuf )
+{
+	BufferReader reader( pszName, pbuf, iSize );
+	g_iBuildDeny = reader.ReadByte();
+	g_flBuildDeny = Now();
+	g_bBuildPlaceAnswered = true; // (the piece sent last refused: not sent again)
+	BuildSound( "build/deny.wav", 0.8f );
+	if ( g_iBuildDeny == BUILD_DISABLED )
+		g_bBuildEnabled = false;
+	if ( g_iBuildDeny == BUILD_DISABLED || g_iBuildDeny == BUILD_CANNOT )
+	{
+		// (refused build mode, or a piece asked for out of it: the server is not in build mode — ours left at once,
+		// the server's word since taken as it comes)
+		g_bBuildServer = false;
+		g_flBuildToggled = -10;
+		BuildSet( false, false );
+	}
+	return 1;
+}
