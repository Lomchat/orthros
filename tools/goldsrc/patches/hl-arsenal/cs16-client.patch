+// The local player's look is one of Half-Life's (no shield hitbox)
+static bool HLLook( void )
+{
+	cl_entity_t *me = gEngfuncs.GetLocalPlayer();
+	if ( !me || !me->model )
+		return false;
+	for ( int t = 0; t < 2; t++ )
+		for ( int i = CS_LOOKS; i < NUM_LOOKS; i++ )
+		{
+			char path[96];
+			snprintf( path, sizeof( path ), "models/player/%s/%s.mdl", g_Looks[t][i].model, g_Looks[t][i].model );
+			if ( !strcmp( me->model->name, path ))
+				return true;
+		}
