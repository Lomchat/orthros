+// (the look panel, when the look was chosen elsewhere — the console: closed once the player is alive in the game after
+// a HUD reset; the game also resets it as a player connects and on a round restart, the player then still watching)
+void ArsUI_Spawned( void )
+{
+	g_flSpawned = Now();
+	// (the server sends its live Pokemon again right after each HUD reset: those it does not are gone)
+	for ( int i = 0; i < MAX_POKEMON; i++ )
+		if ( g_Pokemon[i].ent && g_Pokemon[i].gone < 0 )
+			g_Pokemon[i].stale = g_flSpawned;
+	g_flBallThrown = -1;
+	g_flHackStart = -1; // (a scramble does not outlive its victim)
+	BuildSpawned();
+}
+
+// The server's centre messages while the buy panel is open (a purchase refused: "You have insufficient funds!"...):
+// in the panel's footer, the item just bought flashed red, instead of over the panel
+static char g_szCenter[192]; static float g_flCenter = -1;
+static void DrawCenterMessage( void );
+
+bool ArsUI_CenterPrint( const char *text )
+{
+	if ( !text )
+		return false;
+	if ( g_iPanel != P_BUY )
+	{
+		// (a message with letters the engine's font lacks — the mod's own, in French: drawn here, where the engine's go;
+		// any other, Counter-Strike's included — a player's name in Cyrillic...: left to the engine, as it was)
+		bool latin = false;
+		for ( const unsigned char *c = (const unsigned char *)text; *c; )
+		{
+			if ( *c < 0x80 )
+			{
+				c++;
+				continue;
+			}
+			const int n = LatinSeq( c );
+			if ( !n )
+				return false;
+			latin = true;
+			c += n;
+		}
+		if ( !latin )
+			return false;
+		strncpy( g_szCenter, text, sizeof( g_szCenter ) - 1 );
+		g_szCenter[sizeof( g_szCenter ) - 1] = 0;
+		g_flCenter = Now();
+		return true;
+	}
+	// (on one line, trimmed)
+	int n = 0;
+	for ( const char *c = text; *c && n < (int)sizeof( g_szNote ) - 1; c++ )
+	{
+		const char ch = ( *c == '\n' || *c == '\r' || *c == '\t' ) ? ' ' : *c;
+		if ( ch == ' ' && ( !n || g_szNote[n - 1] == ' ' ))
+			continue;
+		g_szNote[n++] = ch;
+	}
+	while ( n > 0 && g_szNote[n - 1] == ' ' )
+		n--;
+	g_szNote[n] = 0;
+	if ( !n )
+		return true;
+	const float now = Now();
+	g_flNote = now;
+	g_bNoteBad = g_iFlashItem >= 0 && now >= g_flFlash && now - g_flFlash < 1.5f; // (the answer to a purchase)
+	if ( g_bNoteBad && !g_bFlashBad ) // (refused for a reason the panel did not see: flashed red after all)
+	{
+		g_bFlashBad = true;
+		g_flFlash = now;
+	}
+	return true;
+}
