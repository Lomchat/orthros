+// the team panel: the two sides, their models turning, how many play in each; auto-select, spectate
+static void DrawTeam( void )
+{
+	float fade = Fade();
+	float sw = ScreenWidth, sh = ScreenHeight;
+	Title( sh * 0.08f, L( "CHOOSE YOUR SIDE", "CHOISIS TON CAMP" ), L( "Click a side, or press its key", "Clique sur un camp, ou appuie sur sa touche" ), fade );
+	float cw = min( 340.0f, sw * 0.28f ), ch = min( 470.0f, sh * 0.6f ), gap = min( 48.0f, sw * 0.04f );
+	float x0 = sw / 2 - cw - gap / 2, y0 = sh * 0.22f;
+	float xs[2] = { x0, x0 + cw + gap };
+	ShadeAroundRow( xs, 2, cw, y0, ch, Alpha( C_SHADE, fade ));
+	int nT = TeamCount( TEAM_TERRORIST ), nCT = TeamCount( TEAM_CT );
+	char l1[64], l2[64];
+	int look = (int)( Now() / 3.5f ) % NUM_LOOKS; // (the side's looks, in turn)
+	char model[64];
+
+	const char *goals[2] = { L( "Plant the bomb, hold the hostages", "Pose la bombe, garde les otages" ),
+		L( "Defuse the bomb, rescue the hostages", "D\xC3\xA9samorce la bombe, lib\xC3\xA8re les otages" ) };
+	const bool wrap = TextWidth( goals[0] ) > cw - 24 || TextWidth( goals[1] ) > cw - 24; // (a goal too long: both on two lines)
+	Players( l1, sizeof( l1 ), nT );
+	snprintf( model, sizeof( model ), "models/player/%s/%s.mdl", g_Looks[0][look].model, g_Looks[0][look].model );
+	if ( Card( 0, x0, y0, cw, ch, model, POSE_UPRIGHT, "1", L( "Terrorists", "Terroristes" ), l1, goals[0], C_TCOL, Allowed( 1 ), fade, wrap ))
+	{
+		Command( "jointeam %d", 1 );
+		Close();
+		return;
+	}
+	Players( l1, sizeof( l1 ), nCT );
+	snprintf( model, sizeof( model ), "models/player/%s/%s.mdl", g_Looks[1][look].model, g_Looks[1][look].model );
+	if ( Card( 1, x0 + cw + gap, y0, cw, ch, model, POSE_UPRIGHT, "2", L( "Counter-Terrorists", "Anti-terroristes" ), l1, goals[1], C_CTCOL, Allowed( 2 ), fade, wrap ))
+	{
+		Command( "jointeam %d", 2 );
+		Close();
+		return;
+	}
+	(void)l2;
+	float by = y0 + ch + 22, bh = LineHeight() * 2.2f, bw = min( 210.0f, cw * 0.62f );
+	int buttons = 1 + Allowed( 3 ) + Allowed( 6 ) + Allowed( 10 );
+	float bx = sw / 2 - ( buttons * bw + ( buttons - 1 ) * 14 ) / 2;
+	if ( Button( bx, by, bw, bh, "5", L( "Auto-select", "S\xC3\xA9lection auto" ), Allowed( 5 ), C_GOLD ))
+	{
+		Command( "jointeam %d", 5 );
+		Close();
+		return;
+	}
+	bx += bw + 14;
+	if ( Allowed( 3 ))
+	{
+		if ( Button( bx, by, bw, bh, "3", "VIP", true, C_GOLD ))
+		{
+			Command( "jointeam %d", 3 );
+			Close();
+			return;
+		}
+		bx += bw + 14;
+	}
+	if ( Allowed( 6 ))
+	{
+		if ( Button( bx, by, bw, bh, "6", L( "Spectate", "Spectateur" ), true, C_GOLD ))
+		{
+			Command( "jointeam %d", 6 );
+			Close();
+			return;
+		}
+		bx += bw + 14;
+	}
+	if ( Allowed( 10 ) && Button( bx, by, bw, bh, "0", L( "Cancel", "Annuler" ), true, C_GOLD ))
+		Close();
+}
