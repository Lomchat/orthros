+
+static void ItemFigures( float x, float y, float w, const BuyItem &it )
+{
+	int lh = LineHeight();
+	float row = lh * 1.55f;
+	char text[48];
+	if ( it.health > 0 )
+	{
+		// (a Pokemon: its health, its attack's damage and pace, its reach, its speed)
+		snprintf( text, sizeof( text ), "%d", it.health );
+		StatRow( x, y, w, "Health", it.health / 240.0f, text, C_GREEN );
+		y += row;
+		if ( it.pellets > 1 )
+			snprintf( text, sizeof( text ), "%d x %d", (int)it.damage, it.pellets );
+		else
+			snprintf( text, sizeof( text ), "%d", (int)it.damage );
+		StatRow( x, y, w, "Damage", it.damage * it.pellets / 60.0f, text, C_RED );
+		y += row;
+		snprintf( text, sizeof( text ), "every %.1f s", it.cycle );
+		StatRow( x, y, w, "Attack", 1.0f / it.cycle, text, C_GOLD );
+		y += row;
+		snprintf( text, sizeof( text ), "%d m", (int)( it.range * 0.0254f + 0.5f )); // (inches)
+		StatRow( x, y, w, "Range", it.range / 800.0f, text, C_CTCOL );
+		y += row;
+		snprintf( text, sizeof( text ), "%d", (int)it.speed );
+		StatRow( x, y, w, "Speed", ( it.speed - 180 ) / 140.0f, text, C_TEXT );
+		y += row;
+		TextFit( x, y + 2, it.note, w, C_TEXT );
+		TextFit( x, y + 2 + lh * 1.35f, "Follows you; charges whoever you shoot or who hurts you", w, C_FAINT );
+		return;
+	}
+	if ( !it.damage )
+	{
+		Text( x, y, it.note, C_TEXT );
+		return;
+	}
+	if ( it.pellets > 1 )
+		snprintf( text, sizeof( text ), "%d x %d", (int)it.damage, it.pellets );
+	else
+		snprintf( text, sizeof( text ), "%d", (int)it.damage );
+	StatRow( x, y, w, "Damage", it.damage * it.pellets / 120.0f, text, C_RED );
+	y += row;
+	if ( it.cycle > 0 )
+	{
+		snprintf( text, sizeof( text ), "%d rpm", (int)( 60 / it.cycle + 0.5f ));
+		StatRow( x, y, w, "Fire rate", 60 / it.cycle / 900.0f, text, C_GOLD );
+		y += row;
+	}
+	if ( it.armor > 0 && it.speed > 0 )
+	{
+		float pen = min( 1.0f, it.armor * 0.5f );
+		snprintf( text, sizeof( text ), "%d%%", (int)( pen * 100 + 0.5f ));
+		StatRow( x, y, w, "Armor piercing", pen, text, C_CTCOL );
+		y += row;
+	}
+	if ( it.range > 0 )
+	{
+		float kept = it.range * it.range; // (damage kept at 1000 units)
+		snprintf( text, sizeof( text ), "%d%%", (int)( kept * 100 + 0.5f ));
+		StatRow( x, y, w, "Range", kept, text, C_GREEN );
+		y += row;
+	}
+	if ( it.speed > 0 )
+	{
+		snprintf( text, sizeof( text ), "%d", (int)it.speed );
+		StatRow( x, y, w, "Mobility", ( it.speed - 180 ) / 80.0f, text, C_TEXT );
+		y += row;
+	}
+	if ( it.clip > 0 || it.reserve > 0 )
+	{
+		if ( it.clip > 0 )
+			snprintf( text, sizeof( text ), "%d / %d", it.clip, it.reserve );
+		else
+			snprintf( text, sizeof( text ), "%d", it.reserve );
+		Text( x, y, it.clip > 0 ? "Magazine" : "Carried", C_DIM );
+		TextRight( x + w, y, text, C_TEXT );
+		y += row;
+	}
+	Text( x, y + 2, it.note, C_FAINT );
+}
