+// The Half-Life arsenal's death notice icons (d_*) of the Half-Life hud.txt at a resolution, after Counter-Strike's
+// sprites: named d_hl_* where Counter-Strike has one of the same name (d_hl_grenade). Their sprite sheets are the
+// valve folder's, whose names Counter-Strike's shadow.
+static bool HL_WantedSprite( const client_sprite_t *p, int iRes )
+{
+	return p->iRes == iRes && !strncmp( p->szName, "d_", 2 );
+}
+
+static void HL_SpriteName( char *dest, const client_sprite_t *p, const char *names, int count )
+{
+	for ( int i = 0; i < count; i++ )
+	{
+		if ( !strncmp( p->szName, names + i * MAX_SPRITE_NAME_LENGTH, MAX_SPRITE_NAME_LENGTH ) )
+		{
+			snprintf( dest, MAX_SPRITE_NAME_LENGTH, "d_hl_%s", p->szName + 2 );
+			return;
+		}
+	}
+
+	strncpy( dest, p->szName, MAX_SPRITE_NAME_LENGTH );
+}
+
+// Half Strike's own HUD icons, outside any hud.txt: a whole sprite each (its first frame), named for GetSpriteIndex
+// (d_pokemon: the death notice of a kill by a Pokemon, weapon "pokemon"; d_lem: by Le M, weapon "lem")
+static const struct { const char *name, *sprite; } g_ExtraSprites[] =
+{
+	{ "d_pokemon", "sprites/pokemon/d_pokemon.spr" },
+	{ "d_lem", "sprites/others/d_lem.spr" }, // (a kill by Le M, weapon "lem": a laptop with its prompt)
+};
+#define NUM_EXTRA_SPRITES ( (int)( sizeof( g_ExtraSprites ) / sizeof( g_ExtraSprites[0] )))
+
+static void Extra_LoadSprite( int i, HSPRITE *handle, wrect_t *rect, char *name )
+{
+	*handle = SPR_Load( g_ExtraSprites[i].sprite );
+	if ( rect )
+	{
+		rect->left = rect->top = 0;
+		rect->right = *handle ? SPR_Width( *handle, 0 ) : 0;
+		rect->bottom = *handle ? SPR_Height( *handle, 0 ) : 0;
+	}
+	if ( name )
+		strncpy( name, g_ExtraSprites[i].name, MAX_SPRITE_NAME_LENGTH );
+}
