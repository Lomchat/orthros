+//
+// Drawing
+//
+static float SC( float v ) { return v * gHUD.m_flScale; } // (HUD units to the screen's: shapes are drawn in its pixels)
+
+// The shapes of a frame go in one batch, drawn at its end in one call, then its texts over them (in their order:
+// a shape is never drawn over a text)
+#define MAX_QUADS 1024
+#define MAX_TEXTS 320
+
+struct Quad { float x[4], y[4]; Col c[4]; };
+struct QueuedText { float x, y, maxX, scale; Col c; char s[96]; };
+
+static Quad g_Quads[MAX_QUADS];
+static int g_iQuads;
+static QueuedText g_Texts[MAX_TEXTS];
+static int g_iTexts;
+
+static void Quad4( float x, float y, float w, float h, Col c00, Col c01, Col c11, Col c10 )
+{
+	if ( w <= 0 || h <= 0 || g_iQuads >= MAX_QUADS || ( !c00.a && !c01.a && !c11.a && !c10.a ))
+		return;
+	Quad &q = g_Quads[g_iQuads++];
+	q.x[0] = q.x[1] = SC( x ); q.x[2] = q.x[3] = SC( x + w );
+	q.y[0] = q.y[3] = SC( y ); q.y[1] = q.y[2] = SC( y + h );
+	q.c[0] = c00; q.c[1] = c01; q.c[2] = c11; q.c[3] = c10;
+}
+
+// a quadrilateral of any shape (HUD units), one colour
+static void QuadPts( const float *xs, const float *ys, Col c )
+{
+	if ( g_iQuads >= MAX_QUADS || !c.a )
+		return;
+	Quad &q = g_Quads[g_iQuads++];
+	for ( int k = 0; k < 4; k++ ) { q.x[k] = SC( xs[k] ); q.y[k] = SC( ys[k] ); q.c[k] = c; }
+}
+
+static void Color( Col c ) { gEngfuncs.pTriAPI->Color4f( c.r / 255.0f, c.g / 255.0f, c.b / 255.0f, c.a / 255.0f ); }
+
+static void Grad( float x, float y, float w, float h, Col top, Col bottom ) { Quad4( x, y, w, h, top, bottom, bottom, top ); }
+
+static void GradH( float x, float y, float w, float h, Col left, Col right ) { Quad4( x, y, w, h, left, left, right, right ); }
+
+static void Fill( float x, float y, float w, float h, Col c ) { Quad4( x, y, w, h, c, c, c, c ); }
+
+static void Frame( float x, float y, float w, float h, Col c, float t = 1 )
+{
+	Fill( x, y, w, t, c );
+	Fill( x, y + h - t, w, t, c );
+	Fill( x, y + t, t, h - 2 * t, c );
+	Fill( x + w - t, y + t, t, h - 2 * t, c );
+}
+
+// a filled rectangle with a hole in it (where a model turns)
+static void FillAround( float x, float y, float w, float h, float hx, float hy, float hw, float hh, Col c )
+{
+	Fill( x, y, w, hy - y, c );
+	Fill( x, hy + hh, w, y + h - hy - hh, c );
+	Fill( x, hy, hx - x, hh, c );
+	Fill( hx + hw, hy, x + w - hx - hw, hh, c );
+}
+
+// the screen shaded but for a row of cards (same top, same height, left to right)
+static void ShadeAroundRow( const float *xs, int n, float w, float y, float h, Col c )
+{
+	float sw = ScreenWidth, sh = ScreenHeight;
+	Fill( 0, 0, sw, y, c );
+	Fill( 0, y + h, sw, sh - y - h, c );
+	float x = 0;
+	for ( int i = 0; i < n; i++ )
+	{
+		Fill( x, y, xs[i] - x, h, c );
+		x = xs[i] + w;
+	}
+	Fill( x, y, sw - x, h, c );
+}
+
+// the screen shaded but for two rows of cards (each its own left edges, width, top and height)
+static void ShadeAroundRows( const float *xs1, int n1, float w1, float y1, float h1, const float *xs2, int n2, float w2, float y2, float h2, Col c )
+{
+	float sw = ScreenWidth, sh = ScreenHeight;
+	Fill( 0, 0, sw, y1, c );
+	Fill( 0, y1 + h1, sw, y2 - y1 - h1, c );
+	Fill( 0, y2 + h2, sw, sh - y2 - h2, c );
+	const float *xs[2] = { xs1, xs2 }; const int ns[2] = { n1, n2 }; const float ws[2] = { w1, w2 }, ys[2] = { y1, y2 }, hs[2] = { h1, h2 };
+	for ( int r = 0; r < 2; r++ )
+	{
+		float x = 0;
+		for ( int i = 0; i < ns[r]; i++ ) { Fill( x, ys[r], xs[r][i] - x, hs[r], c ); x = xs[r][i] + ws[r]; }
+		Fill( x, ys[r], sw - x, hs[r], c );
+	}
+}
+
+static void FlushShapes( void )
+{
+	if ( !g_iQuads )
+		return;
+	gRenderAPI.GL_SelectTexture( 0 );
+	gRenderAPI.GL_Bind( 0, gHUD.m_WhiteTex );
+	gEngfuncs.pTriAPI->RenderMode( kRenderTransAlpha );
+	gEngfuncs.pTriAPI->CullFace( TRI_NONE );
+	gEngfuncs.pTriAPI->Brightness( 1.0f );
+	gEngfuncs.pTriAPI->Begin( TRI_QUADS );
+	for ( int i = 0; i < g_iQuads; i++ )
+	{
+		const Quad &q = g_Quads[i];
+		for ( int k = 0; k < 4; k++ )
+		{
+			gEngfuncs.pTriAPI->Color4f( q.c[k].r / 255.0f, q.c[k].g / 255.0f, q.c[k].b / 255.0f, q.c[k].a / 255.0f );
+			gEngfuncs.pTriAPI->TexCoord2f( k >= 2, k == 1 || k == 2 );
+			gEngfuncs.pTriAPI->Vertex3f( q.x[k], q.y[k], 0 );
+		}
+	}
+	gEngfuncs.pTriAPI->End();
+	gEngfuncs.pTriAPI->RenderMode( kRenderNormal );
+	g_iQuads = 0;
+}
+
+static int LineHeight( float scale = 1 ) { return (int)( gHUD.GetCharHeight() * scale ); }
+
+// The HUD font is ASCII: an e acute (UTF-8) is drawn as an e with its accent drawn over it (Pokemon). Returns the
+// accents' places in out.
+static int Latin( const char *s, char *out, int size, int *accents, int maxAccents )
+{
+	int n = 0, a = 0;
+	while ( *s && n < size - 1 )
+	{
+		const unsigned char c = (unsigned char)s[0];
+		if ( c == 0xC3 && (unsigned char)s[1] == 0xA9 )
+		{
+			if ( a < maxAccents )
+				accents[a++] = n;
+			out[n++] = 'e';
+			s += 2;
+			continue;
+		}
+		// (any other UTF-8 sequence passed on whole, for the engine's own decoding — or not at all when it does not fit)
+		int len = 1;
+		if ( c >= 0xC0 && c < 0xE0 ) len = 2;
+		else if ( c >= 0xE0 && c < 0xF0 ) len = 3;
+		else if ( c >= 0xF0 && c < 0xF8 ) len = 4;
+		int k = 1;
+		while ( k < len && ( (unsigned char)s[k] & 0xC0 ) == 0x80 )
+			k++;
+		if ( n + k > size - 1 )
+			break;
+		memcpy( out + n, s, k );
+		n += k;
+		s += k;
+	}
+	out[n] = 0;
+	return a;
+}
+
+static int TextWidth( const char *s, float scale = 1 )
+{
+	char buf[128]; int accents[4];
+	Latin( s, buf, sizeof( buf ), accents, 4 );
+	return (int)( DrawUtils::HudStringLen( buf ) * scale );
+}
+
+static bool Scaled( float scale ) { return scale != 1 && g_iMobileAPIVersion; }
+
+static void TextClip( float x, float y, float maxX, const char *s, Col c, float scale = 1 )
+{
+	if ( g_iTexts >= MAX_TEXTS || !c.a || !s[0] )
+		return;
+	const Col accentColour = c;
+	if ( c.a < 255 )
+	{
+		float f = c.a / 255.0f;
+		c.r *= f; c.g *= f; c.b *= f; // (the font is additive)
+	}
+	QueuedText &t = g_Texts[g_iTexts++];
+	t.x = x; t.y = y; t.maxX = maxX; t.scale = Scaled( scale ) ? scale : 0.0f; t.c = c;
+	int accents[4];
+	const int na = Latin( s, t.s, sizeof( t.s ), accents, 4 );
+	// (the accents: a short stroke rising to the right, centred over their e a pixel above its x-height, in the
+	// text's colour. The font's x-height is about 0.35 of its line, from 0.30 of it down; the stroke is 60 % of that)
+	const float k = t.scale ? t.scale : 1.0f, lh = gHUD.GetCharHeight() * k, cw = gHUD.GetCharWidth( 'e' ) * k;
+	for ( int i = 0; i < na; i++ )
+	{
+		char prefix[96];
+		memcpy( prefix, t.s, accents[i] );
+		prefix[accents[i]] = 0;
+		const float ex = x + DrawUtils::HudStringLen( prefix ) * k;
+		if ( ex + cw > maxX )
+			break;
+		const float xh = lh * 0.35f, len = max( 2.5f, xh * 0.6f );
+		const float tw = max( 1.2f, lh * 0.075f ); // (the stroke's width, across)
+		const float dy = len * 0.86f, dx = len * 0.5f; // (rising at 60 degrees)
+		const float cx = ex + cw * 0.5f, yb = y + lh * 0.30f - 2, yt = yb - dy; // (a pixel clear of the e)
+		const float x0 = cx - dx / 2 - tw / 2, x1 = cx + dx / 2 - tw / 2;
+		const float xs[4] = { x0, x0 + tw, x1 + tw, x1 }, ys[4] = { yb, yb, yt, yt };
+		QuadPts( xs, ys, accentColour );
+	}
+}
+
+static void Text( float x, float y, const char *s, Col c, float scale = 1 ) { TextClip( x, y, 100000, s, c, scale ); }
+
+static void FlushTexts( void )
+{
+	for ( int i = 0; i < g_iTexts; i++ )
+	{
+		const QueuedText &t = g_Texts[i];
+		if ( !t.scale )
+		{
+			DrawUtils::DrawHudString( (int)t.x, (int)t.y, (int)t.maxX, t.s, t.c.r, t.c.g, t.c.b );
+			continue;
+		}
+		// (enlarged: a character at a time, advanced by its width at that scale — the client's own scaled strings
+		// divide the advance by the HUD's scale once more, which overlaps them on a stretched HUD)
+		float x = t.x;
+		for ( const char *c = t.s; *c; c++ )
+		{
+			gMobileAPI.pfnDrawScaledCharacter( (int)x, (int)t.y, (unsigned char)*c, t.c.r, t.c.g, t.c.b, t.scale );
+			x += gHUD.GetCharWidth( (unsigned char)*c ) * t.scale;
+		}
+	}
+	g_iTexts = 0;
+}
+
+static int TextW( const char *s, float scale ) { return Scaled( scale ) ? TextWidth( s, scale ) : TextWidth( s ); }
+
+static void TextCenter( float cx, float y, const char *s, Col c, float scale = 1 ) { Text( cx - TextW( s, scale ) / 2, y, s, c, scale ); }
+
+static void TextRight( float rx, float y, const char *s, Col c, float scale = 1 ) { Text( rx - TextW( s, scale ), y, s, c, scale ); }
+
+// the text cut at a width, with an ellipsis
+static void TextFit( float x, float y, const char *s, float w, Col c )
+{
+	char buf[96];
+	strncpy( buf, s, sizeof( buf ) - 1 );
+	buf[sizeof( buf ) - 1] = 0;
+	if ( TextWidth( buf ) <= w )
+	{
+		Text( x, y, buf, c );
+		return;
+	}
+	for ( int n = strlen( buf ); n > 0; n-- )
+	{
+		buf[n] = 0;
+		strcat( buf, "..." );
+		if ( TextWidth( buf ) <= w )
+			break;
+		buf[n] = 0;
+	}
+	Text( x, y, buf, c );
+}
+
+static bool Hover( float x, float y, float w, float h ) { return g_cx >= x && g_cx < x + w && g_cy >= y && g_cy < y + h; }
+
+static bool Clicked( float x, float y, float w, float h ) { return g_bClick && Hover( x, y, w, h ); }
+
+// a key's badge: [1]
+static void KeyBadge( float x, float y, const char *key, bool lit )
+{
+	int h = LineHeight();
+	int w = TextWidth( key ) + 10;
+	Fill( x, y - 2, w, h + 4, lit ? Alpha( C_GOLD, 0.6f ) : C_SOFT );
+	Text( x + 5, y, key, lit ? C_WHITE : C_DIM ); // (the font is additive: light on the gold)
+}
+
+// a button with a key; returns whether it was clicked
+static bool Button( float x, float y, float w, float h, const char *key, const char *label, bool enabled, Col accent )
+{
+	bool hover = enabled && Hover( x, y, w, h );
+	Fill( x, y, w, h, hover ? C_HOVER : C_PANEL2 );
+	Frame( x, y, w, h, hover ? accent : C_SOFT );
+	int lh = LineHeight();
+	float tx = x + 12;
+	if ( key )
+	{
+		KeyBadge( tx, y + ( h - lh ) / 2, key, hover );
+		tx += TextWidth( key ) + 20;
+	}
+	Text( tx, y + ( h - lh ) / 2, label, enabled ? ( hover ? C_GOLDT : C_TEXT ) : C_FAINT );
+	return enabled && Clicked( x, y, w, h );
+}
