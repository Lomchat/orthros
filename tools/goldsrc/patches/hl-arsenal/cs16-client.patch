+}
+
+// The laptop in hand (v_laptop): its screen's code scrolls — its skins are the frames of it, shown in turn
+#define LAPTOP_SCREEN_RATE 12.0f // (frames a second)
+
+void ArsUI_ViewModelSkin( cl_entity_t *view )
+{
+	if ( !view || !view->model )
+		return;
+	if ( strstr( view->model->name, "others/v_laptop" ))
+	{
+		studiohdr_t *hdr = (studiohdr_t *)IEngineStudio.Mod_Extradata( view->model );
+		const int skins = hdr ? hdr->numskinfamilies : 1;
+		const float t = Now();
+		// (the skins carry the typing: they turn only while its hands type, "type" and "deploy"; else the still code)
+		bool typing = false;
+		if ( hdr && view->curstate.sequence >= 0 && view->curstate.sequence < hdr->numseq )
+		{
+			const mstudioseqdesc_t *seq = (const mstudioseqdesc_t *)( (byte *)hdr + hdr->seqindex ) + view->curstate.sequence;
+			typing = !strcmp( seq->label, "type" ) || !strcmp( seq->label, "deploy" );
+		}
+		view->curstate.skin = typing && skins > 1 && t > 0 ? (int)( t * LAPTOP_SCREEN_RATE ) % skins : 0;
+		return;
+	}
+	if ( !strstr( view->model->name, "pokemon/v_pokeball" ))
+		return;
+	const int id = gHUD.m_Ammo.CurrentWeaponId();
+	if ( IsBall( id ))
+		view->curstate.skin = id - PK_PIKACHU;
+}
+
+//
+// Le M's Hack: the victim's screen scrambled a moment (the server's LemHack message: byte duration in hundredths of a
+// second, 0 ends it; byte strength, 255 full) — green glitch blocks, scanlines, torn slices, the view jolted; the
+// screen never hidden whole (at most a third of it covered at the peak, most of that see-through)
+//
+static int LemHack_Msg( const char *pszName, int iSize, void *pbuf )
+{
+	BufferReader reader( pszName, pbuf, iSize );
+	const int length = reader.ReadByte(), strength = reader.ReadByte();
+	if ( length <= 0 )
+	{
+		g_flHackStart = -1;
+		return 1;
+	}
+	const float now = Now(), k = strength > 0 ? strength / 255.0f : 1.0f;
+	// (hit again while scrambled: the longer of the two, the stronger)
+	if ( g_flHackStart >= 0 && now >= g_flHackStart && now < g_flHackStart + g_flHackLength )
+	{
+		g_flHackLength = max( g_flHackStart + g_flHackLength, now + length / 100.0f ) - g_flHackStart;
+		g_flHackStrength = max( g_flHackStrength, k );
+		return 1;
+	}
+	g_flHackStart = now;
+	g_flHackLength = length / 100.0f;
+	g_flHackStrength = k;
+	g_iHackWatched = g_iUser1 == OBS_IN_EYE ? g_iUser2 : 0;
+	return 1;
+}
+
+// the scramble's strength now: up fast, held, faded over its last 40 %; 0 none
+static float HackLevel( float now )
+{
+	if ( g_flHackStart < 0 || g_flHackLength <= 0 )
+		return 0;
+	const float t = now - g_flHackStart;
+	// (it ends with its victim's life — the local player's; a spectator's own health is 0: as long as it watches the
+	// same one through its eyes)
+	const bool gone = g_iHackWatched ? ( g_iUser1 != OBS_IN_EYE || g_iUser2 != g_iHackWatched ) :
+		( g_iUser1 || gHUD.m_Health.m_iHealth <= 0 );
+	if ( t < 0 || t >= g_flHackLength || gone )
+	{
+		g_flHackStart = -1;
+		return 0;
+	}
+	const float u = t / g_flHackLength;
+	return g_flHackStrength * Clamp01( t / 0.04f ) * ( u < 0.6f ? 1.0f : 1.0f - ( u - 0.6f ) / 0.4f );
+}
+
+// (a cheap hash: the same draw for a step of time, another for the next)
+static unsigned HackHash( unsigned a, unsigned b )
+{
+	unsigned h = a * 0x9E3779B1u ^ ( b + 0x7F4A7C15u + ( a << 6 ) + ( a >> 2 ));
+	h ^= h >> 15; h *= 0x2C1B3C6Du; h ^= h >> 12; h *= 0x297A2D39u; h ^= h >> 15;
+	return h;
+}
+static float HackRand( unsigned a, unsigned b ) { return ( HackHash( a, b ) & 0xFFFFFF ) / (float)0x1000000; }
+
+static const Col C_CODE  = { 70, 255, 120, 255 };
+static const Col C_CODE2 = { 20, 150, 60, 255 };
+static const Col C_CODEW = { 200, 255, 210, 255 };
+static const Col C_BLACK = { 0, 0, 0, 255 };
+
+void ArsUI_HackView( float *origin, float *angles )
+{
+	const float k = HackLevel( Now());
+	if ( k <= 0 )
+		return;
+	// (jolted at 25 steps a second, a little: the whole picture torn sideways)
+	const unsigned step = (unsigned)( Now() * 25 );
+	angles[1] += ( HackRand( step, 1 ) - 0.5f ) * 2.4f * k; // (yaw, pitch, roll)
+	angles[0] += ( HackRand( step, 2 ) - 0.5f ) * 1.2f * k;
+	angles[2] += ( HackRand( step, 3 ) - 0.5f ) * 2.0f * k;
+	(void)origin;
+}
+
+void ArsUI_DrawHackScramble( float flTime )
+{
+	const float now = Now(), k = HackLevel( now );
+	if ( k <= 0 )
+		return;
+	const float sw = ScreenWidth, sh = ScreenHeight;
+	const unsigned step = (unsigned)( now * 20 ); // (the blocks redrawn 20 times a second)
+	const float t = now - g_flHackStart;
+
+	// (a green cast over all, strongest at the hit)
+	Fill( 0, 0, sw, sh, Alpha( C_CODE2, k * ( 0.10f + 0.12f * Clamp01( 1 - t / 0.12f ))));
+
+	// (scanlines: a dark line every 4 units, rolling down)
+	const int roll = (int)( now * 60 ) & 3;
+	for ( float y = (float)roll; y < sh; y += 4 )
+		Fill( 0, y, sw, 1, Alpha( C_BLACK, 0.28f * k ));
+
+	// (torn slices: a band shifted sideways — its edge dark where the picture left, a green ghost where it went)
+	const int slices = 3 + (int)( 4 * k );
+	for ( int i = 0; i < slices; i++ )
+	{
+		const float y = HackRand( step, 10 + i ) * sh, h = 4 + HackRand( step, 30 + i ) * sh * 0.05f;
+		const float shift = ( HackRand( step, 50 + i ) - 0.5f ) * sw * 0.12f * k;
+		const float ax = fabs( shift );
+		const float x0 = shift > 0 ? 0 : sw - ax;
+		Fill( x0, y, ax, h, Alpha( C_BLACK, 0.55f * k ));
+		GradH( shift > 0 ? ax : sw - ax - sw * 0.35f, y, sw * 0.35f, h, Alpha( C_CODE, shift > 0 ? 0.20f * k : 0 ), Alpha( C_CODE, shift > 0 ? 0 : 0.20f * k ));
+		Fill( 0, y, sw, 1, Alpha( C_CODEW, 0.35f * k ));
+		Fill( 0, y + h - 1, sw, 1, Alpha( C_CODE2, 0.45f * k ));
+	}
+
+	// (glitch blocks: green and black rectangles in rows, some lit, most see-through)
+	const int blocks = (int)( 14 + 34 * k );
+	for ( int i = 0; i < blocks; i++ )
+	{
+		const float bw = 12 + HackRand( step, 100 + i ) * HackRand( step, 200 + i ) * sw * 0.35f;
+		const float bh = 3 + HackRand( step, 300 + i ) * HackRand( step, 400 + i ) * sh * 0.10f;
+		const float bx = HackRand( step, 500 + i ) * ( sw - bw ), by = HackRand( step, 600 + i ) * ( sh - bh );
+		const float kind = HackRand( step, 700 + i );
+		if ( kind < 0.45f )
+			Fill( bx, by, bw, bh, Alpha( C_CODE, ( 0.18f + 0.30f * HackRand( step, 800 + i )) * k ));
+		else if ( kind < 0.75f )
+			Fill( bx, by, bw, bh, Alpha( C_BLACK, ( 0.35f + 0.35f * HackRand( step, 800 + i )) * k ));
+		else
+		{
+			Fill( bx, by, bw, bh, Alpha( C_CODE2, 0.35f * k ));
+			Frame( bx, by, bw, bh, Alpha( C_CODEW, 0.5f * k ));
+		}
+	}
+	FlushShapes();
+
+	// (code: rows of hex and binary in the font, flickering)
+	static const char digits[] = "0123456789ABCDEF";
+	const int lines = (int)( 4 + 8 * k );
+	const int lh = LineHeight();
+	for ( int i = 0; i < lines; i++ )
+	{
+		char row[40];
+		const int len = 8 + (int)( HackRand( step, 900 + i ) * 24 );
+		const bool binary = HackRand( step, 950 + i ) < 0.4f;
+		for ( int c = 0; c < len; c++ )
+		{
+			const unsigned r = HackHash( step * 64 + i, c );
+			row[c] = ( c % 3 == 2 && !binary ) ? ' ' : binary ? ( r & 1 ? '1' : '0' ) : digits[r & 15];
+		}
+		row[len] = 0;
+		const float x = HackRand( step, 1000 + i ) * sw * 0.8f, y = HackRand( step, 1100 + i ) * ( sh - lh );
+		Text( x, y, row, Alpha( HackRand( step, 1200 + i ) < 0.3f ? C_CODEW : C_CODE, ( 0.55f + 0.45f * HackRand( step, 1300 + i )) * k ));
+	}
+	FlushTexts();
+}
