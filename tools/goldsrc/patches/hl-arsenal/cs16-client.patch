+static bool BuildHidesViewModel( void )
+{
+	if ( !g_bBuild )
+		return false;
+	cl_entity_t *view = gEngfuncs.GetViewModel();
+	return !( view && view->model && strstr( view->model->name, "build/v_build" )); // (the server's build hands shown)
+}
+
+// the blueprint: the piece's model where it would go, see-through, blue or red (its fourth skin, the blueprint's grid,
+// when it has one; lit in that colour: ArsUI_StudioLighting)
+static void BuildCreateGhost( void )
+{
+	if ( !g_bBuild || !g_bBuildSpot )
+		return;
+	const int piece = g_BuildSpot.piece;
+	if ( !g_pBuildModels[piece] && !g_bBuildModelTried[piece] )
+	{
+		g_bBuildModelTried[piece] = true;
+		model_t *m = IEngineStudio.Mod_ForName( g_BuildModels[piece], 0 );
+		g_pBuildModels[piece] = ( m && m->type == mod_studio ) ? m : NULL;
+	}
+	model_t *m = g_pBuildModels[piece];
+	if ( !m )
+		return;
+	cl_entity_t *e = &g_BuildGhost;
+	memset( e, 0, sizeof( *e ));
+	e->model = m;
+	studiohdr_t *hdr = (studiohdr_t *)IEngineStudio.Mod_Extradata( m );
+	const int skins = hdr ? hdr->numskinfamilies : 1;
+	const bool ok = g_iBuildReason == BUILD_OK;
+	e->curstate.skin = skins >= 5 ? ( ok ? 3 : 4 ) : skins >= 4 ? 3 : 0;
+	const float pulse = 0.5f + 0.5f * sinf( Now() * 5.0f );
+	e->curstate.rendermode = skins >= 5 ? kRenderTransAdd : kRenderTransTexture;
+	e->curstate.renderamt = skins >= 5 ? (int)( 150 + 60 * pulse ) : (int)( 110 + 40 * pulse );
+	if ( g_bBuildSlotOnly )
+	{
+		// (that slot built already — the piece just placed, as a rule —: only a faint outline over it, the piece and
+		// its growth seen through, not a red ghost)
+		e->curstate.rendermode = kRenderTransAdd;
+		e->curstate.renderamt = (int)( 28 + 12 * pulse );
+	}
+	e->curstate.rendercolor.r = ok ? C_BLUEP.r : C_RED.r;
+	e->curstate.rendercolor.g = ok ? C_BLUEP.g : C_RED.g;
+	e->curstate.rendercolor.b = ok ? C_BLUEP.b : C_RED.b;
+	e->curstate.movetype = MOVETYPE_NONE;
+	e->curstate.framerate = 0;
+	VectorCopy( g_BuildSpot.origin, e->origin );
+	VectorCopy( e->origin, e->curstate.origin );
+	e->angles[1] = e->curstate.angles[1] = (float)g_BuildSpot.yaw;
+	gEngfuncs.CL_CreateVisibleEntity( ET_NORMAL, e );
+}
+
+static bool BuildGhostLighting( cl_entity_t *ent, alight_t *lighting )
+{
+	if ( ent != &g_BuildGhost )
+		return false;
+	const bool ok = g_iBuildReason == BUILD_OK;
+	lighting->ambientlight = 150;
+	lighting->shadelight = 60;
+	lighting->color[0] = ok ? 0.45f : 1.0f;
+	lighting->color[1] = ok ? 0.75f : 0.32f;
+	lighting->color[2] = ok ? 1.0f : 0.28f;
+	return true;
+}
