+//
+// Drawing
+//
+static float SC( float v ) { return v * gHUD.m_flScale; } // (HUD units to the screen's: shapes are drawn in its pixels)
+
+// The shapes of a frame go in one batch, drawn at its end in one call, then its texts over them (in their order:
+// a shape is never drawn over a text)
+#define MAX_QUADS 1024
+#define MAX_TEXTS 320
+
+struct Quad { float x[4], y[4]; Col c[4]; };
+struct QueuedText { float x, y, maxX, scale; Col c; char s[160]; };
+
+static Quad g_Quads[MAX_QUADS];
+static int g_iQuads;
+static QueuedText g_Texts[MAX_TEXTS];
+static int g_iTexts;
+
+static void Quad4( float x, float y, float w, float h, Col c00, Col c01, Col c11, Col c10 )
+{
+	if ( w <= 0 || h <= 0 || g_iQuads >= MAX_QUADS || ( !c00.a && !c01.a && !c11.a && !c10.a ))
+		return;
+	Quad &q = g_Quads[g_iQuads++];
+	q.x[0] = q.x[1] = SC( x ); q.x[2] = q.x[3] = SC( x + w );
+	q.y[0] = q.y[3] = SC( y ); q.y[1] = q.y[2] = SC( y + h );
+	q.c[0] = c00; q.c[1] = c01; q.c[2] = c11; q.c[3] = c10;
+}
+
+// a quadrilateral of any shape (HUD units), one colour
+static void QuadPts( const float *xs, const float *ys, Col c )
+{
+	if ( g_iQuads >= MAX_QUADS || !c.a )
+		return;
+	Quad &q = g_Quads[g_iQuads++];
+	for ( int k = 0; k < 4; k++ ) { q.x[k] = SC( xs[k] ); q.y[k] = SC( ys[k] ); q.c[k] = c; }
+}
+
+static void Color( Col c ) { gEngfuncs.pTriAPI->Color4f( c.r / 255.0f, c.g / 255.0f, c.b / 255.0f, c.a / 255.0f ); }
+
+static void Grad( float x, float y, float w, float h, Col top, Col bottom ) { Quad4( x, y, w, h, top, bottom, bottom, top ); }
+
+static void GradH( float x, float y, float w, float h, Col left, Col right ) { Quad4( x, y, w, h, left, left, right, right ); }
+
+static void Fill( float x, float y, float w, float h, Col c ) { Quad4( x, y, w, h, c, c, c, c ); }
+
+static void Frame( float x, float y, float w, float h, Col c, float t = 1 )
+{
+	Fill( x, y, w, t, c );
+	Fill( x, y + h - t, w, t, c );
+	Fill( x, y + t, t, h - 2 * t, c );
+	Fill( x + w - t, y + t, t, h - 2 * t, c );
+}
+
+// a filled rectangle with a hole in it (where a model turns)
+static void FillAround( float x, float y, float w, float h, float hx, float hy, float hw, float hh, Col c )
+{
+	Fill( x, y, w, hy - y, c );
+	Fill( x, hy + hh, w, y + h - hy - hh, c );
+	Fill( x, hy, hx - x, hh, c );
+	Fill( hx + hw, hy, x + w - hx - hw, hh, c );
+}
+
+// the screen shaded but for a row of cards (same top, same height, left to right)
+static void ShadeAroundRow( const float *xs, int n, float w, float y, float h, Col c )
+{
+	float sw = ScreenWidth, sh = ScreenHeight;
+	Fill( 0, 0, sw, y, c );
+	Fill( 0, y + h, sw, sh - y - h, c );
+	float x = 0;
+	for ( int i = 0; i < n; i++ )
+	{
+		Fill( x, y, xs[i] - x, h, c );
+		x = xs[i] + w;
+	}
+	Fill( x, y, sw - x, h, c );
+}
+
+// the screen shaded but for two rows of cards (each its own left edges, width, top and height)
+static void ShadeAroundRows( const float *xs1, int n1, float w1, float y1, float h1, const float *xs2, int n2, float w2, float y2, float h2, Col c )
+{
+	float sw = ScreenWidth, sh = ScreenHeight;
+	Fill( 0, 0, sw, y1, c );
+	Fill( 0, y1 + h1, sw, y2 - y1 - h1, c );
+	Fill( 0, y2 + h2, sw, sh - y2 - h2, c );
+	const float *xs[2] = { xs1, xs2 }; const int ns[2] = { n1, n2 }; const float ws[2] = { w1, w2 }, ys[2] = { y1, y2 }, hs[2] = { h1, h2 };
+	for ( int r = 0; r < 2; r++ )
+	{
+		float x = 0;
+		for ( int i = 0; i < ns[r]; i++ ) { Fill( x, ys[r], xs[r][i] - x, hs[r], c ); x = xs[r][i] + ws[r]; }
+		Fill( x, ys[r], sw - x, hs[r], c );
+	}
+}
+
+static void FlushShapes( void )
+{
+	if ( !g_iQuads )
+		return;
+	gRenderAPI.GL_SelectTexture( 0 );
+	gRenderAPI.GL_Bind( 0, gHUD.m_WhiteTex );
+	gEngfuncs.pTriAPI->RenderMode( kRenderTransAlpha );
+	gEngfuncs.pTriAPI->CullFace( TRI_NONE );
+	gEngfuncs.pTriAPI->Brightness( 1.0f );
+	gEngfuncs.pTriAPI->Begin( TRI_QUADS );
+	for ( int i = 0; i < g_iQuads; i++ )
+	{
+		const Quad &q = g_Quads[i];
+		for ( int k = 0; k < 4; k++ )
+		{
+			gEngfuncs.pTriAPI->Color4f( q.c[k].r / 255.0f, q.c[k].g / 255.0f, q.c[k].b / 255.0f, q.c[k].a / 255.0f );
+			gEngfuncs.pTriAPI->TexCoord2f( k >= 2, k == 1 || k == 2 );
+			gEngfuncs.pTriAPI->Vertex3f( q.x[k], q.y[k], 0 );
+		}
+	}
+	gEngfuncs.pTriAPI->End();
+	gEngfuncs.pTriAPI->RenderMode( kRenderNormal );
+	g_iQuads = 0;
+}
+
+static int LineHeight( float scale = 1 ) { return (int)( gHUD.GetCharHeight() * scale ); }
+
+// The HUD font is ASCII: a French letter (UTF-8) is drawn as its plain letter with its accent drawn over it — or its
+// cedilla under it: é è ê ë à â ä ç î ï ô ö ù û ü, their capitals; œ as oe, a typographic apostrophe as '. Returns
+// the accents (their places in out, their kinds). Also ä ï ö ÿ and Ä Ï Ö Ÿ (BuildDrawBar's capitals).
+enum { ACC_ACUTE, ACC_GRAVE, ACC_CIRC, ACC_DIAER, ACC_CEDIL };
+struct Accent { int at; char kind; bool upper; };
+#define MAX_ACCENTS 24
+
+// (the second byte of a letter after 0xC3: its plain letter, its accent)
+static const struct { unsigned char b; char letter, kind; } g_LatinLetters[] =
+{
+	{ 0xA0, 'a', ACC_GRAVE }, { 0xA2, 'a', ACC_CIRC }, { 0xA4, 'a', ACC_DIAER }, { 0xA7, 'c', ACC_CEDIL },
+	{ 0xA8, 'e', ACC_GRAVE }, { 0xA9, 'e', ACC_ACUTE }, { 0xAA, 'e', ACC_CIRC }, { 0xAB, 'e', ACC_DIAER },
+	{ 0xAE, 'i', ACC_CIRC }, { 0xAF, 'i', ACC_DIAER }, { 0xB4, 'o', ACC_CIRC }, { 0xB6, 'o', ACC_DIAER },
+	{ 0xB9, 'u', ACC_GRAVE }, { 0xBB, 'u', ACC_CIRC }, { 0xBC, 'u', ACC_DIAER }, { 0xBF, 'y', ACC_DIAER },
+	{ 0x80, 'A', ACC_GRAVE }, { 0x82, 'A', ACC_CIRC }, { 0x84, 'A', ACC_DIAER }, { 0x87, 'C', ACC_CEDIL },
+	{ 0x88, 'E', ACC_GRAVE }, { 0x89, 'E', ACC_ACUTE }, { 0x8A, 'E', ACC_CIRC }, { 0x8B, 'E', ACC_DIAER },
+	{ 0x8E, 'I', ACC_CIRC }, { 0x8F, 'I', ACC_DIAER }, { 0x94, 'O', ACC_CIRC }, { 0x96, 'O', ACC_DIAER },
+	{ 0x99, 'U', ACC_GRAVE }, { 0x9B, 'U', ACC_CIRC }, { 0x9C, 'U', ACC_DIAER },
+};
+#define NUM_LATIN_LETTERS (int)( sizeof( g_LatinLetters ) / sizeof( g_LatinLetters[0] ))
+
+// the length of the UTF-8 sequence at s that Latin() draws as a letter (or as ' or a space), 0 for any other
+static int LatinSeq( const unsigned char *s )
+{
+	if ( s[0] == 0xC3 )
+	{
+		for ( int k = 0; k < NUM_LATIN_LETTERS; k++ )
+			if ( g_LatinLetters[k].b == s[1] )
+				return 2;
+		return 0;
+	}
+	if ( s[0] == 0xC5 && ( s[1] == 0x92 || s[1] == 0x93 || s[1] == 0xB8 )) // (Œ œ Ÿ)
+		return 2;
+	if ( s[0] == 0xE2 && s[1] == 0x80 && ( s[2] == 0x98 || s[2] == 0x99 )) // (‘ ’)
+		return 3;
+	if ( s[0] == 0xC2 && s[1] == 0xA0 ) // (a no-break space)
+		return 2;
+	return 0;
+}
+
+static int Latin( const char *s, char *out, int size, Accent *accents, int maxAccents )
+{
+	int n = 0, a = 0;
+	while ( *s && n < size - 1 )
+	{
+		const unsigned char c = (unsigned char)s[0], c1 = c ? (unsigned char)s[1] : 0;
+		if ( c == 0xC3 )
+		{
+			int k = 0;
+			while ( k < NUM_LATIN_LETTERS && g_LatinLetters[k].b != c1 )
+				k++;
+			if ( k < NUM_LATIN_LETTERS )
+			{
+				if ( a < maxAccents )
+				{
+					accents[a].at = n;
+					accents[a].kind = g_LatinLetters[k].kind;
+					accents[a].upper = g_LatinLetters[k].letter < 'a';
+					a++;
+				}
+				out[n++] = g_LatinLetters[k].letter;
+				s += 2;
+				continue;
+			}
+		}
+		if ( c == 0xC5 && c1 == 0xB8 ) // (Ÿ)
+		{
+			if ( a < maxAccents )
+			{
+				accents[a].at = n;
+				accents[a].kind = ACC_DIAER;
+				accents[a].upper = true;
+				a++;
+			}
+			out[n++] = 'Y';
+			s += 2;
+			continue;
+		}
+		if ( c == 0xC5 && ( c1 == 0x93 || c1 == 0x92 ) && n < size - 2 ) // (œ, Œ)
+		{
+			out[n++] = c1 == 0x93 ? 'o' : 'O';
+			out[n++] = c1 == 0x93 ? 'e' : 'E';
+			s += 2;
+			continue;
+		}
+		if ( c == 0xE2 && c1 == 0x80 && ( (unsigned char)s[2] == 0x98 || (unsigned char)s[2] == 0x99 )) // (‘ ’)
+		{
+			out[n++] = '\'';
+			s += 3;
+			continue;
+		}
+		if ( c == 0xC2 && c1 == 0xA0 ) // (a no-break space)
+		{
+			out[n++] = ' ';
+			s += 2;
+			continue;
+		}
+		// (any other UTF-8 sequence passed on whole, for the engine's own decoding — or not at all when it does not fit)
+		int len = 1;
+		if ( c >= 0xC0 && c < 0xE0 ) len = 2;
+		else if ( c >= 0xE0 && c < 0xF0 ) len = 3;
+		else if ( c >= 0xF0 && c < 0xF8 ) len = 4;
+		int k = 1;
+		while ( k < len && ( (unsigned char)s[k] & 0xC0 ) == 0x80 )
+			k++;
+		if ( n + k > size - 1 )
+			break;
+		memcpy( out + n, s, k );
+		n += k;
+		s += k;
+	}
+	out[n] = 0;
+	return a;
+}
+
+static int TextWidth( const char *s, float scale = 1 )
+{
+	char buf[192]; Accent accents[1];
+	Latin( s, buf, sizeof( buf ), accents, 0 );
+	return (int)( DrawUtils::HudStringLen( buf ) * scale );
+}
+
+static bool Scaled( float scale ) { return scale != 1 && g_iMobileAPIVersion; }
+
+// an accent over (or under) the letter at x: in the text's colour, one or two quads. The font's x-height is about
+// 0.35 of its line, from 0.30 of it down, its capitals from about 0.10, its baseline at about 0.66
+static void AccentAdd( const Accent &acc, float x, float y, float lh, float cw, Col c )
+{
+	const float xh = lh * 0.35f, len = max( 2.5f, xh * 0.6f );
+	const float tw = max( 1.2f, lh * 0.075f ); // (a stroke's width, across)
+	const float cx = x + cw * 0.5f;
+	const float yb = acc.upper ? y + lh * 0.10f - 1 : y + lh * 0.30f - 2; // (the accent's bottom: a pixel clear of its letter)
+	const float l = acc.upper ? len * 0.8f : len;
+	const float dy = l * 0.86f, dx = l * 0.5f; // (a stroke rising at 60 degrees)
+	switch ( acc.kind )
+	{
+	case ACC_ACUTE:
+	case ACC_GRAVE:
+	{
+		const bool acute = acc.kind == ACC_ACUTE;
+		const float x0 = cx - dx / 2 - tw / 2, x1 = cx + dx / 2 - tw / 2; // (bottom left to top right; the grave mirrored)
+		const float xs[4] = { acute ? x0 : x1, ( acute ? x0 : x1 ) + tw, ( acute ? x1 : x0 ) + tw, acute ? x1 : x0 }, ys[4] = { yb, yb, yb - dy, yb - dy };
+		QuadPts( xs, ys, c );
+		break;
+	}
+	case ACC_CIRC:
+	{
+		const float h = dy * 0.8f, half = max( 1.5f, cw * 0.28f );
+		const float xs1[4] = { cx - half - tw / 2, cx - half + tw / 2, cx + tw / 2, cx - tw / 2 }, ys1[4] = { yb, yb, yb - h, yb - h };
+		const float xs2[4] = { cx - tw / 2, cx + tw / 2, cx + half + tw / 2, cx + half - tw / 2 }, ys2[4] = { yb - h, yb - h, yb, yb };
+		QuadPts( xs1, ys1, c );
+		QuadPts( xs2, ys2, c );
+		break;
+	}
+	case ACC_DIAER:
+	{
+		const float d = max( 1.5f, tw * 1.2f ), off = max( 1.5f, cw * 0.22f );
+		Fill( cx - off - d / 2, yb - d, d, d, c );
+		Fill( cx + off - d / 2, yb - d, d, d, c );
+		break;
+	}
+	case ACC_CEDIL:
+	{
+		const float top = y + lh * 0.66f, h = max( 2.0f, lh * 0.16f );
+		const float xs[4] = { cx - tw / 2, cx + tw / 2, cx - tw / 2 - h * 0.5f + tw, cx - tw / 2 - h * 0.5f }, ys[4] = { top, top, top + h, top + h };
+		QuadPts( xs, ys, c );
+		break;
+	}
+	}
+}
+
+static void TextClip( float x, float y, float maxX, const char *s, Col c, float scale = 1 )
+{
+	if ( g_iTexts >= MAX_TEXTS || !c.a || !s[0] )
+		return;
+	const Col accentColour = c;
+	if ( c.a < 255 )
+	{
+		float f = c.a / 255.0f;
+		c.r *= f; c.g *= f; c.b *= f; // (the font is additive)
+	}
+	QueuedText &t = g_Texts[g_iTexts++];
+	t.x = x; t.y = y; t.maxX = maxX; t.scale = Scaled( scale ) ? scale : 0.0f; t.c = c;
+	Accent accents[MAX_ACCENTS];
+	const int na = Latin( s, t.s, sizeof( t.s ), accents, MAX_ACCENTS );
+	const float k = t.scale ? t.scale : 1.0f, lh = gHUD.GetCharHeight() * k;
+	for ( int i = 0; i < na; i++ )
+	{
+		char prefix[sizeof( t.s )];
+		memcpy( prefix, t.s, accents[i].at );
+		prefix[accents[i].at] = 0;
+		const float ex = x + DrawUtils::HudStringLen( prefix ) * k, cw = gHUD.GetCharWidth( (unsigned char)t.s[accents[i].at] ) * k;
+		if ( ex + cw > maxX )
+			break;
+		AccentAdd( accents[i], ex, y, lh, cw, accentColour );
+	}
+}
+
+static void Text( float x, float y, const char *s, Col c, float scale = 1 ) { TextClip( x, y, 100000, s, c, scale ); }
+
+static void FlushTexts( void )
+{
+	for ( int i = 0; i < g_iTexts; i++ )
+	{
+		const QueuedText &t = g_Texts[i];
+		if ( !t.scale )
+		{
+			DrawUtils::DrawHudString( (int)t.x, (int)t.y, (int)t.maxX, t.s, t.c.r, t.c.g, t.c.b );
+			continue;
+		}
+		// (enlarged: a character at a time, advanced by its width at that scale — the client's own scaled strings
+		// divide the advance by the HUD's scale once more, which overlaps them on a stretched HUD)
+		float x = t.x;
+		for ( const char *c = t.s; *c; c++ )
+		{
+			gMobileAPI.pfnDrawScaledCharacter( (int)x, (int)t.y, (unsigned char)*c, t.c.r, t.c.g, t.c.b, t.scale );
+			x += gHUD.GetCharWidth( (unsigned char)*c ) * t.scale;
+		}
+	}
+	g_iTexts = 0;
+}
+
+static int TextW( const char *s, float scale ) { return Scaled( scale ) ? TextWidth( s, scale ) : TextWidth( s ); }
+
+static void TextCenter( float cx, float y, const char *s, Col c, float scale = 1 ) { Text( cx - TextW( s, scale ) / 2, y, s, c, scale ); }
+
+static void TextRight( float rx, float y, const char *s, Col c, float scale = 1 ) { Text( rx - TextW( s, scale ), y, s, c, scale ); }
+
+// the length of s cut to at most n bytes, at a letter's start (not inside a UTF-8 sequence)
+static int CutAt( const char *s, int n )
+{
+	while ( n > 0 && ( (unsigned char)s[n] & 0xC0 ) == 0x80 )
+		n--;
+	return n;
+}
+
+// the text cut at a width, with an ellipsis
+static void FitInto( const char *s, float w, char *buf, int size )
+{
+	int len = strlen( s );
+	if ( len > size - 1 )
+		len = CutAt( s, size - 1 );
+	memcpy( buf, s, len );
+	buf[len] = 0;
+	if ( TextWidth( buf ) <= w )
+		return;
+	for ( int n = strlen( buf ); n > 0; n = CutAt( buf, n - 1 ))
+	{
+		buf[n] = 0;
+		while ( n > 0 && buf[n - 1] == ' ' )
+			buf[--n] = 0;
+		if ( n + 4 > size )
+			continue;
+		strcat( buf, "..." );
+		if ( TextWidth( buf ) <= w )
+			return;
+		buf[n] = 0;
+	}
+	buf[0] = 0;
+}
+
+static void TextFit( float x, float y, const char *s, float w, Col c )
+{
+	char buf[160];
+	FitInto( s, w, buf, sizeof( buf ));
+	Text( x, y, buf, c );
+}
+
+// The text in lines of at most a width, cut at its spaces: at most maxLines (the last cut with an ellipsis if it is
+// still too long). Returns the lines' count.
+#define WRAP_LEN 160
+static int WrapLines( const char *s, float w, char lines[][WRAP_LEN], int maxLines )
+{
+	int n = 0;
+	while ( *s == ' ' )
+		s++;
+	while ( *s && n < maxLines )
+	{
+		if ( n == maxLines - 1 || TextWidth( s ) <= w )
+		{
+			FitInto( s, w, lines[n++], WRAP_LEN );
+			break;
+		}
+		// (the longest start of it, cut at a space, that fits; none: cut anywhere)
+		int best = 0;
+		for ( int i = 1; s[i] && i < WRAP_LEN - 1; i++ )
+		{
+			if ( s[i] != ' ' )
+				continue;
+			char part[WRAP_LEN];
+			memcpy( part, s, i );
+			part[i] = 0;
+			if ( TextWidth( part ) > w )
+				break;
+			best = i;
+		}
+		if ( !best )
+		{
+			FitInto( s, w, lines[n++], WRAP_LEN );
+			break;
+		}
+		memcpy( lines[n], s, best );
+		lines[n][best] = 0;
+		n++;
+		s += best;
+		while ( *s == ' ' )
+			s++;
+	}
+	return n;
+}
+
+// a text wrapped to a width, from its top left (align 0), right edge (1) or centre (2); returns the lines drawn
+static int TextWrap( float x, float y, const char *s, float w, Col c, int maxLines, float lineH, int align = 0 )
+{
+	char lines[4][WRAP_LEN];
+	const int n = WrapLines( s, w, lines, min( maxLines, 4 ));
+	for ( int i = 0; i < n; i++ )
+	{
+		if ( align == 1 )
+			TextRight( x, y + i * lineH, lines[i], c );
+		else if ( align == 2 )
+			TextCenter( x, y + i * lineH, lines[i], c );
+		else
+			Text( x, y + i * lineH, lines[i], c );
+	}
+	return n;
+}
+
+static bool Hover( float x, float y, float w, float h ) { return g_cx >= x && g_cx < x + w && g_cy >= y && g_cy < y + h; }
+
+static bool Clicked( float x, float y, float w, float h ) { return g_bClick && Hover( x, y, w, h ); }
+
+// a key's badge: [1]
+static void KeyBadge( float x, float y, const char *key, bool lit )
+{
+	int h = LineHeight();
+	int w = TextWidth( key ) + 10;
+	Fill( x, y - 2, w, h + 4, lit ? Alpha( C_GOLD, 0.6f ) : C_SOFT );
+	Text( x + 5, y, key, lit ? C_WHITE : C_DIM ); // (the font is additive: light on the gold)
+}
+
+// a button with a key; returns whether it was clicked
+static bool Button( float x, float y, float w, float h, const char *key, const char *label, bool enabled, Col accent )
+{
+	bool hover = enabled && Hover( x, y, w, h );
+	Fill( x, y, w, h, hover ? C_HOVER : C_PANEL2 );
+	Frame( x, y, w, h, hover ? accent : C_SOFT );
+	int lh = LineHeight();
+	float tx = x + 12;
+	if ( key )
+	{
+		KeyBadge( tx, y + ( h - lh ) / 2, key, hover );
+		tx += TextWidth( key ) + 20;
+	}
+	Text( tx, y + ( h - lh ) / 2, label, enabled ? ( hover ? C_GOLDT : C_TEXT ) : C_FAINT );
+	return enabled && Clicked( x, y, w, h );
+}
+
+//
+// The models
+//
+#define MAX_PREVIEWS 10
+#define PREVIEW_DIST 9.0f
+#define BACKDROP_DIST 14.5f
+
+struct Preview
+{
+	char name[64];
+	model_t *model;
+	int sequence, pose;
+	float x, y, w, h, t0, yaw, zoom;
+	float scale; // (of the last frame, for the light)
+	bool active, failed;
+	bool laid; float layAngle; // (the screen-plane turn that lays a weapon flat: LayAngle, from its first frame's bones)
+	bool fitted; float fitCenter[3], fitHx, fitHz, fitSweep;
+	int measured; float corr; // (the scale corrected once from what its first laid frame drew: PreviewBones)
+	float frameW, frameH, mid[3];
+	float pose0[3][3], m[3][4];
+	cl_entity_t ent;
+};
+
+// the world models that do not lie as the others: `over` turned over along their length (upside down), `roll` degrees
+// in the screen's plane, `yaw` degrees around the vertical (their face toward the view)
+struct Turn { const char *model; bool over; float roll, yaw; };
+static const Turn g_Turns[] = { { "", false, 0, 0 } }; // (none: LayAngle lays them all)
+static const char *const g_Flips[] = { "models/w_9mmhandgun.mdl" };
+
+struct Backdrop
+{
+	float x, y, w, h;
+	Col c;
+};
+
+static Preview g_Previews[MAX_PREVIEWS];
+static bool g_bPreviewUsed[MAX_PREVIEWS];
+static Backdrop g_Backdrops[8], g_BackdropsNext[8];
+static int g_iBackdrops, g_iBackdropsNext;
+static vec3_t g_vViewOrg, g_vForward, g_vRight, g_vUp;
+static bool g_bView;
+
+// a model turning in a rectangle of the screen, this frame (slots keep their animation while their model stays)
+static void PreviewAdd( int slot, const char *model, float x, float y, float w, float h, int pose, float yaw, float zoom = 1 )
+{
+	if ( slot < 0 || slot >= MAX_PREVIEWS || !model || !model[0] )
+		return;
+	Preview &p = g_Previews[slot];
+	if ( strcmp( p.name, model ))
+	{
+		strncpy( p.name, model, sizeof( p.name ) - 1 );
+		p.name[sizeof( p.name ) - 1] = 0;
+		p.model = NULL;
+		p.failed = false;
+		p.laid = false; p.layAngle = 0;
+		p.fitted = false;
+		p.measured = 0; p.corr = 1;
+		p.t0 = Now();
+	}
+	p.x = x; p.y = y; p.w = w; p.h = h; p.pose = pose; p.yaw = yaw; p.zoom = zoom;
+	g_bPreviewUsed[slot] = true;
+}
+
+static void BackdropAdd( float x, float y, float w, float h, Col c )
+{
+	if ( g_iBackdropsNext >= (int)( sizeof( g_BackdropsNext ) / sizeof( g_BackdropsNext[0] )))
+		return;
+	Backdrop &b = g_BackdropsNext[g_iBackdropsNext++];
+	b.x = x; b.y = y; b.w = w; b.h = h; b.c = c;
+}
+
+static int PickSequence( studiohdr_t *hdr, int pose )
+{
+	if ( pose != POSE_UPRIGHT )
+		return 0;
+	mstudioseqdesc_t *seq = (mstudioseqdesc_t *)( (byte *)hdr + hdr->seqindex );
+	// (the model's own standing idle: by its activity, then by name — one without blends, which pose the limbs apart)
+	for ( int i = 0; i < hdr->numseq; i++ )
+		if ( seq[i].activity == 1 /* ACT_IDLE */ && seq[i].numblends <= 1 )
+			return i;
+	for ( int i = 0; i < hdr->numseq; i++ )
+		if ( !strcmp( seq[i].label, "idle1" ))
+			return i;
+	for ( int i = 0; i < hdr->numseq; i++ )
+		if ( strstr( seq[i].label, "idle" ))
+			return i;
+	return 0;
+}
+
+void ArsUI_SetView( const float *origin, const float *angles )
+{
+	VectorCopy( origin, g_vViewOrg );
+	AngleVectors( angles, g_vForward, g_vRight, g_vUp );
+	g_bView = true;
+}
+
+// the tangents of the half field of view, from where the renderer projects two points
+static void Projection( float &tx, float &ty )
+{
+	vec3_t p;
+	float screen[3];
+	tx = ty = 1;
+	VectorMA( g_vViewOrg, 100, g_vForward, p ); VectorMA( p, 100, g_vRight, p );
+	if ( !gEngfuncs.pTriAPI->WorldToScreen( p, screen ) && fabs( screen[0] ) > 0.001f )
+		tx = 1.0f / fabs( screen[0] );
+	VectorMA( g_vViewOrg, 100, g_vForward, p ); VectorMA( p, 100, g_vUp, p );
+	if ( !gEngfuncs.pTriAPI->WorldToScreen( p, screen ) && fabs( screen[1] ) > 0.001f )
+		ty = 1.0f / fabs( screen[1] );
+}
+
+// where a point of the screen (HUD units) is, at a distance in front of the view
+static void ScreenPoint( float sx, float sy, float dist, float tx, float ty, float *out )
+{
+	float nx = sx / ScreenWidth * 2 - 1, ny = 1 - sy / ScreenHeight * 2;
+	for ( int i = 0; i < 3; i++ )
+		out[i] = g_vViewOrg[i] + dist * ( g_vForward[i] + g_vRight[i] * nx * tx + g_vUp[i] * ny * ty );
+}
+
+void ArsUI_CreateEntities( void )
+{
+	if ( !g_bView )
+		return;
+	BuildThink();
+	BuildCreateGhost();
+	for ( int i = 0; i < MAX_PREVIEWS; i++ )
+	{
+		Preview &p = g_Previews[i];
+		if ( !p.active || p.failed || g_iPanel == P_NONE )
+			continue;
+		if ( !p.model )
+		{
+			p.model = IEngineStudio.Mod_ForName( p.name, 0 );
+			if (( !p.model || p.model->type != mod_studio ) && !strncmp( p.name, "models/others/", 14 ))
+			{
+				// (Half Strike's others: in the Pokemon's folder, if that is where they were put)
+				char alt[64];
+				snprintf( alt, sizeof( alt ), "models/pokemon/%s", p.name + 14 );
+				p.model = IEngineStudio.Mod_ForName( alt, 0 );
+			}
+			if ( !p.model || p.model->type != mod_studio )
+			{
+				p.model = NULL;
+				p.failed = true; // (tried once, while its name stays)
+				continue;
+			}
+			p.sequence = PickSequence( (studiohdr_t *)IEngineStudio.Mod_Extradata( p.model ), p.pose );
+		}
+		cl_entity_t *e = &p.ent;
+		memset( e, 0, sizeof( *e ));
+		e->model = p.model;
+		e->curstate.sequence = p.sequence;
+		e->curstate.framerate = 1;
+		e->curstate.animtime = p.t0;
+		e->curstate.rendermode = kRenderNormal;
+		e->curstate.renderamt = 255;
+		e->curstate.movetype = MOVETYPE_NONE;
+		// (a player model: its bone controllers and blends at their middle, the neutral pose — a weapon's are left at 0,
+		// where its maker posed it)
+		if ( p.pose == POSE_UPRIGHT )
+		{
+			for ( int k = 0; k < 4; k++ ) e->curstate.controller[k] = e->latched.prevcontroller[k] = 127;
+			e->curstate.blending[0] = e->curstate.blending[1] = e->latched.prevblending[0] = e->latched.prevblending[1] = 127;
+		}
+		e->latched.prevsequence = p.sequence;
+		float tx, ty;
+		Projection( tx, ty );
+		ScreenPoint( p.x + p.w / 2, p.y + p.h / 2, PREVIEW_DIST, tx, ty, e->origin );
+		VectorCopy( e->origin, e->curstate.origin );
+		gEngfuncs.CL_CreateVisibleEntity( ET_NORMAL, e );
+	}
+}
+
+bool ArsUI_IsPreview( cl_entity_t *ent )
+{
+	return ent >= &g_Previews[0].ent && ent <= &g_Previews[MAX_PREVIEWS - 1].ent;
+}
+
+static Preview *PreviewOf( cl_entity_t *ent )
+{
+	for ( int i = 0; i < MAX_PREVIEWS; i++ )
+		if ( ent == &g_Previews[i].ent )
+			return &g_Previews[i];
+	return NULL;
+}
+
+// The angle, in the screen's plane, that lays a model's length horizontal with its widest overhang down: its vertices,
+// placed by its bones as its sequence poses them (model space), seen in the display frame `pose` gives (x right, z up).
+struct Lay { float angle, center[3], hx, hz, sweep; bool fitted; };
+static Lay LayAngle( studiohdr_t *hdr, const float pose[3][3], float bone[][3][4] )
+{
+	Lay out = { 0, { 0, 0, 0 }, 0, 0, 0, false };
+	vec3_t lo = { 1e9f, 1e9f, 1e9f }, hi = { -1e9f, -1e9f, -1e9f };
+	// (the first body part's first model: the weapon itself)
+	double sx = 0, sz = 0, sxx = 0, szz = 0, sxz = 0; int n = 0;
+	static float px[4096], pz[4096], py[4096];
+	mstudiobodyparts_t *parts = (mstudiobodyparts_t *)( (byte *)hdr + hdr->bodypartindex );
+	for ( int bp = 0; bp < hdr->numbodyparts && n < 4096; bp++ )
+	{
+		if ( parts[bp].nummodels <= 0 )
+			continue;
+		mstudiomodel_t *model = (mstudiomodel_t *)( (byte *)hdr + parts[bp].modelindex );
+		const vec3_t *verts = (const vec3_t *)( (byte *)hdr + model->vertindex );
+		const byte *vbone = (const byte *)hdr + model->vertinfoindex;
+		for ( int v = 0; v < model->numverts && n < 4096; v++ )
+		{
+			const int b = vbone[v] < hdr->numbones ? vbone[v] : 0;
+			vec3_t w;
+			VectorTransform( verts[v], bone[b], w );
+			for ( int k = 0; k < 3; k++ ) { lo[k] = min( lo[k], w[k] ); hi[k] = max( hi[k], w[k] ); }
+			const float x = pose[0][0] * w[0] + pose[0][1] * w[1] + pose[0][2] * w[2];
+			const float z = pose[2][0] * w[0] + pose[2][1] * w[1] + pose[2][2] * w[2];
+			py[n] = pose[1][0] * w[0] + pose[1][1] * w[1] + pose[1][2] * w[2];
+			px[n] = x; pz[n] = z; n++;
+			sx += x; sz += z; sxx += x * x; szz += z * z; sxz += x * z;
+		}
+	}
+	if ( n < 8 )
+		return out;
+	for ( int k = 0; k < 3; k++ ) out.center[k] = ( lo[k] + hi[k] ) / 2;
+	const double mx = sx / n, mz = sz / n, cxx = sxx / n - mx * mx, czz = szz / n - mz * mz, cxz = sxz / n - mx * mz;
+	// (the principal axis; a nearly round item is left as it lies)
+	const double theta = 0.5 * atan2( 2 * cxz, cxx - czz );
+	const double l1 = ( cxx + czz ) / 2 + sqrt(( cxx - czz ) * ( cxx - czz ) / 4 + cxz * cxz ), l2 = cxx + czz - l1;
+	float angle = 0;
+	if ( l1 >= l2 * 1.8 )
+	{
+	// turned by -theta: the axis horizontal; then the farthest overhang (perpendicular) must point down
+	angle = (float)-theta;
+	const float c = cosf( angle ), s = sinf( angle );
+	float up = 0, down = 0;
+	for ( int i = 0; i < n; i++ )
+	{
+		const float z = s * ( px[i] - mx ) + c * ( pz[i] - mz );
+		up = max( up, z ); down = max( down, -z );
+	}
+	if ( up > down )
+		angle += M_PI;
+	}
+	// (the model's own extent once laid: the frame fitted to it, not to its file's box)
+	const float c = cosf( angle ), s = sinf( angle );
+	float x0 = 1e9f, x1 = -1e9f, z0 = 1e9f, z1 = -1e9f;
+	for ( int i = 0; i < n; i++ )
+	{
+		const float x = c * px[i] - s * pz[i], z = s * px[i] + c * pz[i];
+		x0 = min( x0, x ); x1 = max( x1, x ); z0 = min( z0, z ); z1 = max( z1, z );
+	}
+	out.angle = angle; out.hx = ( x1 - x0 ) / 2; out.hz = ( z1 - z0 ) / 2; out.fitted = true;
+	// (how far it reaches from its middle in the plane it turns in — across and in depth: the swing it needs)
+	const float cxm = ( x0 + x1 ) / 2;
+	float y0 = 1e9f, y1 = -1e9f;
+	for ( int i = 0; i < n; i++ ) { y0 = min( y0, py[i] ); y1 = max( y1, py[i] ); }
+	const float cym = ( y0 + y1 ) / 2;
+	for ( int i = 0; i < n; i++ )
+	{
+		const float x = c * px[i] - s * pz[i] - cxm, y = py[i] - cym;
+		out.sweep = max( out.sweep, sqrtf( x * x + y * y ));
+	}
+	// (its middle in model space: the laid frame's middle taken back through the laid axes)
+	const float czm = ( z0 + z1 ) / 2;
+	for ( int k = 0; k < 3; k++ )
+	{
+		const float r0 = c * pose[0][k] - s * pose[2][k], r2 = s * pose[0][k] + c * pose[2][k];
+		out.center[k] = r0 * cxm + pose[1][k] * cym + r2 * czm;
+	}
+	return out;
+}
+
+// the model's frame: its bounding box centered in the rectangle, fitted to it as it turns, the side of a weapon
+// facing the view (world models lie on that side); a player faces it, the top tilted a little toward it
+bool ArsUI_PreviewTransform( cl_entity_t *ent, float m[3][4] )
+{
+	Preview *p = PreviewOf( ent );
+	if ( !p || !g_bView )
+		return false;
+	studiohdr_t *hdr = (studiohdr_t *)IEngineStudio.Mod_Extradata( p->model );
+	vec3_t mins, maxs;
+	mstudioseqdesc_t *seq = (mstudioseqdesc_t *)( (byte *)hdr + hdr->seqindex ) + p->sequence;
+	VectorCopy( seq->bbmin, mins ); VectorCopy( seq->bbmax, maxs );
+	if ( maxs[0] - mins[0] < 0.5f || maxs[2] - mins[2] < 0.5f )
+	{
+		VectorCopy( hdr->bbmin, mins ); VectorCopy( hdr->bbmax, maxs );
+	}
+	if ( maxs[0] - mins[0] < 0.5f || maxs[2] - mins[2] < 0.5f )
+	{
+		VectorCopy( hdr->min, mins ); VectorCopy( hdr->max, maxs );
+	}
+	if ( maxs[0] - mins[0] < 0.5f )
+	{
+		mins[0] = mins[1] = mins[2] = -12;
+		maxs[0] = maxs[1] = maxs[2] = 12;
+	}
+
+	// local axes in the display frame (x: the screen's right, y: away from the view, z: its up)
+	float pose[3][3] = { { 1, 0, 0 }, { 0, 1, 0 }, { 0, 0, 1 } };
+	if ( p->pose == POSE_FLAT )
+	{
+		// (lying weapons: their up toward the view, their left up)
+		pose[0][0] = 1; pose[1][0] = 0; pose[2][0] = 0;
+		pose[0][1] = 0; pose[1][1] = 0; pose[2][1] = 1;
+		pose[0][2] = 0; pose[1][2] = -1; pose[2][2] = 0;
+	}
+	// (models that lie otherwise than the others: turned over along their length, or in the screen's plane, or a
+	// quarter turn to show their face — g_Turns)
+	for ( const Turn &t : g_Turns )
+	{
+		if ( strcmp( t.model, p->name ))
+			continue;
+		const float r = t.roll * M_PI / 180, f = t.over ? M_PI : 0, w = t.yaw * M_PI / 180;
+		// E = Rz(yaw) * Ry(roll) * Rx(over), in the display's axes (x right, y away, z up)
+		const float rx[3][3] = { { 1, 0, 0 }, { 0, cosf( f ), -sinf( f ) }, { 0, sinf( f ), cosf( f ) } };
+		const float ry[3][3] = { { cosf( r ), 0, sinf( r ) }, { 0, 1, 0 }, { -sinf( r ), 0, cosf( r ) } };
+		const float rz[3][3] = { { cosf( w ), -sinf( w ), 0 }, { sinf( w ), cosf( w ), 0 }, { 0, 0, 1 } };
+		float e1[3][3], e[3][3], q[3][3];
+		for ( int i = 0; i < 3; i++ ) for ( int j = 0; j < 3; j++ ) e1[i][j] = ry[i][0] * rx[0][j] + ry[i][1] * rx[1][j] + ry[i][2] * rx[2][j];
+		for ( int i = 0; i < 3; i++ ) for ( int j = 0; j < 3; j++ ) e[i][j] = rz[i][0] * e1[0][j] + rz[i][1] * e1[1][j] + rz[i][2] * e1[2][j];
+		for ( int i = 0; i < 3; i++ ) for ( int j = 0; j < 3; j++ ) q[i][j] = e[i][0] * pose[0][j] + e[i][1] * pose[1][j] + e[i][2] * pose[2][j];
+		memcpy( pose, q, sizeof( q ));
+	}
+	vec3_t center, half;
+	for ( int i = 0; i < 3; i++ )
+	{
+		center[i] = ( mins[i] + maxs[i] ) / 2;
+		half[i] = ( maxs[i] - mins[i] ) / 2;
+	}
+	float ex = 0, ey = 0, ez = 0;
+	for ( int j = 0; j < 3; j++ )
+	{
+		ex += fabs( pose[0][j] ) * half[j];
+		ey += fabs( pose[1][j] ) * half[j];
+		ez += fabs( pose[2][j] ) * half[j];
+	}
+	// (a lying weapon laid along the screen: the model's length — its vertices' principal axis in the shown plane —
+	// horizontal, the side reaching furthest from it (grip, magazine, stock) down; the game's files have them at any
+	// angle. Computed once per model.)
+	if ( p->pose == POSE_FLAT )
+	{
+		memcpy( p->pose0, pose, sizeof( p->pose0 )); // (for PreviewBones: the frame before laying)
+		if ( p->laid && p->layAngle )
+		{
+			const float c = cosf( p->layAngle ), sn = sinf( p->layAngle );
+			for ( int j = 0; j < 3; j++ )
+			{
+				const float x = pose[0][j], z = pose[2][j];
+				pose[0][j] = c * x - sn * z; pose[2][j] = sn * x + c * z;
+			}
+			ex = ey = ez = 0;
+			for ( int j = 0; j < 3; j++ )
+			{
+				ex += fabs( pose[0][j] ) * half[j];
+				ey += fabs( pose[1][j] ) * half[j];
+				ez += fabs( pose[2][j] ) * half[j];
+			}
+		}
+		// (fitted to its vertices: their middle at the frame's, their extent filling it)
+		if ( p->laid && p->fitted )
+		{
+			VectorCopy( p->fitCenter, center );
+			ex = p->fitHx; ez = p->fitHz; ey = min( ey, max( ex, ez ));
+		}
+	}
+	// (small items shown at a sensible size, not blown up to the frame)
+	ez = max( ez, 4.5f );
+	float radius = max( (float)sqrt( ex * ex + ey * ey ), 7.0f );
+	if ( p->laid && p->fitted )
+		radius = max( max( p->fitSweep, p->fitHx ), 7.0f ); // (its real swing: never near the view nor past the backdrop)
+	float tx, ty;
+	Projection( tx, ty );
+	float worldW = p->w / ScreenWidth * 2 * tx * PREVIEW_DIST, worldH = p->h / ScreenHeight * 2 * ty * PREVIEW_DIST;
+	float intro = Clamp01(( Now() - p->t0 ) / 0.25f );
+	intro = 1 - ( 1 - intro ) * ( 1 - intro );
+	float s = min( worldW * 0.94f / ( 2 * radius ), worldH * 0.9f / ( 2 * ez )) * p->zoom * ( 0.86f + 0.14f * intro );
+	// (never deeper than the backdrop: the model stays between it and the view)
+	s = min( s, ( BACKDROP_DIST - PREVIEW_DIST - 0.5f ) / radius );
+	s *= p->corr;
+	p->scale = s;
+
+	// (a slow sway around the side that faces the view: a close model turned edge-on would leave the frame)
+	float yaw = p->yaw + sin(( Now() - p->t0 ) * 0.8f ) * ( p->pose == POSE_UPRIGHT ? 0.55f : 0.42f ) + g_flDragYaw;
+	if ( p->pose == POSE_UPRIGHT )
+		yaw -= M_PI / 2; // (the front toward the view)
+	float cy = cos( yaw ), sy = sin( yaw );
+	float tilt = ( p->pose == POSE_UPRIGHT ? 5.0f : 9.0f ) * M_PI / 180, ct = cos( tilt ), st = sin( tilt );
+	// display = Tilt * Spin * pose
+	float spin[3][3] = { { cy, -sy, 0 }, { sy, cy, 0 }, { 0, 0, 1 } };
+	float tiltm[3][3] = { { 1, 0, 0 }, { 0, ct, -st }, { 0, st, ct } };
+	float a[3][3], d[3][3];
+	for ( int i = 0; i < 3; i++ )
+		for ( int j = 0; j < 3; j++ )
+			a[i][j] = spin[i][0] * pose[0][j] + spin[i][1] * pose[1][j] + spin[i][2] * pose[2][j];
+	for ( int i = 0; i < 3; i++ )
+		for ( int j = 0; j < 3; j++ )
+			d[i][j] = tiltm[i][0] * a[0][j] + tiltm[i][1] * a[1][j] + tiltm[i][2] * a[2][j];
+	// world = [right forward up] * display * scale
+	vec3_t mid;
+	ScreenPoint( p->x + p->w / 2, p->y + p->h / 2, PREVIEW_DIST, tx, ty, mid );
+	for ( int i = 0; i < 3; i++ )
+	{
+		for ( int j = 0; j < 3; j++ )
+			m[i][j] = ( g_vRight[i] * d[0][j] + g_vForward[i] * d[1][j] + g_vUp[i] * d[2][j] ) * s;
+		m[i][3] = mid[i] - ( m[i][0] * center[0] + m[i][1] * center[1] + m[i][2] * center[2] );
+	}
+	VectorCopy( mid, ent->origin );
+	memcpy( p->m, m, sizeof( p->m ));
+	p->frameW = worldW; p->frameH = worldH; VectorCopy( mid, p->mid );
+	return true;
+}
+
+// Whether points (across, in depth, up from the frame's middle), scaled by f and swaying around the up axis,
+// stay within the frame
+static bool PreviewFits( const vec3_t *pts, int n, float f, float X0, float D, float Z0, float frameW, float frameH )
+{
+	for ( int k = 0; k <= 12; k++ )
+	{
+		const float c = cosf( k / 12.0f - 0.5f ), sn = sinf( k / 12.0f - 0.5f ); // (the sway: 0.42 either way)
+		for ( int i = 0; i < n; i++ )
+		{
+			const float x = f * ( pts[i][0] * c - pts[i][1] * sn ), y = f * ( pts[i][0] * sn + pts[i][1] * c ), z = f * pts[i][2];
+			const float den = D + y;
+			if ( den < 0.5f )
+				return false;
+			if ( fabsf( D * ( X0 + x ) / den - X0 ) > 0.46f * frameW || fabsf( D * ( Z0 + z ) / den - Z0 ) > 0.42f * frameH )
+				return false;
+		}
+	}
+	return true;
+}
+
+// The preview's bones of this frame (world space, from m): the first frame of a lying weapon lays it — its bones back
+// in model space, then LayAngle — and is not drawn. False: skip drawing.
+bool ArsUI_PreviewBones( cl_entity_t *ent, float bones[][3][4], int count )
+{
+	Preview *p = PreviewOf( ent );
+	if ( !p || p->pose != POSE_FLAT )
+		return true;
+	if ( p->laid )
+	{
+		// (its first laid frame: the vertices where its bones put them, measured across, up and in depth against the
+		// frame and the room before the backdrop; the scale corrected once, and that frame not drawn)
+		if ( p->measured++ )
+			return true;
+		studiohdr_t *hdr = (studiohdr_t *)IEngineStudio.Mod_Extradata( p->model );
+		static vec3_t pts[8192];
+		int n = 0;
+		float ay = 0;
+		mstudiobodyparts_t *parts = (mstudiobodyparts_t *)( (byte *)hdr + hdr->bodypartindex );
+		for ( int bp = 0; bp < hdr->numbodyparts; bp++ )
+		{
+			if ( parts[bp].nummodels <= 0 ) continue;
+			mstudiomodel_t *model = (mstudiomodel_t *)( (byte *)hdr + parts[bp].modelindex );
+			const vec3_t *verts = (const vec3_t *)( (byte *)hdr + model->vertindex );
+			const byte *vbone = (const byte *)hdr + model->vertinfoindex;
+			for ( int v = 0; v < model->numverts; v++ )
+			{
+				const int b = vbone[v] < count ? vbone[v] : 0;
+				vec3_t w; VectorTransform( verts[v], bones[b], w );
+				vec3_t d = { w[0] - p->mid[0], w[1] - p->mid[1], w[2] - p->mid[2] };
+				ay = max( ay, sqrtf( DotProduct( d, d )));
+				if ( n < 8192 )
+				{
+					pts[n][0] = DotProduct( d, g_vRight ); pts[n][1] = DotProduct( d, g_vForward ); pts[n][2] = DotProduct( d, g_vUp );
+					n++;
+				}
+			}
+		}
+		float f = 1;
+		if ( ay > 0.001f ) f = min( f, ( BACKDROP_DIST - PREVIEW_DIST - 0.5f ) / ay ); // (turning, it reaches that far in depth)
+		// (swaying, in the perspective of a frame off the screen's middle: its nearer end grows away from it)
+		vec3_t o; VectorSubtract( p->mid, g_vViewOrg, o );
+		const float X0 = DotProduct( o, g_vRight ), D = DotProduct( o, g_vForward ), Z0 = DotProduct( o, g_vUp );
+		float lo = 0, hi = f;
+		while ( hi - lo > 0.005f && !PreviewFits( pts, n, hi, X0, D, Z0, p->frameW, p->frameH ))
+		{
+			const float m = ( lo + hi ) / 2;
+			if ( PreviewFits( pts, n, m, X0, D, Z0, p->frameW, p->frameH ))
+				lo = m;
+			else
+				hi = m;
+		}
+		p->corr = PreviewFits( pts, n, hi, X0, D, Z0, p->frameW, p->frameH ) ? hi : lo;
+		// (measured during the intro's zoom, which then ends: the correction of the final size)
+		float intro = Clamp01(( Now() - p->t0 ) / 0.25f );
+		intro = 1 - ( 1 - intro ) * ( 1 - intro );
+		p->corr *= 0.86f + 0.14f * intro;
+		return false;
+	}
+	p->laid = true;
+	if ( count <= 0 || count > 128 )
+		return false;
+	// (m = R*s | t, R orthonormal: its inverse is R^T/s | -R^T t / s)
+	float s2 = p->m[0][0] * p->m[0][0] + p->m[1][0] * p->m[1][0] + p->m[2][0] * p->m[2][0];
+	if ( s2 < 1e-12f )
+		return false;
+	float inv[3][4];
+	for ( int i = 0; i < 3; i++ )
+	{
+		for ( int j = 0; j < 3; j++ ) inv[i][j] = p->m[j][i] / s2;
+		inv[i][3] = -( inv[i][0] * p->m[0][3] + inv[i][1] * p->m[1][3] + inv[i][2] * p->m[2][3] );
+	}
+	static float local[128][3][4];
+	for ( int b = 0; b < count; b++ )
+		ConcatTransforms( inv, bones[b], local[b] );
+	const Lay lay = LayAngle( (studiohdr_t *)IEngineStudio.Mod_Extradata( p->model ), p->pose0, local );
+	p->layAngle = lay.angle;
+	// (a few models whose overhang misleads: the other way up)
+	for ( const char *flip : g_Flips )
+		if ( !strcmp( flip, p->name ))
+			p->layAngle += M_PI;
+	p->fitted = lay.fitted; VectorCopy( lay.center, p->fitCenter ); p->fitHx = lay.hx; p->fitHz = lay.hz; p->fitSweep = lay.sweep;
+
+	return false;
+}
+
+// a light of its own: from above the view, on its left
+void ArsUI_PreviewLighting( cl_entity_t *ent, alight_t *lighting )
+{
+	Preview *p = PreviewOf( ent );
+	if ( !p )
+		return;
+	lighting->ambientlight = 78;
+	lighting->shadelight = 168;
+	lighting->color[0] = lighting->color[1] = lighting->color[2] = 1.0f;
+	vec3_t dir;
+	for ( int i = 0; i < 3; i++ )
+		dir[i] = g_vForward[i] * 0.55f - g_vUp[i] * 0.7f + g_vRight[i] * 0.45f;
+	VectorNormalize( dir );
+	// (the bones are scaled: the light turned in their frame would be too)
+	float k = p->scale > 0.0001f ? 1.0f / p->scale : 1.0f;
+	VectorScale( dir, k, lighting->plightvec );
+}
