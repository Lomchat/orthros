+	if ( value > 0 )
+		GradH( x, y, w * value, h, Alpha( c, 0.65f ), c );
+}
+
+static void StatRow( float x, float y, float w, const char *label, float value, const char *text, Col c )
+{
+	int lh = LineHeight();
+	Text( x, y, label, C_DIM );
+	// (the bar shortened for a long figure: never under it)
+	float bx = x + max( w * 0.34f, TextWidth( label ) + 12.0f ), bw = min( w * 0.42f, x + w - TextWidth( text ) - 12 - bx );
+	if ( bw > 12 )
+		Bar( bx, y + lh / 2 - 3, bw, 6, value, c );
+	TextRight( x + w, y, text, C_TEXT );
+}
