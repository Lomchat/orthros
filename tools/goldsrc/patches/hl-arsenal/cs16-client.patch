+
+// the tangents of the half field of view, from where the renderer projects two points
+static void Projection( float &tx, float &ty )
+{
+	vec3_t p;
+	float screen[3];
+	tx = ty = 1;
+	VectorMA( g_vViewOrg, 100, g_vForward, p ); VectorMA( p, 100, g_vRight, p );
+	if ( !gEngfuncs.pTriAPI->WorldToScreen( p, screen ) && fabs( screen[0] ) > 0.001f )
+		tx = 1.0f / fabs( screen[0] );
+	VectorMA( g_vViewOrg, 100, g_vForward, p ); VectorMA( p, 100, g_vUp, p );
+	if ( !gEngfuncs.pTriAPI->WorldToScreen( p, screen ) && fabs( screen[1] ) > 0.001f )
+		ty = 1.0f / fabs( screen[1] );
+}
+
+// where a point of the screen (HUD units) is, at a distance in front of the view
+static void ScreenPoint( float sx, float sy, float dist, float tx, float ty, float *out )
+{
+	float nx = sx / ScreenWidth * 2 - 1, ny = 1 - sy / ScreenHeight * 2;
+	for ( int i = 0; i < 3; i++ )
+		out[i] = g_vViewOrg[i] + dist * ( g_vForward[i] + g_vRight[i] * nx * tx + g_vUp[i] * ny * ty );
+}
+
+void ArsUI_CreateEntities( void )
+{
+	if ( !g_bView )
+		return;
+	for ( int i = 0; i < MAX_PREVIEWS; i++ )
+	{
+		Preview &p = g_Previews[i];
+		if ( !p.active || p.failed || g_iPanel == P_NONE )
+			continue;
+		if ( !p.model )
+		{
+			p.model = IEngineStudio.Mod_ForName( p.name, 0 );
+			if (( !p.model || p.model->type != mod_studio ) && !strncmp( p.name, "models/others/", 14 ))
+			{
+				// (Half Strike's others: in the Pokemon's folder, if that is where they were put)
+				char alt[64];
+				snprintf( alt, sizeof( alt ), "models/pokemon/%s", p.name + 14 );
+				p.model = IEngineStudio.Mod_ForName( alt, 0 );
+			}
+			if ( !p.model || p.model->type != mod_studio )
+			{
+				p.model = NULL;
+				p.failed = true; // (tried once, while its name stays)
+				continue;
+			}
+			p.sequence = PickSequence( (studiohdr_t *)IEngineStudio.Mod_Extradata( p.model ), p.pose );
+		}
+		cl_entity_t *e = &p.ent;
+		memset( e, 0, sizeof( *e ));
+		e->model = p.model;
+		e->curstate.sequence = p.sequence;
+		e->curstate.framerate = 1;
+		e->curstate.animtime = p.t0;
+		e->curstate.rendermode = kRenderNormal;
+		e->curstate.renderamt = 255;
+		e->curstate.movetype = MOVETYPE_NONE;
+		// (a player model: its bone controllers and blends at their middle, the neutral pose — a weapon's are left at 0,
+		// where its maker posed it)
+		if ( p.pose == POSE_UPRIGHT )
+		{
+			for ( int k = 0; k < 4; k++ ) e->curstate.controller[k] = e->latched.prevcontroller[k] = 127;
+			e->curstate.blending[0] = e->curstate.blending[1] = e->latched.prevblending[0] = e->latched.prevblending[1] = 127;
+		}
+		e->latched.prevsequence = p.sequence;
+		float tx, ty;
+		Projection( tx, ty );
+		ScreenPoint( p.x + p.w / 2, p.y + p.h / 2, PREVIEW_DIST, tx, ty, e->origin );
+		VectorCopy( e->origin, e->curstate.origin );
+		gEngfuncs.CL_CreateVisibleEntity( ET_NORMAL, e );
+	}
+}
+
+bool ArsUI_IsPreview( cl_entity_t *ent )
+{
+	return ent >= &g_Previews[0].ent && ent <= &g_Previews[MAX_PREVIEWS - 1].ent;
+}
+
+static Preview *PreviewOf( cl_entity_t *ent )
+{
+	for ( int i = 0; i < MAX_PREVIEWS; i++ )
+		if ( ent == &g_Previews[i].ent )
+			return &g_Previews[i];
+	return NULL;
+}
+
+// The angle, in the screen's plane, that lays a model's length horizontal with its widest overhang down: its vertices,
+// placed by its bones as its sequence poses them (model space), seen in the display frame `pose` gives (x right, z up).
+struct Lay { float angle, center[3], hx, hz, sweep; bool fitted; };
+static Lay LayAngle( studiohdr_t *hdr, const float pose[3][3], float bone[][3][4] )
+{
+	Lay out = { 0, { 0, 0, 0 }, 0, 0, 0, false };
+	vec3_t lo = { 1e9f, 1e9f, 1e9f }, hi = { -1e9f, -1e9f, -1e9f };
+	// (the first body part's first model: the weapon itself)
+	double sx = 0, sz = 0, sxx = 0, szz = 0, sxz = 0; int n = 0;
+	static float px[4096], pz[4096], py[4096];
+	mstudiobodyparts_t *parts = (mstudiobodyparts_t *)( (byte *)hdr + hdr->bodypartindex );
+	for ( int bp = 0; bp < hdr->numbodyparts && n < 4096; bp++ )
+	{
+		if ( parts[bp].nummodels <= 0 )
+			continue;
+		mstudiomodel_t *model = (mstudiomodel_t *)( (byte *)hdr + parts[bp].modelindex );
+		const vec3_t *verts = (const vec3_t *)( (byte *)hdr + model->vertindex );
+		const byte *vbone = (const byte *)hdr + model->vertinfoindex;
+		for ( int v = 0; v < model->numverts && n < 4096; v++ )
+		{
+			const int b = vbone[v] < hdr->numbones ? vbone[v] : 0;
+			vec3_t w;
+			VectorTransform( verts[v], bone[b], w );
+			for ( int k = 0; k < 3; k++ ) { lo[k] = min( lo[k], w[k] ); hi[k] = max( hi[k], w[k] ); }
+			const float x = pose[0][0] * w[0] + pose[0][1] * w[1] + pose[0][2] * w[2];
+			const float z = pose[2][0] * w[0] + pose[2][1] * w[1] + pose[2][2] * w[2];
+			py[n] = pose[1][0] * w[0] + pose[1][1] * w[1] + pose[1][2] * w[2];
+			px[n] = x; pz[n] = z; n++;
+			sx += x; sz += z; sxx += x * x; szz += z * z; sxz += x * z;
+		}
+	}
+	if ( n < 8 )
+		return out;
+	for ( int k = 0; k < 3; k++ ) out.center[k] = ( lo[k] + hi[k] ) / 2;
+	const double mx = sx / n, mz = sz / n, cxx = sxx / n - mx * mx, czz = szz / n - mz * mz, cxz = sxz / n - mx * mz;
+	// (the principal axis; a nearly round item is left as it lies)
+	const double theta = 0.5 * atan2( 2 * cxz, cxx - czz );
+	const double l1 = ( cxx + czz ) / 2 + sqrt(( cxx - czz ) * ( cxx - czz ) / 4 + cxz * cxz ), l2 = cxx + czz - l1;
+	float angle = 0;
+	if ( l1 >= l2 * 1.8 )
+	{
+	// turned by -theta: the axis horizontal; then the farthest overhang (perpendicular) must point down
+	angle = (float)-theta;
+	const float c = cosf( angle ), s = sinf( angle );
+	float up = 0, down = 0;
+	for ( int i = 0; i < n; i++ )
+	{
+		const float z = s * ( px[i] - mx ) + c * ( pz[i] - mz );
+		up = max( up, z ); down = max( down, -z );
+	}
+	if ( up > down )
+		angle += M_PI;
+	}
+	// (the model's own extent once laid: the frame fitted to it, not to its file's box)
+	const float c = cosf( angle ), s = sinf( angle );
+	float x0 = 1e9f, x1 = -1e9f, z0 = 1e9f, z1 = -1e9f;
+	for ( int i = 0; i < n; i++ )
+	{
+		const float x = c * px[i] - s * pz[i], z = s * px[i] + c * pz[i];
+		x0 = min( x0, x ); x1 = max( x1, x ); z0 = min( z0, z ); z1 = max( z1, z );
+	}
+	out.angle = angle; out.hx = ( x1 - x0 ) / 2; out.hz = ( z1 - z0 ) / 2; out.fitted = true;
+	// (how far it reaches from its middle in the plane it turns in — across and in depth: the swing it needs)
+	const float cxm = ( x0 + x1 ) / 2;
+	float y0 = 1e9f, y1 = -1e9f;
+	for ( int i = 0; i < n; i++ ) { y0 = min( y0, py[i] ); y1 = max( y1, py[i] ); }
+	const float cym = ( y0 + y1 ) / 2;
+	for ( int i = 0; i < n; i++ )
+	{
+		const float x = c * px[i] - s * pz[i] - cxm, y = py[i] - cym;
+		out.sweep = max( out.sweep, sqrtf( x * x + y * y ));
+	}
+	// (its middle in model space: the laid frame's middle taken back through the laid axes)
+	const float czm = ( z0 + z1 ) / 2;
+	for ( int k = 0; k < 3; k++ )
+	{
+		const float r0 = c * pose[0][k] - s * pose[2][k], r2 = s * pose[0][k] + c * pose[2][k];
+		out.center[k] = r0 * cxm + pose[1][k] * cym + r2 * czm;
+	}
+	return out;
+}
+
+// the model's frame: its bounding box centered in the rectangle, fitted to it as it turns, the side of a weapon
+// facing the view (world models lie on that side); a player faces it, the top tilted a little toward it
+bool ArsUI_PreviewTransform( cl_entity_t *ent, float m[3][4] )
+{
+	Preview *p = PreviewOf( ent );
+	if ( !p || !g_bView )
+		return false;
+	studiohdr_t *hdr = (studiohdr_t *)IEngineStudio.Mod_Extradata( p->model );
+	vec3_t mins, maxs;
+	mstudioseqdesc_t *seq = (mstudioseqdesc_t *)( (byte *)hdr + hdr->seqindex ) + p->sequence;
+	VectorCopy( seq->bbmin, mins ); VectorCopy( seq->bbmax, maxs );
+	if ( maxs[0] - mins[0] < 0.5f || maxs[2] - mins[2] < 0.5f )
+	{
+		VectorCopy( hdr->bbmin, mins ); VectorCopy( hdr->bbmax, maxs );
+	}
+	if ( maxs[0] - mins[0] < 0.5f || maxs[2] - mins[2] < 0.5f )
+	{
+		VectorCopy( hdr->min, mins ); VectorCopy( hdr->max, maxs );
+	}
+	if ( maxs[0] - mins[0] < 0.5f )
+	{
+		mins[0] = mins[1] = mins[2] = -12;
+		maxs[0] = maxs[1] = maxs[2] = 12;
+	}
+
+	// local axes in the display frame (x: the screen's right, y: away from the view, z: its up)
+	float pose[3][3] = { { 1, 0, 0 }, { 0, 1, 0 }, { 0, 0, 1 } };
+	if ( p->pose == POSE_FLAT )
+	{
+		// (lying weapons: their up toward the view, their left up)
+		pose[0][0] = 1; pose[1][0] = 0; pose[2][0] = 0;
+		pose[0][1] = 0; pose[1][1] = 0; pose[2][1] = 1;
+		pose[0][2] = 0; pose[1][2] = -1; pose[2][2] = 0;
+	}
+	// (models that lie otherwise than the others: turned over along their length, or in the screen's plane, or a
+	// quarter turn to show their face — g_Turns)
+	for ( const Turn &t : g_Turns )
+	{
+		if ( strcmp( t.model, p->name ))
+			continue;
+		const float r = t.roll * M_PI / 180, f = t.over ? M_PI : 0, w = t.yaw * M_PI / 180;
+		// E = Rz(yaw) * Ry(roll) * Rx(over), in the display's axes (x right, y away, z up)
+		const float rx[3][3] = { { 1, 0, 0 }, { 0, cosf( f ), -sinf( f ) }, { 0, sinf( f ), cosf( f ) } };
+		const float ry[3][3] = { { cosf( r ), 0, sinf( r ) }, { 0, 1, 0 }, { -sinf( r ), 0, cosf( r ) } };
+		const float rz[3][3] = { { cosf( w ), -sinf( w ), 0 }, { sinf( w ), cosf( w ), 0 }, { 0, 0, 1 } };
+		float e1[3][3], e[3][3], q[3][3];
+		for ( int i = 0; i < 3; i++ ) for ( int j = 0; j < 3; j++ ) e1[i][j] = ry[i][0] * rx[0][j] + ry[i][1] * rx[1][j] + ry[i][2] * rx[2][j];
+		for ( int i = 0; i < 3; i++ ) for ( int j = 0; j < 3; j++ ) e[i][j] = rz[i][0] * e1[0][j] + rz[i][1] * e1[1][j] + rz[i][2] * e1[2][j];
+		for ( int i = 0; i < 3; i++ ) for ( int j = 0; j < 3; j++ ) q[i][j] = e[i][0] * pose[0][j] + e[i][1] * pose[1][j] + e[i][2] * pose[2][j];
+		memcpy( pose, q, sizeof( q ));
+	}
+	vec3_t center, half;
+	for ( int i = 0; i < 3; i++ )
+	{
+		center[i] = ( mins[i] + maxs[i] ) / 2;
+		half[i] = ( maxs[i] - mins[i] ) / 2;
+	}
+	float ex = 0, ey = 0, ez = 0;
+	for ( int j = 0; j < 3; j++ )
+	{
+		ex += fabs( pose[0][j] ) * half[j];
+		ey += fabs( pose[1][j] ) * half[j];
+		ez += fabs( pose[2][j] ) * half[j];
+	}
+	// (a lying weapon laid along the screen: the model's length — its vertices' principal axis in the shown plane —
+	// horizontal, the side reaching furthest from it (grip, magazine, stock) down; the game's files have them at any
+	// angle. Computed once per model.)
+	if ( p->pose == POSE_FLAT )
+	{
+		memcpy( p->pose0, pose, sizeof( p->pose0 )); // (for PreviewBones: the frame before laying)
+		if ( p->laid && p->layAngle )
+		{
+			const float c = cosf( p->layAngle ), sn = sinf( p->layAngle );
+			for ( int j = 0; j < 3; j++ )
+			{
+				const float x = pose[0][j], z = pose[2][j];
+				pose[0][j] = c * x - sn * z; pose[2][j] = sn * x + c * z;
+			}
+			ex = ey = ez = 0;
+			for ( int j = 0; j < 3; j++ )
+			{
+				ex += fabs( pose[0][j] ) * half[j];
+				ey += fabs( pose[1][j] ) * half[j];
+				ez += fabs( pose[2][j] ) * half[j];
+			}
+		}
+		// (fitted to its vertices: their middle at the frame's, their extent filling it)
+		if ( p->laid && p->fitted )
+		{
+			VectorCopy( p->fitCenter, center );
+			ex = p->fitHx; ez = p->fitHz; ey = min( ey, max( ex, ez ));
+		}
+	}
+	// (small items shown at a sensible size, not blown up to the frame)
+	ez = max( ez, 4.5f );
+	float radius = max( (float)sqrt( ex * ex + ey * ey ), 7.0f );
+	if ( p->laid && p->fitted )
+		radius = max( max( p->fitSweep, p->fitHx ), 7.0f ); // (its real swing: never near the view nor past the backdrop)
+	float tx, ty;
+	Projection( tx, ty );
+	float worldW = p->w / ScreenWidth * 2 * tx * PREVIEW_DIST, worldH = p->h / ScreenHeight * 2 * ty * PREVIEW_DIST;
+	float intro = Clamp01(( Now() - p->t0 ) / 0.25f );
+	intro = 1 - ( 1 - intro ) * ( 1 - intro );
+	float s = min( worldW * 0.94f / ( 2 * radius ), worldH * 0.9f / ( 2 * ez )) * p->zoom * ( 0.86f + 0.14f * intro );
+	// (never deeper than the backdrop: the model stays between it and the view)
+	s = min( s, ( BACKDROP_DIST - PREVIEW_DIST - 0.5f ) / radius );
+	s *= p->corr;
+	p->scale = s;
+
+	// (a slow sway around the side that faces the view: a close model turned edge-on would leave the frame)
+	float yaw = p->yaw + sin(( Now() - p->t0 ) * 0.8f ) * ( p->pose == POSE_UPRIGHT ? 0.55f : 0.42f ) + g_flDragYaw;
+	if ( p->pose == POSE_UPRIGHT )
+		yaw -= M_PI / 2; // (the front toward the view)
+	float cy = cos( yaw ), sy = sin( yaw );
+	float tilt = ( p->pose == POSE_UPRIGHT ? 5.0f : 9.0f ) * M_PI / 180, ct = cos( tilt ), st = sin( tilt );
+	// display = Tilt * Spin * pose
+	float spin[3][3] = { { cy, -sy, 0 }, { sy, cy, 0 }, { 0, 0, 1 } };
+	float tiltm[3][3] = { { 1, 0, 0 }, { 0, ct, -st }, { 0, st, ct } };
+	float a[3][3], d[3][3];
+	for ( int i = 0; i < 3; i++ )
+		for ( int j = 0; j < 3; j++ )
+			a[i][j] = spin[i][0] * pose[0][j] + spin[i][1] * pose[1][j] + spin[i][2] * pose[2][j];
+	for ( int i = 0; i < 3; i++ )
+		for ( int j = 0; j < 3; j++ )
+			d[i][j] = tiltm[i][0] * a[0][j] + tiltm[i][1] * a[1][j] + tiltm[i][2] * a[2][j];
+	// world = [right forward up] * display * scale
+	vec3_t mid;
+	ScreenPoint( p->x + p->w / 2, p->y + p->h / 2, PREVIEW_DIST, tx, ty, mid );
+	for ( int i = 0; i < 3; i++ )
+	{
+		for ( int j = 0; j < 3; j++ )
+			m[i][j] = ( g_vRight[i] * d[0][j] + g_vForward[i] * d[1][j] + g_vUp[i] * d[2][j] ) * s;
+		m[i][3] = mid[i] - ( m[i][0] * center[0] + m[i][1] * center[1] + m[i][2] * center[2] );
+	}
+	VectorCopy( mid, ent->origin );
+	memcpy( p->m, m, sizeof( p->m ));
+	p->frameW = worldW; p->frameH = worldH; VectorCopy( mid, p->mid );
+	return true;
+}
+
+// Whether points (across, in depth, up from the frame's middle), scaled by f and swaying around the up axis,
+// stay within the frame
+static bool PreviewFits( const vec3_t *pts, int n, float f, float X0, float D, float Z0, float frameW, float frameH )
+{
+	for ( int k = 0; k <= 12; k++ )
+	{
+		const float c = cosf( k / 12.0f - 0.5f ), sn = sinf( k / 12.0f - 0.5f ); // (the sway: 0.42 either way)
+		for ( int i = 0; i < n; i++ )
+		{
+			const float x = f * ( pts[i][0] * c - pts[i][1] * sn ), y = f * ( pts[i][0] * sn + pts[i][1] * c ), z = f * pts[i][2];
+			const float den = D + y;
+			if ( den < 0.5f )
+				return false;
+			if ( fabsf( D * ( X0 + x ) / den - X0 ) > 0.46f * frameW || fabsf( D * ( Z0 + z ) / den - Z0 ) > 0.42f * frameH )
+				return false;
+		}
+	}
+	return true;
+}
+
+// The preview's bones of this frame (world space, from m): the first frame of a lying weapon lays it — its bones back
+// in model space, then LayAngle — and is not drawn. False: skip drawing.
+bool ArsUI_PreviewBones( cl_entity_t *ent, float bones[][3][4], int count )
+{
+	Preview *p = PreviewOf( ent );
+	if ( !p || p->pose != POSE_FLAT )
+		return true;
+	if ( p->laid )
+	{
+		// (its first laid frame: the vertices where its bones put them, measured across, up and in depth against the
+		// frame and the room before the backdrop; the scale corrected once, and that frame not drawn)
+		if ( p->measured++ )
+			return true;
+		studiohdr_t *hdr = (studiohdr_t *)IEngineStudio.Mod_Extradata( p->model );
+		static vec3_t pts[8192];
+		int n = 0;
+		float ay = 0;
+		mstudiobodyparts_t *parts = (mstudiobodyparts_t *)( (byte *)hdr + hdr->bodypartindex );
+		for ( int bp = 0; bp < hdr->numbodyparts; bp++ )
+		{
+			if ( parts[bp].nummodels <= 0 ) continue;
+			mstudiomodel_t *model = (mstudiomodel_t *)( (byte *)hdr + parts[bp].modelindex );
+			const vec3_t *verts = (const vec3_t *)( (byte *)hdr + model->vertindex );
+			const byte *vbone = (const byte *)hdr + model->vertinfoindex;
+			for ( int v = 0; v < model->numverts; v++ )
+			{
+				const int b = vbone[v] < count ? vbone[v] : 0;
+				vec3_t w; VectorTransform( verts[v], bones[b], w );
+				vec3_t d = { w[0] - p->mid[0], w[1] - p->mid[1], w[2] - p->mid[2] };
+				ay = max( ay, sqrtf( DotProduct( d, d )));
+				if ( n < 8192 )
+				{
+					pts[n][0] = DotProduct( d, g_vRight ); pts[n][1] = DotProduct( d, g_vForward ); pts[n][2] = DotProduct( d, g_vUp );
+					n++;
+				}
+			}
+		}
+		float f = 1;
+		if ( ay > 0.001f ) f = min( f, ( BACKDROP_DIST - PREVIEW_DIST - 0.5f ) / ay ); // (turning, it reaches that far in depth)
+		// (swaying, in the perspective of a frame off the screen's middle: its nearer end grows away from it)
+		vec3_t o; VectorSubtract( p->mid, g_vViewOrg, o );
+		const float X0 = DotProduct( o, g_vRight ), D = DotProduct( o, g_vForward ), Z0 = DotProduct( o, g_vUp );
+		float lo = 0, hi = f;
+		while ( hi - lo > 0.005f && !PreviewFits( pts, n, hi, X0, D, Z0, p->frameW, p->frameH ))
+		{
+			const float m = ( lo + hi ) / 2;
+			if ( PreviewFits( pts, n, m, X0, D, Z0, p->frameW, p->frameH ))
+				lo = m;
+			else
+				hi = m;
+		}
+		p->corr = PreviewFits( pts, n, hi, X0, D, Z0, p->frameW, p->frameH ) ? hi : lo;
+		// (measured during the intro's zoom, which then ends: the correction of the final size)
+		float intro = Clamp01(( Now() - p->t0 ) / 0.25f );
+		intro = 1 - ( 1 - intro ) * ( 1 - intro );
+		p->corr *= 0.86f + 0.14f * intro;
+		return false;
+	}
+	p->laid = true;
+	if ( count <= 0 || count > 128 )
+		return false;
+	// (m = R*s | t, R orthonormal: its inverse is R^T/s | -R^T t / s)
+	float s2 = p->m[0][0] * p->m[0][0] + p->m[1][0] * p->m[1][0] + p->m[2][0] * p->m[2][0];
+	if ( s2 < 1e-12f )
+		return false;
+	float inv[3][4];
+	for ( int i = 0; i < 3; i++ )
+	{
+		for ( int j = 0; j < 3; j++ ) inv[i][j] = p->m[j][i] / s2;
+		inv[i][3] = -( inv[i][0] * p->m[0][3] + inv[i][1] * p->m[1][3] + inv[i][2] * p->m[2][3] );
+	}
+	static float local[128][3][4];
+	for ( int b = 0; b < count; b++ )
+		ConcatTransforms( inv, bones[b], local[b] );
+	const Lay lay = LayAngle( (studiohdr_t *)IEngineStudio.Mod_Extradata( p->model ), p->pose0, local );
+	p->layAngle = lay.angle;
+	// (a few models whose overhang misleads: the other way up)
+	for ( const char *flip : g_Flips )
+		if ( !strcmp( flip, p->name ))
+			p->layAngle += M_PI;
+	p->fitted = lay.fitted; VectorCopy( lay.center, p->fitCenter ); p->fitHx = lay.hx; p->fitHz = lay.hz; p->fitSweep = lay.sweep;
+
+	return false;
+}
+
+// a light of its own: from above the view, on its left
+void ArsUI_PreviewLighting( cl_entity_t *ent, alight_t *lighting )
+{
+	Preview *p = PreviewOf( ent );
+	if ( !p )
+		return;
+	lighting->ambientlight = 78;
+	lighting->shadelight = 168;
+	lighting->color[0] = lighting->color[1] = lighting->color[2] = 1.0f;
+	vec3_t dir;
+	for ( int i = 0; i < 3; i++ )
+		dir[i] = g_vForward[i] * 0.55f - g_vUp[i] * 0.7f + g_vRight[i] * 0.45f;
+	VectorNormalize( dir );
+	// (the bones are scaled: the light turned in their frame would be too)
+	float k = p->scale > 0.0001f ? 1.0f / p->scale : 1.0f;
+	VectorScale( dir, k, lighting->plightvec );
+}
