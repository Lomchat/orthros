+static void NumberKey( int key )
+{
+	if ( g_iPanel == P_TEAM )
+	{
+		if ( key == 10 && Allowed( 10 ))
+			Close();
+		else if ( key >= 1 && key <= 6 && key != 4 && Allowed( key ))
+		{
+			Command( "jointeam %d", key );
+			Close();
+		}
+	}
+	else if ( g_iPanel == P_CLASS )
+	{
+		if ( Allowed( key ))
+		{
+			Command( "joinclass %d", key ); // (0: 10, a look at random)
+			Close();
+		}
+	}
+	else if ( g_iPanel == P_BUY )
+	{
+		if ( key == 10 )
+		{
+			if ( g_iKeyLevel == 1 )
+				g_iKeyLevel = 0;
+			else
+				Close();
+			return;
+		}
+		if ( g_iKeyLevel == 0 )
+		{
+			if ( key <= NUM_TABS )
+			{
+				g_iTab = key - 1;
+				g_iKeyLevel = 1;
+				g_iFocus = -1;
+			}
+			return;
+		}
+		int items[16], n = TabItems( g_iTab, items );
+		if ( key <= n )
+		{
+			g_iFocus = items[key - 1];
+			Buy( items[key - 1] );
+		}
+	}
+}
+
+bool ArsUI_Key( int down, int keynum, const char *pszCurrentBinding )
+{
+	bool repeat = false;
+	if ( keynum >= 0 && keynum < 256 )
+	{
+		repeat = down && g_bHeld[keynum];
+		g_bHeld[keynum] = !!down;
+	}
+	if ( g_iPanel == P_NONE || !down )
+		return false; // (releases reach the game: a key held as the panel opened)
+	const char *b = pszCurrentBinding ? pszCurrentBinding : "";
+	if ( keynum == K_MWHEELUP || keynum == K_MWHEELDOWN || ( g_iPanel == P_BUY && ( keynum == K_LEFTARROW || keynum == K_RIGHTARROW || keynum == K_UPARROW || keynum == K_DOWNARROW )))
+	{
+		if ( g_iPanel == P_BUY )
+		{
+			int step = ( keynum == K_MWHEELUP || keynum == K_LEFTARROW || keynum == K_UPARROW ) ? -1 : 1;
+			g_iTab = ( g_iTab + step + NUM_TABS ) % NUM_TABS;
+			g_iFocus = -1;
+			g_iKeyLevel = 1;
+		}
+		return true;
+	}
+	if ( keynum == K_ESCAPE )
+	{
+		if ( repeat )
+			return true;
+		if ( g_iPanel == P_BUY || ( g_iPanel == P_TEAM && Allowed( 10 )))
+		{
+			Close();
+			return true;
+		}
+		// (the engine's menu opens: the mouse is its own until the game is back)
+		Mouse( false );
+		g_bSuspended = true;
+		return false;
+	}
+	if ( keynum >= '0' && keynum <= '9' )
+	{
+		if ( !repeat )
+			NumberKey( keynum == '0' ? 10 : keynum - '0' );
+		return true;
+	}
+	if ( keynum == K_BACKSPACE && g_iPanel == P_BUY )
+	{
+		g_iKeyLevel = 0;
+		return true;
+	}
+	if ( g_iPanel == P_BUY && ( !strcmp( b, "buy" ) || !strcmp( b, "buymenu" ) || !strcmp( b, "client_buy_open" )))
+	{
+		if ( !repeat )
+			Close();
+		return true;
+	}
+	if ( g_iPanel == P_TEAM && !strcmp( b, "chooseteam" ) && Allowed( 10 ))
+	{
+		if ( !repeat )
+			Close();
+		return true;
+	}
+	return false;
+}
