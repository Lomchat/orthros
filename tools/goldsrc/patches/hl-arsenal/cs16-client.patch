+}
+
+// the icons drawn as shapes, when the sprite is not there: a wall of bricks, a floor slab, stairs, a roof
+static void BuildShapeIcon( int frame, float x, float y, float s, Col c )
+{
+	const float u = s / 12;
+	switch ( frame )
+	{
+	case BUILD_WALL:
+		for ( int r = 0; r < 4; r++ )
+			for ( int k = 0; k < 3; k++ )
+			{
+				const float off = ( r & 1 ) ? -2 * u : 0;
+				const float bx = x + u + off + k * 4 * u, bw = 3.4f * u;
+				const float x0 = max( x + u, bx ), x1 = min( x + 11 * u, bx + bw );
+				Fill( x0, y + u + r * 2.6f * u, x1 - x0, 2.0f * u, c );
+			}
+		break;
+	case BUILD_FLOOR:
+	{
+		const float xs[4] = { x + 3 * u, x + 0.5f * u, x + 9 * u, x + 11.5f * u }, ys[4] = { y + 4 * u, y + 8 * u, y + 8 * u, y + 4 * u };
+		QuadPts( xs, ys, c );
+		Fill( x + 0.5f * u, y + 8 * u, 8.5f * u, 1.2f * u, Alpha( c, 0.7f ));
+		break;
+	}
+	case BUILD_RAMP:
+		for ( int k = 0; k < 4; k++ )
+			Fill( x + u + k * 2.5f * u, y + 11 * u - ( k + 1 ) * 2.5f * u, ( 4 - k ) * 2.5f * u, 2.0f * u, c );
+		break;
+	case BUILD_ROOF:
+	{
+		const float xs[4] = { x + 0.5f * u, x + 6 * u, x + 6 * u, x + 11.5f * u }, ys[4] = { y + 9 * u, y + 2.5f * u, y + 2.5f * u, y + 9 * u };
+		QuadPts( xs, ys, c );
+		Fill( x + 0.5f * u, y + 9 * u, 11 * u, 1.2f * u, Alpha( c, 0.7f ));
+		break;
+	}
+	default: // (a brick)
+		Fill( x + u, y + 3 * u, 10 * u, 6 * u, c );
+		Fill( x + u, y + 3 * u, 10 * u, 1.2f * u, Alpha( C_WHITE, c.a / 255.0f * 0.35f ));
+		Fill( x + u, y + 8 * u, 10 * u, 1.0f * u, Alpha( C_SHADE, c.a / 255.0f * 0.6f ));
+		break;
+	}
+}
+
+static void BuildIconAdd( int frame, float x, float y, float s, Col c )
+{
+	if ( !BuildHudSprite())
+	{
+		BuildShapeIcon( frame >= BUILD_ICON_BRICK ? BUILD_ICON_BRICK : frame, x, y, s, frame >= BUILD_ICON_BRICK ? Alpha( C_BRICK, c.a / 255.0f ) : c );
+		return;
+	}
+	if ( g_iBuildIcons >= MAX_BUILD_ICONS || !c.a )
+		return;
+	BuildIcon &i = g_BuildIcons[g_iBuildIcons++];
+	i.x = x; i.y = y; i.w = i.h = s; i.frame = frame; i.c = c;
+}
+
+static void BuildFlushIcons( void )
+{
+	const model_t *m = BuildHudSprite();
+	if ( !m || !g_iBuildIcons )
+	{
+		g_iBuildIcons = 0;
+		return;
+	}
+	gEngfuncs.pTriAPI->RenderMode( kRenderTransAdd );
+	gEngfuncs.pTriAPI->CullFace( TRI_NONE );
+	for ( int n = 0; n < g_iBuildIcons; n++ )
+	{
+		const BuildIcon &i = g_BuildIcons[n];
+		if ( !gEngfuncs.pTriAPI->SpriteTexture( (struct model_s *)m, 0 ))
+			break;
+		const float f = i.c.a / 255.0f;
+		// (its rectangle of the atlas, half a texel in)
+		const float u0 = ( g_BuildIconRects[i.frame].x + 0.5f ) / BUILD_ATLAS_W, u1 = ( g_BuildIconRects[i.frame].x + g_BuildIconRects[i.frame].w - 0.5f ) / BUILD_ATLAS_W;
+		const float v0 = ( g_BuildIconRects[i.frame].y + 0.5f ) / BUILD_ATLAS_H, v1 = ( g_BuildIconRects[i.frame].y + g_BuildIconRects[i.frame].h - 0.5f ) / BUILD_ATLAS_H;
+		gEngfuncs.pTriAPI->Color4f( i.c.r / 255.0f * f, i.c.g / 255.0f * f, i.c.b / 255.0f * f, 1.0f );
+		gEngfuncs.pTriAPI->Begin( TRI_QUADS );
+		gEngfuncs.pTriAPI->TexCoord2f( u0, v0 ); gEngfuncs.pTriAPI->Vertex3f( SC( i.x ), SC( i.y ), 0 );
+		gEngfuncs.pTriAPI->TexCoord2f( u0, v1 ); gEngfuncs.pTriAPI->Vertex3f( SC( i.x ), SC( i.y + i.h ), 0 );
+		gEngfuncs.pTriAPI->TexCoord2f( u1, v1 ); gEngfuncs.pTriAPI->Vertex3f( SC( i.x + i.w ), SC( i.y + i.h ), 0 );
+		gEngfuncs.pTriAPI->TexCoord2f( u1, v0 ); gEngfuncs.pTriAPI->Vertex3f( SC( i.x + i.w ), SC( i.y ), 0 );
+		gEngfuncs.pTriAPI->End();
+	}
+	gEngfuncs.pTriAPI->RenderMode( kRenderNormal );
+	g_iBuildIcons = 0;
+}
+
+static void BuildFlush( void )
+{
+	FlushShapes();
+	BuildFlushIcons();
+	FlushTexts();
+}
+
+// the "+5"s of bricks picked up, rising from a point (the count's), fading
+static void BuildDrawPopups( float x, float y, float now )
+{
+	const int lh = LineHeight();
+	for ( int i = 0; i < MAX_BRICK_POPUPS; i++ )
+	{
+		if ( g_BrickPopups[i].amount <= 0 )
+			continue;
+		const float t = now - g_BrickPopups[i].t;
+		if ( t < 0 || t > 1.4f )
+		{
+			g_BrickPopups[i].amount = 0;
+			continue;
+		}
+		char s[16];
+		snprintf( s, sizeof( s ), "+%d", g_BrickPopups[i].amount );
+		const float a = Clamp01( t / 0.08f ) * ( 1 - Clamp01(( t - 0.8f ) / 0.6f ));
+		const float rise = lh * 1.3f * ( 1 - ( 1 - Clamp01( t / 0.9f )) * ( 1 - Clamp01( t / 0.9f )));
+		TextRight( x, y - lh - rise, s, Alpha( C_GREEN, a ));
+	}
+}
+
+// out of build mode: the brick count by the money, small
+static void BuildDrawCountSmall( float now )
+{
+	if (( gHUD.m_iHideHUDDisplay & HIDEHUD_HEALTH ) || !( gHUD.m_iWeaponBits & ( 1 << WEAPON_SUIT )))
+		return;
+	if ( g_iDollarSprite < 0 )
+		g_iDollarSprite = gHUD.GetSpriteIndex( "dollar" );
+	float dollarW = 24;
+	if ( g_iDollarSprite >= 0 )
+	{
+		const wrect_t &r = gHUD.GetSpriteRect( g_iDollarSprite );
+		dollarW = (float)( r.right - r.left );
+	}
+	const int lh = LineHeight();
+	const float fh = (float)gHUD.m_iFontHeight;
+	const float rx = ScreenWidth - dollarW * 7 - 12, y = ScreenHeight - 3 * fh + ( fh - lh ) / 2;
+	char s[16];
+	snprintf( s, sizeof( s ), "%d", g_iBricks );
+	const float flash = 1 - Clamp01(( now - g_flBricksChanged ) / 0.8f );
+	const float tw = TextWidth( s ), icon = lh * 1.15f;
+	Fill( rx - tw - icon - 14, y - 3, tw + icon + 18, lh + 6, Alpha( C_SHADE, 0.45f + 0.2f * flash ));
+	BuildIconAdd( BUILD_ICON_BRICK, rx - tw - icon - 8, y + ( lh - icon ) / 2, icon, Alpha( C_WHITE, 0.85f ));
+	TextRight( rx, y, s, Mix( Alpha( C_TEXT, 0.8f ), C_GOLDT, flash ));
+	BuildDrawPopups( rx, y, now );
+}
+
+static void BuildDrawBar( float now )
+{
+	const int lh = LineHeight();
+	const float fh = (float)gHUD.m_iFontHeight;
+	const float S = max( 44.0f, lh * 2.8f ), gap = max( 5.0f, S * 0.1f ), W = S * BUILD_PIECES + gap * ( BUILD_PIECES - 1 );
+	const float x0 = (int)( ScreenWidth / 2 - W / 2 ), y0 = (int)( ScreenHeight - 2 * fh - S - 10 );
+	const bool afford = g_iBricks >= BUILD_COST;
+
+	// (the backing, a strip under the slots)
+	Grad( x0 - 10, y0 - 8, W + 20, S + 16, Alpha( C_PANEL, 0.0f ), Alpha( C_PANEL, 0.75f ));
+	for ( int i = 0; i < BUILD_PIECES; i++ )
+	{
+		const bool sel = i == g_iBuildPiece;
+		const float x = x0 + i * ( S + gap ), y = y0 - ( sel ? 4 : 0 );
+		Grad( x, y, S, S, Alpha( sel ? C_PANEL2 : C_PANEL, 0.92f ), Alpha( C_PANEL, 0.92f ));
+		if ( sel )
+		{
+			Fill( x, y, S, S, C_SEL );
+			Frame( x - 1, y - 1, S + 2, S + 2, C_GOLD, 2 );
+			Fill( x, y, S, 3, C_GOLDT );
+		}
+		else
+			Frame( x, y, S, S, C_SOFT );
+		const float is = S * 0.58f;
+		BuildIconAdd( i, x + ( S - is ) / 2, y + S * 0.12f, is, sel ? C_WHITE : Alpha( C_TEXT, 0.6f ));
+		// (its key, top left; its cost, bottom right — red when the bricks are short)
+		char key[2] = { (char)( '1' + i ), 0 };
+		Text( x + 4, y + 2, key, sel ? C_GOLDT : C_FAINT, 0.8f );
+		char cost[8];
+		snprintf( cost, sizeof( cost ), "%d", BUILD_COST );
+		const float bi = lh * 0.8f;
+		const Col cc = afford ? ( sel ? C_TEXT : C_DIM ) : C_RED;
+		TextRight( x + S - 4, y + S - lh - 1, cost, cc, 0.8f );
+		BuildIconAdd( BUILD_ICON_BRICK_SMALL, x + S - 6 - TextW( cost, 0.8f ) - bi, y + S - lh - 1 + ( lh - bi ) / 2, bi, Alpha( C_WHITE, afford ? 0.8f : 0.45f ));
+	}
+
+	// (the bricks, to the right: big)
+	char s[16];
+	snprintf( s, sizeof( s ), "%d", g_iBricks );
+	const float flash = 1 - Clamp01(( now - g_flBricksChanged ) / 0.8f );
+	const float big = 1.35f, icon = lh * 1.6f;
+	const float bx = x0 + W + 16, lhb = Scaled( big ) ? LineHeight( big ) : lh;
+	Fill( bx - 4, y0 + S / 2 - icon / 2 - 5, icon + TextW( s, big ) + 18, icon + 10, Alpha( C_PANEL, 0.8f ));
+	Fill( bx - 4, y0 + S / 2 - icon / 2 - 5, 3, icon + 10, afford ? C_BRICK : C_RED );
+	BuildIconAdd( BUILD_ICON_BRICK, bx + 2, y0 + S / 2 - icon / 2, icon, C_WHITE );
+	Text( bx + icon + 8, y0 + S / 2 - lhb / 2, s, Mix( afford ? C_TEXT : C_RED, C_GOLDT, flash ), big );
+	BuildDrawPopups( bx + icon + 8 + TextW( s, big ), y0 + S / 2 - lhb / 2, now );
+
+	// (the piece's name and, in red under it, why it may not go where the blueprint is: in the bar's row, right of the
+	// bricks — not over the build tablet's screen, whose picture is the bar's middle; on a screen too narrow for that,
+	// over the bar as a last resort)
+	const char *name = L( g_BuildNames[g_iBuildPiece] );
+	char title[64];
+	snprintf( title, sizeof( title ), "%s", name );
+	for ( unsigned char *c = (unsigned char *)title; *c; c++ ) // (in capitals: a UTF-8 é to É too)
+	{
+		if ( *c >= 'a' && *c <= 'z' )
+			*c -= 32;
+		else if ( *c == 0xC3 && c[1] >= 0xA0 && c[1] <= 0xBE && c[1] != 0xB7 )
+			*++c -= 32;
+		else if ( *c == 0xC5 && c[1] == 0x93 ) // (œ to Œ)
+			*++c = 0x92;
+	}
+	const bool denied = g_iBuildDeny && now - g_flBuildDeny < 1.6f && now >= g_flBuildDeny;
+	const char *why = denied ? BuildReasonText( g_iBuildDeny ) : ( g_bBuildSpot && g_iBuildReason != BUILD_OK ) ? BuildReasonText( g_iBuildReason ) : NULL;
+	if ( why && !why[0] )
+		why = NULL;
+	const float wa = !why ? 0 : denied ? 1.0f - Clamp01(( now - g_flBuildDeny - 1.1f ) / 0.5f ) : 0.75f;
+	const float lx = bx - 4 + icon + TextW( s, big ) + 18 + 14;
+	const float lw = max( (float)TextWidth( title ), why ? (float)TextWidth( why ) : 0.0f );
+	if ( lx + lw + 8 <= ScreenWidth )
+	{
+		const float ly = y0 + S / 2 - lh - 2;
+		Fill( lx - 6, ly - 4, lw + 12, 2 * lh + 12, Alpha( C_PANEL, 0.7f ));
+		Fill( lx - 6, ly - 4, 2, 2 * lh + 12, why ? Alpha( C_RED, max( wa, 0.4f )) : C_GOLD );
+		Text( lx, ly, title, C_GOLDT );
+		if ( why )
+			Text( lx, ly + lh + 4, why, Alpha( C_RED, wa ));
+	}
+	else
+	{
+		TextCenter( ScreenWidth / 2, y0 - lh - 12, title, C_GOLDT );
+		if ( why )
+			TextCenter( ScreenWidth / 2, y0 - 2 * lh - 16, why, Alpha( C_RED, wa ));
+	}
+
+	// (the keys, to the left)
+	const float kx = x0 - 16;
+	const char *const hints[3][2] = { { "R", L( "Rotate", "Tourner" ) }, { L( "LMB", "Clic G" ), L( "Build", "Construire" ) }, { "F", L( "Exit", "Quitter" ) } };
+	for ( int i = 0; i < 3; i++ )
+	{
+		const float y = y0 + S / 2 - 1.5f * ( lh + 6 ) + i * ( lh + 6 ) + 3;
+		const float lw = TextWidth( hints[i][1] ), kw = TextWidth( hints[i][0] ) + 10;
+		TextRight( kx, y, hints[i][1], C_DIM );
+		KeyBadge( kx - lw - 8 - kw, y, hints[i][0], false );
+	}
+}
+
+static void BuildDrawHud( float now, bool intermission )
+{
+	if ( intermission || g_iPanel != P_NONE || !gHUD.m_pCvarDraw->value || ( gHUD.m_iHideHUDDisplay & HIDEHUD_ALL ))
+		return;
+	if ( g_bBuild )
+		BuildDrawBar( now );
+	else if ( g_bBuildEnabled && BuildCanUse() && ( g_bBricksKnown || g_bBuildKnown ))
+		BuildDrawCountSmall( now );
+	else if ( g_iBuildDeny && now - g_flBuildDeny < 1.6f && now >= g_flBuildDeny )
+	{
+		// (F refused out of build mode: why, over the timer)
+		const int lh = LineHeight();
+		TextCenter( ScreenWidth / 2, ScreenHeight - 2 * gHUD.m_iFontHeight - lh - 10, BuildReasonText( g_iBuildDeny ), Alpha( C_RED, 1.0f - Clamp01(( now - g_flBuildDeny - 1.1f ) / 0.5f )));
+	}
+	BuildFlush();
+}
