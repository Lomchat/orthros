diff --git a/cl_dll/events/event_hl.cpp b/cl_dll/events/event_hl.cpp
new file mode 100644
index 0000000..98cc8d1
--- /dev/null
+++ b/cl_dll/events/event_hl.cpp
@@ -0,0 +1,486 @@
+/*
+*	Half-Life arsenal: the client events of the Half-Life SDK's 9mm handgun, .357, MP5, shotgun, crossbow, RPG, Gauss
+*	and Egon (ev_hldm.cpp), on this client's helpers. These weapons are not predicted: the shooter receives their events
+*	as everyone does, the weapon animation of a shot coming from here as in Half-Life, the others from the server (the
+*	crowbar's, the hornet gun's and the thrown weapons' all from there).
+*/
+#include "events.h"
+
+enum hl_glock_e { GLOCK_IDLE1 = 0, GLOCK_IDLE2, GLOCK_IDLE3, GLOCK_SHOOT, GLOCK_SHOOT_EMPTY, GLOCK_RELOAD, GLOCK_RELOAD_NOT_EMPTY, GLOCK_DRAW, GLOCK_HOLSTER, GLOCK_ADD_SILENCER };
+enum hl_python_e { PYTHON_IDLE1 = 0, PYTHON_FIDGET, PYTHON_FIRE1, PYTHON_RELOAD, PYTHON_HOLSTER, PYTHON_DRAW, PYTHON_IDLE2, PYTHON_IDLE3 };
+enum hl_mp5_e { MP5_LONGIDLE = 0, MP5_IDLE1, MP5_LAUNCH, MP5_RELOAD, MP5_DEPLOY, MP5_FIRE1, MP5_FIRE2, MP5_FIRE3 };
+enum hl_shotgun_e { SHOTGUN_IDLE = 0, SHOTGUN_FIRE, SHOTGUN_FIRE2, SHOTGUN_RELOAD, SHOTGUN_PUMP, SHOTGUN_START_RELOAD, SHOTGUN_DRAW, SHOTGUN_HOLSTER, SHOTGUN_IDLE4, SHOTGUN_IDLE_DEEP };
+enum hl_gauss_e { GAUSS_IDLE = 0, GAUSS_IDLE2, GAUSS_FIDGET, GAUSS_SPINUP, GAUSS_SPIN, GAUSS_FIRE, GAUSS_FIRE2, GAUSS_HOLSTER, GAUSS_DRAW };
+enum hl_crossbow_e
+{
+	CROSSBOW_IDLE1 = 0, CROSSBOW_IDLE2, CROSSBOW_FIDGET1, CROSSBOW_FIDGET2, CROSSBOW_FIRE1, CROSSBOW_FIRE2, CROSSBOW_FIRE3,
+	CROSSBOW_RELOAD, CROSSBOW_DRAW1, CROSSBOW_DRAW2, CROSSBOW_HOLSTER1, CROSSBOW_HOLSTER2
+};
+enum hl_rpg_e { RPG_IDLE = 0, RPG_FIDGET, RPG_RELOAD, RPG_FIRE2, RPG_HOLSTER1, RPG_DRAW1, RPG_HOLSTER2, RPG_DRAW_UL, RPG_IDLE_UL, RPG_FIDGET_UL };
+enum hl_egon_e { EGON_IDLE1 = 0, EGON_FIDGET1, EGON_ALTFIREON, EGON_ALTFIRECYCLE, EGON_ALTFIREOFF, EGON_FIRE1, EGON_FIRE2, EGON_FIRE3, EGON_FIRE4, EGON_DRAW, EGON_HOLSTER };
+
+#define HL_SND_CHANGE_PITCH   (1 << 7)
+#define HL_EGON_FIRE_WIDE     1
+#define HL_EGON_SOUND_OFF     "weapons/egon_off1.wav"
+#define HL_EGON_SOUND_RUN     "weapons/egon_run3.wav"
+#define HL_EGON_SOUND_STARTUP "weapons/egon_windup2.wav"
+
+// (this client's gunshot decal, as events/ev_cs16.cpp defines it: include/ev_hldm.h declares an older one)
+void EV_HLDM_DecalGunshot( pmtrace_t *pTrace, int iBulletType, float scale, int r, int g, int b, bool bCreateWallPuff, bool bCreateSparks, char cTextureType, bool isSky );
+
+// (a Half-Life bullet mark: a gunshot decal with its puff and sparks)
+static void HL_DecalGunshot( pmtrace_t *pTrace )
+{
+	EV_HLDM_DecalGunshot( pTrace, BULLET_PLAYER_50AE, 0.5f, 40, 40, 40, true, true, 'C', false );
+}
+
+// (a Half-Life brass shell: models/shell.mdl, which the server precaches for these weapons)
+static void HL_EjectShell( event_args_t *args, Vector &origin, Vector &angles, Vector &forward, Vector &right, Vector &up, const char *model, int soundtype, int count = 1 )
+{
+	Vector velocity( args->velocity );
+	Vector ShellVelocity, ShellOrigin;
+	int shell = gEngfuncs.pEventAPI->EV_FindModelIndex( model );
+
+	for ( int i = 0; i < count; i++ )
+	{
+		EV_GetDefaultShellInfo( args, origin, velocity, ShellVelocity, ShellOrigin, forward, right, up, 20.0, -12.0, 4.0 );
+		EV_EjectBrass( ShellOrigin, ShellVelocity, angles[YAW], shell, soundtype );
+	}
+}
+
+// The 9mm handgun's two fire modes
+static void EV_FireHLGlock( event_args_t *args )
+{
+	int idx = args->entindex;
+	Vector origin( args->origin );
+	Vector angles( args->angles );
+	Vector forward, right, up;
+	vec3_t vecSrc;
+
+	AngleVectors( angles, forward, right, up );
+
+	if ( EV_IsLocal( idx ) )
+	{
+		EV_MuzzleFlash();
+		gEngfuncs.pEventAPI->EV_WeaponAnimation( args->bparam1 ? GLOCK_SHOOT_EMPTY : GLOCK_SHOOT, 0 );
+	}
+
+	HL_EjectShell( args, origin, angles, forward, right, up, "models/shell.mdl", TE_BOUNCE_SHELL );
+	gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_WEAPON, "weapons/pl_gun3.wav", gEngfuncs.pfnRandomFloat( 0.92, 1.0 ), ATTN_NORM, 0, 98 + gEngfuncs.pfnRandomLong( 0, 3 ) );
+
+	EV_GetGunPosition( args, vecSrc, origin );
+	Vector vSpread( args->fparam1, args->fparam2, 0.0f );
+	EV_HLDM_FireBullets( idx, forward, right, up, 1, vecSrc, forward, vSpread, 8192.0, BULLET_PLAYER_9MM, 1 );
+}
+
+void EV_FireHLGlock1( event_args_t *args )
+{
+	EV_FireHLGlock( args );
+}
+
+void EV_FireHLGlock2( event_args_t *args )
+{
+	EV_FireHLGlock( args );
+}
+
+void EV_FireHLMP5( event_args_t *args )
+{
+	int idx = args->entindex;
+	Vector origin( args->origin );
+	Vector angles( args->angles );
+	Vector forward, right, up;
+	vec3_t vecSrc;
+
+	AngleVectors( angles, forward, right, up );
+
+	if ( EV_IsLocal( idx ) )
+	{
+		EV_MuzzleFlash();
+		gEngfuncs.pEventAPI->EV_WeaponAnimation( MP5_FIRE1 + gEngfuncs.pfnRandomLong( 0, 2 ), 0 );
+	}
+
+	HL_EjectShell( args, origin, angles, forward, right, up, "models/shell.mdl", TE_BOUNCE_SHELL );
+	gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_WEAPON, gEngfuncs.pfnRandomLong( 0, 1 ) ? "weapons/hks2.wav" : "weapons/hks1.wav", 1, ATTN_NORM, 0, 94 + gEngfuncs.pfnRandomLong( 0, 0xf ) );
+
+	EV_GetGunPosition( args, vecSrc, origin );
+	Vector vSpread( args->fparam1, args->fparam2, 0.0f );
+	EV_HLDM_FireBullets( idx, forward, right, up, 1, vecSrc, forward, vSpread, 8192.0, BULLET_PLAYER_9MM, 1 );
+}
+
+// The MP5's grenade launcher
+void EV_FireHLMP52( event_args_t *args )
+{
+	int idx = args->entindex;
+	Vector origin( args->origin );
+
+	if ( EV_IsLocal( idx ) )
+		gEngfuncs.pEventAPI->EV_WeaponAnimation( MP5_LAUNCH, 0 );
+
+	gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_WEAPON, gEngfuncs.pfnRandomLong( 0, 1 ) ? "weapons/glauncher2.wav" : "weapons/glauncher.wav", 1, ATTN_NORM, 0, 94 + gEngfuncs.pfnRandomLong( 0, 0xf ) );
+}
+
+// One barrel or both (the pellets of the server's cones, their traces here random)
+static void EV_FireHLShotgun( event_args_t *args, bool bDouble )
+{
+	int idx = args->entindex;
+	Vector origin( args->origin );
+	Vector angles( args->angles );
+	Vector forward, right, up;
+	vec3_t vecSrc;
+
+	AngleVectors( angles, forward, right, up );
+
+	if ( EV_IsLocal( idx ) )
+	{
+		EV_MuzzleFlash();
+		gEngfuncs.pEventAPI->EV_WeaponAnimation( bDouble ? SHOTGUN_FIRE2 : SHOTGUN_FIRE, 0 );
+	}
+
+	HL_EjectShell( args, origin, angles, forward, right, up, "models/shotgunshell.mdl", TE_BOUNCE_SHOTSHELL, bDouble ? 2 : 1 );
+
+	if ( bDouble )
+		gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_WEAPON, "weapons/dbarrel1.wav", gEngfuncs.pfnRandomFloat( 0.98, 1.0 ), ATTN_NORM, 0, 85 + gEngfuncs.pfnRandomLong( 0, 0x1f ) );
+	else
+		gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_WEAPON, "weapons/sbarrel1.wav", gEngfuncs.pfnRandomFloat( 0.95, 1.0 ), ATTN_NORM, 0, 93 + gEngfuncs.pfnRandomLong( 0, 0x1f ) );
+
+	EV_GetGunPosition( args, vecSrc, origin );
+	Vector vSpread = bDouble ? Vector( 0.09f, 0.06f, 0.0f ) : Vector( 0.0675f, 0.0675f, 0.0f );
+	EV_HLDM_FireBullets( idx, forward, right, up, bDouble ? 12 : 6, vecSrc, forward, vSpread, 3000.0, BULLET_PLAYER_BUCKSHOT, 1 );
+}
+
+void EV_FireHLShotgunSingle( event_args_t *args )
+{
+	EV_FireHLShotgun( args, false );
+}
+
+void EV_FireHLShotgunDouble( event_args_t *args )
+{
+	EV_FireHLShotgun( args, true );
+}
+
+void EV_FirePython( event_args_t *args )
+{
+	int idx = args->entindex;
+	Vector origin( args->origin );
+	Vector angles( args->angles );
+	Vector forward, right, up;
+	vec3_t vecSrc;
+
+	AngleVectors( angles, forward, right, up );
+
+	if ( EV_IsLocal( idx ) )
+	{
+		EV_MuzzleFlash();
+		gEngfuncs.pEventAPI->EV_WeaponAnimation( PYTHON_FIRE1, 1 ); // (body 1: the multiplayer scope)
+	}
+
+	gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_WEAPON, Com_RandomLong( 0, 1 ) ? "weapons/357_shot2.wav" : "weapons/357_shot1.wav",
+		gEngfuncs.pfnRandomFloat( 0.8f, 0.9f ), ATTN_NORM, 0, PITCH_NORM );
+
+	EV_GetGunPosition( args, vecSrc, origin );
+	Vector vSpread( args->fparam1, args->fparam2, 0.0f );
+	EV_HLDM_FireBullets( idx, forward, right, up, 1, vecSrc, forward, vSpread, 8192.0, BULLET_PLAYER_50AE, 2 );
+}
+
+void EV_SpinGauss( event_args_t *args )
+{
+	int idx = args->entindex;
+	Vector origin( args->origin );
+
+	if ( args->bparam2 ) // (overcharged)
+	{
+		gEngfuncs.pEventAPI->EV_StopSound( idx, CHAN_WEAPON, "ambience/pulsemachine.wav" );
+		return;
+	}
+
+	gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_WEAPON, "ambience/pulsemachine.wav", 1.0, ATTN_NORM, args->bparam1 ? HL_SND_CHANGE_PITCH : 0, args->iparam1 );
+}
+
+static void EV_StopPreviousGauss( int idx )
+{
+	// (no gauss spin left queued for this player)
+	gEngfuncs.pEventAPI->EV_KillEvents( idx, "events/gaussspin.sc" );
+	gEngfuncs.pEventAPI->EV_StopSound( idx, CHAN_WEAPON, "ambience/pulsemachine.wav" );
+}
+
+void EV_FireGauss( event_args_t *args )
+{
+	int idx = args->entindex;
+	Vector origin( args->origin );
+	Vector angles( args->angles );
+	float flDamage = args->fparam1;
+	int m_fPrimaryFire = args->bparam1;
+	vec3_t vecSrc, vecDest, forward, right, up;
+	pmtrace_t tr, beam_tr;
+	int fHasPunched = 0;
+	int fFirstBeam = 1;
+	int nMaxHits = 10;
+
+	if ( args->bparam2 )
+	{
+		EV_StopPreviousGauss( idx );
+		return;
+	}
+
+	EV_GetGunPosition( args, vecSrc, origin );
+
+	int m_iBeam = gEngfuncs.pEventAPI->EV_FindModelIndex( "sprites/smoke.spr" );
+	int m_iGlow = gEngfuncs.pEventAPI->EV_FindModelIndex( "sprites/hotglow.spr" );
+	int m_iBalls = m_iGlow;
+
+	AngleVectors( angles, forward, right, up );
+	VectorMA( vecSrc, 8192, forward, vecDest );
+
+	if ( EV_IsLocal( idx ) )
+		gEngfuncs.pEventAPI->EV_WeaponAnimation( GAUSS_FIRE2, 2 );
+
+	gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_WEAPON, "weapons/gauss2.wav", 0.5 + flDamage * ( 1.0 / 400.0 ), ATTN_NORM, 0, 85 + gEngfuncs.pfnRandomLong( 0, 0x1f ) );
+
+	while ( flDamage > 10 && nMaxHits > 0 )
+	{
+		nMaxHits--;
+
+		gEngfuncs.pEventAPI->EV_SetUpPlayerPrediction( false, true );
+		gEngfuncs.pEventAPI->EV_PushPMStates();
+		gEngfuncs.pEventAPI->EV_SetSolidPlayers( idx - 1 );
+		gEngfuncs.pEventAPI->EV_SetTraceHull( 2 );
+		gEngfuncs.pEventAPI->EV_PlayerTrace( vecSrc, vecDest, PM_STUDIO_BOX, -1, &tr );
+		gEngfuncs.pEventAPI->EV_PopPMStates();
+
+		if ( tr.allsolid )
+			break;
+
+		if ( fFirstBeam )
+		{
+			if ( EV_IsLocal( idx ) )
+				EV_MuzzleFlash();
+
+			fFirstBeam = 0;
+			gEngfuncs.pEfxAPI->R_BeamEntPoint( idx | 0x1000, tr.endpos, m_iBeam, 0.1, m_fPrimaryFire ? 1.0 : 2.5, 0.0,
+				m_fPrimaryFire ? 128.0 : flDamage, 0, 0, 0, 255, m_fPrimaryFire ? 128 : 255, m_fPrimaryFire ? 0 : 255 );
+		}
+		else
+		{
+			gEngfuncs.pEfxAPI->R_BeamPoints( vecSrc, tr.endpos, m_iBeam, 0.1, m_fPrimaryFire ? 1.0 : 2.5, 0.0,
+				m_fPrimaryFire ? 128.0 : flDamage, 0, 0, 0, 255, m_fPrimaryFire ? 128 : 255, m_fPrimaryFire ? 0 : 255 );
+		}
+
+		physent_t *pEntity = gEngfuncs.pEventAPI->EV_GetPhysent( tr.ent );
+		if ( pEntity == NULL )
+			break;
+
+		if ( pEntity->solid == SOLID_BSP )
+		{
+			float n = -DotProduct( tr.plane.normal, forward );
+
+			if ( n < 0.5 ) // (60 degrees: it reflects)
+			{
+				vec3_t r;
+				VectorMA( forward, 2.0 * n, tr.plane.normal, r );
+				VectorCopy( r, forward );
+				VectorMA( tr.endpos, 8.0, forward, vecSrc );
+				VectorMA( vecSrc, 8192.0, forward, vecDest );
+
+				gEngfuncs.pEfxAPI->R_TempSprite( tr.endpos, vec3_origin, 0.2, m_iGlow, kRenderGlow, kRenderFxNoDissipation, flDamage * n / 255.0, flDamage * n * 0.5 * 0.1, FTENT_FADEOUT );
+
+				vec3_t fwd;
+				VectorAdd( tr.endpos, tr.plane.normal, fwd );
+				gEngfuncs.pEfxAPI->R_Sprite_Trail( TE_SPRITETRAIL, tr.endpos, fwd, m_iBalls, 3, 0.1, gEngfuncs.pfnRandomFloat( 10, 20 ) / 100.0, 100, 255, 100 );
+
+				if ( n == 0 )
+					n = 0.1;
+
+				flDamage = flDamage * ( 1 - n );
+			}
+			else
+			{
+				// (a tunnel)
+				HL_DecalGunshot( &tr );
+				gEngfuncs.pEfxAPI->R_TempSprite( tr.endpos, vec3_origin, 1.0, m_iGlow, kRenderGlow, kRenderFxNoDissipation, flDamage / 255.0, 6.0, FTENT_FADEOUT );
+
+				if ( fHasPunched )
+					break;
+
+				fHasPunched = 1;
+
+				// (the charged shot through the wall)
+				if ( !m_fPrimaryFire )
+				{
+					vec3_t start;
+					VectorMA( tr.endpos, 8.0, forward, start );
+
+					gEngfuncs.pEventAPI->EV_PushPMStates();
+					gEngfuncs.pEventAPI->EV_SetSolidPlayers( idx - 1 );
+					gEngfuncs.pEventAPI->EV_SetTraceHull( 2 );
+					gEngfuncs.pEventAPI->EV_PlayerTrace( start, vecDest, PM_STUDIO_BOX, -1, &beam_tr );
+
+					if ( !beam_tr.allsolid )
+					{
+						vec3_t delta;
+
+						// (backwards to the exit point)
+						gEngfuncs.pEventAPI->EV_PlayerTrace( beam_tr.endpos, tr.endpos, PM_STUDIO_BOX, -1, &beam_tr );
+						VectorSubtract( beam_tr.endpos, tr.endpos, delta );
+
+						float len = Vector( delta ).Length();
+						if ( len < flDamage )
+						{
+							if ( len == 0 )
+								len = 1;
+
+							flDamage -= len;
+
+							vec3_t fwd;
+							VectorSubtract( tr.endpos, forward, fwd );
+							gEngfuncs.pEfxAPI->R_Sprite_Trail( TE_SPRITETRAIL, tr.endpos, fwd, m_iBalls, 3, 0.1, gEngfuncs.pfnRandomFloat( 10, 20 ) / 100.0, 100, 255, 100 );
+
+							HL_DecalGunshot( &beam_tr );
+							gEngfuncs.pEfxAPI->R_TempSprite( beam_tr.endpos, vec3_origin, 0.1, m_iGlow, kRenderGlow, kRenderFxNoDissipation, flDamage / 255.0, 6.0, FTENT_FADEOUT );
+
+							VectorSubtract( beam_tr.endpos, forward, fwd );
+							gEngfuncs.pEfxAPI->R_Sprite_Trail( TE_SPRITETRAIL, beam_tr.endpos, fwd, m_iBalls, (int)( flDamage * 0.3 ), 0.1, gEngfuncs.pfnRandomFloat( 10, 20 ) / 100.0, 200, 255, 40 );
+
+							VectorAdd( beam_tr.endpos, forward, vecSrc );
+						}
+					}
+					else
+					{
+						flDamage = 0;
+					}
+
+					gEngfuncs.pEventAPI->EV_PopPMStates();
+				}
+				else
+				{
+					// (the primary slug never goes through: a glow and some balls)
+					gEngfuncs.pEfxAPI->R_TempSprite( tr.endpos, vec3_origin, 0.2, m_iGlow, kRenderGlow, kRenderFxNoDissipation, 200.0 / 255.0, 0.3, FTENT_FADEOUT );
+
+					vec3_t fwd;
+					VectorAdd( tr.endpos, tr.plane.normal, fwd );
+					gEngfuncs.pEfxAPI->R_Sprite_Trail( TE_SPRITETRAIL, tr.endpos, fwd, m_iBalls, 8, 0.6, gEngfuncs.pfnRandomFloat( 10, 20 ) / 100.0, 100, 255, 200 );
+
+					flDamage = 0;
+				}
+			}
+		}
+		else
+		{
+			VectorAdd( tr.endpos, forward, vecSrc );
+		}
+	}
+}
+
+// (keeps a stuck bolt where it hit)
+static void EV_BoltCallback( struct tempent_s *ent, float frametime, float currenttime )
+{
+	ent->entity.origin = ent->entity.baseline.vuser1;
+	ent->entity.angles = ent->entity.baseline.vuser2;
+}
+
+// The zoomed shot: an instant bolt, stuck where it lands
+void EV_FireCrossbow2( event_args_t *args )
+{
+	int idx = args->entindex;
+	Vector origin( args->origin );
+	Vector angles( args->angles );
+	vec3_t vecSrc, vecEnd, forward, right, up;
+	pmtrace_t tr;
+
+	AngleVectors( angles, forward, right, up );
+	EV_GetGunPosition( args, vecSrc, origin );
+	VectorMA( vecSrc, 8192, forward, vecEnd );
+
+	gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_WEAPON, "weapons/xbow_fire1.wav", 1, ATTN_NORM, 0, 93 + gEngfuncs.pfnRandomLong( 0, 0xF ) );
+	gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_ITEM, "weapons/xbow_reload1.wav", gEngfuncs.pfnRandomFloat( 0.95, 1.0 ), ATTN_NORM, 0, 93 + gEngfuncs.pfnRandomLong( 0, 0xF ) );
+
+	if ( EV_IsLocal( idx ) )
+		gEngfuncs.pEventAPI->EV_WeaponAnimation( args->iparam1 ? CROSSBOW_FIRE1 : CROSSBOW_FIRE3, 1 );
+
+	gEngfuncs.pEventAPI->EV_SetUpPlayerPrediction( false, true );
+	gEngfuncs.pEventAPI->EV_PushPMStates();
+	gEngfuncs.pEventAPI->EV_SetSolidPlayers( idx - 1 );
+	gEngfuncs.pEventAPI->EV_SetTraceHull( 2 );
+	gEngfuncs.pEventAPI->EV_PlayerTrace( vecSrc, vecEnd, PM_STUDIO_BOX, -1, &tr );
+
+	if ( tr.fraction < 1.0 )
+	{
+		physent_t *pe = gEngfuncs.pEventAPI->EV_GetPhysent( tr.ent );
+
+		// (in the world: stuck there for a while)
+		if ( pe && pe->solid == SOLID_BSP )
+		{
+			gEngfuncs.pEventAPI->EV_PlaySound( idx, tr.endpos, CHAN_BODY, "weapons/xbow_hit1.wav", gEngfuncs.pfnRandomFloat( 0.95, 1.0 ), ATTN_NORM, 0, PITCH_NORM );
+
+			int iModelIndex = gEngfuncs.pEventAPI->EV_FindModelIndex( "models/crossbow_bolt.mdl" );
+			TEMPENTITY *bolt = gEngfuncs.pEfxAPI->R_TempModel( tr.endpos - forward * 10, Vector( 0, 0, 0 ), angles, 5, iModelIndex, TE_BOUNCE_NULL );
+			if ( bolt )
+			{
+				bolt->flags |= ( FTENT_CLIENTCUSTOM ); // (so that it does not fall)
+				bolt->entity.baseline.vuser1 = tr.endpos - forward * 10; // (its origin and angles once stuck)
+				bolt->entity.baseline.vuser2 = angles;
+				bolt->callback = EV_BoltCallback;
+			}
+		}
+	}
+
+	gEngfuncs.pEventAPI->EV_PopPMStates();
+}
+
+// The bolt in flight (the server's entity)
+void EV_FireCrossbow( event_args_t *args )
+{
+	int idx = args->entindex;
+	Vector origin( args->origin );
+
+	gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_WEAPON, "weapons/xbow_fire1.wav", 1, ATTN_NORM, 0, 93 + gEngfuncs.pfnRandomLong( 0, 0xF ) );
+	gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_ITEM, "weapons/xbow_reload1.wav", gEngfuncs.pfnRandomFloat( 0.95, 1.0 ), ATTN_NORM, 0, 93 + gEngfuncs.pfnRandomLong( 0, 0xF ) );
+
+	if ( EV_IsLocal( idx ) )
+	{
+		if ( args->iparam1 )
+			gEngfuncs.pEventAPI->EV_WeaponAnimation( CROSSBOW_FIRE1, 1 );
+		else if ( args->iparam2 )
+			gEngfuncs.pEventAPI->EV_WeaponAnimation( CROSSBOW_FIRE3, 1 );
+	}
+}
+
+void EV_FireRpg( event_args_t *args )
+{
+	int idx = args->entindex;
+	Vector origin( args->origin );
+
+	gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_WEAPON, "weapons/rocketfire1.wav", 0.9, ATTN_NORM, 0, PITCH_NORM );
+	gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_ITEM, "weapons/glauncher.wav", 0.7, ATTN_NORM, 0, PITCH_NORM );
+
+	if ( EV_IsLocal( idx ) )
+		gEngfuncs.pEventAPI->EV_WeaponAnimation( RPG_FIRE2, 1 );
+}
+
+// (its beams are the server's, the shooter's included)
+void EV_EgonFire( event_args_t *args )
+{
+	int idx = args->entindex;
+	Vector origin( args->origin );
+	int iFireMode = args->iparam2;
+	int iStartup = args->bparam1;
+	static const int fireAnims[] = { EGON_FIRE1, EGON_FIRE2, EGON_FIRE3, EGON_FIRE4 };
+
+	if ( iStartup )
+		gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_WEAPON, HL_EGON_SOUND_STARTUP, iFireMode == HL_EGON_FIRE_WIDE ? 0.98 : 0.9, ATTN_NORM, 0, iFireMode == HL_EGON_FIRE_WIDE ? 125 : 100 );
+	else
+		gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_STATIC, HL_EGON_SOUND_RUN, iFireMode == HL_EGON_FIRE_WIDE ? 0.98 : 0.9, ATTN_NORM, 0, iFireMode == HL_EGON_FIRE_WIDE ? 125 : 100 );
+
+	if ( EV_IsLocal( idx ) )
+		gEngfuncs.pEventAPI->EV_WeaponAnimation( fireAnims[gEngfuncs.pfnRandomLong( 0, 3 )], 1 );
+}
+
+void EV_EgonStop( event_args_t *args )
+{
+	int idx = args->entindex;
+	Vector origin( args->origin );
+
+	gEngfuncs.pEventAPI->EV_StopSound( idx, CHAN_STATIC, HL_EGON_SOUND_RUN );
+
+	if ( args->iparam1 )
+		gEngfuncs.pEventAPI->EV_PlaySound( idx, origin, CHAN_WEAPON, HL_EGON_SOUND_OFF, 0.98, ATTN_NORM, 0, 100 );
+}
