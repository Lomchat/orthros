+// whether the item's companion is the one out (its row's tag in gold)
+static bool CompanionOut( const BuyItem &it ) { return IsCompanionItem( it.id ) && PokemonOut() == ItemSpecies( it.id ); }
+
+// a row's short tag where "owned" goes, for a refusal that is not about the money (null: none)
+static const char *RefusalTag( const BuyItem &it )
+{
+	if ( IsCompanionItem( it.id ))
+	{
+		const int out = PokemonOut();
+		if ( out == ItemSpecies( it.id ))
+			return L( "out", "sorti" );
+		if ( Owned( it.id ))
+			return L( "owned", "poss\xC3\xA9" "d\xC3\xA9" );
+		if ( out >= 0 )
+			return out == SPECIES_LEM ? L( "Le M out", "Le M sorti" ) : L( "Pok\xC3\xA9mon out", "Pok\xC3\xA9mon sorti" );
+		if ( Owned( LEM_LAPTOP ))
+			return L( "laptop", "ordinateur" );
+		if ( OwnsCompanionItem())
+			return L( "one Pok\xC3\xA9 Ball", "une Pok\xC3\xA9 Ball" );
+		return 0;
+	}
+	if ( Owned( it.id ) || Full( it ))
+		return L( "owned", "poss\xC3\xA9" "d\xC3\xA9" );
+	if ( Refused( it ))
+		return !strcmp( it.cmd, "shield" ) ? L( "HL pistol", "pistolet HL" ) : L( "shield", "bouclier" );
+	return 0;
+}
