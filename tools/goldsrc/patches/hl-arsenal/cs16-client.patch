+// the buy panel: the categories, their items, the hovered one turning with its figures
+static void DrawBuy( void )
+{
+	float fade = Fade();
+	float sw = ScreenWidth, sh = ScreenHeight;
+	int lh = LineHeight();
+	float W = min( 1120.0f, sw - 40 ), H = min( 640.0f, sh - 40 );
+	float x0 = (int)( sw - W ) / 2, y0 = (int)( sh - H ) / 2;
+	float headH = lh * 3.4f, footH = lh * 3.0f;
+	float tabsW = min( 200.0f, W * 0.2f ), listW = min( 380.0f, W * 0.36f );
+	float bodyY = y0 + headH, bodyH = H - headH - footH;
+	float dx = x0 + tabsW + listW, dw = W - tabsW - listW;
+	float px = dx + 1, py = bodyY + 1, pw = dw - 2, ph = bodyH * 0.46f; // (the model's hole)
+	int money = gHUD.m_Money.Money();
+
+	// panel, its hole
+	BackdropAdd( px, py, pw, ph, Alpha( C_PANEL, fade ));
+	Grad( px, py + ph * 0.6f, pw, ph * 0.4f, Alpha( C_GOLD, 0 ), Alpha( C_GOLD, 0.07f * fade ));
+	FillAround( x0, y0, W, H, px, py, pw, ph, Alpha( C_PANEL, fade ));
+	Grad( x0, y0, W, headH, Alpha( C_PANEL2, fade ), Alpha( C_PANEL, fade ));
+	Fill( x0, y0 + headH - 1, W, 1, Alpha( C_LINE, fade ));
+	Fill( x0, y0 + H - footH, W, 1, Alpha( C_LINE, fade ));
+	Fill( x0 + tabsW, bodyY, 1, bodyH, Alpha( C_SOFT, fade ));
+	Fill( dx, bodyY, 1, bodyH, Alpha( C_SOFT, fade ));
+	Frame( x0, y0, W, H, Alpha( C_LINE, fade ));
+	Fill( x0, y0, W, 2, Alpha( C_GOLD, fade ));
+
+	// header
+	float hy = y0 + ( headH - LineHeight( Scaled( 1.7f ) ? 1.7f : 1 )) / 2;
+	Text( x0 + 18, hy, "BUY", Alpha( C_GOLDT, fade ), 1.7f );
+	Text( x0 + 22 + TextW( "BUY", 1.7f ) + 10, hy + LineHeight( Scaled( 1.7f ) ? 1.7f : 1 ) - lh - 1, "Anywhere, anytime  -  B, Esc or right click closes", Alpha( C_DIM, fade ));
+	char sz[48];
+	snprintf( sz, sizeof( sz ), "$ %d", money );
+	TextRight( x0 + W - 18, hy, sz, Alpha( C_GREEN, fade ), 1.7f );
+
+	// tabs
+	float ty = bodyY + 8, tabH = min( lh * 2.25f, ( bodyH - 16 ) / NUM_TABS - 2 ); // (ten: fitted to a short screen)
+	for ( int t = 0; t < NUM_TABS; t++ )
+	{
+		int items[16], n = TabItems( t, items );
+		bool sel = t == g_iTab, hover = Hover( x0, ty, tabsW, tabH );
+		if ( sel || hover )
+			Fill( x0 + 1, ty, tabsW - 1, tabH, sel ? C_SEL : C_HOVER );
+		if ( sel )
+			Fill( x0 + 1, ty, 3, tabH, C_GOLD );
+		char key[4];
+		snprintf( key, sizeof( key ), "%d", ( t + 1 ) % 10 ); // (the tenth: 0)
+		KeyBadge( x0 + 14, ty + ( tabH - lh ) / 2, key, sel && g_iKeyLevel == 0 );
+		Text( x0 + 40, ty + ( tabH - lh ) / 2, g_Tabs[t].title, Alpha( sel ? C_GOLDT : hover ? C_TEXT : C_DIM, fade ));
+		snprintf( key, sizeof( key ), "%d", n );
+		TextRight( x0 + tabsW - 12, ty + ( tabH - lh ) / 2, key, Alpha( C_FAINT, fade ));
+		if ( Clicked( x0, ty, tabsW, tabH ) && t != g_iTab )
+		{
+			g_iTab = t;
+			g_iFocus = -1;
+			g_iKeyLevel = 1;
+		}
+		ty += tabH + 2;
+	}
+
+	// items
+	int items[16], n = TabItems( g_iTab, items );
+	float lx = x0 + tabsW + 1, ly = bodyY + 8, rowH = lh * 2.4f;
+	Text( lx + 14, ly + 2, g_Tabs[g_iTab].menuTitle, Alpha( C_GOLDT, fade ));
+	ly += lh * 1.8f;
+	int hovered = -1;
+	for ( int i = 0; i < n; i++ )
+	{
+		const BuyItem &it = g_Items[items[i]];
+		bool hover = Hover( lx, ly, listW - 1, rowH );
+		bool focus = items[i] == g_iFocus;
+		bool refused = Refused( it ) || Full( it ), afford = !refused && Price( it ) <= money, owned = Owned( it.id ) || Full( it );
+		if ( hover )
+			hovered = items[i];
+		float flash = items[i] == g_iFlashItem ? Clamp01( 1 - ( Now() - g_flFlash ) / 0.5f ) : 0;
+		Fill( lx + 6, ly + 1, listW - 13, rowH - 2, ( hover || focus ) ? C_HOVER : C_ROW );
+		if ( flash > 0 )
+			Fill( lx + 6, ly + 1, listW - 13, rowH - 2, Alpha( g_bFlashBad ? C_RED : C_GREEN, flash * 0.35f ));
+		if ( hover || focus )
+			Fill( lx + 6, ly + 1, 2, rowH - 2, C_GOLD );
+		char key[4];
+		snprintf( key, sizeof( key ), "%d", i + 1 );
+		float cy = ly + ( rowH - lh ) / 2;
+		KeyBadge( lx + 16, cy, key, ( hover || focus ) && g_iKeyLevel == 1 );
+		// (red only for the money; refused for another reason: dimmed, with why in a word)
+		Text( lx + 42, cy, it.name, Alpha( afford ? (( hover || focus ) ? C_GOLDT : C_TEXT ) : refused ? C_DIM : C_FAINT, fade ));
+		snprintf( sz, sizeof( sz ), "$%d", Price( it ));
+		TextRight( lx + listW - 18, cy, sz, Alpha( afford ? C_GREEN : refused ? C_DIM : C_RED, fade ));
+		const char *tag = ( refused || owned ) ? RefusalTag( it ) : 0;
+		if ( tag )
+			TextRight( lx + listW - 26 - TextWidth( sz ), cy, tag, Alpha( !strcmp( tag, "out" ) ? C_GOLD : C_DIM, fade ));
+		if ( hover && g_bClick )
+			Buy( items[i] );
+		ly += rowH + 3;
+	}
+	if ( hovered >= 0 && hovered != g_iHover )
+	{
+		g_iHover = hovered;
+		g_flHoverSince = Now();
+		g_flDragYaw = 0;
+	}
+	int shown = hovered >= 0 ? hovered : g_iFocus >= 0 ? g_iFocus : ( g_iHover >= 0 && g_iHover >= g_Tabs[g_iTab].first && g_iHover < g_Tabs[g_iTab].first + g_Tabs[g_iTab].count ) ? g_iHover : ( n ? items[0] : -1 );
+
+	// the shown item: its model, its figures
+	if ( shown >= 0 )
+	{
+		const BuyItem &it = g_Items[shown];
+		if ( it.model[0] )
+			PreviewAdd( 0, it.model, px + 10, py + 10, pw - 20, ph - 20, it.pose, 0 );
+		else
+			TextCenter( px + pw / 2, py + ph / 2 - lh / 2, "no model to show", Alpha( C_FAINT, fade ));
+		if ( Hover( px, py, pw, ph ))
+			TextRight( px + pw - 10, py + ph - lh - 8, "drag to turn", Alpha( C_FAINT, fade ));
+		float ix = dx + 22, iy = py + ph + 12, iw = dw - 44;
+		Text( ix, iy, it.name, Alpha( C_GOLDT, fade ), 1.45f );
+		snprintf( sz, sizeof( sz ), "$%d", Price( it ));
+		bool refused = Refused( it ) || Full( it ), afford = !refused && Price( it ) <= money;
+		TextRight( ix + iw, iy, sz, Alpha( afford ? C_GREEN : refused ? C_DIM : C_RED, fade ), 1.45f );
+		iy += LineHeight( Scaled( 1.45f ) ? 1.45f : 1 ) + 4;
+		char kind[96];
+		snprintf( kind, sizeof( kind ), "%s%s", it.kind, it.team == ONLY_T ? "  -  Terrorists only" : it.team == ONLY_CT ? "  -  Counter-Terrorists only" : "" );
+		Text( ix, iy, kind, Alpha( C_DIM, fade ));
+		iy += lh * 1.9f;
+		ItemFigures( ix, iy, iw, it );
+	}
+
+	// footer: ammo, close
+	float fy = y0 + H - footH + ( footH - lh * 2.1f ) / 2, bh = lh * 2.1f;
+	float bx = x0 + 14;
+	if ( Button( bx, fy, 190, bh, ",", "Primary ammo", true, C_GOLD ))
+		ClientCmd( "primammo" );
+	bx += 200;
+	if ( Button( bx, fy, 200, bh, ".", "Secondary ammo", true, C_GOLD ))
+		ClientCmd( "secammo" );
+	if ( Button( x0 + W - 14 - 130, fy, 130, bh, "B", "Close", true, C_GOLD ))
+		Close();
+
+	// (the keys, or why a purchase failed: the server's word when it sent one, else what it would say; a centre
+	// message of the server that came while the panel is open)
+	const float noteRight = x0 + W - 14 - 130 - 16, noteLeft = x0 + 14 + 200 + 200 + 14;
+	if ( g_flNote >= 0 && Now() >= g_flNote && Now() - g_flNote < 2.5f && g_szNote[0] )
+	{
+		const float w = min( (float)TextWidth( g_szNote ), noteRight - noteLeft );
+		TextFit( noteRight - w, fy + ( bh - lh ) / 2, g_szNote, noteRight - noteLeft, g_bNoteBad ? C_RED : C_GOLDT );
+	}
+	else if ( g_iFlashItem >= 0 && g_bFlashBad && Now() - g_flFlash < 1.5f )
+		TextRight( noteRight, fy + ( bh - lh ) / 2, RefusalText( g_Items[g_iFlashItem] ), C_RED );
+	else
+	{
+		char hint[80];
+		if ( g_iKeyLevel )
+			snprintf( hint, sizeof( hint ), n > 1 ? "1-%d buy    0 categories    wheel, arrows: category" : "%d buy    0 categories    wheel, arrows: category", min( max( n, 1 ), 9 ));
+		else if ( NUM_TABS >= 10 )
+			snprintf( hint, sizeof( hint ), "1-9, 0 category    wheel, arrows: category" );
+		else
+			snprintf( hint, sizeof( hint ), "1-%d category    wheel, arrows: category", NUM_TABS );
+		TextRight( x0 + W - 14 - 130 - 16, fy + ( bh - lh ) / 2, hint, Alpha( C_FAINT, fade ));
+	}
+
+	// dragging the model turns it
+	if ( g_bMouseDown && ( g_bDragging || Hover( px, py, pw, ph )))
+	{
+		if ( g_bDragging )
+			g_flDragYaw += ( g_cx - g_flDragLastX ) * 0.02f;
+		g_bDragging = true;
+		g_flDragLastX = g_cx;
+	}
+	else
+		g_bDragging = false;
+}
