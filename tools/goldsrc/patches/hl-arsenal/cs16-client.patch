+bool ArsUI_ShowVGUIMenu( int menuType, int bitsValidSlots )
+{
+	switch ( menuType )
+	{
+	case VGUI_TEAM:
+		Open( P_TEAM, bitsValidSlots );
+		return true;
+	case VGUI_CLASS_T:
+	case VGUI_CLASS_CT:
+		Open( P_CLASS, bitsValidSlots );
+		g_iClassTeam = menuType == VGUI_CLASS_CT;
+		return true;
+	case VGUI_BUY:
+	case VGUI_BUY_PISTOL:
+	case VGUI_BUY_SHOTGUN:
+	case VGUI_BUY_RIFLE:
+	case VGUI_BUY_SMG:
+	case VGUI_BUY_MG:
+	case VGUI_BUY_ITEM:
+		if ( g_iPanel != P_BUY )
+			Open( P_BUY, bitsValidSlots );
+		for ( int t = 0; t < NUM_TABS; t++ )
+			if ( g_Tabs[t].vgui == menuType )
+			{
+				g_iTab = t;
+				g_iKeyLevel = 1;
+			}
+		return true;
+	}
+	return false;
+}
