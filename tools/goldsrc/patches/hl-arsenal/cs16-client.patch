+void ArsUI_SetView( const float *origin, const float *angles )
+{
+	VectorCopy( origin, g_vViewOrg );
+	AngleVectors( angles, g_vForward, g_vRight, g_vUp );
+	g_bView = true;
+}
+
+// the tangents of the half field of view, from where the renderer projects two points
+static void Projection( float &tx, float &ty )
+{
+	vec3_t p;
+	float screen[3];
+	tx = ty = 1;
+	VectorMA( g_vViewOrg, 100, g_vForward, p ); VectorMA( p, 100, g_vRight, p );
+	if ( !gEngfuncs.pTriAPI->WorldToScreen( p, screen ) && fabs( screen[0] ) > 0.001f )
+		tx = 1.0f / fabs( screen[0] );
+	VectorMA( g_vViewOrg, 100, g_vForward, p ); VectorMA( p, 100, g_vUp, p );
+	if ( !gEngfuncs.pTriAPI->WorldToScreen( p, screen ) && fabs( screen[1] ) > 0.001f )
+		ty = 1.0f / fabs( screen[1] );
+}
+
+// where a point of the screen (HUD units) is, at a distance in front of the view
+static void ScreenPoint( float sx, float sy, float dist, float tx, float ty, float *out )
+{
+	float nx = sx / ScreenWidth * 2 - 1, ny = 1 - sy / ScreenHeight * 2;
+	for ( int i = 0; i < 3; i++ )
+		out[i] = g_vViewOrg[i] + dist * ( g_vForward[i] + g_vRight[i] * nx * tx + g_vUp[i] * ny * ty );
+}
+
+void ArsUI_CreateEntities( void )
+{
+	if ( !g_bView )
+		return;
+	for ( int i = 0; i < MAX_PREVIEWS; i++ )
+	{
+		Preview &p = g_Previews[i];
+		if ( !p.active || p.failed || g_iPanel == P_NONE )
+			continue;
+		if ( !p.model )
+		{
+			p.model = IEngineStudio.Mod_ForName( p.name, 0 );
+			if ( !p.model || p.model->type != mod_studio )
+			{
+				p.model = NULL;
+				p.failed = true; // (tried once, while its name stays)
+				continue;
+			}
+			p.sequence = PickSequence( (studiohdr_t *)IEngineStudio.Mod_Extradata( p.model ), p.pose );
+		}
+		cl_entity_t *e = &p.ent;
+		memset( e, 0, sizeof( *e ));
+		e->model = p.model;
+		e->curstate.sequence = p.sequence;
+		e->curstate.framerate = 1;
+		e->curstate.animtime = p.t0;
+		e->curstate.rendermode = kRenderNormal;
+		e->curstate.renderamt = 255;
+		e->curstate.movetype = MOVETYPE_NONE;
+		e->latched.prevsequence = p.sequence;
+		float tx, ty;
+		Projection( tx, ty );
+		ScreenPoint( p.x + p.w / 2, p.y + p.h / 2, PREVIEW_DIST, tx, ty, e->origin );
+		VectorCopy( e->origin, e->curstate.origin );
+		gEngfuncs.CL_CreateVisibleEntity( ET_NORMAL, e );
+	}
+}
+
+bool ArsUI_IsPreview( cl_entity_t *ent )
+{
+	return ent >= &g_Previews[0].ent && ent <= &g_Previews[MAX_PREVIEWS - 1].ent;
+}
+
+static Preview *PreviewOf( cl_entity_t *ent )
+{
+	for ( int i = 0; i < MAX_PREVIEWS; i++ )
+		if ( ent == &g_Previews[i].ent )
+			return &g_Previews[i];
+	return NULL;
+}
+
+// the model's frame: its bounding box centered in the rectangle, fitted to it as it turns, the side of a weapon
+// facing the view (world models lie on that side); a player faces it, the top tilted a little toward it
+bool ArsUI_PreviewTransform( cl_entity_t *ent, float m[3][4] )
+{
+	Preview *p = PreviewOf( ent );
+	if ( !p || !g_bView )
+		return false;
+	studiohdr_t *hdr = (studiohdr_t *)IEngineStudio.Mod_Extradata( p->model );
+	vec3_t mins, maxs;
+	mstudioseqdesc_t *seq = (mstudioseqdesc_t *)( (byte *)hdr + hdr->seqindex ) + p->sequence;
+	VectorCopy( seq->bbmin, mins ); VectorCopy( seq->bbmax, maxs );
+	if ( maxs[0] - mins[0] < 0.5f || maxs[2] - mins[2] < 0.5f )
+	{
+		VectorCopy( hdr->bbmin, mins ); VectorCopy( hdr->bbmax, maxs );
+	}
+	if ( maxs[0] - mins[0] < 0.5f || maxs[2] - mins[2] < 0.5f )
+	{
+		VectorCopy( hdr->min, mins ); VectorCopy( hdr->max, maxs );
+	}
+	if ( maxs[0] - mins[0] < 0.5f )
+	{
+		mins[0] = mins[1] = mins[2] = -12;
+		maxs[0] = maxs[1] = maxs[2] = 12;
+	}
+
+	// local axes in the display frame (x: the screen's right, y: away from the view, z: its up)
+	float pose[3][3] = { { 1, 0, 0 }, { 0, 1, 0 }, { 0, 0, 1 } };
+	if ( p->pose == POSE_FLAT )
+	{
+		// (lying weapons: their up toward the view, their left up)
+		pose[0][0] = 1; pose[1][0] = 0; pose[2][0] = 0;
+		pose[0][1] = 0; pose[1][1] = 0; pose[2][1] = 1;
+		pose[0][2] = 0; pose[1][2] = -1; pose[2][2] = 0;
+	}
+	// (models that lie otherwise than the others: turned over along their length, or in the screen's plane, or a
+	// quarter turn to show their face — g_Turns)
+	for ( const Turn &t : g_Turns )
+	{
+		if ( strcmp( t.model, p->name ))
+			continue;
+		const float r = t.roll * M_PI / 180, f = t.over ? M_PI : 0, w = t.yaw * M_PI / 180;
+		// E = Rz(yaw) * Ry(roll) * Rx(over), in the display's axes (x right, y away, z up)
+		const float rx[3][3] = { { 1, 0, 0 }, { 0, cosf( f ), -sinf( f ) }, { 0, sinf( f ), cosf( f ) } };
+		const float ry[3][3] = { { cosf( r ), 0, sinf( r ) }, { 0, 1, 0 }, { -sinf( r ), 0, cosf( r ) } };
+		const float rz[3][3] = { { cosf( w ), -sinf( w ), 0 }, { sinf( w ), cosf( w ), 0 }, { 0, 0, 1 } };
+		float e1[3][3], e[3][3], q[3][3];
+		for ( int i = 0; i < 3; i++ ) for ( int j = 0; j < 3; j++ ) e1[i][j] = ry[i][0] * rx[0][j] + ry[i][1] * rx[1][j] + ry[i][2] * rx[2][j];
+		for ( int i = 0; i < 3; i++ ) for ( int j = 0; j < 3; j++ ) e[i][j] = rz[i][0] * e1[0][j] + rz[i][1] * e1[1][j] + rz[i][2] * e1[2][j];
+		for ( int i = 0; i < 3; i++ ) for ( int j = 0; j < 3; j++ ) q[i][j] = e[i][0] * pose[0][j] + e[i][1] * pose[1][j] + e[i][2] * pose[2][j];
+		memcpy( pose, q, sizeof( q ));
+	}
+	vec3_t center, half;
+	for ( int i = 0; i < 3; i++ )
+	{
+		center[i] = ( mins[i] + maxs[i] ) / 2;
+		half[i] = ( maxs[i] - mins[i] ) / 2;
+	}
+	float ex = 0, ey = 0, ez = 0;
+	for ( int j = 0; j < 3; j++ )
+	{
+		ex += fabs( pose[0][j] ) * half[j];
+		ey += fabs( pose[1][j] ) * half[j];
+		ez += fabs( pose[2][j] ) * half[j];
+	}
+	// (small items shown at a sensible size, not blown up to the frame)
+	ez = max( ez, 4.5f );
+	float radius = max( (float)sqrt( ex * ex + ey * ey ), 7.0f );
+	float tx, ty;
+	Projection( tx, ty );
+	float worldW = p->w / ScreenWidth * 2 * tx * PREVIEW_DIST, worldH = p->h / ScreenHeight * 2 * ty * PREVIEW_DIST;
+	float intro = Clamp01(( Now() - p->t0 ) / 0.25f );
+	intro = 1 - ( 1 - intro ) * ( 1 - intro );
+	float s = min( worldW * 0.94f / ( 2 * radius ), worldH * 0.9f / ( 2 * ez )) * p->zoom * ( 0.86f + 0.14f * intro );
+	// (never deeper than the backdrop: the model stays between it and the view)
+	s = min( s, ( BACKDROP_DIST - PREVIEW_DIST - 0.5f ) / radius );
+	p->scale = s;
+
+	// (a slow sway around the side that faces the view: a close model turned edge-on would leave the frame)
+	float yaw = p->yaw + sin(( Now() - p->t0 ) * 0.8f ) * ( p->pose == POSE_UPRIGHT ? 0.55f : 0.42f ) + g_flDragYaw;
+	if ( p->pose == POSE_UPRIGHT )
+		yaw -= M_PI / 2; // (the front toward the view)
+	float cy = cos( yaw ), sy = sin( yaw );
+	float tilt = ( p->pose == POSE_UPRIGHT ? 5.0f : 9.0f ) * M_PI / 180, ct = cos( tilt ), st = sin( tilt );
+	// display = Tilt * Spin * pose
+	float spin[3][3] = { { cy, -sy, 0 }, { sy, cy, 0 }, { 0, 0, 1 } };
+	float tiltm[3][3] = { { 1, 0, 0 }, { 0, ct, -st }, { 0, st, ct } };
+	float a[3][3], d[3][3];
+	for ( int i = 0; i < 3; i++ )
+		for ( int j = 0; j < 3; j++ )
+			a[i][j] = spin[i][0] * pose[0][j] + spin[i][1] * pose[1][j] + spin[i][2] * pose[2][j];
+	for ( int i = 0; i < 3; i++ )
+		for ( int j = 0; j < 3; j++ )
+			d[i][j] = tiltm[i][0] * a[0][j] + tiltm[i][1] * a[1][j] + tiltm[i][2] * a[2][j];
+	// world = [right forward up] * display * scale
+	vec3_t mid;
+	ScreenPoint( p->x + p->w / 2, p->y + p->h / 2, PREVIEW_DIST, tx, ty, mid );
+	for ( int i = 0; i < 3; i++ )
+	{
+		for ( int j = 0; j < 3; j++ )
+			m[i][j] = ( g_vRight[i] * d[0][j] + g_vForward[i] * d[1][j] + g_vUp[i] * d[2][j] ) * s;
+		m[i][3] = mid[i] - ( m[i][0] * center[0] + m[i][1] * center[1] + m[i][2] * center[2] );
+	}
+	VectorCopy( mid, ent->origin );
+	return true;
+}
+
+// a light of its own: from above the view, on its left
+void ArsUI_PreviewLighting( cl_entity_t *ent, alight_t *lighting )
+{
+	Preview *p = PreviewOf( ent );
+	if ( !p )
+		return;
+	lighting->ambientlight = 78;
+	lighting->shadelight = 168;
+	lighting->color[0] = lighting->color[1] = lighting->color[2] = 1.0f;
+	vec3_t dir;
+	for ( int i = 0; i < 3; i++ )
+		dir[i] = g_vForward[i] * 0.55f - g_vUp[i] * 0.7f + g_vRight[i] * 0.45f;
+	VectorNormalize( dir );
+	// (the bones are scaled: the light turned in their frame would be too)
+	float k = p->scale > 0.0001f ? 1.0f / p->scale : 1.0f;
+	VectorScale( dir, k, lighting->plightvec );
+}
+
+void ArsUI_DrawBackdrops( void )
+{
+	if ( !g_bView || !g_iBackdrops || g_iPanel == P_NONE )
+		return;
+	float tx, ty;
+	Projection( tx, ty );
+	gRenderAPI.GL_SelectTexture( 0 );
+	gRenderAPI.GL_Bind( 0, gHUD.m_WhiteTex );
+	gEngfuncs.pTriAPI->RenderMode( kRenderTransAlpha );
+	gEngfuncs.pTriAPI->CullFace( TRI_NONE );
+	for ( int i = 0; i < g_iBackdrops; i++ )
+	{
+		Backdrop &b = g_Backdrops[i];
+		vec3_t c[4];
+		ScreenPoint( b.x, b.y, BACKDROP_DIST, tx, ty, c[0] );
+		ScreenPoint( b.x, b.y + b.h, BACKDROP_DIST, tx, ty, c[1] );
+		ScreenPoint( b.x + b.w, b.y + b.h, BACKDROP_DIST, tx, ty, c[2] );
+		ScreenPoint( b.x + b.w, b.y, BACKDROP_DIST, tx, ty, c[3] );
+		Color( b.c );
+		gEngfuncs.pTriAPI->Begin( TRI_QUADS );
+		for ( int k = 0; k < 4; k++ )
+		{
+			gEngfuncs.pTriAPI->TexCoord2f( 0, 0 );
+			gEngfuncs.pTriAPI->Vertex3fv( c[k] );
+		}
+		gEngfuncs.pTriAPI->End();
+	}
+	gEngfuncs.pTriAPI->RenderMode( kRenderNormal );
+}
