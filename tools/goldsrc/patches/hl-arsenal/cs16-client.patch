+
+// the blueprint and its checks: the world traced as the player moves
+static int BuildPieceOfName( const char *name )
+{
+	if ( !name || strncmp( name, "models/build/", 13 ))
+		return -1;
+	for ( int i = 0; i < BUILD_PIECES; i++ )
+		if ( !strcmp( name, g_BuildModels[i] ))
+			return i;
+	return -1;
+}
+
+static int BuildPieceOfModel( const model_t *m ) { return m ? BuildPieceOfName( m->name ) : -1; }
+
+static bool g_bBuildTraceOnPiece; static float g_flBuildTracePieceZ; // (the last trace: stopped on a piece or one of its steps)
+
+// What the grid's traces meet — the server's (BUILD_TraceLine): the world, brush entities (a physent with a brush
+// model: SOLID_BSP) and built pieces with their steps (SOLID_BBOX: no model pointer in their physent, their model's
+// name); through anything else (players, Pokemon, C4, satchels, grenades, bolts...). worldOnly: the world and brush
+// entities (doors, func_wall, breakables: a piece may not be built into them either)
+static int BuildIgnorePiecesToo( physent_t *pe ) { return !pe->model && BuildPieceOfName( pe->name ) < 0; }
+static int BuildIgnoreAllButBrushes( physent_t *pe ) { return !pe->model; }
+
+// (Xash3D's event API goes on past the SDK's event_api_t: its first extension, a trace with a filter)
+struct BuildEventApiExt
+{
+	event_api_t sdk;
+	void ( *EV_PlayerTraceExt )( float *start, float *end, int traceFlags, int ( *pfnIgnore )( physent_t *pe ), pmtrace_t *tr );
+};
+
+static float BuildTrace( void *, const float *start, const float *end, int worldOnly, float *endpos, int *startsolid )
+{
+	pmtrace_t tr;
+	const BuildEventApiExt *api = (const BuildEventApiExt *)gEngfuncs.pEventAPI;
+	if ( api->EV_PlayerTraceExt )
+		api->EV_PlayerTraceExt( (float *)start, (float *)end, PM_NORMAL, worldOnly ? BuildIgnoreAllButBrushes : BuildIgnorePiecesToo, &tr );
+	else // (not Xash3D: the old filter — players and Pokemon left out, other boxes not)
+		gEngfuncs.pEventAPI->EV_PlayerTrace( (float *)start, (float *)end, worldOnly ? PM_WORLD_ONLY : PM_STUDIO_IGNORE, -1, &tr );
+	VectorCopy( tr.endpos, endpos );
+	*startsolid = tr.startsolid || tr.allsolid;
+	g_bBuildTraceOnPiece = false;
+	// (the start inside the world, a brush entity or a piece: startsolid — build_grid.h's contract, the server's too)
+	if ( tr.fraction < 1.0f && !*startsolid && !worldOnly && tr.ent > 0 )
+	{
+		// (its steps carry its model and its origin)
+		physent_t *pe = gEngfuncs.pEventAPI->EV_GetPhysent( tr.ent );
+		if ( pe && !pe->model && BuildPieceOfName( pe->name ) >= 0 )
+		{
+			g_bBuildTraceOnPiece = true;
+			g_flBuildTracePieceZ = pe->origin[2];
+		}
+	}
+	return tr.fraction;
+}
+
+static int BuildTracePiece( void *, float *origin_z )
+{
+	if ( !g_bBuildTraceOnPiece )
+		return 0;
+	*origin_z = g_flBuildTracePieceZ;
+	return 1;
+}
+
+// a piece built there already (the pieces in sight: the server's own, their origin and yaw the spot's)
+static bool BuildSlotTaken( const build_spot_t &s, cl_entity_t *local )
+{
+	for ( int i = gEngfuncs.GetMaxClients() + 1; i < 4096; i++ )
+	{
+		cl_entity_t *e = gEngfuncs.GetEntityByIndex( i );
+		if ( !e )
+			break;
+		if ( !e->model || e->curstate.messagenum != local->curstate.messagenum || ( e->curstate.effects & EF_NODRAW ))
+			continue;
+		const int piece = BuildPieceOfModel( e->model );
+		if ( piece != s.piece )
+			continue;
+		int yaw = (int)floorf( e->curstate.angles[1] + 0.5f ) % 360;
+		if ( yaw < 0 ) yaw += 360;
+		if ( build_same_slot( &s, piece, yaw, e->curstate.origin ))
+			return true;
+	}
+	return false;
+}
+
+// a player in the way (the living ones in sight, the local one included)
+static bool BuildPlayerInside( const build_spot_t &s, cl_entity_t *local )
+{
+	const int maxClients = gEngfuncs.GetMaxClients();
+	for ( int i = 1; i <= maxClients; i++ )
+	{
+		cl_entity_t *e = gEngfuncs.GetEntityByIndex( i );
+		if ( !e || !e->player || !e->model )
+			continue;
+		if ( e != local && ( e->curstate.messagenum != local->curstate.messagenum || e->curstate.solid == SOLID_NOT || ( e->curstate.effects & EF_NODRAW )))
+			continue;
+		const bool ducked = e->curstate.usehull == 1;
+		const float *o = e->origin;
+		const float mins[3] = { o[0] - 16, o[1] - 16, o[2] - ( ducked ? 18.0f : 36.0f ) };
+		const float maxs[3] = { o[0] + 16, o[1] + 16, o[2] + ( ducked ? 18.0f : 36.0f ) };
+		if ( build_overlaps_box( &s, mins, maxs ))
+			return true;
+	}
+	return false;
+}
+
+// the view the spot is computed from: the local player's eye and angles (those the server has: no punch, no bob)
+static bool BuildView( float *eye, float *angles, float *feet )
+{
+	cl_entity_t *local = gEngfuncs.GetLocalPlayer();
+	if ( !local )
+		return false;
+	float ofs[3];
+	gEngfuncs.pEventAPI->EV_LocalPlayerViewheight( ofs );
+	VectorAdd( local->origin, ofs, eye );
+	gEngfuncs.GetViewAngles( angles );
+	float mins[3], maxs[3];
+	gEngfuncs.pEventAPI->EV_LocalPlayerBounds( local->curstate.usehull == 1 ? 1 : 0, mins, maxs );
+	*feet = local->origin[2] + mins[2];
+	return true;
+}
+
+static void BuildUpdateSpot( void )
+{
+	g_bBuildSpot = false;
+	cl_entity_t *local = gEngfuncs.GetLocalPlayer();
+	float eye[3], angles[3], feet;
+	if ( !local || !BuildView( eye, angles, &feet ))
+		return;
+	build_engine_t e = { NULL, BuildTrace, BuildTracePiece };
+	gEngfuncs.pEventAPI->EV_SetUpPlayerPrediction( false, true );
+	gEngfuncs.pEventAPI->EV_PushPMStates();
+	gEngfuncs.pEventAPI->EV_SetSolidPlayers( -1 );
+	gEngfuncs.pEventAPI->EV_SetTraceHull( 2 );
+	build_aim( &e, eye, angles, feet, g_iBuildPiece, g_iBuildTurns, &g_BuildSpot );
+	int reason = BUILD_OK;
+	bool slotOnly = false;
+	if ( !g_bBuildEnabled ) reason = BUILD_DISABLED;
+	else if ( !build_in_reach( &g_BuildSpot, eye )) reason = BUILD_TOO_FAR;
+	else
+	{
+		const bool slot = BuildSlotTaken( g_BuildSpot, local );
+		const bool other = BuildPlayerInside( g_BuildSpot, local ) || build_world_blocked( &e, &g_BuildSpot );
+		if ( slot || other ) reason = BUILD_BLOCKED;
+		else if ( g_iBricks < BUILD_COST ) reason = BUILD_NO_BRICKS;
+		slotOnly = slot && !other;
+	}
+	if ( g_pBuildDebug && g_pBuildDebug->value > 0 && Now() >= g_flBuildDebugNext )
+	{
+		g_flBuildDebugNext = Now() + 0.5f;
+		const build_spot_t &s = g_BuildSpot;
+		build_spot_t u = s; u.aimed = 0;
+		gEngfuncs.Con_Printf( "build_debug: piece %d at %.0f %.0f %.0f yaw %d aim %.0f %.0f %.0f eye %.0f %.0f %.0f feet %.0f: reason %d (slot %d player %d world %d reached %d)\n",
+			s.piece, s.origin[0], s.origin[1], s.origin[2], s.yaw, s.aim[0], s.aim[1], s.aim[2], eye[0], eye[1], eye[2], feet, reason,
+			BuildSlotTaken( s, local ), BuildPlayerInside( s, local ), build_world_blocked( &e, &u ), build_reached( &e, &s ));
+	}
+	gEngfuncs.pEventAPI->EV_PopPMStates();
+	g_iBuildReason = reason;
+	g_bBuildSlotOnly = slotOnly;
+	g_bBuildSpot = true;
+}
+
+static bool BuildSameSpot( const build_spot_t &a, const build_spot_t &b )
+{
+	return a.piece == b.piece && a.yaw == b.yaw && a.origin[0] == b.origin[0] && a.origin[1] == b.origin[1] && a.origin[2] == b.origin[2];
+}
+
+// a click: the blueprint's spot asked for; refused at once when the blueprint says why (the server would)
+static void BuildPlace( bool repeat )
+{
+	if ( !g_bBuildSpot )
+		BuildUpdateSpot();
+	if ( !g_bBuildSpot )
+		return;
+	if ( g_iBuildReason != BUILD_OK )
+	{
+		if ( !repeat )
+			BuildDenyLocal( g_iBuildReason );
+		return;
+	}
+	if ( repeat && g_bBuildPlacedOnce && BuildSameSpot( g_BuildSpot, g_BuildLastPlaced ))
+		return;
+	const float now = Now();
+	if ( now - g_flBuildEntered < BUILD_ENTER_DELAY && now >= g_flBuildEntered )
+	{
+		// (just entered: the server would drop it, silently — held until it takes pieces)
+		if ( !repeat )
+			g_bBuildClickQueued = true;
+		return;
+	}
+	g_bBuildClickQueued = false;
+	char cmd[96];
+	snprintf( cmd, sizeof( cmd ), "build_place %d %d %d %d %d %d", g_BuildSpot.piece, (int)g_BuildSpot.origin[0], (int)g_BuildSpot.origin[1], (int)g_BuildSpot.origin[2], g_BuildSpot.yaw, g_iBuildTurns );
+	ClientCmd( cmd );
+	g_BuildLastPlaced = g_BuildSpot;
+	g_bBuildPlacedOnce = true;
+	g_flBuildPlaced = now;
+	g_iBuildBricksAtPlace = g_iBricks;
+	g_bBuildPlaceAnswered = false;
+}
+
+static void BuildChoose( int piece )
+{
+	piece = ( piece % BUILD_PIECES + BUILD_PIECES ) % BUILD_PIECES;
+	if ( piece != g_iBuildPiece )
+		BuildSound( "build/select.wav", 0.6f );
+	g_iBuildPiece = piece;
+	g_bBuildPlacedOnce = false;
+}
+
+// the keys: true when build mode took it (its release then taken too)
+// (a release swallowed only after a press swallowed: ArsUI_Key forgets each key's flag as it is pressed again — a
+// release that never came, in the console or the menu, leaves no stale flag)
+static bool BuildKey( int down, int keynum, const char *b, bool repeat )
+{
+	const bool inRange = keynum >= 0 && keynum < 256;
+	if ( !down )
+	{
+		if ( inRange && g_bBuildSwallowed[keynum] )
+		{
+			g_bBuildSwallowed[keynum] = false;
+			return true;
+		}
+		return false;
+	}
+	bool took = false;
+	if ( !strcmp( b, "impulse 100" ))
+	{
+		// (F: build mode on and off; building off in this game: the flashlight's own)
+		if ( !g_bBuildEnabled && !g_bBuild )
+			return false;
+		if ( !repeat )
+		{
+			if ( !g_bBuild && !BuildCanUse())
+				BuildDenyLocal( BUILD_CANNOT );
+			else
+				BuildSet( !g_bBuild, true );
+		}
+		took = true;
+	}
+	else if ( g_bBuild )
+	{
+		// (a text menu shown — the radio's, an old-style one —: the slot keys are its own)
+		const bool menu = gHUD.m_Menu.m_fMenuDisplayed != 0;
+		if (( keynum == K_MWHEELUP || keynum == K_MWHEELDOWN ) && ( !b[0] || !strcmp( b, "invnext" ) || !strcmp( b, "invprev" )))
+		{
+			// (the wheel, when it chooses weapons — bound to +jump or another action: that one, as ever)
+			BuildChoose( g_iBuildPiece + ( keynum == K_MWHEELUP ? -1 : 1 ));
+			took = true;
+		}
+		else if ( menu && !strncmp( b, "slot", 4 ))
+			took = false;
+		else if ( !strncmp( b, "slot", 4 ) && b[4] >= '1' && b[4] <= '4' && !b[5] )
+		{
+			if ( !repeat )
+				BuildChoose( b[4] - '1' );
+			took = true;
+		}
+		else if ( !strcmp( b, "+reload" ))
+		{
+			if ( !repeat )
+			{
+				g_iBuildTurns = ( g_iBuildTurns + 1 ) & 3;
+				g_bBuildPlacedOnce = false;
+				BuildSound( "build/select.wav", 0.5f );
+			}
+			took = true;
+		}
+		else if ( !strcmp( b, "+attack" ))
+		{
+			// (a piece at once; the key passed on: its +attack and -attack keep in_attack, held fire, BuildThink —
+			// the button never sent to the server in build mode, ArsUI_BuildMasksAttack)
+			if ( !repeat )
+				BuildPlace( false );
+		}
+		else if ( !strcmp( b, "+attack2" ))
+			took = true; // (nothing in build mode: no scope, no second fire)
+		else if ( !strncmp( b, "slot", 4 ) || !strcmp( b, "lastinv" ) || !strcmp( b, "invnext" ) || !strcmp( b, "invprev" ) || !strncmp( b, "weapon_", 7 ) || !strcmp( b, "drop" ))
+			BuildSet( false, true ); // (another weapon asked for: build mode left, the key passed on)
+	}
+	if ( took && inRange )
+		g_bBuildSwallowed[keynum] = true;
+	return took;
+}
+
+// a key pressed: its last press's swallowing forgotten (BuildKey takes the new one, if it does)
+static void BuildKeyPressed( int keynum )
+{
+	if ( keynum >= 0 && keynum < 256 )
+		g_bBuildSwallowed[keynum] = false;
+}
+
+// the game's keys lost — the console, the chat, the engine's menu, the window's focus —: the fire button let go (its
+// release may never come back to the game; in build mode, no piece built behind the player's back)
+static void BuildKeysLost( void )
+{
+	if ( g_bBuild && BuildFireHeld())
+		ClientCmd( "-attack" );
+	g_bBuildClickQueued = false;
+}
+
+// each frame: build mode left when it may not go on; fire held builds on
+static void BuildThink( void )
+{
+	// (the server's build mode, when it disagrees with ours once our toggles are settled: a refusal, a weapon bought
+	// or picked up, as ours was toggled)
+	if ( g_bBuildKnown && g_bBuildServer != g_bBuild && BuildGraceOver( Now()))
+		BuildSet( g_bBuildServer, false );
+	if ( g_bBuild && ( !BuildCanUse() || g_iPanel != P_NONE || !g_bBuildEnabled ))
+		BuildSet( false, true );
+	if ( !g_bBuild )
+	{
+		g_bBuildSpot = false;
+		return;
+	}
+	BuildUpdateSpot();
+	const float now = Now();
+	// (a piece sent neither built nor refused — dropped, sent too soon after another —: it may be sent again)
+	if ( g_bBuildPlacedOnce && !g_bBuildPlaceAnswered && ( now - g_flBuildPlaced >= BUILD_RETRY || now < g_flBuildPlaced ))
+	{
+		g_bBuildPlacedOnce = false;
+		g_bBuildPlaceAnswered = true;
+	}
+	if ( g_bBuildClickQueued && !( now - g_flBuildEntered < BUILD_ENTER_DELAY && now >= g_flBuildEntered ))
+		BuildPlace( false );
+	else if ( BuildFireHeld() && ( now - g_flBuildPlaced >= BUILD_REPEAT || now < g_flBuildPlaced ))
+		BuildPlace( true );
+}
