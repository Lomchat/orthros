+// The price the server asks: the armor only for what is missing
+static int Price( const BuyItem &it )
+{
+	if ( !strcmp( it.cmd, "vesthelm" ) && gHUD.m_Battery.Armor() >= 100 && !gHUD.m_Battery.Helmet())
+		return 350;
+	if ( !strcmp( it.cmd, "vesthelm" ) && gHUD.m_Battery.Helmet() && gHUD.m_Battery.Armor() > 0 && gHUD.m_Battery.Armor() < 100 )
+		return 650;
