diff --git a/cl_dll/arsenal_ui.cpp b/cl_dll/arsenal_ui.cpp
new file mode 100644
index 0000000..1a290b5
--- /dev/null
+++ b/cl_dll/arsenal_ui.cpp
@@ -0,0 +1,4272 @@
+/*
+arsenal_ui.cpp - the Half-Life arsenal's own menus, drawn by the client
+
+The server's team, appearance and buy menus (VGUIMenu messages, the client announcing them with the _ars_ui
+user info) open panels of their own. While one is open the engine shows the mouse's own cursor (the touch
+screen's client-only mode, which frees the mouse as its menus do): a client button over the whole screen gives
+its presses (+ars_click), the engine its position; the keys 1-9 choose too. The hovered weapon, item or player
+model turns in its panel, with its figures; the server's other text menus (radio...) are styled alike.
+
+The models are entities of the frame placed close in front of the view at the panels' places, scaled down and lit
+on their own (the hull keeps walls further away), over backdrops drawn in the world at a slightly larger depth:
+the panels' 2D parts are drawn around them.
+*/
+
+#include "hud.h"
+#include "cl_util.h"
+#include "const.h"
+#include "com_model.h"
+#include "studio.h"
+#include "entity_state.h"
+#include "cl_entity.h"
+#include "entity_types.h"
+#include "triangleapi.h"
+#include "r_studioint.h"
+#include "keydefs.h"
+#include "draw_util.h"
+#include "ammohistory.h"
+#include "weapontype.h"
+#include "arsenal_ui.h"
+#include "studio_util.h"
+#include "parsemsg.h"
+#include "pm_defs.h"
+#include "pmtrace.h"
+#include "event_api.h"
+#include "pm_shared.h"
+#include "kbutton.h"
+#include <string.h>
+#include <stdio.h>
+#include <math.h>
+#include "../3rdparty/ReGameDLL_CS/regamedll/dlls/wpn_shared/build_grid.h" // (Half Strike's building: the server's grid)
+
+extern engine_studio_api_t IEngineStudio;
+extern int g_iMobileAPIVersion;
+
+// (the server's menus: cdll_dll.h)
+enum
+{
+	VGUI_TEAM = 2,
+	VGUI_CLASS_T = 26,
+	VGUI_CLASS_CT,
+	VGUI_BUY,
+	VGUI_BUY_PISTOL,
+	VGUI_BUY_SHOTGUN,
+	VGUI_BUY_RIFLE,
+	VGUI_BUY_SMG,
+	VGUI_BUY_MG,
+	VGUI_BUY_ITEM
+};
+
+// (the Half-Life arsenal's weapon ids, from the server's)
+enum
+{
+	HL_PYTHON = 32, HL_CROSSBOW, HL_RPG, HL_GAUSS, HL_EGON, HL_CROWBAR, HL_GLOCK, HL_MP5, HL_SHOTGUN, HL_HORNETGUN,
+	HL_HANDGRENADE, HL_SATCHEL, HL_TRIPMINE, HL_SNARK,
+	PK_PIKACHU, PK_CHARIZARD, PK_BLASTOISE, // (Half Strike's Poke Balls)
+	LEM_LAPTOP // (Half Strike's laptop: Le M, summoned)
+};
+
+// (Half Strike's building, at the end)
+static void BuildInit( void );
+static void BuildVidInit( void );
+static void BuildNewLevel( void );
+static bool BuildKey( int down, int keynum, const char *b, bool repeat );
+static void BuildThink( void );
+static bool BuildHidesViewModel( void );
+static void BuildCreateGhost( void );
+static bool BuildGhostLighting( struct cl_entity_s *ent, struct alight_s *lighting );
+static void BuildDrawHud( float now, bool intermission );
+static void BuildSpawned( void );
+static int BuildSelectedPiece( void );
+static void BuildKeyPressed( int keynum );
+static void BuildKeysLost( void );
+
+static bool IsBall( int id ) { return id >= PK_PIKACHU && id <= PK_BLASTOISE; }
+// (what brings a companion out — a ball, the laptop: one companion at a time, whichever)
+static bool IsCompanionItem( int id ) { return id >= PK_PIKACHU && id <= LEM_LAPTOP; }
+
+//
+// Look
+//
+struct Col { unsigned char r, g, b, a; };
+static const Col C_PANEL   = { 15, 16, 21, 238 };
+static const Col C_PANEL2  = { 24, 26, 33, 238 };
+static const Col C_ROW     = { 255, 255, 255, 10 };
+static const Col C_HOVER   = { 201, 165, 90, 46 };
+static const Col C_SEL     = { 201, 165, 90, 78 };
+static const Col C_LINE    = { 201, 165, 90, 80 };
+static const Col C_SOFT    = { 255, 255, 255, 26 };
+static const Col C_GOLD    = { 201, 165, 90, 255 };
+static const Col C_GOLDT   = { 236, 205, 138, 255 };
+static const Col C_TEXT    = { 226, 229, 236, 255 };
+static const Col C_DIM     = { 132, 137, 150, 255 };
+static const Col C_FAINT   = { 86, 90, 102, 255 };
+static const Col C_RED     = { 232, 96, 84, 255 };
+static const Col C_GREEN   = { 124, 214, 128, 255 };
+static const Col C_TCOL    = { 226, 128, 76, 255 };
+static const Col C_CTCOL   = { 104, 160, 236, 255 };
+static const Col C_BAR     = { 255, 255, 255, 22 };
+static const Col C_SHADE   = { 6, 7, 10, 150 };
+static const Col C_WHITE   = { 255, 250, 238, 255 };
+static const Col C_EDGE    = { 255, 255, 255, 60 };
+
+static Col Alpha( Col c, float f ) { c.a = (unsigned char)( c.a * ( f < 0 ? 0 : f > 1 ? 1 : f )); return c; }
+static Col Mix( Col a, Col b, float t ) { Col c = { (unsigned char)( a.r + ( b.r - a.r ) * t ), (unsigned char)( a.g + ( b.g - a.g ) * t ), (unsigned char)( a.b + ( b.b - a.b ) * t ), (unsigned char)( a.a + ( b.a - a.a ) * t ) }; return c; }
+static float Clamp01( float f ) { return f < 0 ? 0 : f > 1 ? 1 : f; }
+
+//
+// Languages: the ars_lang cvar (en, the default, or fr — the page sets it from the language the player chose; in the
+// user info, the server's messages follow it too). Every text of the mod is a pair, chosen as it is drawn: a change
+// shows at the next frame. (fr null: the same in both — a weapon's name)
+//
+static cvar_t *g_pLang;
+static bool French( void ) { return g_pLang && g_pLang->string && !strcmp( g_pLang->string, "fr" ); } // (exactly: the server's test)
+
+struct Str { const char *en, *fr; };
+#define TR( en, fr ) { en, fr }
+#define SAME( s ) { s, NULL }
+
+static const char *L( const char *en, const char *fr ) { return French() && fr ? fr : en; }
+static const char *L( const Str &s ) { return L( s.en, s.fr ); }
+
+//
+// The catalog: Counter-Strike's figures from its server sources (weapons.h, weapontype.cpp, player.cpp's armor
+// ratios), the Half-Life arsenal's from hl_weapons.h; a cycle is the time between two shots
+//
+enum { ANY = 0, ONLY_T = 1, ONLY_CT = 2 };
+enum { POSE_FLAT, POSE_UPRIGHT };
+
+struct BuyItem
+{
+	const char *cmd; Str name, kind; const char *model;
+	int id, price, team, pose;
+	float damage; int pellets; float cycle; int clip, reserve; float speed, armor, range;
+	Str note;
+	int health; // (a Pokemon's: its figures are a creature's, its preview its own model)
+};
+
+#define GUN( cmd, name, kind, model, id, price, team, dmg, pel, cyc, clip, res, spd, arm, rng, note ) \
+	{ cmd, name, kind, "models/" model ".mdl", id, price, team, POSE_FLAT, dmg, pel, cyc, clip, res, spd, arm, rng, note }
+#define ITEM( cmd, name, kind, model, id, price, team, note ) \
+	{ cmd, name, kind, model, id, price, team, POSE_FLAT, 0, 0, 0, 0, 0, 0, 0, 0, note }
+// (a Poke Ball: the Pokemon standing, its figures — damage a hit, `ticks` hits an attack, an attack every `cyc` seconds,
+// its range in units, its speed)
+#define POKE( cmd, name, kind, model, id, price, health, dmg, ticks, cyc, rng, spd, note ) \
+	{ cmd, name, kind, "models/pokemon/" model ".mdl", id, price, ANY, POSE_UPRIGHT, dmg, ticks, cyc, 0, 0, spd, 0, rng, note, health }
+// (another companion: the same figures, its model elsewhere)
+#define OTHER( cmd, name, kind, model, id, price, health, dmg, ticks, cyc, rng, spd, note ) \
+	{ cmd, name, kind, "models/others/" model ".mdl", id, price, ANY, POSE_UPRIGHT, dmg, ticks, cyc, 0, 0, spd, 0, rng, note, health }
+
+static const BuyItem g_Items[] =
+{
+	// pistols
+	GUN( "glock", SAME( "Glock 18" ), TR( "Pistol  -  9mm", "Pistolet  -  9 mm" ), "w_glock18", WEAPON_GLOCK18, 400, ANY, 25, 1, 0.15f, 20, 120, 250, 1.05f, 0.75f,
