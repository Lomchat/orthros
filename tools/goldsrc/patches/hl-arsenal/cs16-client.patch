+// the appearance panel: the side's looks, turning
+static void DrawClass( void )
+{
+	float fade = Fade();
+	float sw = ScreenWidth, sh = ScreenHeight;
+	int team = g_iClassTeam, lh = LineHeight();
+	Title( sh * 0.06f, "CHOOSE YOUR LOOK", team ? "Counter-Terrorists" : "Terrorists", fade );
+	Col accent = team ? C_CTCOL : C_TCOL;
+	// (two rows: Counter-Strike's looks, Half-Life's; keys 1 to 9, 0 at random)
+	const int counts[2] = { CS_LOOKS, NUM_LOOKS - CS_LOOKS };
+	const char *rowNames[2] = { "Counter-Strike", "Half-Life" };
+	float gap = 12, labelH = lh * 1.6f, bh = lh * 2.2f;
+	float top = sh * 0.06f + LineHeight( Scaled( 2.0f ) ? 2.0f : 1.0f ) + lh * 2.6f;
+	float ch = min( 300.0f, ( sh - top - labelH * 2 - gap - bh - 40 ) / 2 ), cw = min( 190.0f, ( sw - 60 - gap * 4 ) / 5 );
+	float xs[2][5], ys[2];
+	for ( int r = 0; r < 2; r++ )
+	{
+		ys[r] = top + labelH + r * ( ch + gap + labelH );
+		float x0 = sw / 2 - ( counts[r] * cw + ( counts[r] - 1 ) * gap ) / 2;
+		for ( int i = 0; i < counts[r]; i++ ) xs[r][i] = x0 + i * ( cw + gap );
+	}
+	ShadeAroundRows( xs[0], counts[0], cw, ys[0], ch, xs[1], counts[1], cw, ys[1], ch, Alpha( C_SHADE, fade ));
+	int index = 0;
+	for ( int r = 0; r < 2; r++ )
+	{
+		Text( xs[r][0], ys[r] - labelH + lh * 0.25f, rowNames[r], Alpha( C_DIM, fade ));
+		for ( int i = 0; i < counts[r]; i++, index++ )
+		{
+			const Look &l = g_Looks[team][index];
+			char model[64], key[4];
+			snprintf( model, sizeof( model ), "models/player/%s/%s.mdl", l.model, l.model );
+			snprintf( key, sizeof( key ), "%d", index + 1 );
+			if ( Card( index, xs[r][i], ys[r], cw, ch, model, POSE_UPRIGHT, key, l.name, l.note, NULL, accent, Allowed( index + 1 ), fade ))
+			{
+				Command( "joinclass %d", index + 1 );
+				Close();
+				return;
+			}
+		}
+	}
+	float bw = 230;
+	if ( Button( sw / 2 - bw / 2, ys[1] + ch + 16, bw, bh, "0", "Auto-select", Allowed( 10 ), C_GOLD ))
+	{
+		Command( "joinclass %d", 10 );
+		Close();
+	}
+}
