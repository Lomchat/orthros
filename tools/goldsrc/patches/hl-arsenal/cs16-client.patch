+	DrawCenterMessage();
+	FlushShapes();
+	FlushTexts();
+	g_bClick = false;
+
+	// (a panel closed by a click of this frame: nothing of it in the next one)
+	if ( g_iPanel == P_NONE )
+	{
+		memset( g_bPreviewUsed, 0, sizeof( g_bPreviewUsed ));
+		g_iBackdropsNext = 0;
+	}
