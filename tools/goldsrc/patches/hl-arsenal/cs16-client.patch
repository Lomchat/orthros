+static bool Full( const BuyItem &it )
+{
+	const int armor = gHUD.m_Battery.Armor();
+	const bool helmet = gHUD.m_Battery.Helmet() && armor > 0;
+	return ( !strcmp( it.cmd, "vest" ) && armor >= 100 ) || ( !strcmp( it.cmd, "vesthelm" ) && armor >= 100 && helmet );
