+//
+// Half Strike's building (Fortnite-like): F (the flashlight's "impulse 100") toggles build mode — the weapon put away,
+// a build bar at the bottom (wall, floor, stairs, roof: the wheel or 1-4 choose, R turns the piece), a blueprint of
+// the piece where it would go (blue: it may be built; red: blocked, too far, not enough bricks), a click builds
+// (build_place, the spot the blueprint shows: the server checks it again with the same code, build_grid.h). The
+// server's messages: Bricks (the count, the bricks just picked up), BuildMode (build mode on, building allowed),
+// BuildDeny (why a piece was refused).
+//
+static const char *const g_BuildModels[BUILD_PIECES] = { "models/build/wall.mdl", "models/build/floor.mdl", "models/build/ramp.mdl", "models/build/roof.mdl" };
+static const Str g_BuildNames[BUILD_PIECES] = { TR( "Wall", "Mur" ), TR( "Floor", "Sol" ), TR( "Stairs", "Escalier" ), TR( "Roof", "Toit" ) };
+#define BUILD_HUD_SPRITE "sprites/build/hud.spr" // (one frame, 512 x 64, grey on black: the icons' rectangles below)
+#define BUILD_ICON_BRICK 4
+#define BUILD_ICON_BRICK_SMALL 5
+static const struct { float x, y, w, h; } g_BuildIconRects[] = { { 0, 0, 64, 64 }, { 64, 0, 64, 64 }, { 128, 0, 64, 64 }, { 192, 0, 64, 64 },
+	{ 256, 0, 48, 48 }, { 304, 0, 24, 24 } }; // (wall, floor, stairs, roof, brick, small brick)
+#define BUILD_ATLAS_W 512.0f
+#define BUILD_ATLAS_H 64.0f
+#define BUILD_REPEAT 0.16f   // (fire held: another piece where the blueprint moved, at most that often — the server
+                             // drops, silently, a player's pieces closer than BUILD_PLACE_DELAY 0.12 s: a margin for jitter)
+#define BUILD_ENTER_DELAY 0.25f // (the server takes no piece for 0.2 s after entering build mode: a click before, held)
+#define BUILD_RETRY 0.5f     // (a piece sent, neither built — no bricks spent — nor refused after that long: sent again)
+#define BUILD_SERVER_GRACE 1.0f // (after a toggle of ours, the server's other word waits that long: it may be older)
+#define MAX_BRICK_POPUPS 4
+
+static const Col C_BRICK  = { 196, 96, 64, 255 };
