+static bool BuildGraceOver( float now ) { return now - g_flBuildToggled > BUILD_SERVER_GRACE || now < g_flBuildToggled; }
+
+static void BuildSet( bool on, bool tell )
+{
+	if ( on == g_bBuild )
+		return;
+	g_bBuild = on;
+	g_bBuildPlacedOnce = false;
+	g_bBuildClickQueued = false;
+	if ( tell )
+	{
+		g_flBuildToggled = Now();
+		if ( on )
+			g_flBuildEntered = g_flBuildToggled;
+		ClientCmd( on ? "build_mode 1" : "build_mode 0" );
+	}
+	// (a button held as it opens: its action stopped — its release passes; as it closes: a click of building does not
+	// go on as the weapon's fire)
+	ClientCmd( on ? "-attack\n-attack2\n-reload" : "-attack" );
+	if ( tell )
+		BuildSound( "build/toggle.wav", 0.6f );
+}
