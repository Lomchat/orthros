+struct Pokemon
+{
+	int ent; // (0: a free slot)
+	int species, team, owner;
+	float hp;              // (the server's, 0 to 1)
+	float shown, trail;    // (the bar, eased; the health just lost, fading behind it)
+	float lastHit, born, gone; // (gone: since its 0 came, the bar fading out; -1 alive)
+	float vis, nextTrace; bool clear; // (seen from the view: the last traces, eased)
+	float stale; // (a HUD reset's time, until the server sends it again: -1 confirmed)
+	float boneTop, boneTime; int boneSeq; // (its highest bone over its origin and its sequence, when last drawn: ArsUI_StudioBones)
+	float topGap; // (its model's top over its highest bone, standing: from its idle sequence's box; 0 not seen yet)
+	float barTop; // (the bar's height over its origin, eased: 0 not placed yet)
+};
