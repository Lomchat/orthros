+void ArsUI_Draw( float flTime )
+{
+	// (what was drawn this frame is what the next one renders)
+	for ( int i = 0; i < MAX_PREVIEWS; i++ )
+		g_bPreviewUsed[i] = false;
+	g_iBackdropsNext = 0;
+
+	// (dead: the death camera, not the shop)
+	if ( g_iPanel == P_BUY && ( gHUD.m_Health.m_iHealth <= 0 || g_iUser1 || LocalTeam() == 0 ))
+		Close();
+	if ( g_iPanel != P_NONE && !g_bTouch && !g_bSuspended )
+		Mouse( true );
+
+	if ( g_iPanel != P_NONE )
+	{
+		int mx = 0, my = 0;
+		gEngfuncs.GetMousePosition( &mx, &my );
+		g_cx = mx / gHUD.m_flScale;
+		g_cy = my / gHUD.m_flScale;
+	}
+
+	switch ( g_iPanel )
+	{
+	case P_TEAM: DrawTeam(); break;
+	case P_CLASS: DrawClass(); break;
+	case P_BUY: DrawBuy(); break;
+	}
+	FlushShapes();
+	FlushTexts();
+	g_bClick = false;
+
+	// (a panel closed by a click of this frame: nothing of it in the next one)
+	if ( g_iPanel == P_NONE )
+	{
+		memset( g_bPreviewUsed, 0, sizeof( g_bPreviewUsed ));
+		g_iBackdropsNext = 0;
+	}
+	for ( int i = 0; i < MAX_PREVIEWS; i++ )
+	{
+		g_Previews[i].active = g_bPreviewUsed[i];
+		if ( !g_bPreviewUsed[i] )
+			g_Previews[i].name[0] = 0;
+	}
+	memcpy( g_Backdrops, g_BackdropsNext, sizeof( g_Backdrops ));
+	g_iBackdrops = g_iBackdropsNext;
+}
+
+// the server's text menus: a panel on the left, its title in gold, its keys as badges
+bool ArsUI_DrawTextMenu( const char *pszMenu )
+{
+	if ( g_iPanel != P_NONE )
+		return true;
+	char lines[24][128];
+	int n = 0;
+	for ( const char *p = pszMenu; *p && n < 24; )
+	{
+		int len = 0;
+		while ( p[len] && p[len] != '\n' )
+			len++;
+		int copy = min( len, 127 );
+		memcpy( lines[n], p, copy );
+		lines[n][copy] = 0;
+		n++;
+		p += len;
+		if ( *p == '\n' )
+			p++;
+	}
+	while ( n > 0 && !lines[n - 1][0] )
+		n--;
+	if ( !n )
+		return true;
+	int lh = LineHeight(), rowH = (int)( lh * 1.55f );
+	float w = 0;
+	for ( int i = 0; i < n; i++ )
+		w = max( w, (float)TextWidth( lines[i] ));
+	w = max( w + 70, 240.0f );
+	float h = n * rowH + 24;
+	float x = 18, y = ScreenHeight / 2 - h / 2 - 30;
+	Fill( x, y, w, h, Alpha( C_PANEL, 0.86f ));
+	Fill( x, y, 3, h, C_GOLD );
+	Frame( x, y, w, h, C_SOFT );
+	float ty = y + 12;
+	for ( int i = 0; i < n; i++ )
+	{
+		const char *s = lines[i];
+		Col c = i == 0 ? C_GOLDT : C_TEXT;
+		// (codes of a whole line: \y title, \w normal, \d disabled, \r red)
+		while ( s[0] == '\\' && s[1] )
+		{
+			if ( s[1] == 'y' ) c = C_GOLDT;
+			else if ( s[1] == 'w' ) c = C_TEXT;
+			else if ( s[1] == 'd' ) c = C_FAINT;
+			else if ( s[1] == 'r' ) c = C_RED;
+			else break;
+			s += 2;
+		}
+		if ( s[0] >= '0' && s[0] <= '9' && s[1] == '.' )
+		{
+			char key[2] = { s[0], 0 };
+			KeyBadge( x + 14, ty + ( rowH - lh ) / 2, key, false );
+			s += 2;
+			while ( *s == ' ' )
+				s++;
+			TextClip( x + 40, ty + ( rowH - lh ) / 2, x + w - 10, s, c );
+		}
+		else if ( s[0] )
+			TextClip( x + 14, ty + ( rowH - lh ) / 2, x + w - 10, s, c );
+		if ( i == 0 && n > 1 )
+			Fill( x + 14, ty + rowH - 2, w - 28, 1, C_LINE );
+		ty += rowH;
+	}
+	FlushShapes();
+	FlushTexts();
+	return true;
+}
