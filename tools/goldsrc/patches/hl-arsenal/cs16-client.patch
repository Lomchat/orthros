+
+#define MAX_POKEMON 64
+
+struct Pokemon
+{
+	int ent; // (0: a free slot)
+	int species, team, owner;
+	float hp;              // (the server's, 0 to 1)
+	float shown, trail;    // (the bar, eased; the health just lost, fading behind it)
+	float lastHit, born, gone; // (gone: since its 0 came, the bar fading out; -1 alive)
+	float vis, nextTrace; bool clear; // (seen from the view: the last traces, eased)
+	float stale; // (a HUD reset's time, until the server sends it again: -1 confirmed)
+	float boneTop, boneTime; int boneSeq; // (its highest bone over its origin and its sequence, when last drawn: ArsUI_StudioBones)
+	float topGap; // (its model's top over its highest bone, standing: from its idle sequence's box; 0 not seen yet)
+	float barTop; // (the bar's height over its origin, eased: 0 not placed yet)
+};
+
+static Pokemon g_Pokemon[MAX_POKEMON];
+static char g_szPokemonLevel[64]; // (the level the table is for: another one, or none, empties it)
+static float g_flBallThrown = -1; // (the local player's ball thrown, not opened yet: its time, -1 none)
+static int g_iBallThrown, g_iBallHeld; // (its weapon id; the ball last seen in hand)
+static float g_flBallHeld = -1;
+// (Le M's Hack on the local player: its screen scrambled from g_flHackStart, -1 none — ArsUI_DrawHackScramble)
+static float g_flHackStart = -1, g_flHackLength, g_flHackStrength;
+static int g_iHackWatched; // (the player watched through its eyes when it came — a spectator's —, 0 the local one's own)
+static int LemHack_Msg( const char *pszName, int iSize, void *pbuf );
+
+// The table kept across the client's VidInits (a window resize is one): emptied when the level changes or the
+// connection ends; after a HUD reset (each spawn, each connection) the server sends its live Pokemon again, so those
+// it does not confirm within a second are dropped (a reconnection to the same map, one missed while away)
+static void PokemonPurge( void )
+{
+	const float now = gEngfuncs.GetClientTime();
+	const char *level = gEngfuncs.pfnGetLevelName();
+	if ( !level )
+		level = "";
+	if ( strncmp( level, g_szPokemonLevel, sizeof( g_szPokemonLevel ) - 1 ))
+	{
+		memset( g_Pokemon, 0, sizeof( g_Pokemon ));
+		snprintf( g_szPokemonLevel, sizeof( g_szPokemonLevel ), "%s", level );
+		g_flBallThrown = g_flBallHeld = -1;
+	}
+	for ( int i = 0; i < MAX_POKEMON; i++ )
+	{
+		Pokemon &p = g_Pokemon[i];
+		if ( p.ent && p.stale >= 0 && ( now - p.stale > 1.0f || now < p.stale ))
+			p.ent = 0;
+	}
+	if ( g_flBallThrown >= 0 && ( now - g_flBallThrown > 3.0f || now < g_flBallThrown ))
+		g_flBallThrown = -1; // (it opened, or came back: what the server says rules again)
+}
+
+static Pokemon *PokemonSlot( int ent, bool create )
+{
+	Pokemon *free = NULL;
+	for ( int i = 0; i < MAX_POKEMON; i++ )
+	{
+		if ( g_Pokemon[i].ent == ent )
+			return &g_Pokemon[i];
+		if ( !g_Pokemon[i].ent && !free )
+			free = &g_Pokemon[i];
+	}
+	if ( !create )
+		return NULL;
+	if ( !free ) // (full: the one fading out the longest)
+	{
+		for ( int i = 0; i < MAX_POKEMON; i++ )
+			if ( g_Pokemon[i].gone >= 0 && ( !free || g_Pokemon[i].gone < free->gone ))
+				free = &g_Pokemon[i];
+		if ( !free )
+			return NULL;
+	}
+	memset( free, 0, sizeof( *free ));
+	free->ent = ent;
+	free->gone = free->stale = -1;
+	return free;
+}
+
+static int PokeHP_Msg( const char *pszName, int iSize, void *pbuf )
+{
+	BufferReader reader( pszName, pbuf, iSize );
+	int lo = reader.ReadByte(), hi = reader.ReadByte();
+	int ent = lo | ( hi << 8 );
+	int hp = reader.ReadByte(), species = reader.ReadByte(), team = reader.ReadByte(), owner = reader.ReadByte();
+	if ( ent <= 0 )
+		return 1;
+	PokemonPurge();
+	float now = gEngfuncs.GetClientTime();
+	Pokemon *p = PokemonSlot( ent, hp > 0 );
+	if ( !p )
+		return 1;
+	if ( hp <= 0 )
+	{
+		if ( p->gone < 0 )
+		{
+			p->hp = 0;
+			p->gone = now;
+			p->lastHit = now;
+		}
+		return 1;
+	}
+	bool fresh = p->gone >= 0 || !p->born || p->born > now || p->species != min( species, NUM_SPECIES - 1 ) ||
+		p->owner != owner;
+	if ( fresh ) // (a new one, maybe in a slot just freed by the server; or the clock went back)
+	{
+		memset( p, 0, sizeof( *p ));
+		p->ent = ent;
+		p->gone = p->stale = -1;
+		p->born = now;
+		p->shown = p->trail = min( hp, 100 ) / 100.0f;
+		p->nextTrace = 0;
+	}
+	float v = min( hp, 100 ) / 100.0f;
+	if ( v < p->hp )
+		p->lastHit = now;
+	p->hp = v;
+	if ( p->trail < v )
+		p->trail = v;
+	p->species = min( species, NUM_SPECIES - 1 );
+	p->team = team;
+	p->owner = owner;
+	p->stale = -1;
+	if ( gEngfuncs.GetLocalPlayer() && owner == gEngfuncs.GetLocalPlayer()->index )
+		g_flBallThrown = -1; // (the ball thrown has opened: this is its Pokemon)
+	return 1;
+}
+
+static int LocalIndex( void )
+{
+	cl_entity_t *me = gEngfuncs.GetLocalPlayer();
+	return me ? me->index : 0;
+}
+
+// the local player's Pokemon out (its species), -1 none; a ball thrown and not opened yet counts (the server's rule:
+// one Pokemon out, its ball in flight included)
+static int PokemonOut( void )
+{
+	PokemonPurge();
+	int me = LocalIndex();
+	for ( int i = 0; i < MAX_POKEMON; i++ )
+		if ( g_Pokemon[i].ent && g_Pokemon[i].gone < 0 && g_Pokemon[i].stale < 0 && g_Pokemon[i].owner == me )
+			return g_Pokemon[i].species;
+	if ( g_flBallThrown >= 0 )
+		return ItemSpecies( g_iBallThrown );
+	return -1;
+}
+
+// The local player's weapons changed (HLWeapons, bit 0 for id 32): a ball gone from the hand that held it was thrown,
+// the laptop gone from it has typed Le M out
+void ArsUI_WeaponBits( int oldBits, int newBits )
+{
+	const float now = Now();
+	int balls = 0;
+	for ( int id = PK_PIKACHU; id <= LEM_LAPTOP; id++ )
+	{
+		const int bit = 1 << ( id - 32 );
+		balls |= newBits & bit;
+		const bool held = gHUD.m_Ammo.CurrentWeaponId() == id ||
+			( g_iBallHeld == id && g_flBallHeld >= 0 && now - g_flBallHeld < 1.0f && now >= g_flBallHeld );
+		if (( oldBits & bit ) && !( newBits & bit ) && held && gHUD.m_Health.m_iHealth > 0 )
+		{
+			g_flBallThrown = now;
+			g_iBallThrown = id;
+		}
+	}
+	if ( balls )
+		g_flBallThrown = -1; // (a ball carried again: it came back, no room to come out)
+	// (the laptop goes 0.5 s after Le M came — his PokeHP before it —: the one out already said so)
+	if ( g_flBallThrown >= 0 )
+	{
+		const int me = LocalIndex();
+		for ( int i = 0; i < MAX_POKEMON; i++ )
+			if ( g_Pokemon[i].ent && g_Pokemon[i].gone < 0 && g_Pokemon[i].stale < 0 && g_Pokemon[i].owner == me )
+				g_flBallThrown = -1;
+	}
+}
