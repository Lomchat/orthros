+extern void IN_ReleaseMouseButtons( void );
+
+static void Mouse( bool on )
+{
+	if ( on == g_bTouch || !g_iMobileAPIVersion )
+		return;
+	g_bTouch = on;
+	g_bInMouse = true;
+	if ( on )
+	{
+		// (a button held as the panel opens: its release would go to the panel, its action stay on, +attack firing)
+		IN_ReleaseMouseButtons();
+		static byte none[4] = { 0, 0, 0, 0 };
+		gMobileAPI.pfnTouchAddClientButton( "_ars_click", "*white", "+ars_click", 0, 0, 1, 1, none, 0, 1.0f, 0 );
+		gMobileAPI.pfnTouchSetClientOnly( 1 );
+	}
+	else
+	{
+		gMobileAPI.pfnTouchRemoveButton( "_ars_click" );
+		gMobileAPI.pfnTouchSetClientOnly( 0 );
+	}
+	g_bInMouse = false;
+}
+
+static void Open( int panel, int bits )
+{
+	Mouse( true );
+	if ( g_iPanel != panel )
+		g_flOpened = Now();
+	g_iPanel = panel;
+	g_iBits = bits;
+	g_iHover = g_iFocus = -1;
+	g_iKeyLevel = 0;
+	g_bClick = g_bMouseDown = g_bDragging = false;
+	g_flDragYaw = 0;
+	gHUD.m_Menu.m_fMenuDisplayed = 0;
+	gHUD.m_Menu.m_iFlags &= ~HUD_DRAW;
+}
+
+static void Close( void )
+{
+	Mouse( false );
+	g_bSuspended = false;
+	g_iPanel = P_NONE;
+	g_bClick = g_bMouseDown = g_bDragging = false;
+}
+
+static bool Allowed( int key ) { return !!( g_iBits & ( 1 << ( key - 1 ))); }
+
+static void Command( const char *fmt, int arg )
+{
+	char buf[64];
+	snprintf( buf, sizeof( buf ), fmt, arg );
+	ClientCmd( buf );
+}
+
+static int TeamCount( int team )
+{
+	int n = 0;
+	gHUD.m_Scoreboard.GetAllPlayersInfo();
+	for ( int i = 1; i <= MAX_PLAYERS; i++ )
+		if ( g_PlayerInfoList[i].name && g_PlayerInfoList[i].name[0] && g_PlayerExtraInfo[i].teamnumber == team )
+			n++;
+	return n;
+}
+
+static float Fade( void ) { return Clamp01(( Now() - g_flOpened ) / 0.15f ); }
+
+static void Title( float y, const char *title, const char *subtitle, float fade )
+{
+	float cx = ScreenWidth / 2;
+	TextCenter( cx, y, title, Alpha( C_GOLDT, fade ), 2.0f );
+	float ty = y + LineHeight( Scaled( 2.0f ) ? 2.0f : 1.0f ) + 8;
+	GradH( cx - 160, ty, 160, 1, Alpha( C_GOLD, 0 ), Alpha( C_GOLD, fade * 0.8f ));
+	GradH( cx, ty, 160, 1, Alpha( C_GOLD, fade * 0.8f ), Alpha( C_GOLD, 0 ));
+	if ( subtitle )
+		TextCenter( cx, ty + 10, subtitle, Alpha( C_DIM, fade ));
+}
+
+// a card: a model turning over its backdrop, its name under it; returns whether it was clicked
+static bool Card( int slot, float x, float y, float w, float h, const char *model, int pose, const char *key, const char *name,
+	const char *line1, const char *line2, Col accent, bool enabled, float fade )
+{
+	bool hover = enabled && Hover( x, y, w, h );
+	int lh = LineHeight();
+	float infoH = lh * ( line2 ? 4.6f : 3.4f );
+	float hx = x + 1, hy = y + 1, hw = w - 2, hh = h - infoH - 1;
+	Col back = hover ? Mix( C_PANEL, accent, 0.10f ) : C_PANEL;
+	BackdropAdd( hx, hy, hw, hh, Alpha( back, fade * 0.92f ));
+	Grad( hx, hy + hh * 0.55f, hw, hh * 0.45f, Alpha( accent, 0 ), Alpha( accent, ( hover ? 0.20f : 0.08f ) * fade )); // (the floor's glow)
+	if ( model )
+		PreviewAdd( slot, model, hx + 6, hy + 8, hw - 12, hh - 14, pose, 0, hover ? 1.04f : 0.97f );
+	Fill( x, y + h - infoH, w, infoH, Alpha( hover ? C_PANEL2 : C_PANEL, fade ));
+	Fill( x, y + h - infoH, w, 2, Alpha( accent, ( hover ? 1.0f : 0.55f ) * fade ));
+	Frame( x, y, w, h, Alpha( hover ? accent : C_SOFT, fade ));
+	float ty = y + h - infoH + lh * 0.55f;
+	if ( key )
+		KeyBadge( x + 12, ty, key, hover );
+	Text( x + ( key ? 22 + TextWidth( key ) : 12 ), ty, name, Alpha( enabled ? ( hover ? C_GOLDT : C_TEXT ) : C_FAINT, fade ));
+	if ( line1 )
+		TextFit( x + 12, ty + lh * 1.3f, line1, w - 24, Alpha( C_DIM, fade ));
+	if ( line2 )
+		TextFit( x + 12, ty + lh * 2.4f, line2, w - 24, Alpha( C_FAINT, fade ));
+	return enabled && Clicked( x, y, w, h );
+}
