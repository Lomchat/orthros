+static void NumberKey( int key )
+{
+	if ( g_iPanel == P_TEAM )
+	{
+		if ( key == 10 && Allowed( 10 ))
+			Close();
+		else if ( key >= 1 && key <= 6 && key != 4 && Allowed( key ))
+		{
+			Command( "jointeam %d", key );
+			Close();
+		}
+	}
+	else if ( g_iPanel == P_CLASS )
+	{
+		if ( Allowed( key ))
+		{
+			Command( "joinclass %d", key ); // (0: 10, a look at random)
+			Close();
+		}
+	}
+	else if ( g_iPanel == P_BUY )
+	{
+		// (0: back to the categories from the items; among the categories, the tenth — B, Esc, a right click close)
+		if ( key == 10 && g_iKeyLevel == 1 )
+		{
+			g_iKeyLevel = 0;
+			return;
+		}
+		if ( key == 10 && NUM_TABS < 10 )
+		{
+			Close();
+			return;
+		}
+		if ( g_iKeyLevel == 0 )
+		{
+			if ( key <= NUM_TABS )
+			{
+				g_iTab = key - 1;
+				g_iKeyLevel = 1;
+				g_iFocus = -1;
+			}
+			return;
+		}
+		int items[16], n = TabItems( g_iTab, items );
+		if ( key <= n )
+		{
+			g_iFocus = items[key - 1];
+			Buy( items[key - 1] );
+		}
+	}
+}
+
+static bool PanelKey( int down, int keynum, const char *pszCurrentBinding, bool repeat );
+static bool EngineKeyDown( int keynum, const char *pszCurrentBinding, bool repeat );
+
+bool ArsUI_Key( int down, int keynum, const char *pszCurrentBinding )
+{
+	bool repeat = false;
+	if ( keynum >= 0 && keynum < 256 )
+	{
+		repeat = down && g_bHeld[keynum];
+		g_bHeld[keynum] = !!down;
+	}
+	// (build mode's keys, no panel open — the releases of those it took, whatever)
+	if ( down && !repeat )
+		BuildKeyPressed( keynum );
+	if (( !down || g_iPanel == P_NONE ) && BuildKey( down, keynum, pszCurrentBinding ? pszCurrentBinding : "", repeat ))
+		return true;
+	if ( PanelKey( down, keynum, pszCurrentBinding, repeat ))
+		return true;
+	if ( down && keynum >= 0 && keynum < 256 )
+		return EngineKeyDown( keynum, pszCurrentBinding, repeat );
+	return false;
+}
+
+// A press the client did not take: the engine passes its release on only for a press the client took (key_game,
+// keys[].gamedown) — so, declined, B's "buy" opening the shop would leave B held here, its next press (closing the
+// shop) seen as an auto-repeat and swallowed. A binding of commands run on the press only (no +button) is run here,
+// as the engine would (Key_AddKeyCommands: Cbuf, the press only, its auto-repeats ignored), and the press taken: its
+// release comes back. The others (+buttons, the keys the engine handles itself or repeats): left to the engine, the
+// key forgotten (its release will not come).
+static bool EngineKeyDown( int keynum, const char *pszCurrentBinding, bool repeat )
+{
+	const char *b = pszCurrentBinding;
+	const bool own = keynum == K_ESCAPE || keynum == '`' || keynum == '~' || keynum == K_BACKSPACE || keynum == K_PAUSE
+		|| keynum == K_PGUP || keynum == K_KP_PGUP || keynum == K_PGDN || keynum == K_KP_PGDN;
+	if ( own || !b || !b[0] || strchr( b, '+' ))
+	{
+		g_bHeld[keynum] = false;
+		return false;
+	}
+	if ( !repeat )
+		ClientCmd( (char *)b );
+	return true;
+}
+
+static bool PanelKey( int down, int keynum, const char *pszCurrentBinding, bool repeat )
+{
+	if ( g_iPanel == P_NONE || !down )
+		return false; // (releases reach the game: a key held as the panel opened)
+	const char *b = pszCurrentBinding ? pszCurrentBinding : "";
+	if ( keynum == K_MWHEELUP || keynum == K_MWHEELDOWN || ( g_iPanel == P_BUY && ( keynum == K_LEFTARROW || keynum == K_RIGHTARROW || keynum == K_UPARROW || keynum == K_DOWNARROW )))
+	{
+		if ( g_iPanel == P_BUY )
+		{
+			int step = ( keynum == K_MWHEELUP || keynum == K_LEFTARROW || keynum == K_UPARROW ) ? -1 : 1;
+			g_iTab = ( g_iTab + step + NUM_TABS ) % NUM_TABS;
+			g_iFocus = -1;
+			g_iKeyLevel = 1;
+		}
+		return true;
+	}
+	if ( keynum == K_ESCAPE )
+	{
+		if ( repeat )
+			return true;
+		if ( g_iPanel == P_BUY || ( g_iPanel == P_TEAM && Allowed( 10 )))
+		{
+			Close();
+			return true;
+		}
+		// (the engine's menu opens: the mouse is its own until the game is back)
+		Mouse( false );
+		g_bSuspended = true;
+		memset( g_bHeld, 0, sizeof( g_bHeld )); // (the keys released in the engine's menu: their releases are its own)
+		return false;
+	}
+	if ( keynum >= '0' && keynum <= '9' )
+	{
+		if ( !repeat )
+			NumberKey( keynum == '0' ? 10 : keynum - '0' );
+		return true;
+	}
+	if ( keynum == K_BACKSPACE && g_iPanel == P_BUY )
+	{
+		g_iKeyLevel = 0;
+		return true;
+	}
+	if ( g_iPanel == P_BUY && ( !strcmp( b, "buy" ) || !strcmp( b, "buymenu" ) || !strcmp( b, "client_buy_open" )))
+	{
+		if ( !repeat )
+			Close();
+		return true;
+	}
+	if ( g_iPanel == P_TEAM && !strcmp( b, "chooseteam" ) && Allowed( 10 ))
+	{
+		if ( !repeat )
+			Close();
+		return true;
+	}
+	return false;
+}
+
+// the engine's key state cleared (the window's focus lost)
+void ArsUI_ClearStates( void ) { BuildKeysLost(); }
+
+// The engine's mouse callbacks (the client's IN_ActivateMouse / IN_DeactivateMouse): the game has the mouse again
+void ArsUI_EngineMouse( bool active )
+{
+	if ( !active )
+		BuildKeysLost(); // (the engine's menu, the console, the chat: the keys are no longer the game's)
+	if ( !g_bInMouse && active )
+	{
+		g_bSuspended = false;
+		memset( g_bHeld, 0, sizeof( g_bHeld )); // (back from the engine's menu or console: what was released there)
+	}
+}
+
+// A press of the mouse while the touch screen's client-only mode is on: finger 0 the left button, 1 the others
+bool ArsUI_Touch( int type, int finger )
+{
+	if ( !g_bTouch )
+		return false;
+	if ( finger == 0 )
+	{
+		if ( type == 0 )
+			ClickDown();
+		else if ( type == 1 )
+			ClickUp();
+	}
+	else if ( finger == 1 && type == 0 && ( g_iPanel == P_BUY || ( g_iPanel == P_TEAM && Allowed( 10 ))))
+		Close(); // (a right click closes what may be closed)
+	return true;
+}
