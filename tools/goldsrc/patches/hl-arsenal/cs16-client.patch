+// What the server refuses whatever the money: Half-Life's pistols and the shield do not go together
+static bool Refused( const BuyItem &it )
+{
+	if (( it.id == HL_GLOCK || it.id == HL_PYTHON ) && g_bOwnsShield )
+		return true;
+	if ( !strcmp( it.cmd, "shield" ) && ( Owned( HL_GLOCK ) || Owned( HL_PYTHON ) || HLLook()))
+		return true;
+	// (one companion: a ball or the laptop carried, or a Pokemon or Le M out)
+	if ( IsCompanionItem( it.id ) && ( OwnsCompanionItem() || PokemonOut() >= 0 ))
+		return true;
+	return false;
+}
