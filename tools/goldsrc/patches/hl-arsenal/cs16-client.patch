+// What the server refuses whatever the money: Half-Life's pistols and the shield do not go together
+static bool Refused( const BuyItem &it )
+{
+	if (( it.id == HL_GLOCK || it.id == HL_PYTHON ) && g_bOwnsShield )
+		return true;
+	if ( !strcmp( it.cmd, "shield" ) && ( Owned( HL_GLOCK ) || Owned( HL_PYTHON ) || HLLook()))
+		return true;
+	// (one companion: a ball or the laptop carried, or a Pokemon or Le M out)
+	if ( IsCompanionItem( it.id ) && ( OwnsCompanionItem() || PokemonOut() >= 0 ))
+		return true;
+	return false;
+}
+
+// What the server refuses as already had: a full vest, and the helmet with it
+static bool Full( const BuyItem &it )
+{
+	const int armor = gHUD.m_Battery.Armor();
+	const bool helmet = gHUD.m_Battery.Helmet() && armor > 0;
+	return ( !strcmp( it.cmd, "vest" ) && armor >= 100 ) || ( !strcmp( it.cmd, "vesthelm" ) && armor >= 100 && helmet );
+}
+
+// why the server refuses an item, or would (the row flashed red)
+static const char *RefusalText( const BuyItem &it )
+{
+	if ( Full( it ))
+		return "Already have it";
+	if ( IsCompanionItem( it.id ))
+	{
+		const int out = PokemonOut();
+		if ( out == SPECIES_LEM )
+			return "Le M is already out: one companion at a time";
+		if ( out >= 0 )
+			return "Your Pok\xC3\xA9mon is already out: one companion at a time";
+		if ( Owned( LEM_LAPTOP ))
+			return it.id == LEM_LAPTOP ? "You already carry the laptop" : "You carry the laptop: one companion at a time";
+		if ( OwnsCompanionItem())
+			return IsBall( it.id ) ? "You already carry a Pok\xC3\xA9 Ball" : "You carry a Pok\xC3\xA9 Ball: one companion at a time";
+	}
+	if ( !Refused( it ))
+		return "Not enough money";
+	return strcmp( it.cmd, "shield" ) ? "Not with the shield" : "Not with a Half-Life pistol or look";
+}
+
+// a row's short tag where "owned" goes, for a refusal that is not about the money (null: none)
+static const char *RefusalTag( const BuyItem &it )
+{
+	if ( IsCompanionItem( it.id ))
+	{
+		const int out = PokemonOut();
+		if ( out == ItemSpecies( it.id ))
+			return "out";
+		if ( Owned( it.id ))
+			return "owned";
+		if ( out >= 0 )
+			return out == SPECIES_LEM ? "Le M out" : "Pok\xC3\xA9mon out";
+		if ( Owned( LEM_LAPTOP ))
+			return "laptop";
+		if ( OwnsCompanionItem())
+			return "one ball";
+		return 0;
+	}
+	if ( Owned( it.id ) || Full( it ))
+		return "owned";
+	if ( Refused( it ))
+		return !strcmp( it.cmd, "shield" ) ? "HL pistol" : "shield";
+	return 0;
+}
