+//
+// The models
+//
+#define MAX_PREVIEWS 10
+#define PREVIEW_DIST 9.0f
+#define BACKDROP_DIST 14.5f
+
+struct Preview
+{
+	char name[64];
+	model_t *model;
+	int sequence, pose;
+	float x, y, w, h, t0, yaw, zoom;
+	float scale; // (of the last frame, for the light)
+	bool active, failed;
+	bool laid; float layAngle; // (the screen-plane turn that lays a weapon flat: LayAngle, from its first frame's bones)
+	bool fitted; float fitCenter[3], fitHx, fitHz, fitSweep;
+	int measured; float corr; // (the scale corrected once from what its first laid frame drew: PreviewBones)
+	float frameW, frameH, mid[3];
+	float pose0[3][3], m[3][4];
+	cl_entity_t ent;
+};
+
+// the world models that do not lie as the others: `over` turned over along their length (upside down), `roll` degrees
+// in the screen's plane, `yaw` degrees around the vertical (their face toward the view)
+struct Turn { const char *model; bool over; float roll, yaw; };
+static const Turn g_Turns[] = { { "", false, 0, 0 } }; // (none: LayAngle lays them all)
+static const char *const g_Flips[] = { "models/w_9mmhandgun.mdl" };
+
+struct Backdrop
+{
+	float x, y, w, h;
+	Col c;
+};
+
+static Preview g_Previews[MAX_PREVIEWS];
+static bool g_bPreviewUsed[MAX_PREVIEWS];
+static Backdrop g_Backdrops[8], g_BackdropsNext[8];
+static int g_iBackdrops, g_iBackdropsNext;
+static vec3_t g_vViewOrg, g_vForward, g_vRight, g_vUp;
+static bool g_bView;
+
+// a model turning in a rectangle of the screen, this frame (slots keep their animation while their model stays)
+static void PreviewAdd( int slot, const char *model, float x, float y, float w, float h, int pose, float yaw, float zoom = 1 )
+{
+	if ( slot < 0 || slot >= MAX_PREVIEWS || !model || !model[0] )
+		return;
+	Preview &p = g_Previews[slot];
+	if ( strcmp( p.name, model ))
+	{
+		strncpy( p.name, model, sizeof( p.name ) - 1 );
+		p.name[sizeof( p.name ) - 1] = 0;
+		p.model = NULL;
+		p.failed = false;
+		p.laid = false; p.layAngle = 0;
+		p.fitted = false;
+		p.measured = 0; p.corr = 1;
+		p.t0 = Now();
+	}
+	p.x = x; p.y = y; p.w = w; p.h = h; p.pose = pose; p.yaw = yaw; p.zoom = zoom;
+	g_bPreviewUsed[slot] = true;
+}
+
+static void BackdropAdd( float x, float y, float w, float h, Col c )
+{
+	if ( g_iBackdropsNext >= (int)( sizeof( g_BackdropsNext ) / sizeof( g_BackdropsNext[0] )))
+		return;
+	Backdrop &b = g_BackdropsNext[g_iBackdropsNext++];
+	b.x = x; b.y = y; b.w = w; b.h = h; b.c = c;
+}
+
+static int PickSequence( studiohdr_t *hdr, int pose )
+{
+	if ( pose != POSE_UPRIGHT )
+		return 0;
+	mstudioseqdesc_t *seq = (mstudioseqdesc_t *)( (byte *)hdr + hdr->seqindex );
+	// (the model's own standing idle: by its activity, then by name — one without blends, which pose the limbs apart)
+	for ( int i = 0; i < hdr->numseq; i++ )
+		if ( seq[i].activity == 1 /* ACT_IDLE */ && seq[i].numblends <= 1 )
+			return i;
+	for ( int i = 0; i < hdr->numseq; i++ )
+		if ( !strcmp( seq[i].label, "idle1" ))
+			return i;
+	for ( int i = 0; i < hdr->numseq; i++ )
+		if ( strstr( seq[i].label, "idle" ))
+			return i;
+	return 0;
+}
