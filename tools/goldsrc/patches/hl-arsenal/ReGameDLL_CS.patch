+	PRECACHE_SOUND("weapons/rocket1.wav");
+}
+
+// (tells the launcher this rocket no longer follows its spot)
+void CHLRpgRocket::Forget()
+{
+	if (m_hLauncher.IsValid())
+	{
+		m_hLauncher->m_cActiveRockets--;
+		m_hLauncher = nullptr;
+	}
+}
+
+void CHLRpgRocket::Explode(TraceResult *pTrace)
+{
+	Forget();
+	STOP_SOUND(edict(), CHAN_VOICE, "weapons/rocket1.wav");
+
+	entvars_t *pevOwner = pev->owner ? VARS(pev->owner) : nullptr;
+	pev->model = iStringNull;
+	pev->solid = SOLID_NOT;
+	pev->effects |= EF_NODRAW;
+	HL_Explosion(this, pTrace, pevOwner, pev->dmg, pev->dmg * 2.5f, int((pev->dmg - 50) * 0.6f));
+
+	SetTouch(nullptr);
+	SetThink(&CBaseEntity::SUB_Remove);
+	pev->nextthink = gpGlobals->time + 0.1f;
+}
+
+void CHLRpgRocket::RocketTouch(CBaseEntity *pOther)
+{
+	if (pOther->edict() == pev->owner)
+		return;
+
+	TraceResult tr;
+	Vector vecSpot = pev->origin - pev->velocity.Normalize() * 32;
+	UTIL_TraceLine(vecSpot, vecSpot + pev->velocity.Normalize() * 64, ignore_monsters, edict(), &tr);
+	Explode(&tr);
+}
+
+void CHLRpgRocket::IgniteThink()
+{
+	pev->movetype = MOVETYPE_FLY;
+	pev->effects |= EF_LIGHT;
+
+	EMIT_SOUND(ENT(pev), CHAN_VOICE, "weapons/rocket1.wav", VOL_NORM, 0.5f);
+
+	MESSAGE_BEGIN(MSG_BROADCAST, SVC_TEMPENTITY);
+		WRITE_BYTE(TE_BEAMFOLLOW);
+		WRITE_SHORT(entindex());
+		WRITE_SHORT(m_iTrail);
+		WRITE_BYTE(40); // life
+		WRITE_BYTE(5);  // width
+		WRITE_BYTE(224); // r, g, b
+		WRITE_BYTE(224);
+		WRITE_BYTE(255);
+		WRITE_BYTE(255); // brightness
+	MESSAGE_END();
+
+	m_flIgniteTime = gpGlobals->time;
+	SetThink(&CHLRpgRocket::FollowThink);
+	pev->nextthink = gpGlobals->time + 0.1f;
+}
+
+void CHLRpgRocket::FollowThink()
+{
+	CBaseEntity *pOther = nullptr;
+	Vector vecTarget;
+	TraceResult tr;
+
+	UTIL_MakeAimVectors(pev->angles);
+	vecTarget = gpGlobals->v_forward;
+	float flMax = 4096;
+
+	// (the nearest visible laser spot ahead)
+	while ((pOther = UTIL_FindEntityByClassname(pOther, "laser_spot")))
+	{
+		UTIL_TraceLine(pev->origin, pOther->pev->origin, dont_ignore_monsters, ENT(pev), &tr);
+		if (tr.flFraction >= 0.9f)
+		{
+			Vector vecDir = pOther->pev->origin - pev->origin;
+			float flDist = vecDir.Length();
+			vecDir = vecDir.Normalize();
+			float flDot = DotProduct(gpGlobals->v_forward, vecDir);
+			if (flDot > 0 && flDist * (1 - flDot) < flMax)
+			{
+				flMax = flDist * (1 - flDot);
+				vecTarget = vecDir;
+			}
+		}
+	}
+
+	pev->angles = UTIL_VecToAngles(vecTarget);
+
+	float flSpeed = pev->velocity.Length();
+	if (gpGlobals->time - m_flIgniteTime < 1.0f)
+	{
+		pev->velocity = pev->velocity * 0.2f + vecTarget * (flSpeed * 0.8f + 400.0f);
+		if (pev->waterlevel == 3)
+		{
+			if (pev->velocity.Length() > 300.0f)
+				pev->velocity = pev->velocity.Normalize() * 300.0f;
+
+			UTIL_BubbleTrail(pev->origin - pev->velocity * 0.1f, pev->origin, 4);
+		}
+		else if (pev->velocity.Length() > 2000.0f)
+		{
+			pev->velocity = pev->velocity.Normalize() * 2000.0f;
+		}
+	}
+	else
+	{
+		if (pev->effects & EF_LIGHT)
+		{
+			pev->effects = 0;
+			STOP_SOUND(ENT(pev), CHAN_VOICE, "weapons/rocket1.wav");
+		}
+
+		pev->velocity = pev->velocity * 0.2f + vecTarget * flSpeed * 0.798f;
+		if (pev->waterlevel == 0 && pev->velocity.Length() < 1500.0f)
+		{
+			Explode(nullptr);
+			return;
+		}
+	}
+
+	if (m_hLauncher.IsValid() && ((pev->origin - m_hLauncher->pev->origin).Length() > 8192 || gpGlobals->time - m_flIgniteTime > 6.0f))
+		Forget();
+
+	if (UTIL_PointContents(pev->origin) == CONTENTS_SKY)
+	{
+		Explode(nullptr);
+		return;
+	}
+
+	pev->nextthink = gpGlobals->time + 0.1f;
+}
