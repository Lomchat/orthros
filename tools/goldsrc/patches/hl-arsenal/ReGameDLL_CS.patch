+
+void CHLRpg::Reload()
+{
+	if (m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] <= 0 || m_iClip == HL_RPG_MAX_CLIP)
+		return;
+
+	m_flNextPrimaryAttack = GetNextAttackDelay(0.5f);
+
+	// (no reloading while a rocket in flight follows the spot)
+	if (m_cActiveRockets && m_fSpotActive)
+		return;
+
+	if (m_pSpot && m_fSpotActive)
+	{
+		m_pSpot->Suspend(2.1f);
+		m_flNextSecondaryAttack = UTIL_WeaponTimeBase() + 2.1f;
+	}
+
+	if (m_iClip == 0 && DefaultReload(HL_RPG_MAX_CLIP, RPG_RELOAD, 2))
+	{
+		m_pPlayer->SetAnimation(PLAYER_RELOAD);
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 10, 15);
+	}
+}
+
+void CHLRpg::WeaponIdle()
+{
+	UpdateSpot();
+
+	if (m_flTimeWeaponIdle > UTIL_WeaponTimeBase())
+		return;
+
+	if (m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] || m_iClip)
+	{
+		ResetEmptySound();
+
+		int iAnim;
+		if (UTIL_SharedRandomFloat(m_pPlayer->random_seed, 0.0f, 1.0f) <= 0.75f || m_fSpotActive)
+		{
+			iAnim = m_iClip ? RPG_IDLE : RPG_IDLE_UL;
+			m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 90.0f / 15.0f;
+		}
+		else
+		{
+			iAnim = m_iClip ? RPG_FIDGET : RPG_FIDGET_UL;
+			m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 3.0f;
+		}
+
+		SendWeaponAnim(iAnim);
+	}
+	else
+	{
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 1.0f;
+	}
+}
+
+void CHLRpg::UpdateSpot()
+{
+	if (!m_fSpotActive || !m_pPlayer || !m_pPlayer->IsAlive())
+		return;
+
+	if (!m_pSpot)
+		m_pSpot = CHLLaserSpot::CreateSpot();
+
+	UTIL_MakeVectors(m_pPlayer->pev->v_angle);
+	Vector vecSrc = m_pPlayer->GetGunPosition();
+
+	TraceResult tr;
+	UTIL_TraceLine(vecSrc, vecSrc + gpGlobals->v_forward * 8192.0f, dont_ignore_monsters, ENT(m_pPlayer->pev), &tr);
+	UTIL_SetOrigin(m_pSpot->pev, tr.vecEndPos);
+}
