+// ---------------------------------------------------------------------------------------------------------------------
+// placing a piece
+
+static void BUILD_EyeOf(CBasePlayer *pPlayer, float *eye, float *angles, float &feet)
+{
+	Vector vecEye = pPlayer->pev->origin + pPlayer->pev->view_ofs;
+	eye[0] = vecEye.x;
+	eye[1] = vecEye.y;
+	eye[2] = vecEye.z;
+	angles[0] = pPlayer->pev->v_angle.x;
+	angles[1] = pPlayer->pev->v_angle.y;
+	angles[2] = 0;
+	feet = pPlayer->pev->origin.z + pPlayer->pev->mins.z;
+}
+
+// Why a spot may not be built for this player (0: it may)
+static int BUILD_Check(CBasePlayer *pPlayer, const build_engine_t *e, const build_spot_t &spot, const float *eye)
+{
+	if (pPlayer->m_iBricks < BUILD_COST)
+		return BUILD_NO_BRICKS;
+
+	// (the caps: the player's pieces, all pieces, their entities, the edicts left)
+	int iMine = 0, iAll = 0, iEntities = 0;
+	bool bTaken = false;
+	CBaseEntity *pEntity = nullptr;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "build_piece")))
+	{
+		if (pEntity->pev->flags & FL_KILLME)
+			continue;
+
+		CBuildPiece *pPiece = static_cast<CBuildPiece *>(pEntity);
+		iAll++;
+		iEntities += pPiece->Entities();
+		if (pPiece->IsOwnedBy(pPlayer))
+			iMine++;
+
+		float o[3] = { pEntity->pev->origin.x, pEntity->pev->origin.y, pEntity->pev->origin.z };
+		if (build_same_slot(&spot, pPiece->Piece(), pPiece->Yaw(), o))
+			bTaken = true;
+	}
+
+	if (iMine >= BUILD_PLAYER_CAP)
+		return BUILD_MY_CAP;
+
+	// (the edicts: the game's margin kept, and room for every pile there may be)
+	const int iNeed = build_steps(spot.piece);
+	if (iAll >= BUILD_GLOBAL_CAP || iEntities + iNeed > BUILD_ENTITY_CAP
+		|| NUMBER_OF_ENTITIES() + iNeed + BUILD_EDICT_MARGIN + BUILD_PILE_CAP - BUILD_LivePiles() > gpGlobals->maxEntities)
+		return BUILD_ALL_CAP;
+
+	if (!build_in_reach(&spot, eye))
+		return BUILD_TOO_FAR;
+
+	if (bTaken)
+		return BUILD_BLOCKED;
+
+	// (players, hostages and Pokemon in its steps)
+	CBaseEntity *pList[64];
+	int n = UTIL_EntitiesInBox(pList, ARRAYSIZE(pList), Vector(spot.mins[0], spot.mins[1], spot.mins[2]), Vector(spot.maxs[0], spot.maxs[1], spot.maxs[2]), FL_CLIENT | FL_FAKECLIENT | FL_MONSTER);
+	for (int i = 0; i < n; i++)
+	{
+		entvars_t *pevOther = pList[i]->pev;
+		if (pevOther->solid == SOLID_NOT || pevOther->deadflag != DEAD_NO || pevOther->health <= 0.0f)
+			continue;
+
+		if (build_overlaps_box(&spot, pevOther->absmin, pevOther->absmax))
+			return BUILD_BLOCKED;
+	}
+
+	// (spawn points: not refused — the client could not show it, and a spawn area is where a round's building starts;
+	// a player spawning into pieces later in a round breaks them: BUILD_PlayerSpawned)
+
+	if (build_world_blocked(e, &spot))
+		return BUILD_BLOCKED;
+
+	return BUILD_OK;
+}
+
+// The spot the server finds for a player: its own aim with the piece (turns: the one giving the client's spot, if the
+// client sent one and any does; aimed at the client's spot's centre if the view moved since — latency —; else the
+// turns giving the client's yaw, or 0)
+static void BUILD_FindSpot(CBasePlayer *pPlayer, const build_engine_t *e, int iPiece, const build_spot_t *pAsked, int iTurns, build_spot_t &spot)
+{
+	float eye[3], angles[3], feet;
+	BUILD_EyeOf(pPlayer, eye, angles, feet);
+
+	if (pAsked)
+	{
+		build_spot_t trySpot;
+		for (int t = 0; t < 4; t++)
+		{
+			build_aim(e, eye, angles, feet, iPiece, t, &trySpot);
+			if (build_same_slot(&trySpot, pAsked->piece, pAsked->yaw, pAsked->origin))
+			{
+				spot = trySpot;
+				return;
+			}
+		}
+
+		// (the view at the asked spot's centre, from the same eye)
+		float c[3];
+		build_box(pAsked->piece, pAsked->yaw, pAsked->origin, c, trySpot.maxs);
+		for (int k = 0; k < 3; k++)
+			c[k] = (c[k] + trySpot.maxs[k]) / 2 - eye[k];
+
+		float flHoriz = Q_sqrt(c[0] * c[0] + c[1] * c[1]);
+		if (flHoriz > 1.0f)
+		{
+			float aimed[3] = { float(-Q_atan2(c[2], flHoriz) * 180.0 / M_PI), float(Q_atan2(c[1], c[0]) * 180.0 / M_PI), 0 };
+			// (only a small correction: a view the player had a moment ago)
+			float dyaw = Q_fabs(UTIL_AngleDiff(aimed[1], angles[1])), dpitch = Q_fabs(aimed[0] - angles[0]);
+			if (dyaw < 30.0f && dpitch < 30.0f)
+			{
+				for (int t = 0; t < 4; t++)
+				{
+					build_aim(e, eye, aimed, feet, iPiece, t, &trySpot);
+					if (build_same_slot(&trySpot, pAsked->piece, pAsked->yaw, pAsked->origin))
+					{
+						spot = trySpot;
+						return;
+					}
+				}
+			}
+		}
+
+		// (its own, the turns that give the asked yaw)
+		for (int t = 0; t < 4; t++)
+		{
+			build_aim(e, eye, angles, feet, iPiece, t, &trySpot);
+			if (trySpot.yaw == pAsked->yaw)
+			{
+				spot = trySpot;
+				return;
+			}
+		}
+	}
+
+	build_aim(e, eye, angles, feet, iPiece, iTurns & 3, &spot);
+}
+
+static void BUILD_Place(CBasePlayer *pPlayer, int iPiece, const build_spot_t *pAsked, int iTurns)
+{
+	if (!BUILD_On())
+	{
+		BUILD_Deny(pPlayer, BUILD_DISABLED);
+		return;
+	}
+
+	if (!pPlayer->m_bBuildMode || !BUILD_CanPlay(pPlayer) || iPiece < 0 || iPiece >= BUILD_PIECES)
+	{
+		BUILD_Deny(pPlayer, BUILD_CANNOT);
+		return;
+	}
+
+	// (a moment between two: the quiet way to refuse a held button's repeats)
+	if (gpGlobals->time < pPlayer->m_flNextBuild)
+		return;
+
+	BuildTraceCtx ctx = { pPlayer->edict(), nullptr };
+	build_engine_t e = BUILD_Engine(&ctx);
+
+	build_spot_t spot;
+	BUILD_FindSpot(pPlayer, &e, iPiece, pAsked, iTurns, spot);
+
+	float eye[3], angles[3], feet;
+	BUILD_EyeOf(pPlayer, eye, angles, feet);
+	int iReason = BUILD_Check(pPlayer, &e, spot, eye);
+	if (iReason != BUILD_OK)
+	{
+		pPlayer->m_flNextBuild = gpGlobals->time + 0.1f;
+		BUILD_Deny(pPlayer, iReason);
+		return;
+	}
+
+	if (!CBuildPiece::Create(pPlayer, spot))
+	{
+		BUILD_Deny(pPlayer, BUILD_ALL_CAP);
+		return;
+	}
+
+	pPlayer->m_iBricks -= BUILD_COST;
+	pPlayer->m_flNextBuild = gpGlobals->time + BUILD_PLACE_DELAY;
+	BUILD_WeaponAnim(pPlayer, BUILD_VSEQ_PLACE);
+}
