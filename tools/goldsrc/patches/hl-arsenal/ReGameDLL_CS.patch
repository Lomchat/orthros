+
+void CLemLaptopWeapon::PrimaryAttack()
+{
+	// (the fire button held: no idle comes meanwhile)
+	if (IsBusy())
+	{
+		Advance();
+		return;
+	}
+
+	if (m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] <= 0 || !CanFire())
+		return;
+
+	// (one companion at a time)
+	if (PK_HasOut(m_pPlayer))
+	{
+		PK_CenterPrint(m_pPlayer, PK_OutMessage(m_pPlayer));
+		m_flNextPrimaryAttack = GetNextAttackDelay(1.0f);
+		return;
+	}
+
+	// (typing: Le M's code, a while)
+	m_flStartThrow = gpGlobals->time;
+	SendWeaponAnim(Seq(SEQ_TYPE));
+	EMIT_SOUND(ENT(m_pPlayer->pev), CHAN_WEAPON, "others/laptop_type.wav", 0.8f, ATTN_NORM);
+	m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + LEM_TYPE_TIME;
+	m_flNextPrimaryAttack = m_flNextSecondaryAttack = GetNextAttackDelay(LEM_TYPE_TIME);
+}
+
+// (the secondary button held: no idle comes meanwhile either — the laptop has no secondary attack)
+void CLemLaptopWeapon::SecondaryAttack()
+{
+	if (IsBusy())
+		Advance();
+}
+
+// Le M where its player aims (up to LEM_SUMMON_RANGE, short of what the aim meets), else nearer along its aim, else
+// in front of it, facing it — always in its sight (never through a wall or a door, however close it stands to it)
+bool CLemLaptopWeapon::Summon()
+{
+	Vector vecFwd;
+	UTIL_MakeVectorsPrivate(m_pPlayer->pev->v_angle + m_pPlayer->pev->punchangle, vecFwd, nullptr, nullptr);
+	Vector vecEye = m_pPlayer->EyePosition();
+
+	TraceResult tr;
+	UTIL_TraceLine(vecEye, vecEye + vecFwd * LEM_SUMMON_RANGE, dont_ignore_monsters, m_pPlayer->edict(), &tr);
+	float flDist = LEM_SUMMON_RANGE * tr.flFraction;
+	bool bFloor = (tr.flFraction < 1.0f && tr.vecPlaneNormal.z > 0.7f);
+
+	Vector vecFace = vecEye - tr.vecEndPos;
+	vecFace.z = 0.0f;
+	float flYaw = vecFace.Length() > 1.0f ? UTIL_VecToYaw(vecFace) : UTIL_AngleMod(m_pPlayer->pev->v_angle.y + 180.0f);
+
+	static const float fractions[] = { 1.0f, 0.7f, 0.45f, 0.25f };
+	for (int i = 0; i < int(ARRAYSIZE(fractions)); i++)
+	{
+		// (on the floor aimed at, or his half width short of a wall or someone — never past it)
+		Vector vecSpot;
+		if (i == 0 && bFloor)
+			vecSpot = tr.vecEndPos + Vector(0, 0, 2);
+		else
+			vecSpot = vecEye + vecFwd * Q_max(Q_min(flDist * fractions[i], flDist - 20.0f), 0.0f);
+
+		if (CPokemon::Create(PK_LEM, m_pPlayer, vecSpot, flYaw, &vecEye))
+			return true;
+	}
+
+	Vector vecFlat(vecFwd.x, vecFwd.y, 0.0f);
+	vecFlat = vecFlat.Length() > 0.1f ? vecFlat.Normalize() : Vector(1, 0, 0);
+	return CPokemon::Create(PK_LEM, m_pPlayer, PK_Feet(m_pPlayer) + vecFlat * 56.0f + Vector(0, 0, 8), flYaw, &vecEye) != nullptr;
+}
+
+void CLemLaptopWeapon::WeaponIdle()
+{
+	if (IsBusy())
+	{
+		Advance();
+		return;
+	}
+
+	if (m_flTimeWeaponIdle > UTIL_WeaponTimeBase())
+		return;
+
+	if (m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType])
+	{
+		SendWeaponAnim(Seq(SEQ_IDLE));
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 10.0f, 15.0f);
+	}
+}
+
+void CLemLaptopWeapon::Advance()
+{
+	// (the enter key down: Le M compiles where its player aims now)
+	if (m_flEnterTime > 0.0f)
+	{
+		if (gpGlobals->time < m_flEnterTime)
+			return;
+
+		m_flEnterTime = 0.0f;
+		EMIT_SOUND(ENT(m_pPlayer->pev), CHAN_WEAPON, "others/laptop_enter.wav", VOL_NORM, ATTN_NORM);
+		m_pPlayer->SetAnimation(PLAYER_ATTACK1);
+
+		if (!PK_HasOut(m_pPlayer) && m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] > 0 && Summon())
+		{
+			m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType]--;
+			m_bSummoned = true;
+			m_flTimeWeaponIdle = m_flNextPrimaryAttack = m_flNextSecondaryAttack = GetNextAttackDelay(LEM_DEPLOY_HOLD);
+		}
+		else
+		{
+			// (the screen back to the code at once: never "LE M ONLINE" when he is not)
+			PK_CenterPrint(m_pPlayer, PK_HasOut(m_pPlayer) ? PK_OutMessage(m_pPlayer) : "No room for Le M there");
+			SendWeaponAnim(Seq(SEQ_IDLE));
+			m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + LEM_NO_ROOM_TIME;
+			m_flNextPrimaryAttack = m_flNextSecondaryAttack = GetNextAttackDelay(LEM_NO_ROOM_TIME);
+		}
+
+		return;
+	}
+
+	if (m_flTimeWeaponIdle > UTIL_WeaponTimeBase())
+		return;
+
+	if (IsTyping())
+	{
+		m_flStartThrow = 0.0f;
+
+		// (a companion of its out meanwhile — another way —: the laptop kept)
+		if (PK_HasOut(m_pPlayer) || m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] <= 0)
+		{
+			STOP_SOUND(ENT(m_pPlayer->pev), CHAN_WEAPON, "others/laptop_type.wav");
+			SendWeaponAnim(Seq(SEQ_IDLE));
+			m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 1.0f;
+			return;
+		}
+
+		// (typed: the deploy sequence, its enter key down a moment later)
+		SendWeaponAnim(Seq(SEQ_DEPLOY));
+		m_flEnterTime = gpGlobals->time + LEM_ENTER_AT;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + LEM_ENTER_AT;
+		m_flNextPrimaryAttack = m_flNextSecondaryAttack = GetNextAttackDelay(LEM_ENTER_AT);
+		return;
+	}
+
+	// (out: the laptop goes)
+	m_bSummoned = false;
+	if (!m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType])
+		RetireWeapon();
+}
