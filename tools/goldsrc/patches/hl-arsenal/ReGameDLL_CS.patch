+// ---------------------------------------------------------------------------------------------------------------------
+// Effects (temporary entities)
+
+static void PK_FxSprite(const Vector &pos, int iSprite, int iScale, int iBrightness)
+{
+	MESSAGE_BEGIN(MSG_PVS, SVC_TEMPENTITY, pos);
+		WRITE_BYTE(TE_SPRITE);
+		WRITE_COORD(pos.x);
+		WRITE_COORD(pos.y);
+		WRITE_COORD(pos.z);
+		WRITE_SHORT(iSprite);
+		WRITE_BYTE(clamp(iScale, 1, 255));
+		WRITE_BYTE(clamp(iBrightness, 0, 255));
+	MESSAGE_END();
+}
+
+// Where a flash of this half-size is drawn near pos: a sprite is depth-tested, so the floor under it would cut it flat
+// (and a ceiling over it): its centre at least its half-size (and flMinHeight) above the floor, under the ceiling when
+// there is room for it
+static Vector PK_FlashSpot(const Vector &pos, float flHalf, float flMinHeight, edict_t *pIgnore)
+{
+	float flLift = Q_max(flHalf, flMinHeight);
+	Vector vecSpot = pos;
+
+	TraceResult tr;
+	UTIL_TraceLine(pos + Vector(0, 0, 1), pos - Vector(0, 0, flLift), ignore_monsters, pIgnore, &tr);
+	if (tr.fStartSolid)
+		return pos;
+
+	float flFloor = (tr.flFraction < 1.0f) ? tr.vecEndPos.z : pos.z - flLift;
+	vecSpot.z = Q_max(pos.z, flFloor + flLift);
+
+	UTIL_TraceLine(Vector(pos.x, pos.y, flFloor + 1.0f), Vector(pos.x, pos.y, vecSpot.z + flHalf), ignore_monsters, pIgnore, &tr);
+	if (tr.flFraction < 1.0f && !tr.fStartSolid)
+		vecSpot.z = Q_max(flFloor + Q_min(flLift, 0.5f * (tr.vecEndPos.z - flFloor)), Q_min(vecSpot.z, tr.vecEndPos.z - flHalf));
+
+	return vecSpot;
+}
+
+// flash.spr (white, additive) at TE_SPRITE scale iScale (tenths), lifted clear of the floor
+static void PK_FxFlash(const Vector &pos, int iScale, int iBrightness, float flMinHeight, edict_t *pIgnore)
+{
+	float flHalf = 0.5f * PK_FLASH_PIXELS * 0.1f * iScale;
+	PK_FxSprite(PK_FlashSpot(pos, flHalf, flMinHeight, pIgnore), s_iSprFlash, iScale, iBrightness);
+}
+
+// The spawn glow shell's colour, fading with k (1 at the start, 0 at the end)
+static Vector PK_SpawnGlowColour(float k)
+{
+	return Vector(120, 170, 255) * k;
