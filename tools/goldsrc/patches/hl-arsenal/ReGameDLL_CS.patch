+	{ "Pokemon", { { "Pikachu", WEAPON_PK_PIKACHU, PK_PIKACHU_PRICE }, { "Charizard", WEAPON_PK_CHARIZARD, PK_CHARIZARD_PRICE }, { "Blastoise", WEAPON_PK_BLASTOISE, PK_BLASTOISE_PRICE } } },
+};
+
+// (a long menu in several messages, as their size is limited)
+static void HL_ShowMenuText(CBasePlayer *pPlayer, int bitsValidSlots, const char *pszText)
+{
+	char chunk[176];
+	int len = Q_strlen(pszText);
+	for (int i = 0; i < len; i += sizeof(chunk) - 1)
+	{
+		Q_strlcpy(chunk, pszText + i);
+		ShowMenu(pPlayer, bitsValidSlots, -1, (i + int(sizeof(chunk)) - 1 < len) ? TRUE : FALSE, chunk);
+	}
+}
+
+static void HL_ShowArsenalMenu(CBasePlayer *pPlayer)
+{
+	char text[256] = "\\yHalf-Life arsenal\\w\n\n";
+	int bits = MENU_KEY_0;
+	for (int i = 0; i < int(ARRAYSIZE(HL_BuyCategories)); i++)
+	{
+		Q_snprintf(text + Q_strlen(text), sizeof(text) - Q_strlen(text), "%d. %s\n", i + 1, HL_BuyCategories[i].title);
+		bits |= 1 << i;
+	}
+
+	Q_strlcat(text, "\n0. Exit");
+	HL_ShowMenuText(pPlayer, bits, text);
+}
+
+static void HL_ShowCategoryMenu(CBasePlayer *pPlayer, int iCategory)
+{
+	const HLBuyCategory &category = HL_BuyCategories[iCategory];
+	char text[512];
+	Q_snprintf(text, sizeof(text), "\\yHalf-Life arsenal: %s\\w\n\n", category.title);
+
+	int bits = MENU_KEY_0;
+	for (int i = 0; i < int(ARRAYSIZE(category.items)) && category.items[i].name; i++)
+	{
+		Q_snprintf(text + Q_strlen(text), sizeof(text) - Q_strlen(text), "%d. %s\\R$%d\n", i + 1, category.items[i].name, category.items[i].price);
+		bits |= 1 << i;
+	}
+
+	Q_strlcat(text, "\n0. Exit");
+	HL_ShowMenuText(pPlayer, bits, text);
+}
+
+static void HL_BuyCategoryItem(CBasePlayer *pPlayer, int iCategory, int iSlot)
+{
+	const HLBuyCategory &category = HL_BuyCategories[iCategory];
+	if (iSlot < 1 || iSlot > int(ARRAYSIZE(category.items)) || !category.items[iSlot - 1].name)
+		return;
+
+	const HLBuyItem &item = category.items[iSlot - 1];
+	if (item.id == WEAPON_NONE)
+		HL_BuyARGrenade(pPlayer);
+	else
+		BuyWeaponByWeaponID(pPlayer, item.id);
+}
