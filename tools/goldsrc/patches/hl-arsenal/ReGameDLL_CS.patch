+// Half Strike: the Half-Life player models, after Counter-Strike's four looks of a side (slots 5 to 9) — the Black
+// Mesa defenders on the Counter-Terrorists' side, its enemies on the Terrorists'
+static const char *const HL_SkinsT[] = { "hgrunt", "recon", "gman", "zombie", "robo" };
+static const char *const HL_SkinsCT[] = { "barney", "gordon", "helmet", "gina", "scientist" };
+#define HL_NUM_SKIN 5
+// (the model files, kept for the engine: it keeps the pointers it is given to precache)
+const char *HL_SkinPath(const char *name)
+{
+	static char paths[2 * HL_NUM_SKIN][MAX_PATH];
+	for (int i = 0; i < 2 * HL_NUM_SKIN; i++)
+	{
+		const char *skin = i < HL_NUM_SKIN ? HL_SkinsT[i] : HL_SkinsCT[i - HL_NUM_SKIN];
+		if (Q_strcmp(skin, name))
+			continue;
+		if (!paths[i][0])
+			Q_snprintf(paths[i], sizeof(paths[i]), "models/player/%s/%s.mdl", skin, skin);
+		return paths[i];
+	}
+	return "models/player.mdl";
+}
+
+const char *HL_SkinForTeam(const char *name, int team)
+{
+	for (int i = 0; i < HL_NUM_SKIN; i++)
+	{
+		if (!Q_strcmp(name, HL_SkinsT[i]) || !Q_strcmp(name, HL_SkinsCT[i]))
+			return team == TERRORIST ? HL_SkinsT[i] : team == CT ? HL_SkinsCT[i] : nullptr;
+	}
+	return nullptr;
+}
