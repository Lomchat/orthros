+void CPokemon::Spawn()
+{
+	Precache();
+	MAKE_STRING_CLASS("monster_pokemon", pev);
+
+	const PokemonInfo &info = PK_Info(m_iSpecies);
+	pev->movetype = MOVETYPE_STEP;
+	pev->solid = SOLID_NOT; // (solid once in place: StartLife)
+	pev->takedamage = DAMAGE_NO;
+	pev->flags |= FL_MONSTER;
+	pev->deadflag = DEAD_NO;
+	pev->gravity = 1.0f;
+	pev->friction = 1.0f;
+
+	SET_MODEL(edict(), info.model);
+	UTIL_SetSize(pev, info.mins, info.maxs);
+	pev->skin = 0;
+	pev->max_health = pev->health = info.health;
+	pev->view_ofs = Vector(0, 0, info.eyeHeight);
+
+	m_bloodColor = info.bloodColor;
+	m_flFieldOfView = 0.0f;
+	m_LastHitGroup = HITGROUP_GENERIC;
+	m_hEnemy = nullptr;
+
+	m_iState = STATE_SPAWNING;
+	m_iTeam = UNASSIGNED;
+	m_iCurSeq = -1;
+	m_flLastThink = gpGlobals->time;
+	m_flStateEnd = 0.0f;
+	m_flEnemySeen = m_flEnemySince = 0.0f;
+	m_flNextAimCheck = 0.0f;
+	m_flNextAttack = 0.0f;
+	m_flAttackStart = m_flAttackHit = m_flAttackEnd = 0.0f;
+	m_flStreamEnd = m_flNextFlameTick = m_flNextFlameFx = 0.0f;
+	m_bAttackFired = false;
+	m_bKilledEnemy = false;
+	m_flFlinchEnd = m_flNextFlinch = 0.0f;
+	m_flKnockbackEnd = m_flSlowEnd = m_flAirborneEnd = 0.0f;
+	m_bFollowMoving = false;
+	m_flStuckTime = 0.0f;
+	m_flStuckCheck = 0.0f;
+	m_vecStuckPos = g_vecZero;
+	m_flNextTeleport = 0.0f;
+	m_flStepDist = 0.0f;
+	m_flNextIdleSound = 0.0f;
+	m_flNextBattleCry = 0.0f;
+	m_flGlowEnd = 0.0f;
+	m_flDeathTime = 0.0f;
+	m_iHealthSent = -1;
+	m_flSpeedNow = 0.0f;
+	m_path.Invalidate();
+	m_iPathIndex = 0;
+	m_vecPathGoal = g_vecZero;
+	m_vecWaypoint = g_vecZero;
+	m_flNextRepath = 0.0f;
+	ClearAfflictions();
+
+	LoadSequences();
+
+	// (one spawned by other means than a ball has no player: it goes at its first think)
+	SetThink(&CPokemon::LiveThink);
+	pev->nextthink = gpGlobals->time + PK_THINK_INTERVAL;
+}
+
+// Its sequences by the model contract's names (else its indices), their lengths and ground speeds
+void CPokemon::LoadSequences()
+{
+	studiohdr_t *pStudio = (studiohdr_t *)GET_MODEL_PTR(edict());
+	for (int i = 0; i < SEQ_COUNT; i++)
+	{
+		int seq = LookupSequence(g_PokemonSeqNames[i]);
+		if (seq < 0)
+			seq = (pStudio && i < pStudio->numseq) ? i : 0;
+
+		m_iSeq[i] = seq;
+		m_flSeqDuration[i] = 1.0f;
+		m_flSeqGroundSpeed[i] = 0.0f;
+
+		if (pStudio && seq < pStudio->numseq)
+		{
+			mstudioseqdesc_t *pDesc = (mstudioseqdesc_t *)((byte *)pStudio + pStudio->seqindex) + seq;
+			if (pDesc->numframes > 1 && pDesc->fps > 0.0f)
+			{
+				m_flSeqDuration[i] = (pDesc->numframes - 1) / pDesc->fps;
+				m_flSeqGroundSpeed[i] = Vector(pDesc->linearmovement[0], pDesc->linearmovement[1], pDesc->linearmovement[2]).Length() / m_flSeqDuration[i];
+			}
+		}
+	}
+}
+
+CPokemon *CPokemon::Create(int iSpecies, CBasePlayer *pOwner, const Vector &vecNear, float flYaw)
+{
+	if (!PK_PlayerPlaying(pOwner))
+		return nullptr;
+
+	CPokemon *pPokemon = GetClassPtr<CCSMonster>((CPokemon *)nullptr);
+	pPokemon->m_iSpecies = clamp(iSpecies, 0, PK_NUM_SPECIES - 1);
+	pPokemon->pev->owner = pOwner->edict(); // (it and its player go through each other, and its player's shots through it)
+	pPokemon->Spawn();
+
+	Vector vecPos;
+	if (!pPokemon->FindRoom(vecNear, vecPos))
+	{
+		pPokemon->SetThink(nullptr);
+		UTIL_Remove(pPokemon);
+		return nullptr;
+	}
+
+	UTIL_SetOrigin(pPokemon->pev, vecPos);
+	pPokemon->pev->angles = Vector(0, flYaw, 0);
+	pPokemon->m_hOwner = pOwner;
+	pPokemon->m_iTeam = pOwner->m_iTeam;
+	pPokemon->StartLife();
+	return pPokemon;
+}
+
+// A standing spot for its hull near a point, in sight of it: the point itself, else around it
+bool CPokemon::FindRoom(const Vector &vecNear, Vector &vecOut)
+{
+	static const float radii[] = { 0.0f, 36.0f, 72.0f, 108.0f };
+	TraceResult tr;
+
+	for (int r = 0; r < int(ARRAYSIZE(radii)); r++)
+	{
+		const int count = radii[r] > 0.0f ? 8 : 1;
+		for (int k = 0; k < count; k++)
+		{
+			float a = (k * 45.0f + r * 22.5f) * (M_PI / 180.0f);
+			Vector xy = vecNear + Vector(Q_cos(a) * radii[r], Q_sin(a) * radii[r], 0.0f);
+
+			// (not behind a wall from the ball)
+			UTIL_TraceLine(vecNear + Vector(0, 0, 4), xy + Vector(0, 0, 4), ignore_monsters, edict(), &tr);
+			if (tr.flFraction < 1.0f || tr.fStartSolid)
+				continue;
+
+			// (the ground under it)
+			UTIL_TraceLine(xy + Vector(0, 0, 4), xy - Vector(0, 0, 256), ignore_monsters, edict(), &tr);
+			if (tr.flFraction >= 1.0f || tr.fStartSolid || tr.fAllSolid)
+				continue;
+
+			// (room for its hull there, players and monsters included)
+			Vector vecFloor = tr.vecEndPos + Vector(0, 0, 1);
+			TRACE_MONSTER_HULL(edict(), vecFloor, vecFloor, dont_ignore_monsters, edict(), &tr);
+			if (tr.fStartSolid || tr.fAllSolid)
+				continue;
+
+			vecOut = vecFloor;
+			return true;
+		}
+	}
+
+	return false;
+}
+
+void CPokemon::StartLife()
+{
+	const PokemonInfo &info = PK_Info(m_iSpecies);
+
+	pev->solid = SOLID_SLIDEBOX;
+	pev->takedamage = DAMAGE_YES;
+	UTIL_SetOrigin(pev, pev->origin);
+	DROP_TO_FLOOR(edict());
+
+	SetSeq(SEQ_SPAWN, 1.0f, true);
+	SetState(STATE_SPAWNING);
+	m_flStateEnd = gpGlobals->time + clamp(m_flSeqDuration[SEQ_SPAWN], 0.5f, 2.0f);
+
+	// (out of the light of the ball: a soft blue-white shell, fading out — SpawnGlow)
+	pev->renderfx = kRenderFxGlowShell;
+	pev->rendercolor = PK_SpawnGlowColour(1.0f);
+	pev->renderamt = PK_SPAWN_GLOW_AMOUNT;
+	m_flGlowEnd = gpGlobals->time + PK_SPAWN_GLOW_TIME;
+
+	EMIT_SOUND_DYN(ENT(pev), CHAN_VOICE, info.sndCry, VOL_NORM, ATTN_NORM, 0, PITCH_NORM);
+	m_flNextIdleSound = gpGlobals->time + RANDOM_FLOAT(12.0f, 25.0f);
+	m_flNextBattleCry = gpGlobals->time + 3.0f;
+
+	m_flLastThink = gpGlobals->time;
+	SendHealth(nullptr);
+
+	SetThink(&CPokemon::LiveThink);
+	pev->nextthink = gpGlobals->time + PK_THINK_INTERVAL;
+}
+
+CBasePlayer *CPokemon::Owner() const
+{
+	CBasePlayer *pOwner = m_hOwner;
+	return pOwner;
+}
+
+void CPokemon::SetState(int iState)
+{
+	m_iState = iState;
+	m_flStuckTime = 0.0f;
+	m_flStuckCheck = gpGlobals->time + 1.0f;
+	m_vecStuckPos = pev->origin;
+}
+
+// Stuck: wanting to go somewhere, not a step away from where it was a second ago (sliding to and fro included)
+void CPokemon::NoteProgress(bool bWantMove)
+{
+	const float now = gpGlobals->time;
+	if (!bWantMove)
+	{
+		m_flStuckTime = 0.0f;
+		m_vecStuckPos = pev->origin;
+		m_flStuckCheck = now + 1.0f;
+		return;
+	}
+
+	if (now < m_flStuckCheck || !(pev->flags & FL_ONGROUND))
+		return;
+
+	if ((pev->origin - m_vecStuckPos).Length() < 24.0f)
+		m_flStuckTime += 1.0f;
+	else
+		m_flStuckTime = 0.0f;
+
+	m_vecStuckPos = pev->origin;
+	m_flStuckCheck = now + 1.0f;
+}
+
+// Its target down by its hand (and no other target yet): its victory sequence and call, then back to following
+bool CPokemon::StartVictory()
+{
+	// (its victim: no longer an enemy — dead — though its handle may last until the next look at it)
+	CBaseEntity *pEnemy = m_hEnemy;
+	if (!m_bKilledEnemy || (pEnemy && IsEnemy(pEnemy)))
+		return false;
+
+	m_bKilledEnemy = false;
+	m_hEnemy = nullptr;
+	SetState(STATE_VICTORY);
+	SetSeq(SEQ_VICTORY, 1.0f, true);
+	m_flStateEnd = gpGlobals->time + clamp(m_flSeqDuration[SEQ_VICTORY], 0.5f, 2.5f);
+	EMIT_SOUND_DYN(ENT(pev), CHAN_VOICE, PK_Info(m_iSpecies).sndCry2, VOL_NORM, ATTN_NORM, 0, PITCH_NORM);
+	return true;
+}
+
+void CPokemon::SetSeq(int iSeq, float flFrameRate, bool bRestart)
+{
+	int seq = m_iSeq[iSeq];
+	if (bRestart || pev->sequence != seq || m_iCurSeq != iSeq)
+	{
+		// (walk and run blend into each other at the same point of the stride)
+		bool bGait = (m_iCurSeq == SEQ_WALK || m_iCurSeq == SEQ_RUN) && (iSeq == SEQ_WALK || iSeq == SEQ_RUN);
+		float flFrame = pev->frame;
+
+		pev->sequence = seq;
+		ResetSequenceInfo();
+		pev->frame = (bGait && !bRestart) ? flFrame : 0.0f;
+		m_iCurSeq = iSeq;
+	}
+
+	pev->framerate = flFrameRate;
+}
+
+void CPokemon::SendHealth(edict_t *pTo)
+{
+	int percent = 0;
+	if (IsOut() && pev->health > 0.0f)
+		percent = clamp(int(ceil(pev->health * 100.0f / pev->max_health)), 1, 100);
+
+	CBasePlayer *pOwner = Owner();
+	int index = entindex();
+	int team = (m_iTeam == TERRORIST || m_iTeam == CT) ? m_iTeam : 0;
+
+	if (pTo)
+	{
+		MESSAGE_BEGIN(MSG_ONE, gmsgPokeHP, nullptr, pTo);
+	}
+	else
+	{
+		MESSAGE_BEGIN(MSG_ALL, gmsgPokeHP);
+	}
+
+	WRITE_BYTE(index & 0xFF);
+	WRITE_BYTE((index >> 8) & 0xFF);
+	WRITE_BYTE(percent);
+	WRITE_BYTE(m_iSpecies);
+	WRITE_BYTE(team);
+	WRITE_BYTE(pOwner ? pOwner->entindex() : 0);
+	MESSAGE_END();
+
+	if (!pTo)
+		m_iHealthSent = percent;
+}
+
+void CPokemon::Flash(const Vector &vecPos, int r, int g, int b)
+{
+	PK_FxFlash(vecPos, PK_FLASH_SCALE, PK_FLASH_BRIGHTNESS, PK_FLASH_MIN_HEIGHT, edict());
+	PK_FxLight(vecPos, 14, r, g, b, 3, 50);
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Friends and enemies
+
+bool CPokemon::IsEnemy(CBaseEntity *pEntity)
+{
+	if (!pEntity || pEntity == this)
+		return false;
+
+	CBasePlayer *pOwner = Owner();
+
+	if (pEntity->IsPlayer())
+	{
+		CBasePlayer *pPlayer = static_cast<CBasePlayer *>(pEntity);
+		if (pPlayer == pOwner || !PK_PlayerPlaying(pPlayer))
+			return false;
+
+		if (PK_FreeForAll())
+			return true;
+
+		// (a teammate only as the target it was set on, with friendly fire: one who hurt it or its player)
+		if (pPlayer->m_iTeam == m_iTeam)
+			return friendlyfire.value != 0.0f && m_hEnemy.IsValid() && m_hEnemy == pEntity;
+
+		return true;
+	}
+
+	if (PK_IsPokemon(pEntity->pev))
+	{
+		CPokemon *pOther = static_cast<CPokemon *>(pEntity);
+		if (!pOther->IsAlive() || (pOwner && pOther->IsOwnedBy(pOwner)))
+			return false;
+
+		if (PK_FreeForAll())
+			return true;
+
+		if (pOther->m_iTeam == m_iTeam)
+			return friendlyfire.value != 0.0f && m_hEnemy.IsValid() && m_hEnemy == pEntity;
+
+		return true;
+	}
+
+	return false;
+}
+
+bool CPokemon::CanBeHurtBy(CBaseEntity *pAttacker)
+{
+	if (!pAttacker || !pAttacker->IsPlayer())
+		return true; // (the world: falls, hazards)
+
+	CBasePlayer *pPlayer = static_cast<CBasePlayer *>(pAttacker);
+	if (IsOwnedBy(pPlayer))
+		return false;
+
+	if (PK_FreeForAll() || pPlayer->m_iTeam != m_iTeam)
+		return true;
+
+	return friendlyfire.value != 0.0f;
+}
+
+bool CPokemon::CanSee(CBaseEntity *pEntity)
+{
+	TraceResult tr;
+	Vector vecEye = pev->origin + pev->view_ofs;
+
+	UTIL_TraceLine(vecEye, pEntity->Center(), ignore_monsters, edict(), &tr);
+	if (tr.flFraction >= 1.0f || tr.pHit == pEntity->edict())
+		return true;
+
+	UTIL_TraceLine(vecEye, pEntity->EyePosition(), ignore_monsters, edict(), &tr);
+	return tr.flFraction >= 1.0f || tr.pHit == pEntity->edict();
+}
+
+void CPokemon::SetEnemy(CBaseEntity *pEnemy)
+{
+	if (!pEnemy)
+		return;
+
+	bool bNew = !(m_hEnemy.IsValid() && m_hEnemy == pEnemy);
+	m_hEnemy = pEnemy;
+	m_flEnemySeen = gpGlobals->time;
+	m_bKilledEnemy = false;
+
+	if (bNew)
+	{
+		m_flEnemySince = gpGlobals->time;
+		m_path.Invalidate();
+		m_flNextRepath = 0.0f;
+	}
+
+	if (m_iState == STATE_FOLLOW || m_iState == STATE_VICTORY)
+		SetState(STATE_CHASE);
+
+	// (its call as it charges)
+	if (bNew && gpGlobals->time >= m_flNextBattleCry)
+	{
+		EMIT_SOUND_DYN(ENT(pev), CHAN_VOICE, PK_Info(m_iSpecies).sndCry2, 0.9f, ATTN_NORM, 0, PITCH_NORM + RANDOM_LONG(-4, 4));
+		m_flNextBattleCry = gpGlobals->time + 4.0f;
+	}
+}
+
+// The enemy nearest to its player's aim that its player sees
+CBaseEntity *CPokemon::FindAimTarget(CBasePlayer *pOwner)
+{
+	// (its own vectors: called from its player's SetAnimation, in the middle of weapon code reading gpGlobals->v_forward)
+	Vector vecAim;
+	UTIL_MakeVectorsPrivate(pOwner->pev->v_angle + pOwner->pev->punchangle, vecAim, nullptr, nullptr);
+	const Vector vecEye = pOwner->EyePosition();
+	const float flCone = PK_AGGRO_CONE * (M_PI / 180.0f);
+
+	CBaseEntity *pBest = nullptr;
+	float flBest = flCone;
+
+	auto consider = [&](CBaseEntity *pEntity)
+	{
+		if (!IsEnemy(pEntity))
+			return;
+
+		Vector vecTo = pEntity->Center() - vecEye;
+		float flDist = vecTo.Length();
+		if (flDist < 1.0f || flDist > PK_AGGRO_RANGE)
+			return;
+
+		float flCos = clamp(float(DotProduct(vecTo / flDist, vecAim)), -1.0f, 1.0f);
+		float flOff = Q_acos(flCos) - Q_atan2(PK_TARGET_RADIUS, flDist);
+		if (flOff >= flBest)
+			return;
+
+		TraceResult tr;
+		UTIL_TraceLine(vecEye, pEntity->Center(), ignore_monsters, pOwner->edict(), &tr);
+		if (tr.flFraction < 1.0f && tr.pHit != pEntity->edict())
+			return;
+
+		pBest = pEntity;
+		flBest = flOff;
+	};
+
+	for (int i = 1; i <= gpGlobals->maxClients; i++)
+	{
+		CBasePlayer *pPlayer = UTIL_PlayerByIndex(i);
+		if (pPlayer)
+			consider(pPlayer);
+	}
+
+	CBaseEntity *pEntity = nullptr;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "monster_pokemon")))
+		consider(pEntity);
+
+	return pBest;
+}
+
+void CPokemon::OnOwnerAttack()
+{
+	if (!IsOut() || gpGlobals->time < m_flNextAimCheck)
+		return;
+
+	m_flNextAimCheck = gpGlobals->time + 0.2f;
+
+	CBasePlayer *pOwner = Owner();
+	if (!PK_PlayerPlaying(pOwner))
+		return;
+
+	CBaseEntity *pTarget = FindAimTarget(pOwner);
+	if (pTarget)
+		SetEnemy(pTarget);
+}
+
+// Hurt, or its player hurt, by this one
+void CPokemon::OnProvoked(CBaseEntity *pAggressor)
+{
+	if (!IsOut() || !pAggressor)
+		return;
+
+	// (with friendly fire, a teammate who hurt it or its player becomes a target)
+	bool bTeammateAttack = false;
+	if (friendlyfire.value != 0.0f && !PK_FreeForAll())
+	{
+		if (pAggressor->IsPlayer() && PK_PlayerPlaying(static_cast<CBasePlayer *>(pAggressor)) && !IsOwnedBy(static_cast<CBasePlayer *>(pAggressor))
+			&& static_cast<CBasePlayer *>(pAggressor)->m_iTeam == m_iTeam)
+			bTeammateAttack = true;
+	}
+
+	if (!bTeammateAttack && !IsEnemy(pAggressor))
+		return;
+
+	// (keeps on a target it fights, seen and set on lately)
+	if (m_hEnemy.IsValid() && !(m_hEnemy == pAggressor) && IsEnemy(m_hEnemy) && gpGlobals->time - m_flEnemySeen < 1.0f && gpGlobals->time - m_flEnemySince < 2.0f)
+		return;
+
+	SetEnemy(pAggressor);
+}
+
+// The target: still alive, an enemy, in reach, seen lately
+bool CPokemon::CheckEnemy()
+{
+	CBaseEntity *pEnemy = m_hEnemy;
+	if (!pEnemy)
+		return false;
+
+	if (!IsEnemy(pEnemy) || (pEnemy->Center() - Center()).Length() > PK_LOSE_RANGE)
+	{
+		m_hEnemy = nullptr;
+		return false;
+	}
+
+	if (CanSee(pEnemy))
+		m_flEnemySeen = gpGlobals->time;
+	else if (gpGlobals->time - m_flEnemySeen > PK_LOSE_SIGHT)
+	{
+		m_hEnemy = nullptr;
+		return false;
+	}
+
+	return true;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Damage taken
+
+void CPokemon::TraceAttack(entvars_t *pevAttacker, float flDamage, Vector vecDir, TraceResult *ptr, int bitsDamageType)
+{
+	if (!IsAlive() || !CanBeHurtBy(CBaseEntity::Instance(pevAttacker)))
+		return;
+
+	CBaseMonster::TraceAttack(pevAttacker, flDamage, vecDir, ptr, bitsDamageType);
+
+	// (the bloodless ones spark where they are hit)
+	if (BloodColor() == DONT_BLEED && (bitsDamageType & (DMG_BULLET | DMG_SLASH | DMG_CLUB)) && RANDOM_LONG(0, 2) == 0)
+		PK_FxSparks(ptr->vecEndPos - vecDir * 4.0f);
+}
+
+BOOL CPokemon::TakeDamage(entvars_t *pevInflictor, entvars_t *pevAttacker, float flDamage, int bitsDamageType)
+{
+	if (!IsAlive() || pev->takedamage == DAMAGE_NO || flDamage <= 0.0f)
+		return FALSE;
+
+	CBaseEntity *pAttacker = pevAttacker ? CBaseEntity::Instance(pevAttacker) : nullptr;
+	if (!CanBeHurtBy(pAttacker))
+		return FALSE;
+
+	pev->health -= flDamage;
+
+	if (pev->health <= 0.0f)
+	{
+		pev->health = 0.0f;
+		Killed(pevAttacker, GIB_NEVER);
+		return TRUE;
+	}
+
+	int percent = clamp(int(ceil(pev->health * 100.0f / pev->max_health)), 1, 100);
+	if (percent != m_iHealthSent)
+		SendHealth(nullptr);
+
+	// (a flinch and a cry, not too often, and not in the middle of its attack)
+	if (gpGlobals->time >= m_flNextFlinch)
+	{
+		m_flNextFlinch = gpGlobals->time + PK_FLINCH_EVERY;
+		EMIT_SOUND_DYN(ENT(pev), CHAN_VOICE, PK_Info(m_iSpecies).sndHurt, VOL_NORM, ATTN_NORM, 0, PITCH_NORM + RANDOM_LONG(-5, 5));
+
+		if (m_iState != STATE_ATTACK && m_iState != STATE_SPAWNING)
+		{
+			SetSeq(SEQ_FLINCH, 1.0f, true);
+			m_flFlinchEnd = gpGlobals->time + clamp(m_flSeqDuration[SEQ_FLINCH], 0.2f, 0.6f);
+		}
+	}
+
+	// (turns on what hurt it: an enemy Pokemon itself, else its player)
+	CBaseEntity *pInflictor = pevInflictor ? CBaseEntity::Instance(pevInflictor) : nullptr;
+	OnProvoked((pInflictor && PK_IsPokemon(pInflictor->pev)) ? pInflictor : pAttacker);
+	return TRUE;
+}
+
+void CPokemon::Killed(entvars_t *pevAttacker, int iGib)
+{
+	if (m_iState == STATE_DYING || m_iState == STATE_RETURNING)
+		return;
+
+	SetState(STATE_DYING);
+	pev->deadflag = DEAD_DYING;
+	pev->takedamage = DAMAGE_NO;
+	pev->solid = SOLID_NOT;
+	pev->health = 0.0f;
+	pev->renderfx = kRenderFxNone;
+	pev->velocity.x = pev->velocity.y = 0.0f;
+	UTIL_SetOrigin(pev, pev->origin);
+
+	m_hEnemy = nullptr;
+	ClearAfflictions();
+	SetSeq(SEQ_DIE, 1.0f, true);
+	EMIT_SOUND_DYN(ENT(pev), CHAN_VOICE, PK_Info(m_iSpecies).sndDie, VOL_NORM, ATTN_NORM, 0, PITCH_NORM);
+	SendHealth(nullptr);
+
+	m_flDeathTime = gpGlobals->time;
+	SetThink(&CPokemon::DeadThink);
+	pev->nextthink = gpGlobals->time + PK_THINK_INTERVAL;
+}
+
+// Lies there a while, then fades out
+void CPokemon::DeadThink()
+{
+	StudioFrameAdvance();
+	pev->nextthink = gpGlobals->time + PK_THINK_INTERVAL;
+
+	float flSince = gpGlobals->time - m_flDeathTime;
+	if (flSince < PK_CORPSE_TIME)
+		return;
+
+	pev->rendermode = kRenderTransTexture;
+	pev->renderamt = clamp(255.0f * (1.0f - (flSince - PK_CORPSE_TIME) / PK_FADE_TIME), 0.0f, 255.0f);
+	if (pev->renderamt <= 0.0f)
+		UTIL_Remove(this);
+}
+
+void CPokemon::GoBack()
+{
+	if (m_iState == STATE_RETURNING)
+		return;
+
+	bool bWasOut = IsOut();
+	SetState(STATE_RETURNING);
+	pev->takedamage = DAMAGE_NO;
+	pev->solid = SOLID_NOT;
+	pev->velocity = g_vecZero;
+	m_hEnemy = nullptr;
+	ClearAfflictions();
+
+	// (a red light draws it back into its ball)
+	pev->renderfx = kRenderFxGlowShell;
+	pev->rendercolor = Vector(255, 50, 40);
+	pev->renderamt = 14;
+	EMIT_SOUND(ENT(pev), CHAN_ITEM, "pokemon/ball_return.wav", VOL_NORM, ATTN_NORM);
+	PK_FxLight(Center(), 14, 255, 50, 40, 4, 40);
+	PK_FxReturnFlash(Center(), clamp((pev->maxs.z - pev->mins.z) / 160.0f, 0.25f, 0.45f), PK_FLASH_MIN_HEIGHT, edict());
+
+	if (bWasOut)
+		SendHealth(nullptr);
+
+	m_flStateEnd = gpGlobals->time + PK_RETURN_TIME;
+	SetThink(&CPokemon::ReturnThink);
+	pev->nextthink = gpGlobals->time + PK_THINK_INTERVAL;
+}
+
+void CPokemon::ReturnThink()
+{
+	StudioFrameAdvance();
+	pev->nextthink = gpGlobals->time + PK_THINK_INTERVAL;
+
+	float flLeft = m_flStateEnd - gpGlobals->time;
+	pev->rendermode = kRenderTransTexture;
+	pev->renderamt = clamp(255.0f * flLeft / PK_RETURN_TIME, 0.0f, 255.0f);
+
+	if (flLeft <= 0.0f)
+	{
+		PK_FxLight(Center(), 12, 255, 60, 40, 3, 50);
+		UTIL_Remove(this);
+	}
+}
+
+void CPokemon::Vanish()
+{
+	bool bWasOut = IsOut();
+	SetState(STATE_RETURNING);
+	ClearAfflictions();
+	if (bWasOut)
+		SendHealth(nullptr);
+
+	SetThink(nullptr);
+	UTIL_Remove(this);
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Burns (Charizard's; Pikachu's slows are its victims' own)
+
+void CPokemon::ClearAfflictions()
+{
+	for (int i = 0; i < PK_MAX_AFFLICTED; i++)
+	{
+		PokemonAffliction &a = m_afflicted[i];
+
+		a.hVictim = nullptr;
+		a.flUntil = 0.0f;
+		a.flNext = 0.0f;
+	}
+}
+
+void CPokemon::Afflict(CBaseEntity *pVictim, float flUntil, float flFirstTick)
+{
+	int iFree = -1;
+	for (int i = 0; i < PK_MAX_AFFLICTED; i++)
+	{
+		PokemonAffliction &a = m_afflicted[i];
+		if (a.hVictim.IsValid() && a.hVictim == pVictim)
+		{
+			// (burnt again: no burn tick before the new stream is over)
+			a.flUntil = Q_max(a.flUntil, flUntil);
+			a.flNext = Q_max(a.flNext, flFirstTick);
+			return;
+		}
+
+		if (iFree < 0 && !a.hVictim.IsValid())
+			iFree = i;
+	}
+
+	if (iFree < 0)
+		return; // (as many as it can follow)
+
+	PokemonAffliction &a = m_afflicted[iFree];
+	a.hVictim = pVictim;
+	a.flUntil = flUntil;
+	a.flNext = flFirstTick;
+}
+
+void CPokemon::UpdateAfflictions()
+{
+	const float now = gpGlobals->time;
+	for (int i = 0; i < PK_MAX_AFFLICTED; i++)
+	{
+		PokemonAffliction &a = m_afflicted[i];
+		CBaseEntity *pVictim = a.hVictim;
+		if (!pVictim)
+			continue;
+
+		bool bAlive = pVictim->IsPlayer() ? PK_PlayerPlaying(static_cast<CBasePlayer *>(pVictim)) : pVictim->IsAlive();
+
+		// (Charizard's burn, once its stream is over: small hits while it lasts — every one, the last included, whatever
+		// the think times — and a flame on the victim)
+		if (!bAlive)
+		{
+			a.hVictim = nullptr;
+			continue;
+		}
+
+		if (now < a.flNext - PK_BURN_TICK)
+			continue;
+
+		// (on its body, below the eyes)
+		if (RANDOM_LONG(0, 1))
+			PK_FxFlame(pVictim->Center() + Vector(RANDOM_FLOAT(-8, 8), RANDOM_FLOAT(-8, 8), RANDOM_FLOAT(-22, 0)), 6.0f, 28);
+
+		while (a.hVictim.IsValid() && now >= a.flNext && a.flNext <= a.flUntil + 0.01f)
+		{
+			a.flNext += PK_BURN_TICK;
+			DealDamage(pVictim, PK_BURN_DAMAGE, DMG_BURN);
+		}
+
+		if (a.flNext > a.flUntil + 0.01f)
+			a.hVictim = nullptr;
+	}
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Thinking
+
+void CPokemon::LiveThink()
+{
+	const float now = gpGlobals->time;
+	float dt = clamp(now - m_flLastThink, 0.0f, 0.25f);
+	m_flLastThink = now;
+	pev->nextthink = now + PK_THINK_INTERVAL;
+
+	StudioFrameAdvance();
+
+	if (!IsInWorld())
+	{
+		Vanish();
+		return;
+	}
+
+	// (its player gone, dead or on the other side: back into the ball)
+	CBasePlayer *pOwner = Owner();
+	if (!PK_PlayerPlaying(pOwner) || pOwner->m_iTeam != m_iTeam)
+	{
+		GoBack();
+		return;
+	}
+
+	if (m_flGlowEnd && now >= m_flGlowEnd)
+	{
+		pev->renderfx = kRenderFxNone;
+		m_flGlowEnd = 0.0f;
+	}
+	else if (m_flGlowEnd)
+	{
+		float flLeft = clamp((m_flGlowEnd - now) / PK_SPAWN_GLOW_TIME, 0.0f, 1.0f);
+		pev->rendercolor = PK_SpawnGlowColour(flLeft);
+		pev->renderamt = Q_max(1.0f, PK_SPAWN_GLOW_AMOUNT * flLeft);
+	}
+
+	// (on its feet: still between steps; knocked or jumping: the physics carries it)
+	if ((pev->flags & FL_ONGROUND) && now >= m_flKnockbackEnd && now >= m_flAirborneEnd)
+	{
+		pev->velocity.x = pev->velocity.y = 0.0f;
+		if (pev->velocity.z < 0.0f)
+			pev->velocity.z = 0.0f;
+	}
+
+	UpdateAfflictions();
+	m_flSpeedNow = 0.0f;
+
+	if (m_iState == STATE_SPAWNING)
+	{
+		if (now >= m_flStateEnd)
+			SetState(STATE_FOLLOW);
+		else
+			return;
+	}
+
+	bool bHasEnemy = CheckEnemy();
+
+	if (m_iState == STATE_ATTACK)
+	{
+		UpdateAttack();
+		return;
+	}
+
+	if (m_iState == STATE_VICTORY)
+	{
+		if (now < m_flStateEnd && !bHasEnemy)
+			return;
+
+		SetState(STATE_FOLLOW);
+	}
+
+	// (a flinch holds it a moment)
+	if (now < m_flFlinchEnd)
+		return;
+
+	if (bHasEnemy)
+	{
+		if (m_iState != STATE_CHASE)
+			SetState(STATE_CHASE);
+
+		Chase(dt);
+	}
+	else
+	{
+		// (its target down by its hand while it chased it — a burn, after its attack: a little celebration)
+		if (m_iState == STATE_CHASE && StartVictory())
+			return;
+
+		if (m_iState != STATE_FOLLOW)
+			SetState(STATE_FOLLOW);
+
+		Follow(pOwner, dt);
+	}
+
+	// (stuck: next to its player again — given up on its target first)
+	if (m_flStuckTime >= PK_STUCK_TIME)
+	{
+		if (CVAR_GET_FLOAT("developer") >= 2.0f)
+		{
+			// (what is in its way, for the logs)
+			TraceResult trLow, trHigh;
+			Vector vecFwd;
+			UTIL_MakeVectorsPrivate(Vector(0, UTIL_VecToYaw(m_vecWaypoint - pev->origin), 0), vecFwd, nullptr, nullptr);
+			TRACE_MONSTER_HULL(edict(), pev->origin + Vector(0, 0, 2), pev->origin + Vector(0, 0, 2) + vecFwd * 24.0f, dont_ignore_monsters, edict(), &trLow);
+			TRACE_MONSTER_HULL(edict(), pev->origin + Vector(0, 0, 20), pev->origin + Vector(0, 0, 20) + vecFwd * 24.0f, dont_ignore_monsters, edict(), &trHigh);
+			TraceResult trFloor;
+			TRACE_MONSTER_HULL(edict(), pev->origin + Vector(0, 0, 2) + vecFwd * 24.0f, pev->origin + vecFwd * 24.0f - Vector(0, 0, 400), ignore_monsters, edict(), &trFloor);
+			Vector vecSave = pev->origin;
+			int iWalk = WALK_MOVE(edict(), UTIL_VecToYaw(m_vecWaypoint - pev->origin), 16.0f, WALKMOVE_CHECKONLY);
+			UTIL_SetOrigin(pev, vecSave);
+			ALERT(at_aiconsole, "pokemon #%d: floor ahead %.1f (start %d frac %.2f n%.2f), walk %d, yaw %.0f\n", entindex(), trFloor.vecEndPos.z, trFloor.fStartSolid, trFloor.flFraction, trFloor.vecPlaneNormal.z, iWalk, pev->angles.y);
+			ALERT(at_aiconsole, "pokemon #%d: stuck at %.0f %.0f %.0f (%s, path %d/%d, waypoint %.0f %.0f %.0f; ahead low %.2f n%.2f %s, high %.2f %s; onground %d)\n",
+				entindex(), pev->origin.x, pev->origin.y, pev->origin.z, PK_StateNames[m_iState], m_path.IsValid() ? m_iPathIndex : 0,
+				m_path.IsValid() ? m_path.GetSegmentCount() : 0, m_vecWaypoint.x, m_vecWaypoint.y, m_vecWaypoint.z,
+				trLow.flFraction, trLow.vecPlaneNormal.z, trLow.pHit ? STRING(trLow.pHit->v.classname) : "-", trHigh.flFraction, trHigh.pHit ? STRING(trHigh.pHit->v.classname) : "-",
+				(pev->flags & FL_ONGROUND) ? 1 : 0);
+		}
+
+		m_flStuckTime = 0.0f;
+		if (m_iState == STATE_CHASE)
+		{
+			m_hEnemy = nullptr;
+			SetState(STATE_FOLLOW);
+		}
+		else
+			TeleportToOwner(pOwner);
+	}
+
+	// (now and then, a call)
+	if (m_iState == STATE_FOLLOW && !m_bFollowMoving && now >= m_flNextIdleSound)
+	{
+		EMIT_SOUND_DYN(ENT(pev), CHAN_VOICE, PK_Info(m_iSpecies).sndCry, 0.55f, ATTN_IDLE, 0, PITCH_NORM + RANDOM_LONG(-3, 3));
+		m_flNextIdleSound = now + RANDOM_FLOAT(15.0f, 30.0f);
+	}
+}
+
+void CPokemon::Follow(CBasePlayer *pOwner, float dt)
+{
+	const PokemonInfo &info = PK_Info(m_iSpecies);
+	Vector vecGoal = PK_Feet(pOwner);
+	float flDist = (vecGoal - pev->origin).Length();
+
+	if (flDist > PK_TELEPORT_DIST)
+	{
+		TeleportToOwner(pOwner);
+		return;
+	}
+
+	if (m_bFollowMoving)
+	{
+		if (flDist < PK_FOLLOW_NEAR && CanSee(pOwner))
+			m_bFollowMoving = false;
+	}
+	else if (flDist > PK_FOLLOW_FAR)
+		m_bFollowMoving = true;
+
+	if (m_bFollowMoving)
+	{
+		// (runs to catch up, walks when close)
+		float flSpeed = info.walkSpeed;
+		if (flDist > PK_FOLLOW_RUN)
+			flSpeed = info.runSpeed;
+		else if (flDist > PK_FOLLOW_FAR + 40.0f)
+			flSpeed = clamp(float(pOwner->pev->velocity.Length2D()) + 40.0f, info.walkSpeed, info.runSpeed);
+
+		MoveTo(vecGoal, flSpeed, PK_FOLLOW_NEAR - 20.0f, dt);
+		NoteProgress(true);
+		UpdateAnimation(m_flSpeedNow);
+		return;
+	}
+
+	NoteProgress(false);
+
+	// (makes way for its player walking into it)
+	Vector2D vecAway = (pev->origin - pOwner->pev->origin).Make2D();
+	if (flDist < PK_FOLLOW_TOO_CLOSE && vecAway.Length() > 0.1f && DotProduct(pOwner->pev->velocity.Make2D(), vecAway) > 0.0f)
+	{
+		Vector2D dir = vecAway.Normalize();
+		Vector vecAside = pev->origin + Vector(dir.x, dir.y, 0) * 64.0f;
+		MoveTo(vecAside, info.walkSpeed, 8.0f, dt);
+		UpdateAnimation(m_flSpeedNow);
+		return;
+	}
+
+	// (stands by, looking where its player looks)
+	TurnTowards(pOwner->pev->v_angle.y, dt, info.yawSpeed * 0.25f);
+	UpdateAnimation(0.0f);
+}
+
+void CPokemon::Chase(float dt)
+{
+	const PokemonInfo &info = PK_Info(m_iSpecies);
+	CBaseEntity *pEnemy = m_hEnemy;
+
+	Vector vecTarget = pEnemy->Center();
+	Vector vecFrom = pev->origin + pev->view_ofs;
+	float flDist = (vecTarget - vecFrom).Length() - PK_TARGET_RADIUS;
+	bool bSeen = (m_flEnemySeen == gpGlobals->time);
+
+	if (flDist <= PK_ATTACK_RANGE && bSeen)
+	{
+		// (in reach: faces it, attacks when ready)
+		float flYaw = UTIL_VecToYaw(vecTarget - pev->origin);
+		TurnTowards(flYaw, dt, info.yawSpeed);
+		NoteProgress(false);
+		UpdateAnimation(0.0f);
+
+		if (gpGlobals->time >= m_flNextAttack && Q_fabs(UTIL_AngleDiff(flYaw, pev->angles.y)) < 20.0f)
+			StartAttack();
+
+		return;
+	}
+
+	MoveTo(PK_Feet(pEnemy), info.runSpeed, 0.0f, dt);
+	NoteProgress(true);
+	UpdateAnimation(m_flSpeedNow);
+}
+
+void CPokemon::TurnTowards(float flYaw, float dt, float flRate)
+{
+	pev->angles.x = 0.0f;
+	pev->angles.z = 0.0f;
+	pev->angles.y = UTIL_ApproachAngle(flYaw, pev->angles.y, flRate * dt);
+}
+
+// Its gait matched to its pace: walk or run, played as fast as it covers ground
+void CPokemon::UpdateAnimation(float flSpeed)
+{
+	if (gpGlobals->time < m_flFlinchEnd)
+		return;
+
+	const PokemonInfo &info = PK_Info(m_iSpecies);
+	if (flSpeed < 8.0f && (pev->flags & FL_ONGROUND))
+	{
+		SetSeq(SEQ_IDLE, 1.0f, false);
+		return;
+	}
+
+	int iSeq = (flSpeed > (info.walkSpeed + info.runSpeed) * 0.5f) ? SEQ_RUN : SEQ_WALK;
+	float flGround = m_flSeqGroundSpeed[iSeq];
+	float flRate = flGround > 1.0f ? clamp(flSpeed / flGround, 0.4f, 2.5f) : 1.0f;
+	if (!(pev->flags & FL_ONGROUND))
+		flRate = 1.0f; // (in the air)
+
+	SetSeq(iSeq, flRate, false);
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Movement: steps of the engine's monster walk (stairs, slopes, no walking off ledges), turned smoothly, along the
+// bots' navigation mesh when the map has one; jumps up and drops down when its way needs it
+
+// Steps of the walk toward a point (the distance covered): blocked straight ahead, it jumps up or drops down when its
+// way needs it, else slides along what blocks it
+float CPokemon::Step(float flYaw, float flDist, const Vector &vecPoint, float flSpeed, bool &bLeapt)
+{
+	static const float deflections[] = { 35.0f, -35.0f, 70.0f, -70.0f };
+	Vector vecStart = pev->origin;
+	bLeapt = false;
+
+	float flLeft = flDist;
+	while (flLeft > 0.1f)
+	{
+		float flStep = Q_min(16.0f, flLeft); // (more and stairs stop working)
+		if (!WALK_MOVE(edict(), flYaw, flStep, WALKMOVE_NORMAL) && !EdgeStep(flYaw, flStep))
+		{
+			if (TryJumpOrDrop(flYaw, vecPoint, flSpeed))
+			{
+				bLeapt = true;
+				break;
+			}
+
+			bool bMoved = false;
+			for (int i = 0; i < int(ARRAYSIZE(deflections)) && !bMoved; i++)
+				bMoved = WALK_MOVE(edict(), flYaw + deflections[i], flStep * 0.7f, WALKMOVE_NORMAL) != 0;
+
+			if (!bMoved)
+				break;
+		}
+
+		flLeft -= flStep;
+	}
+
+	return (pev->origin - vecStart).Length2D();
+}
+
+// The walk refuses a step with a corner of the hull over a drop; a player walks there, along a ledge or a narrow way:
+// so does it, while the middle of its step has ground within a step under it
+bool CPokemon::EdgeStep(float flYaw, float flStep)
+{
+	Vector vecFwd;
+	UTIL_MakeVectorsPrivate(Vector(0, flYaw, 0), vecFwd, nullptr, nullptr);
+	Vector vecMid = pev->origin + vecFwd * flStep;
+
+	TraceResult tr;
+	UTIL_TraceLine(vecMid + Vector(0, 0, 18), vecMid - Vector(0, 0, 20), ignore_monsters, edict(), &tr);
+	if (tr.fStartSolid || tr.flFraction >= 1.0f)
+		return false;
+
+	pev->flags |= FL_PARTIALGROUND;
+	bool bMoved = WALK_MOVE(edict(), flYaw, flStep, WALKMOVE_NORMAL) != 0;
+	pev->flags &= ~FL_PARTIALGROUND;
+	pev->flags |= FL_ONGROUND; // (its middle is on the ground)
+	return bMoved;
+}
+
+bool CPokemon::DirectlyReachable(const Vector &vecGoal)
+{
+	if (Q_fabs(vecGoal.z - pev->origin.z) > 40.0f)
+		return false;
+
+	TraceResult tr;
+	TRACE_MONSTER_HULL(edict(), pev->origin + Vector(0, 0, 18), vecGoal + Vector(0, 0, 18), ignore_monsters, edict(), &tr);
+	return !tr.fStartSolid && tr.flFraction >= 1.0f;
+}
+
+// The point to head for: straight to the goal when it is in reach, else along a path on the navigation mesh
+bool CPokemon::NextWaypoint(const Vector &vecGoal, Vector &vecPoint)
+{
+	vecPoint = vecGoal;
+
+	if (TheNavAreaList.empty() || DirectlyReachable(vecGoal))
+	{
+		m_path.Invalidate();
+		return true;
+	}
+
+	// (computed again sparingly: when the goal moved away from the path's end, or the path ran out)
+	const float now = gpGlobals->time;
+	bool bStale = !m_path.IsValid() || m_iPathIndex >= m_path.GetSegmentCount() || (vecGoal - m_vecPathGoal).Length() > 120.0f;
+	if (bStale && now >= m_flNextRepath)
+	{
+		PokemonPathCost cost(PK_Info(m_iSpecies).maxs.z > 40.0f);
+		Vector vecStart = pev->origin + Vector(0, 0, 16);
+		Vector vecEnd = vecGoal + Vector(0, 0, 16);
+		m_vecPathGoal = vecGoal;
+		m_iPathIndex = 1;
+		m_flNextRepath = now + 1.0f;
+		if (!m_path.Compute(&vecStart, &vecEnd, cost))
+		{
+			m_path.Invalidate();
+			m_flNextRepath = now + 0.5f;
+		}
+	}
+
+	if (!m_path.IsValid())
+		return true;
+
+	// (past the points reached, and the next one when it is in a straight line)
+	int count = m_path.GetSegmentCount();
+	while (m_iPathIndex < count && (m_path[m_iPathIndex]->pos - pev->origin).Length2D() < 24.0f)
+		m_iPathIndex++;
+
+	if (m_iPathIndex + 1 < count && DirectlyReachable(m_path[m_iPathIndex + 1]->pos))
+		m_iPathIndex++;
+
+	if (m_iPathIndex >= count)
+		return true;
+
+	vecPoint = m_path[m_iPathIndex]->pos;
+	return true;
+}
+
+// Toward a goal at a pace, stopping at a distance; the distance covered
+float CPokemon::MoveTo(const Vector &vecGoal, float flSpeed, float flStopDist, float dt)
+{
+	const PokemonInfo &info = PK_Info(m_iSpecies);
+	const float now = gpGlobals->time;
+
+	if (now < m_flSlowEnd)
+		flSpeed *= 0.5f;
+
+	// (in the air: the physics carries it, it only turns)
+	if (!(pev->flags & FL_ONGROUND))
+	{
+		m_flSpeedNow = pev->velocity.Length2D();
+		return 1.0f;
+	}
+
+	Vector vecPoint;
+	NextWaypoint(vecGoal, vecPoint);
+	m_vecWaypoint = vecPoint;
+
+	Vector vecTo = vecPoint - pev->origin;
+	float flDist2D = vecTo.Length2D();
+	if (vecPoint == vecGoal && flDist2D <= flStopDist)
+		return 1.0f;
+
+	float flYaw = UTIL_VecToYaw(vecTo);
+	TurnTowards(flYaw, dt, info.yawSpeed);
+
+	// (slows into sharp turns, turns on the spot past a right angle)
+	float flOff = Q_fabs(UTIL_AngleDiff(flYaw, pev->angles.y));
+	float flFactor = flOff >= 85.0f ? 0.0f : Q_cos(flOff * (M_PI / 180.0f));
+	float flDist = flSpeed * flFactor * dt;
+	if (vecPoint == vecGoal)
+		flDist = Q_min(flDist, flDist2D - flStopDist);
+
+	if (flDist <= 0.5f)
+	{
+		m_flSpeedNow = 0.0f;
+		return flFactor > 0.0f ? 0.0f : 1.0f; // (turning on the spot is not being stuck)
+	}
+
+	bool bLeapt;
+	float flMoved = Step(flYaw, flDist, vecPoint, flSpeed, bLeapt);
+	if (bLeapt)
+		flMoved = flDist;
+
+	// (footsteps)
+	m_flStepDist += flMoved;
+	if (m_flStepDist >= info.stepDistance)
+	{
+		m_flStepDist = 0.0f;
+		EMIT_SOUND_DYN(ENT(pev), CHAN_BODY, "pokemon/pk_step.wav", info.stepVolume, ATTN_STATIC, 0, info.stepPitch + RANDOM_LONG(-6, 6));
+	}
+
+	m_flSpeedNow = dt > 0.0f ? flMoved / dt : 0.0f;
+	return flMoved;
+}
+
+// Blocked: up onto a ledge within a jump, or down from one toward a lower goal
+bool CPokemon::TryJumpOrDrop(float flYaw, const Vector &vecGoal, float flSpeed)
+{
+	TraceResult tr;
+	Vector vecFwd;
+	UTIL_MakeVectorsPrivate(Vector(0, flYaw, 0), vecFwd, nullptr, nullptr);
+
+	const float flJump = 60.0f; // (a little more than a player's: the nav mesh's jumps)
+	if (vecGoal.z > pev->origin.z - 16.0f)
+	{
+		// (something at its feet ahead, else no jump helps)
+		Vector vecLow = pev->origin + Vector(0, 0, 2);
+		TRACE_MONSTER_HULL(edict(), vecLow, vecLow + vecFwd * 20.0f, ignore_monsters, edict(), &tr);
+		if (!tr.fStartSolid && tr.flFraction >= 1.0f)
+			goto drop;
+
+		// (room above it, and over it)
+		Vector vecUp = pev->origin + Vector(0, 0, flJump + 2.0f);
+		TRACE_MONSTER_HULL(edict(), pev->origin, vecUp, ignore_monsters, edict(), &tr);
+		if (tr.fStartSolid || tr.flFraction < 1.0f)
+			return false;
+
+		Vector vecOver = vecUp + vecFwd * 28.0f;
+		TRACE_MONSTER_HULL(edict(), vecUp, vecOver, ignore_monsters, edict(), &tr);
+		if (tr.fStartSolid || tr.flFraction < 1.0f)
+			return false;
+
+		// (the top of the obstacle, and where it lands: not lower than a step down)
+		TRACE_MONSTER_HULL(edict(), vecUp + vecFwd * 14.0f, Vector(pev->origin.x, pev->origin.y, pev->origin.z) + vecFwd * 14.0f, ignore_monsters, edict(), &tr);
+		float flTop = (tr.flFraction < 1.0f && !tr.fStartSolid) ? tr.vecEndPos.z : pev->origin.z;
+
+		TRACE_MONSTER_HULL(edict(), vecOver, vecOver - Vector(0, 0, flJump + 2.0f + 18.0f), ignore_monsters, edict(), &tr);
+		if (tr.fStartSolid || tr.flFraction >= 1.0f)
+			return false;
+
+		float flHeight = Q_max(flTop, float(tr.vecEndPos.z)) - pev->origin.z + 10.0f;
+		if (flHeight > flJump + 2.0f)
+			return false;
+
+		pev->velocity = vecFwd * Q_min(flSpeed, 180.0f);
+		pev->velocity.z = Q_sqrt(2.0f * 800.0f * Q_max(flHeight, 24.0f));
+		pev->flags &= ~FL_ONGROUND;
+		m_flAirborneEnd = gpGlobals->time + 0.3f;
+		return true;
+	}
+
+drop:
+	if (vecGoal.z < pev->origin.z - 20.0f)
+	{
+		// (no wall ahead: an edge the walk does not step over — a ledge, or a corner of it over one — with ground below,
+		// not a pit)
+		Vector vecAhead = pev->origin + Vector(0, 0, 2) + vecFwd * 24.0f;
+		TRACE_MONSTER_HULL(edict(), pev->origin + Vector(0, 0, 2), vecAhead, ignore_monsters, edict(), &tr);
+		if (tr.fStartSolid || tr.flFraction < 1.0f)
+			return false;
+
+		TRACE_MONSTER_HULL(edict(), vecAhead + vecFwd * 16.0f, vecAhead + vecFwd * 16.0f - Vector(0, 0, 400), ignore_monsters, edict(), &tr);
+		if (tr.fStartSolid || tr.flFraction >= 1.0f)
+			return false;
+
+		// (no hurting liquid below)
+		int contents = UTIL_PointContents(tr.vecEndPos + Vector(0, 0, 2));
+		if (contents == CONTENTS_LAVA || contents == CONTENTS_SLIME)
+			return false;
+
+		pev->velocity = vecFwd * Q_min(flSpeed, 200.0f);
+		pev->velocity.z = 60.0f;
+		pev->flags &= ~FL_ONGROUND;
+		m_flAirborneEnd = gpGlobals->time + 0.3f;
+		return true;
+	}
+
+	return false;
+}
+
+// Beside its player again, in a light
+bool CPokemon::TeleportToOwner(CBasePlayer *pOwner)
+{
+	// (tried again in a while when there is no room by its player)
+	if (gpGlobals->time < m_flNextTeleport)
+		return false;
+
+	m_flNextTeleport = gpGlobals->time + 1.0f;
+
+	static const float offsets[][2] = { { -60, 50 }, { -60, -50 }, { 0, 64 }, { 0, -64 }, { -80, 0 }, { 50, 50 }, { 50, -50 }, { 70, 0 } };
+
+	Vector vecFwd, vecRight;
+	UTIL_MakeVectorsPrivate(Vector(0, pOwner->pev->v_angle.y, 0), vecFwd, vecRight, nullptr);
+	Vector vecFeet = PK_Feet(pOwner);
+	Vector vecEye = pOwner->EyePosition();
+	TraceResult tr;
+
+	for (int i = 0; i < int(ARRAYSIZE(offsets)); i++)
+	{
+		Vector vecSpot = vecFeet + vecFwd * offsets[i][0] + vecRight * offsets[i][1];
+
+		UTIL_TraceLine(vecEye, vecSpot + Vector(0, 0, 24), ignore_monsters, pOwner->edict(), &tr);
+		if (tr.flFraction < 1.0f)
+			continue;
+
+		TRACE_MONSTER_HULL(edict(), vecSpot + Vector(0, 0, 24), vecSpot - Vector(0, 0, 64), dont_ignore_monsters, edict(), &tr);
+		if (tr.fStartSolid || tr.fAllSolid || tr.flFraction >= 1.0f)
+			continue;
+
+		ALERT(at_aiconsole, "pokemon #%d: teleported to its player (%.0f units away)\n", entindex(), (pOwner->pev->origin - pev->origin).Length());
+		Flash(pev->origin, 255, 255, 240);
+		UTIL_SetOrigin(pev, tr.vecEndPos);
+		pev->velocity = g_vecZero;
+		pev->angles.y = pOwner->pev->v_angle.y;
+		DROP_TO_FLOOR(edict());
+		Flash(pev->origin, 255, 255, 240);
+
+		m_path.Invalidate();
+		m_flStuckTime = 0.0f;
+		m_bFollowMoving = false;
+		return true;
+	}
+
+	return false;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Attacks: the attack sequence, the hit at 40 % of it
+
+Vector CPokemon::AttackOrigin(int iAttachment)
+{
+	Vector vecOrigin, vecAngles;
+	GetAttachment(iAttachment, vecOrigin, vecAngles);
+
+	// (a model without it: from its eyes)
+	if ((vecOrigin - pev->origin).Length() > 160.0f || vecOrigin == g_vecZero)
+		vecOrigin = pev->origin + pev->view_ofs;
+
+	return vecOrigin;
+}
+
+void CPokemon::StartAttack()
+{
+	const float now = gpGlobals->time;
+	float flDuration = clamp(m_flSeqDuration[SEQ_ATTACK], 0.3f, 3.0f);
+	float flRate = 1.0f;
+
+	// (Pikachu and Blastoise: the sequence fits their rate)
+	float flInterval = (m_iSpecies == PK_PIKACHU) ? PK_ZAP_INTERVAL : PK_HYDRO_INTERVAL;
+	if (m_iSpecies != PK_CHARIZARD && flDuration > flInterval)
+		flRate = flDuration / flInterval;
+
+	SetState(STATE_ATTACK);
+	SetSeq(SEQ_ATTACK, flRate, true);
+
+	m_flAttackStart = now;
+	m_flAttackHit = now + 0.4f * flDuration / flRate;
+	m_flAttackEnd = now + flDuration / flRate;
+	m_bAttackFired = false;
+
+	if (m_iSpecies == PK_CHARIZARD)
+	{
+		// (its stream from the 40 % of the sequence, the rest of which is spread over the stream)
+		m_flStreamEnd = m_flAttackHit + PK_FLAME_STREAM;
+		m_flAttackEnd = m_flStreamEnd;
+		m_flNextAttack = m_flStreamEnd + PK_FLAME_COOLDOWN;
+	}
+	else
+		m_flNextAttack = now + flInterval;
+
+	pev->nextthink = Q_min(pev->nextthink, m_flAttackHit);
+}
+
+void CPokemon::UpdateAttack()
+{
+	const float now = gpGlobals->time;
+	const PokemonInfo &info = PK_Info(m_iSpecies);
+	CBaseEntity *pEnemy = m_hEnemy;
+
+	// (keeps facing its target, slower while it fires)
+	if (pEnemy)
+		TurnTowards(UTIL_VecToYaw(pEnemy->Center() - pev->origin), PK_THINK_INTERVAL, m_bAttackFired ? info.yawSpeed * 0.5f : info.yawSpeed);
+
+	if (!m_bAttackFired)
+	{
+		// (its target gone before the hit: the attack stops)
+		if (!pEnemy && m_iSpecies != PK_CHARIZARD)
+		{
+			if (!StartVictory())
+				SetState(STATE_FOLLOW);
+			return;
+		}
+
+		if (now >= m_flAttackHit - 0.001f)
+		{
+			m_bAttackFired = true;
+			switch (m_iSpecies)
+			{
+			case PK_PIKACHU:   FireThunderbolt(); break;
+			case PK_BLASTOISE: FireHydroPump(); break;
+			case PK_CHARIZARD:
+			{
+				EMIT_SOUND_DYN(ENT(pev), CHAN_WEAPON, info.sndAttack, VOL_NORM, ATTN_NORM, 0, PITCH_NORM);
+				m_flNextFlameTick = now;
+				m_flNextFlameFx = now;
+
+				// (the rest of the sequence spread over the stream)
+				float flLeft = 0.6f * clamp(m_flSeqDuration[SEQ_ATTACK], 0.3f, 3.0f);
+				pev->framerate = clamp(flLeft / PK_FLAME_STREAM, 0.3f, 1.5f);
+				break;
+			}
+			}
+		}
+	}
+
+	if (m_bAttackFired && m_iSpecies == PK_CHARIZARD)
+	{
+		if (now < m_flStreamEnd && now >= m_flNextFlameFx)
+		{
+			FlameEffects();
+			m_flNextFlameFx = now + PK_THINK_INTERVAL - 0.01f;
+		}
+
+		// (every tick of the stream, whatever the think times)
+		while (now >= m_flNextFlameTick && m_flNextFlameTick <= m_flStreamEnd + 0.001f)
+		{
+			FlameTick();
+			m_flNextFlameTick += PK_FLAME_TICK;
+		}
+	}
+
+	if (now >= m_flAttackEnd)
+	{
+		// (its target killed by this attack — the usual end of a fight: a little celebration)
+		if (StartVictory())
+			return;
+
+		SetState(m_hEnemy.IsValid() ? STATE_CHASE : STATE_FOLLOW);
+		SetSeq(SEQ_IDLE, 1.0f, false);
+	}
+}
+
+void CPokemon::DealDamage(CBaseEntity *pVictim, float flDamage, int bitsDamageType)
+{
+	CBasePlayer *pOwner = Owner();
+	if (!pVictim || !pOwner || !pVictim->IsAlive())
+		return;
+
+	// (not a headshot: a body hit, armour as for any)
+	if (pVictim->IsPlayer())
+		static_cast<CBasePlayer *>(pVictim)->m_LastHitGroup = HITGROUP_GENERIC;
+
+	// (its player is the attacker — the kill and its money are its player's — and the Pokemon the inflictor)
+	pVictim->TakeDamage(pev, pOwner->pev, flDamage, bitsDamageType);
+
+	if (!pVictim->IsAlive() && m_hEnemy.IsValid() && m_hEnemy == pVictim)
+		m_bKilledEnemy = true;
+}
+
+// Pikachu: a bolt from its cheeks to its target, which it slows a moment
+void CPokemon::FireThunderbolt()
+{
+	CBaseEntity *pEnemy = m_hEnemy;
+	Vector vecSrc = AttackOrigin(0);
+
+	EMIT_SOUND_DYN(ENT(pev), CHAN_WEAPON, PK_Info(m_iSpecies).sndAttack, VOL_NORM, ATTN_NORM, 0, PITCH_NORM + RANDOM_LONG(-3, 3));
+
+	TraceResult tr;
+	Vector vecEnd;
+	bool bHit = false;
+	if (pEnemy)
+	{
+		vecEnd = pEnemy->Center() + Vector(RANDOM_FLOAT(-4, 4), RANDOM_FLOAT(-4, 4), RANDOM_FLOAT(0, 10));
+		UTIL_TraceLine(vecSrc, vecEnd, ignore_monsters, edict(), &tr);
+		bHit = ((vecEnd - vecSrc).Length() <= PK_ATTACK_RANGE + 2.0f * PK_TARGET_RADIUS) && (tr.flFraction >= 1.0f || tr.pHit == pEnemy->edict());
+		if (!bHit)
+			vecEnd = tr.vecEndPos;
+	}
+	else
+	{
+		Vector vecFwd;
+		UTIL_MakeVectorsPrivate(pev->angles, vecFwd, nullptr, nullptr);
+		UTIL_TraceLine(vecSrc, vecSrc + vecFwd * 96.0f, ignore_monsters, edict(), &tr);
+		vecEnd = tr.vecEndPos;
+	}
+
+	PK_FxBolt(vecSrc, vecEnd);
+	PK_FxLight(vecSrc, 10, 255, 240, 120, 2, 50);
+	PK_FxLight(vecEnd, 15, 255, 230, 100, 3, 60);
+	PK_FxSparks(vecEnd);
+
+	if (!bHit)
+		return;
+
+	DealDamage(pEnemy, PK_ZAP_DAMAGE, DMG_SHOCK);
+
+	// (slowed: half pace a moment)
+	if (pEnemy->IsAlive())
+	{
+		float flUntil = gpGlobals->time + PK_ZAP_SLOW_TIME;
+		if (pEnemy->IsPlayer())
+		{
+			// (the victim's own: several Pikachus' slows overlap, it wears off on its own — CBasePlayer::PreThink)
+			CBasePlayer *pPlayer = static_cast<CBasePlayer *>(pEnemy);
+			pPlayer->m_flPokeSlowUntil = Q_max(pPlayer->m_flPokeSlowUntil, flUntil);
+			pPlayer->ResetMaxSpeed();
+		}
+		else if (PK_IsPokemon(pEnemy->pev))
+		{
+			CPokemon *pOther = static_cast<CPokemon *>(pEnemy);
+			pOther->m_flSlowEnd = Q_max(pOther->m_flSlowEnd, flUntil);
+		}
+	}
+}
+
+// Blastoise: two jets from its cannons, a hit that pushes its target away
+void CPokemon::FireHydroPump()
+{
+	CBaseEntity *pEnemy = m_hEnemy;
+	EMIT_SOUND_DYN(ENT(pev), CHAN_WEAPON, PK_Info(m_iSpecies).sndAttack, VOL_NORM, ATTN_NORM, 0, PITCH_NORM + RANDOM_LONG(-3, 3));
+
+	Vector vecTarget;
+	if (pEnemy)
+		vecTarget = pEnemy->Center();
+	else
+	{
+		Vector vecFwd;
+		UTIL_MakeVectorsPrivate(pev->angles, vecFwd, nullptr, nullptr);
+		vecTarget = pev->origin + pev->view_ofs + vecFwd * 160.0f;
+	}
+
+	bool bHit = false;
+	TraceResult tr;
+	for (int i = 0; i < 2; i++)
+	{
+		Vector vecSrc = AttackOrigin(i);
+		Vector vecEnd = vecTarget + Vector(RANDOM_FLOAT(-5, 5), RANDOM_FLOAT(-5, 5), RANDOM_FLOAT(-4, 8));
+		UTIL_TraceLine(vecSrc, vecEnd, ignore_monsters, edict(), &tr);
+		bool bClear = (tr.flFraction >= 1.0f || (pEnemy && tr.pHit == pEnemy->edict()));
+		if (!bClear)
+			vecEnd = tr.vecEndPos;
+
+		if (pEnemy && bClear && (vecEnd - vecSrc).Length() <= PK_ATTACK_RANGE + 2.0f * PK_TARGET_RADIUS)
+			bHit = true;
+
+		// (the jet: a thin flowing blue core beam, short-lived water puffs along it — small at the cannon, a little
+		// wider downstream —, a small splash short of the target and a few droplets thrown on past it, falling; on a
+		// player the beam and the jet's puffs stop short of him, PK_HYDRO_BEAM_*: seen by him, a beam to his chest
+		// would fill the bottom of his screen; every puff clear of the world, the splash of the crate behind him)
+		Vector vecDir = (vecEnd - vecSrc).Normalize();
+		float flLen = (vecEnd - vecSrc).Length();
+		float flJet = flLen;
+		bool bOnPlayer = (pEnemy && bClear && pEnemy->IsPlayer());
+		if (bOnPlayer)
+			flJet = Q_max(flLen - clamp(PK_HYDRO_SHORT_FRAC * flLen, PK_HYDRO_SHORT_MIN, PK_HYDRO_SHORT_MAX), 0.0f);
+
+		float flEyeFactor = bOnPlayer ? PK_EYE_FACTOR_NEAR : PK_EYE_FACTOR;
+		PK_FxBeam(vecSrc - vecDir * PK_HYDRO_BEAM_BACK, vecSrc + vecDir * flJet, g_sModelIndexLaser, 0, 0, 4,
+			PK_HYDRO_BEAM_WIDTH, 4, 90, 170, 255, PK_HYDRO_BEAM_BRIGHT, 150);
+		PK_FxWater(vecSrc, PK_HYDRO_MUZZLE_RADIUS, 30, flEyeFactor, &vecDir);
+		for (int k = 1; k <= PK_WATER_JET_PUFFS; k++)
+		{
+			float f = (k - 0.5f + RANDOM_FLOAT(-0.3f, 0.3f)) / PK_WATER_JET_PUFFS;
+			PK_FxWater(vecSrc + vecDir * (flJet * f), 4.5f + 0.045f * flJet * f, 30 - 2 * k, flEyeFactor, &vecDir);
+		}
+
+		for (int j = 0; j < 2; j++)
+		{
+			Vector vecJitter(RANDOM_FLOAT(-3, 3), RANDOM_FLOAT(-3, 3), RANDOM_FLOAT(-2, 4));
+			PK_FxWater(vecEnd - vecDir * (8.0f + 6.0f * j) + vecJitter, 11.0f - 3.0f * j, 26, flEyeFactor, &vecDir);
+		}
+
+		PK_FxSpray(vecEnd - vecDir * 4.0f, (vecDir + Vector(0, 0, -0.25f)).Normalize(), s_iSprDrops, 3, 90, 30);
+	}
+
+	if (!bHit)
+		return;
+
+	DealDamage(pEnemy, PK_HYDRO_DAMAGE, DMG_GENERIC);
+
+	// (pushed away from it)
+	if (pEnemy->IsAlive())
+	{
+		Vector2D vecAway = (pEnemy->pev->origin - pev->origin).Make2D();
+		vecAway = vecAway.Length() > 0.1f ? vecAway.Normalize() : Vector2D(1, 0);
+		float flPush = PK_HYDRO_KNOCKBACK;
+		float flLift = PK_HYDRO_LIFT;
+		if (PK_IsPokemon(pEnemy->pev))
+		{
+			// (a Pokemon by its weight, barely lifted: pushed back along the ground, not onto crates)
+			CPokemon *pOther = static_cast<CPokemon *>(pEnemy);
+			flPush *= PK_Info(pOther->m_iSpecies).knockback;
+			flLift = PK_HYDRO_LIFT_POKEMON;
+			pOther->m_flKnockbackEnd = gpGlobals->time + 0.5f;
+		}
+
+		pEnemy->pev->velocity.x += vecAway.x * flPush;
+		pEnemy->pev->velocity.y += vecAway.y * flPush;
+		pEnemy->pev->velocity.z = Q_max(float(pEnemy->pev->velocity.z), flLift);
+		pEnemy->pev->flags &= ~FL_ONGROUND;
+	}
+}
+
+// Charizard: a tick of its stream, on the enemies in its cone
+void CPokemon::FlameTick()
+{
+	Vector vecMouth = AttackOrigin(0);
+	CBaseEntity *pEnemy = m_hEnemy;
+
+	Vector vecAim;
+	if (pEnemy)
+		vecAim = (pEnemy->Center() - vecMouth).Normalize();
+	else
+	{
+		UTIL_MakeVectorsPrivate(pev->angles, vecAim, nullptr, nullptr);
+	}
+
+	// (its aim is where it faces, pitched at its target)
+	Vector vecFacing;
+	UTIL_MakeVectorsPrivate(Vector(0, pev->angles.y, 0), vecFacing, nullptr, nullptr);
+	Vector2D aim2D = vecAim.Make2D();
+	float flHoriz = aim2D.Length();
+	vecAim = Vector(vecFacing.x * flHoriz, vecFacing.y * flHoriz, vecAim.z).Normalize();
+
+	const float flHalfCone = PK_FLAME_HALF_CONE * (M_PI / 180.0f);
+
+	auto burn = [&](CBaseEntity *pEntity)
+	{
+		if (!IsEnemy(pEntity))
+			return;
+
+		Vector vecTo = pEntity->Center() - vecMouth;
+		float flDist = vecTo.Length();
+		if (flDist > PK_ATTACK_RANGE + PK_TARGET_RADIUS || flDist < 1.0f)
+			return;
+
+		float flCos = clamp(float(DotProduct(vecTo / flDist, vecAim)), -1.0f, 1.0f);
+		if (Q_acos(flCos) > flHalfCone + Q_atan2(PK_TARGET_RADIUS, flDist))
+			return;
+
+		TraceResult tr;
+		UTIL_TraceLine(vecMouth, pEntity->Center(), ignore_monsters, edict(), &tr);
+		if (tr.flFraction < 1.0f && tr.pHit != pEntity->edict())
+			return;
+
+		// (then it burns for a while after the stream: its first burn tick one tick after the stream's end)
+		DealDamage(pEntity, PK_FLAME_DAMAGE, DMG_BURN);
+		if (pEntity->IsAlive())
+		{
+			float flAfter = Q_max(m_flStreamEnd, float(gpGlobals->time));
+			Afflict(pEntity, flAfter + PK_BURN_TIME, flAfter + PK_BURN_TICK);
+		}
+	};
+
+	for (int i = 1; i <= gpGlobals->maxClients; i++)
+	{
+		CBasePlayer *pPlayer = UTIL_PlayerByIndex(i);
+		if (pPlayer)
+			burn(pPlayer);
+	}
+
+	CBaseEntity *pEntity = nullptr;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "monster_pokemon")))
+		burn(pEntity);
+}
+
+// Charizard: the flames of its stream — small, dense and quick at its mouth, swelling as they go —, up to the first
+// wall, player or Pokemon in their way
+void CPokemon::FlameEffects()
+{
+	Vector vecMouth = AttackOrigin(0);
+	CBaseEntity *pEnemy = m_hEnemy;
+
+	Vector vecFacing;
+	UTIL_MakeVectorsPrivate(Vector(0, pev->angles.y, 0), vecFacing, nullptr, nullptr);
+	float flPitchZ = 0.0f;
+	if (pEnemy)
+	{
+		Vector vecTo = (pEnemy->Center() - vecMouth).Normalize();
+		flPitchZ = vecTo.z;
+	}
+
+	Vector vecAim = Vector(vecFacing.x, vecFacing.y, flPitchZ).Normalize();
+	Vector vecSide = CrossProduct(vecAim, Vector(0, 0, 1));
+	vecSide = vecSide.Length() > 0.01f ? vecSide.Normalize() : Vector(1, 0, 0);
+	Vector vecUp = CrossProduct(vecSide, vecAim);
+
+	TraceResult tr;
+	UTIL_TraceLine(vecMouth, vecMouth + vecAim * PK_ATTACK_RANGE, dont_ignore_monsters, edict(), &tr);
+	float flReach = PK_ATTACK_RANGE * tr.flFraction;
+
+	// (on a player at close range, seen by him: smaller puffs, PK_EYE_FACTOR_NEAR, and its last 30 % thinned out
+	// — fewer puffs stacked along his line of sight, dimmer —, the impact puff dropped near his eye: the dynamic light
+	// and his burning icon tell him)
+	bool bNear = false;
+	if (pEnemy && pEnemy->IsPlayer())
+		bNear = ((pEnemy->pev->origin + pEnemy->pev->view_ofs) - vecMouth).Length() <= PK_FLAME_NEAR;
+
+	float flEyeFactor = bNear ? PK_EYE_FACTOR_NEAR : PK_EYE_FACTOR;
+
+	// (a new phase along the stream each tenth: the puffs of the last few — each lives a third of a second — fill each
+	// other's gaps)
+	float flPhase = RANDOM_FLOAT(0.0f, 1.0f);
+	float flLastRadius = PK_FLAME_RADIUS_MOUTH;
+	for (int k = 0; k < PK_FLAME_PUFFS; k++)
+	{
+		float d = PK_FLAME_PUFF_FIRST * Q_pow(PK_FLAME_PUFF_STEP, k + flPhase) - 2.0f;
+		float r = PK_FLAME_RADIUS_MOUTH + PK_FLAME_RADIUS_GROWTH * d;
+		if (d + 0.5f * r > flReach)
+			break;
+
+		flLastRadius = r;
+
+		if (bNear)
+		{
+			float t = (d / Q_max(flReach, 1.0f) - (1.0f - PK_FLAME_NEAR_FADE)) / PK_FLAME_NEAR_FADE;
+			if (t > 0.0f && RANDOM_FLOAT(0.0f, 1.0f) > 1.0f - (1.0f - PK_FLAME_NEAR_KEEP) * Q_min(t, 1.0f))
+				continue;
+		}
+
+		float spread = 0.35f * r;
+		Vector pos = vecMouth + vecAim * d + vecSide * RANDOM_FLOAT(-spread, spread) + vecUp * (0.7f * RANDOM_FLOAT(-spread, spread));
+
+		// (quicker at the mouth, where the stream is fast)
+		PK_FxFlame(pos, r, 44 - int(14.0f * d / PK_ATTACK_RANGE), flEyeFactor, &vecAim);
+	}
+
+	// (where it hits: a puff spreading on it, short of it, no bigger than the stream's last one; none near an eye)
+	if (tr.flFraction < 1.0f && flReach > 24.0f)
+	{
+		float r = Q_min(PK_FLAME_RADIUS_MOUTH + PK_FLAME_RADIUS_GROWTH * flReach, flLastRadius);
+		Vector pos = tr.vecEndPos - vecAim * (0.8f * r + 2.0f);
+		if (PK_FxEyeDistance(pos) >= PK_FLAME_IMPACT_EYE)
+			PK_FxFlame(pos, r, 30, flEyeFactor, &vecAim);
+	}
+
+	PK_FxLight(vecMouth + vecAim * Q_min(0.5f * flReach, 80.0f), 14, 255, 130, 40, 2, 40);
+}
