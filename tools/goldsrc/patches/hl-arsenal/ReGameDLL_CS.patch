+
+	SetAmount(m_iAmount - iTake);
+	if (m_iAmount <= 0)
+	{
+		pev->solid = SOLID_NOT;
+		UTIL_Remove(this);
+	}
+}
+
+// The piles there are (no scan of every edict per impact): the live ones first, iPiles of them
+static EHANDLE s_hPiles[BUILD_PILE_CAP];
+static int s_iPiles = 0;
+
+static void BUILD_ForgetPiles()
+{
+	for (int i = 0; i < BUILD_PILE_CAP; i++)
+		s_hPiles[i] = nullptr;
+	s_iPiles = 0;
+}
+
+static int BUILD_LivePiles()
+{
+	int n = 0;
+	for (int i = 0; i < s_iPiles; i++)
+	{
+		CBaseEntity *pPile = s_hPiles[i];
+		if (pPile && !(pPile->pev->flags & FL_KILLME))
+			s_hPiles[n++] = pPile;
+	}
+
+	for (int i = n; i < s_iPiles; i++)
+		s_hPiles[i] = nullptr;
+
+	s_iPiles = n;
+	return n;
+}
+
+void CBrickPile::Drop(const Vector &vecGround, int iAmount)
+{
+	const int iPiles = BUILD_LivePiles();
+
+	// (into a pile near enough, while it has room)
+	for (int i = 0; i < iPiles && iAmount > 0; i++)
+	{
+		CBrickPile *pPile = static_cast<CBrickPile *>((CBaseEntity *)s_hPiles[i]);
+		if ((pPile->pev->origin - vecGround).Length() > BUILD_PILE_MERGE)
+			continue;
+
+		int iAdd = Q_min(iAmount, BUILD_PILE_MAX - pPile->m_iAmount);
+		if (iAdd <= 0)
+			continue;
+
+		pPile->SetAmount(pPile->m_iAmount + iAdd);
+		pPile->pev->nextthink = gpGlobals->time + BUILD_PILE_LIFE; // (a growing pile lives on)
+		iAmount -= iAdd;
+	}
+
+	if (iAmount <= 0)
+		return;
+
+	// (a new one: the oldest goes past the cap; none when the edicts left are the game's — the engine's end otherwise)
+	int iOldest = -1;
+	for (int i = 0; i < iPiles; i++)
+	{
+		if (iOldest < 0 || static_cast<CBrickPile *>((CBaseEntity *)s_hPiles[i])->m_flBornTime < static_cast<CBrickPile *>((CBaseEntity *)s_hPiles[iOldest])->m_flBornTime)
+			iOldest = i;
+	}
+
+	if (iPiles < BUILD_PILE_CAP && NUMBER_OF_ENTITIES() + BUILD_EDICT_MARGIN >= gpGlobals->maxEntities)
+		return;
+
+	if (iPiles >= BUILD_PILE_CAP && iOldest >= 0)
+	{
+		CBaseEntity *pOldest = s_hPiles[iOldest];
+		pOldest->pev->solid = SOLID_NOT;
+		UTIL_Remove(pOldest);
+		s_hPiles[iOldest] = s_hPiles[--s_iPiles];
+		s_hPiles[s_iPiles] = nullptr;
+	}
+
+	CBrickPile *pPile = GetClassPtr<CCSEntity>((CBrickPile *)nullptr);
+	if (!pPile)
+		return;
+
+	pPile->Spawn();
+	pPile->SetAmount(iAmount);
+	UTIL_SetOrigin(pPile->pev, vecGround);
+	if (s_iPiles < BUILD_PILE_CAP)
+		s_hPiles[s_iPiles++] = pPile;
+}
+
+// Bricks for an impact at vecPos (out of the surface, on its near side): a pile on the ground below, a little towards
+// vecToward
+static void BUILD_DropBelow(const Vector &vecPos, const Vector &vecToward)
+{
+	Vector vecBack = vecToward - vecPos;
+	vecBack.z = 0;
+	float flLen = vecBack.Length();
+	Vector vecStart = vecPos;
+	if (flLen > 0.1f)
+	{
+		Vector vecTry = vecPos + vecBack * (Q_min(16.0f, flLen) / flLen);
+		TraceResult tr;
+		UTIL_TraceLine(vecPos, vecTry, ignore_monsters, nullptr, &tr);
+		vecStart = tr.vecEndPos;
+	}
+
+	if (UTIL_PointContents(vecStart) == CONTENTS_SOLID || UTIL_PointContents(vecStart) == CONTENTS_SKY)
+		return;
+
+	// (down onto the world, a brush or a built floor: the players in between are passed through)
+	BuildTraceCtx ctx = { nullptr, nullptr };
+	Vector vecGround;
+	bool bStartSolid;
+	if (BUILD_TraceLine(&ctx, vecStart, vecStart - Vector(0, 0, 4096), false, vecGround, bStartSolid) >= 1.0f || bStartSolid)
+		return;
+
+	CBrickPile::Drop(vecGround + Vector(0, 0, 1), BUILD_DROP);
+}
+
+// A brush surface that drops bricks when hit: the world (not its sky) or a brush entity
+static bool BUILD_BrickSurface(TraceResult *ptr, const Vector &vecSrc)
+{
+	edict_t *pHit = ptr->pHit;
+	if (!pHit || ptr->flFraction >= 1.0f || pHit->v.solid != SOLID_BSP || (pHit->v.flags & (FL_CLIENT | FL_FAKECLIENT | FL_MONSTER)))
+		return false;
+
+	if (ENTINDEX(pHit) == 0)
+	{
+		Vector vecDir = (ptr->vecEndPos - vecSrc).Normalize();
+		const char *pszTexture = TRACE_TEXTURE(pHit, ptr->vecEndPos - vecDir * 4, ptr->vecEndPos + vecDir * 8);
+		if (pszTexture && !Q_stricmp(pszTexture, "sky"))
+			return false;
+	}
+
+	return true;
+}
+
+void BUILD_BulletImpact(entvars_t *pevAttacker, const Vector &vecSrc, TraceResult *ptr)
+{
+	if (!BUILD_On() || !ptr || !BUILD_BrickSurface(ptr, vecSrc))
+		return;
+
+	BUILD_DropBelow(ptr->vecEndPos + ptr->vecPlaneNormal * 4.0f, vecSrc);
+}
+
+void BUILD_ImpactOnce(entvars_t *pevAttacker, const Vector &vecSrc, TraceResult *ptr, edict_t **pHits, int &iHits, int iMax)
+{
+	if (!ptr || !ptr->pHit || ptr->flFraction >= 1.0f || ptr->pHit->v.solid != SOLID_BSP)
+		return;
+
+	for (int i = 0; i < iHits; i++)
+	{
+		if (pHits[i] == ptr->pHit)
+			return;
+	}
+
+	if (iHits >= iMax)
+		return;
+
+	pHits[iHits++] = ptr->pHit;
+	BUILD_BulletImpact(pevAttacker, vecSrc, ptr);
+}
+
+void BUILD_ExplosionImpact(entvars_t *pevAttacker, const Vector &vecSrc, float flRadius, float flDamage)
+{
+	// (a real blast — not the Egon's beam end, its small radius — by a player)
+	if (!BUILD_On() || flRadius <= 128.0f || flDamage < 20.0f || !pevAttacker)
+		return;
+
+	CBaseEntity *pAttacker = CBaseEntity::Instance(pevAttacker);
+	if (!pAttacker || !pAttacker->IsPlayer())
+		return;
+
+	// (the nearest brush surface around it, within 96 units)
+	static const Vector dirs[] = { Vector(0, 0, -1), Vector(1, 0, 0), Vector(-1, 0, 0), Vector(0, 1, 0), Vector(0, -1, 0), Vector(0, 0, 1) };
+	TraceResult best;
+	best.flFraction = 1.0f;
+	for (int i = 0; i < int(ARRAYSIZE(dirs)); i++)
+	{
+		TraceResult tr;
+		UTIL_TraceLine(vecSrc, vecSrc + dirs[i] * 96.0f, ignore_monsters, nullptr, &tr);
+		if (tr.fStartSolid || tr.flFraction >= best.flFraction || !BUILD_BrickSurface(&tr, vecSrc))
+			continue;
+
+		best = tr;
+	}
+
+	if (best.flFraction >= 1.0f)
+		return;
+
+	BUILD_DropBelow(best.vecEndPos + best.vecPlaneNormal * 4.0f, vecSrc);
+}
