+void CBrickPile::Touch(CBaseEntity *pOther)
+{
+	if (!pOther || !pOther->IsPlayer() || !pOther->IsAlive() || !BUILD_On() || m_iAmount <= 0)
+		return;
+
+	CBasePlayer *pPlayer = static_cast<CBasePlayer *>(pOther);
+	if (pPlayer->IsBot() || pPlayer->GetObserverMode() != OBS_NONE || (pPlayer->m_iTeam != TERRORIST && pPlayer->m_iTeam != CT))
+		return;
