+
+CHLRpgRocket *CHLRpgRocket::CreateRpgRocket(Vector vecOrigin, Vector vecAngles, CBaseEntity *pOwner, CHLRpg *pLauncher)
+{
+	CHLRpgRocket *pRocket = GetClassPtr<CCSEntity>((CHLRpgRocket *)nullptr);
+
+	UTIL_SetOrigin(pRocket->pev, vecOrigin);
+	pRocket->pev->angles = vecAngles;
+	pRocket->Spawn();
+	pRocket->SetTouch(&CHLRpgRocket::RocketTouch);
+	pRocket->m_hLauncher = pLauncher; // (the RPG that fired it)
+	pLauncher->m_cActiveRockets++;
