+// (a long menu in several messages, as their size is limited)
+static void HL_ShowMenuText(CBasePlayer *pPlayer, int bitsValidSlots, const char *pszText)
+{
+	char chunk[176];
+	int len = Q_strlen(pszText);
+	for (int i = 0; i < len; i += sizeof(chunk) - 1)
+	{
+		Q_strlcpy(chunk, pszText + i);
+		ShowMenu(pPlayer, bitsValidSlots, -1, (i + int(sizeof(chunk)) - 1 < len) ? TRUE : FALSE, chunk);
