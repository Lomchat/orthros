+
+void CHLEgon::Attack()
+{
+	if (m_pPlayer->pev->waterlevel == 3)
+	{
+		if (m_fireState != FIRE_OFF || m_pBeam)
+			EndAttack();
+		else
+			PlayEmptySound();
+
+		return;
+	}
+
+	UTIL_MakeVectors(m_pPlayer->pev->v_angle + m_pPlayer->pev->punchangle);
+	Vector vecAiming = gpGlobals->v_forward;
+	Vector vecSrc = m_pPlayer->GetGunPosition();
+
+	switch (m_fireState)
+	{
+		case FIRE_OFF:
+		{
+			if (!HasAmmo())
+			{
+				m_flNextPrimaryAttack = m_flNextSecondaryAttack = UTIL_WeaponTimeBase() + 0.25f;
+				PlayEmptySound();
+				return;
+			}
+
+			m_flAmmoUseTime = gpGlobals->time; // (ammo from now on)
+			PLAYBACK_EVENT_FULL(0, m_pPlayer->edict(), m_usEgonFire, 0.0f, (float *)&g_vecZero, (float *)&g_vecZero, 0.0f, 0.0f, 0, HL_EGON_FIRE_WIDE, 1, 0);
+
+			m_shakeTime = 0;
+			m_pPlayer->m_iWeaponVolume = HL_EGON_PRIMARY_VOLUME;
+			m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 0.1f;
+			m_flStartupTime = gpGlobals->time + 2.0f;
+			m_flDamageTime = gpGlobals->time + HL_EGON_INTERVAL;
+			m_fireState = FIRE_CHARGE;
+			break;
+		}
+		case FIRE_CHARGE:
+		{
+			Fire(vecSrc, vecAiming);
+			m_pPlayer->m_iWeaponVolume = HL_EGON_PRIMARY_VOLUME;
+
+			// (the running sound once the startup one is over)
+			if (m_flStartupTime != 0.0f && m_flStartupTime <= gpGlobals->time)
+			{
+				PLAYBACK_EVENT_FULL(0, m_pPlayer->edict(), m_usEgonFire, 0.0f, (float *)&g_vecZero, (float *)&g_vecZero, 0.0f, 0.0f, 0, HL_EGON_FIRE_WIDE, 0, 0);
+				m_flStartupTime = 0.0f;
+			}
+
+			if (!HasAmmo())
+			{
+				EndAttack();
+				m_flNextPrimaryAttack = m_flNextSecondaryAttack = UTIL_WeaponTimeBase() + 1.0f;
+			}
+			break;
+		}
+	}
+
+	m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 0.1f;
+}
+
+void CHLEgon::Fire(const Vector &vecOrigSrc, const Vector &vecDir)
+{
+	Vector vecDest = vecOrigSrc + vecDir * 2048.0f;
+	Vector tmpSrc = vecOrigSrc + gpGlobals->v_up * -8.0f + gpGlobals->v_right * 3.0f;
+
+	TraceResult tr;
+	UTIL_TraceLine(vecOrigSrc, vecDest, dont_ignore_monsters, m_pPlayer->edict(), &tr);
+	if (tr.fAllSolid)
+		return;
+
+	CBaseEntity *pEntity = CBaseEntity::Instance(tr.pHit);
+	if (!pEntity)
+		return;
+
+	if (m_pSprite)
+	{
+		if (pEntity->pev->takedamage)
+			m_pSprite->pev->effects &= ~EF_NODRAW;
+		else
+			m_pSprite->pev->effects |= EF_NODRAW;
+	}
+
+	if (m_flDamageTime < gpGlobals->time)
+	{
+		ClearMultiDamage();
+		if (pEntity->pev->takedamage)
+			pEntity->TraceAttack(m_pPlayer->pev, HL_EGON_DAMAGE, vecDir, &tr, DMG_ENERGYBEAM | DMG_ALWAYSGIB);
+
+		ApplyMultiDamage(m_pPlayer->pev, m_pPlayer->pev);
+		::RadiusDamage(tr.vecEndPos, pev, m_pPlayer->pev, HL_EGON_DAMAGE * 0.25f, 128, CLASS_NONE, DMG_ENERGYBEAM | DMG_BLAST | DMG_ALWAYSGIB);
+
+		if (!m_pPlayer->IsAlive())
+			return;
+
+		if (gpGlobals->time >= m_flAmmoUseTime)
+		{
+			UseAmmo(1);
+			m_flAmmoUseTime = gpGlobals->time + 0.2f;
+		}
+
+		m_flDamageTime = gpGlobals->time + HL_EGON_INTERVAL;
+		if (m_shakeTime < gpGlobals->time)
+		{
+			UTIL_ScreenShake(tr.vecEndPos, 5.0f, 150.0f, 0.75f, 250.0f);
+			m_shakeTime = gpGlobals->time + 1.5f;
+		}
+	}
+
+	float timedist = (m_flDamageTime - gpGlobals->time) / HL_EGON_INTERVAL;
+	timedist = 1 - clamp(timedist, 0.0f, 1.0f);
+	UpdateEffect(tmpSrc, tr.vecEndPos, timedist);
+}
+
+void CHLEgon::UpdateEffect(const Vector &startPoint, const Vector &endPoint, float timeBlend)
+{
+	if (!m_pBeam)
+		CreateEffect();
+
+	m_pBeam->SetStartPos(endPoint);
+	m_pBeam->SetBrightness(int(255 - (timeBlend * 180)));
+	m_pBeam->SetWidth(int(40 - (timeBlend * 20)));
+	m_pBeam->SetColor(int(30 + (25 * timeBlend)), int(30 + (30 * timeBlend)), int(64 + 80 * Q_fabs(Q_sin(gpGlobals->time * 10.0f))));
+
+	UTIL_SetOrigin(m_pSprite->pev, endPoint);
+	m_pSprite->pev->frame += 8.0f * gpGlobals->frametime;
+	if (m_pSprite->pev->frame > m_pSprite->Frames())
+		m_pSprite->pev->frame = 0;
+
+	m_pNoise->SetStartPos(endPoint);
+}
+
+// (the beams are server entities for everyone, the shooter included: no client-side beam follows its aim)
+void CHLEgon::CreateEffect()
+{
+	DestroyEffect();
+
+	m_pBeam = CBeam::BeamCreate(HL_EGON_BEAM_SPRITE, 40);
+	m_pBeam->PointEntInit(pev->origin, m_pPlayer->entindex());
+	m_pBeam->SetFlags(BEAM_FSINE);
+	m_pBeam->SetEndAttachment(1);
+	m_pBeam->pev->spawnflags |= SF_BEAM_TEMPORARY;
+	m_pBeam->pev->owner = m_pPlayer->edict();
+	m_pBeam->SetScrollRate(50);
+	m_pBeam->SetNoise(20);
+
+	m_pNoise = CBeam::BeamCreate(HL_EGON_BEAM_SPRITE, 55);
+	m_pNoise->PointEntInit(pev->origin, m_pPlayer->entindex());
+	m_pNoise->SetScrollRate(25);
+	m_pNoise->SetBrightness(100);
+	m_pNoise->SetEndAttachment(1);
+	m_pNoise->pev->spawnflags |= SF_BEAM_TEMPORARY;
+	m_pNoise->pev->owner = m_pPlayer->edict();
+	m_pNoise->SetColor(50, 50, 255);
+	m_pNoise->SetNoise(8);
+
+	m_pSprite = CSprite::SpriteCreate(HL_EGON_FLARE_SPRITE, pev->origin, FALSE);
+	m_pSprite->pev->scale = 1.0;
+	m_pSprite->SetTransparency(kRenderGlow, 255, 255, 255, 255, kRenderFxNoDissipation);
+	m_pSprite->pev->spawnflags |= SF_SPRITE_TEMPORARY;
+	m_pSprite->pev->owner = m_pPlayer->edict();
+}
+
+void CHLEgon::DestroyEffect()
+{
+	if (m_pBeam)
+	{
+		UTIL_Remove(m_pBeam);
+		m_pBeam = nullptr;
+	}
+
+	if (m_pNoise)
+	{
+		UTIL_Remove(m_pNoise);
+		m_pNoise = nullptr;
+	}
+
+	if (m_pSprite)
+	{
+		m_pSprite->Expand(10, 500);
+		m_pSprite = nullptr;
+	}
+}
+
+void CHLEgon::WeaponIdle()
+{
+	ResetEmptySound();
+
+	if (m_flTimeWeaponIdle > UTIL_WeaponTimeBase())
+		return;
+
+	if (m_fireState != FIRE_OFF)
+	{
+		EndAttack();
+		return;
+	}
+
+	int iAnim;
+	if (RANDOM_FLOAT(0.0f, 1.0f) <= 0.5f)
+	{
+		iAnim = EGON_IDLE1;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 10.0f, 15.0f);
+	}
+	else
+	{
+		iAnim = EGON_FIDGET1;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 3.0f;
+	}
+
+	SendWeaponAnim(iAnim);
+}
+
+void CHLEgon::EndAttack()
+{
+	bool bMakeNoise = (m_fireState != FIRE_OFF);
+	PLAYBACK_EVENT_FULL(FEV_GLOBAL | FEV_RELIABLE, m_pPlayer->edict(), m_usEgonStop, 0.0f, m_pPlayer->pev->origin, m_pPlayer->pev->angles, 0.0f, 0.0f, bMakeNoise, 0, 0, 0);
+
+	m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 2.0f;
+	m_flNextPrimaryAttack = m_flNextSecondaryAttack = UTIL_WeaponTimeBase() + 0.5f;
+	m_fireState = FIRE_OFF;
+	DestroyEffect();
+}
