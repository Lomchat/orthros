+	EMIT_SOUND_DYN(ENT(pev), CHAN_VOICE, "common/bodysplat.wav", 0.75f, ATTN_NORM, 0, 200);
+	UTIL_BloodDrips(pev->origin, BloodColor(), 80);
+
+	entvars_t *pevOwner = m_hOwner.IsValid() ? m_hOwner->pev : pev;
+	HL_RadiusDamage(pev->origin, pev, pevOwner, pev->dmg, pev->dmg * 2.5f);
+
