+// Half Strike: Poke Balls and their Pokemon (pokemon.h). A ball is thrown as the Half-Life hand grenade; it opens and
+// its Pokemon comes out, follows its player and fights the enemies its player shoots at or that hurt it or its player.
+// Entities are named with MAKE_STRING_CLASS (the game's classname table, as the Half-Life arsenal's), followed by entity
+// handles, think every 0.1 s (the clients interpolate a step monster between thinks), allocate nothing while they live.
+#include "precompiled.h"
+
+extern bool g_bClientPrintEnable; // (client.cpp)
+
+// ---------------------------------------------------------------------------------------------------------------------
