+
+// Pikachu's bolt: a wide yellow beam and a thin white core (30 % of it) along a zig-zag through randomly offset points —
+// the engine's beam noise grows with a beam's length, so a short beam alone would be a straight rod —, each from its own
+// frame of zap.spr (any of its 8 stands alone), flickering through them at 20 frames a second, the wide one scrolling.
+// One bolt with a hot core: the core rides the kinked line itself (no noise: two noisy beams would wander apart and
+// read as two bolts), only the wide glow crackles around it; the glow's legs run on 3 units past each kink so that
+// neighbouring legs overlap (no dark notch where two square ends meet at an angle).
+static void PK_FxBolt(const Vector &vecSrc, const Vector &vecEnd)
+{
+	Vector vecDelta = vecEnd - vecSrc;
+	float flLen = vecDelta.Length();
+	if (flLen < 1.0f)
+		return;
+
+	Vector vecDir = vecDelta * (1.0f / flLen);
+	Vector vecSide = CrossProduct(vecDir, Vector(0, 0, 1));
+	if (vecSide.Length() < 0.1f)
+		vecSide = Vector(1, 0, 0);
+
+	vecSide = vecSide.Normalize();
+	Vector vecUp = CrossProduct(vecSide, vecDir).Normalize();
+
+	// (2 to 4 legs, a kink at least every 70 units; its points off the line by 5 to 12 units, alternating sides)
+	const int MAX_LEGS = 4;
+	int iLegs = clamp(int(flLen / 70.0f) + 2, 2, MAX_LEGS);
+	float flOffset = clamp(flLen * 0.07f, 5.0f, 12.0f);
+	Vector vecPoints[MAX_LEGS + 1];
+	vecPoints[0] = vecSrc;
+	vecPoints[iLegs] = vecEnd;
+	float flSign = RANDOM_LONG(0, 1) ? 1.0f : -1.0f;
+	for (int i = 1; i < iLegs; i++)
+	{
+		float flAlong = (float(i) + RANDOM_FLOAT(-0.2f, 0.2f)) / float(iLegs);
+		float flAngle = RANDOM_FLOAT(-0.6f, 0.6f);
+		float flAmount = flSign * flOffset * RANDOM_FLOAT(0.6f, 1.0f);
+		vecPoints[i] = vecSrc + vecDelta * flAlong + (vecSide * cosf(flAngle) + vecUp * sinf(flAngle)) * flAmount;
+		flSign = -flSign;
+	}
+
+	int iFrame = RANDOM_LONG(0, PK_ZAP_FRAMES - 1);
+	int iCoreFrame = (iFrame + RANDOM_LONG(1, PK_ZAP_FRAMES - 1)) % PK_ZAP_FRAMES;
+	for (int i = 0; i < iLegs; i++)
+	{
+		// (the engine's noise: about noise * length / 5000 units off the leg, none at its ends; a crackle of ~1.5 units)
+		Vector vecLeg = vecPoints[i + 1] - vecPoints[i];
+		float flLeg = vecLeg.Length();
+		int iNoise = clamp(int(7500.0f / Q_max(flLeg, 1.0f)), 30, 255);
+		Vector vecLegDir = vecLeg * (1.0f / Q_max(flLeg, 1.0f));
+		Vector vecGlowStart = (i > 0) ? vecPoints[i] - vecLegDir * 3.0f : vecPoints[i];
+		Vector vecGlowEnd = (i < iLegs - 1) ? vecPoints[i + 1] + vecLegDir * 3.0f : vecPoints[i + 1];
+		PK_FxBeam(vecGlowStart, vecGlowEnd, s_iSprZap, iFrame, PK_ZAP_FRAMERATE, 2, 50, iNoise, 255, 230, 80, 255, 35);
+		PK_FxBeam(vecPoints[i], vecPoints[i + 1], s_iSprZap, iCoreFrame, PK_ZAP_FRAMERATE, 2, 15, 0, 255, 255, 255, 255, 60);
+	}
+}
+
+// (the distance from pos to the nearest living player's eye)
+static float PK_FxEyeDistance(const Vector &pos)
+{
+	float flNearest = 1e9f;
+	for (int i = 1; i <= gpGlobals->maxClients; i++)
+	{
+		CBasePlayer *pPlayer = UTIL_PlayerByIndex(i);
+		if (!pPlayer || !UTIL_IsValidPlayer(pPlayer) || pPlayer->has_disconnected || !pPlayer->IsAlive())
+			continue;
+
+		flNearest = Q_min(flNearest, float((pos - (pPlayer->pev->origin + pPlayer->pev->view_ofs)).Length()));
+	}
+
+	return flNearest;
+}
+
+// (a puff's radius, shrunk so that it never reaches into anyone's eye: at most flFactor of its distance to it, less
+// PK_FLAME_EYE_CLEAR)
+static float PK_FxEyeClear(const Vector &pos, float flRadius, float flFactor = PK_EYE_FACTOR)
+{
+	for (int i = 1; i <= gpGlobals->maxClients; i++)
+	{
+		CBasePlayer *pPlayer = UTIL_PlayerByIndex(i);
+		if (!pPlayer || !UTIL_IsValidPlayer(pPlayer) || pPlayer->has_disconnected || !pPlayer->IsAlive())
+			continue;
+
+		float flEye = (pos - (pPlayer->pev->origin + pPlayer->pev->view_ofs)).Length();
+		flRadius = Q_min(flRadius, (flEye - PK_FLAME_EYE_CLEAR) * flFactor);
+	}
+
+	return flRadius;
+}
+
+// (the free distance from pos along dir, up to flMax: the world only)
+static float PK_FxFree(const Vector &pos, const Vector &dir, float flMax)
+{
+	TraceResult tr;
+	UTIL_TraceLine(pos, pos + dir * flMax, ignore_monsters, nullptr, &tr);
+	if (tr.fStartSolid || tr.fAllSolid)
+		return 0.0f;
+
+	return flMax * tr.flFraction;
+}
+
+// A puff: an effect sprite played once at its own pace (TE_EXPLOSION without its light, sound and particles: TE_SPRITE
+// plays at 10 frames a second, ~1 s for fire.spr or water.spr, and lingers), additive (the engine's 180). Never in
+// anyone's face: near a player's eye it shrinks (flEyeFactor: PK_FxEyeClear), so that a victim standing in the stream
+// still sees (no white-out). Never cut by the world in a hard seam (a sprite is a depth-tested billboard facing its
+// viewer, so any surface within its radius, seen from the side, slices it): one within its radius of the floor is
+// lifted clear of it, then it shrinks to its free distance (less 2 units) to the walls around and the ceiling, and
+// along pvecDir (where it goes: the crate behind a target); one left too small is not drawn.
+static void PK_FxPuff(const Vector &vecPos, int iSprite, float flUnits, float flRadius, int iFrameRate,
+	float flEyeFactor = PK_EYE_FACTOR, const Vector *pvecDir = nullptr)
+{
+	const float flMin = 0.5f * flUnits * 0.1f;
+	Vector pos = vecPos;
+	flRadius = PK_FxEyeClear(pos, flRadius, flEyeFactor);
+	if (flRadius < flMin)
+		return;
+
+	TraceResult tr;
+	UTIL_TraceLine(pos, pos - Vector(0, 0, flRadius), ignore_monsters, nullptr, &tr);
+	if (tr.fStartSolid)
+		return;
+
+	if (tr.flFraction < 1.0f)
+	{
+		pos.z = tr.vecEndPos.z + flRadius;
+		flRadius = PK_FxEyeClear(pos, flRadius, flEyeFactor);
+		if (flRadius < flMin)
+			return;
+	}
+
+	static const Vector s_vecAround[] = { Vector(1, 0, 0), Vector(-1, 0, 0), Vector(0, 1, 0), Vector(0, -1, 0), Vector(0, 0, 1) };
+	float flFree = flRadius + 2.0f;
+	for (const Vector &dir : s_vecAround)
+		flFree = PK_FxFree(pos, dir, flFree);
+
+	if (pvecDir)
+		flFree = PK_FxFree(pos, *pvecDir, flFree);
+
+	flRadius = Q_min(flRadius, flFree - 2.0f);
+	if (flRadius < flMin)
+		return;
+
+	MESSAGE_BEGIN(MSG_PVS, SVC_TEMPENTITY, pos);
+		WRITE_BYTE(TE_EXPLOSION);
+		WRITE_COORD(pos.x);
+		WRITE_COORD(pos.y);
+		WRITE_COORD(pos.z - 10.0f); // (an explosion's sprite is drawn 10 units up)
+		WRITE_SHORT(iSprite);
+		WRITE_BYTE(clamp(int(flRadius / flUnits * 10.0f + 0.25f), 1, 255));
+		WRITE_BYTE(clamp(iFrameRate, 1, 255));
+		WRITE_BYTE(TE_EXPLFLAG_NODLIGHTS | TE_EXPLFLAG_NOSOUND | TE_EXPLFLAG_NOPARTICLES);
+	MESSAGE_END();
+}
+
+// A puff of fire (fire.spr, 12 frames: ~0.25 to 0.4 s at 30 to 44 frames a second)
+static void PK_FxFlame(const Vector &pos, float flRadius, int iFrameRate, float flEyeFactor = PK_EYE_FACTOR, const Vector *pvecDir = nullptr)
+{
+	PK_FxPuff(pos, s_iSprFire, PK_FIRE_UNITS, flRadius, iFrameRate, flEyeFactor, pvecDir);
+}
+
+// A puff of water (water.spr, 8 frames: ~0.25 s at 28 frames a second)
+static void PK_FxWater(const Vector &pos, float flRadius, int iFrameRate, float flEyeFactor = PK_EYE_FACTOR, const Vector *pvecDir = nullptr)
+{
+	PK_FxPuff(pos, s_iSprWater, PK_WATER_UNITS, flRadius, iFrameRate, flEyeFactor, pvecDir);
+}
+
+// The red glow of a return to the ball: flash.spr tinted (a temporary env_sprite: TE_SPRITE cannot tint)
+// (lifted clear of the floor as the white flashes)
+static void PK_FxReturnFlash(const Vector &pos, float flScale, float flMinHeight, edict_t *pIgnore)
+{
+	Vector vecSpot = PK_FlashSpot(pos, 0.5f * PK_FLASH_PIXELS * flScale, flMinHeight, pIgnore);
+	CSprite *pSprite = CSprite::SpriteCreate("sprites/pokemon/flash.spr", vecSpot, FALSE);
+	if (!pSprite)
+		return;
+
+	pSprite->SetTransparency(kRenderTransAdd, 255, 50, 40, PK_FLASH_BRIGHTNESS, kRenderFxNoDissipation);
+	pSprite->SetScale(flScale);
+	pSprite->pev->frame = 0;
+	pSprite->AnimateAndDie(12.0f);
+}
+
+// A shower of moving sprites (additive), along a direction
+static void PK_FxSpray(const Vector &pos, const Vector &dir, int iSprite, int iCount, int iSpeed, int iNoise)
+{
+	MESSAGE_BEGIN(MSG_PVS, SVC_TEMPENTITY, pos);
+		WRITE_BYTE(TE_SPRAY);
+		WRITE_COORD(pos.x);
+		WRITE_COORD(pos.y);
+		WRITE_COORD(pos.z);
+		WRITE_COORD(dir.x);
+		WRITE_COORD(dir.y);
+		WRITE_COORD(dir.z);
+		WRITE_SHORT(iSprite);
+		WRITE_BYTE(iCount);
+		WRITE_BYTE(iSpeed);
+		WRITE_BYTE(iNoise);
+		WRITE_BYTE(kRenderTransAdd);
+	MESSAGE_END();
+}
