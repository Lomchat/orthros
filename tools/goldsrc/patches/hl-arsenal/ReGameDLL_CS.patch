+CHLRpgRocket *CHLRpgRocket::CreateRpgRocket(Vector vecOrigin, Vector vecAngles, CBaseEntity *pOwner, CHLRpg *pLauncher)
+{
+	CHLRpgRocket *pRocket = GetClassPtr<CCSEntity>((CHLRpgRocket *)nullptr);
