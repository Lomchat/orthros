+
+BOOL CHLCrowbar::Swing(BOOL fFirst)
+{
+	if (!m_pPlayer)
+		return FALSE;
+
+	TraceResult tr;
+	UTIL_MakeVectors(m_pPlayer->pev->v_angle);
+	Vector vecSrc = m_pPlayer->GetGunPosition();
+	Vector vecEnd = vecSrc + gpGlobals->v_forward * 32.0f;
+
+	UTIL_TraceLine(vecSrc, vecEnd, dont_ignore_monsters, ENT(m_pPlayer->pev), &tr);
+	if (tr.flFraction >= 1.0f)
+	{
+		UTIL_TraceHull(vecSrc, vecEnd, dont_ignore_monsters, head_hull, ENT(m_pPlayer->pev), &tr);
+		if (tr.flFraction < 1.0f)
+		{
+			// (the point of the object the hull hit)
+			CBaseEntity *pHit = CBaseEntity::Instance(tr.pHit);
+			if (!pHit || pHit->IsBSPModel())
+				FindHullIntersection(vecSrc, tr, VEC_DUCK_HULL_MIN, VEC_DUCK_HULL_MAX, m_pPlayer->edict());
+
+			vecEnd = tr.vecEndPos;
+		}
+	}
+
+	if (tr.flFraction >= 1.0f)
+	{
+		if (fFirst)
+		{
+			static const int missAnims[] = { CROWBAR_ATTACK1MISS, CROWBAR_ATTACK2MISS, CROWBAR_ATTACK3MISS };
+			SendWeaponAnim(missAnims[(m_iSwing++) % 3]);
+			EMIT_SOUND_DYN(ENT(m_pPlayer->pev), CHAN_WEAPON, "weapons/cbar_miss1.wav", VOL_NORM, ATTN_NORM, 0, 94 + RANDOM_LONG(0, 15));
+			m_flNextPrimaryAttack = GetNextAttackDelay(0.5f);
+			m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 2.0f;
+			m_pPlayer->SetAnimation(PLAYER_ATTACK1);
+		}
+
+		return FALSE;
+	}
+
+	static const int hitAnims[] = { CROWBAR_ATTACK1HIT, CROWBAR_ATTACK2HIT, CROWBAR_ATTACK3HIT };
+	SendWeaponAnim(hitAnims[(m_iSwing++) % 3]);
+	m_pPlayer->SetAnimation(PLAYER_ATTACK1);
+	m_flNextPrimaryAttack = GetNextAttackDelay(0.35f);
+	m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 2.0f;
+
+	float flVol = 1.0f;
+	bool bHitWorld = true;
+
+	CBaseEntity *pEntity = CBaseEntity::Instance(tr.pHit);
+	if (pEntity)
+	{
+		ClearMultiDamage();
+		pEntity->TraceAttack(m_pPlayer->pev, HL_CROWBAR_DAMAGE, gpGlobals->v_forward, &tr, DMG_NEVERGIB | DMG_BULLET);
+		ApplyMultiDamage(m_pPlayer->pev, m_pPlayer->pev);
+
+		if (pEntity->Classify() != CLASS_NONE && pEntity->Classify() != CLASS_MACHINE && pEntity->Classify() != CLASS_VEHICLE)
+		{
+			static const char *bodySounds[] = { "weapons/cbar_hitbod1.wav", "weapons/cbar_hitbod2.wav", "weapons/cbar_hitbod3.wav" };
+			EMIT_SOUND(ENT(m_pPlayer->pev), CHAN_ITEM, bodySounds[RANDOM_LONG(0, 2)], VOL_NORM, ATTN_NORM);
+			m_pPlayer->m_iWeaponVolume = HL_CROWBAR_BODYHIT_VOLUME;
+
+			if (!pEntity->IsAlive())
+				return TRUE;
+
+			flVol = 0.1f;
+			bHitWorld = false;
+		}
+	}
+
+	if (bHitWorld)
+	{
+		TEXTURETYPE_PlaySound(&tr, vecSrc, vecSrc + (vecEnd - vecSrc) * 2.0f, BULLET_PLAYER_CROWBAR);
+		EMIT_SOUND_DYN(ENT(m_pPlayer->pev), CHAN_ITEM, RANDOM_LONG(0, 1) ? "weapons/cbar_hit2.wav" : "weapons/cbar_hit1.wav", VOL_NORM, ATTN_NORM, 0, 98 + RANDOM_LONG(0, 3));
+
+		// (its mark a moment later)
+		m_trHit = tr;
+		SetThink(&CHLCrowbar::Smack);
+		pev->nextthink = gpGlobals->time + 0.2f;
+	}
+
+	m_pPlayer->m_iWeaponVolume = int(flVol * HL_CROWBAR_WALLHIT_VOLUME);
+	return TRUE;
+}
