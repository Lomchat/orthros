+// Le M's laptop in hand: fired, its player types (~1.2 s), then hits enter and Le M materialises where it aims
+class CLemLaptopWeapon: public CHLWeapon
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+	virtual int GetItemInfo(ItemInfo *p);
+	virtual BOOL Deploy();
+	virtual void Holster(int skiplocal = 0);
+	virtual BOOL CanDrop() { return FALSE; }
+	virtual float GetMaxSpeed() { return PK_BALL_MAX_SPEED; }
+	virtual int iItemSlot() { return GRENADE_SLOT; }
+	virtual void PrimaryAttack();
+	virtual void SecondaryAttack();
+	virtual void WeaponIdle();
+
+	bool IsTyping() const { return m_flStartThrow != 0.0f; }
+	bool IsBusy() const { return IsTyping() || m_flEnterTime > 0.0f || m_bSummoned; }
+
+	enum Sequence
+	{
+		SEQ_IDLE = 0,
+		SEQ_DRAW,
+		SEQ_TYPE,
+		SEQ_DEPLOY,
+		SEQ_HOLSTER,
+		SEQ_COUNT
+	};
+
+private:
+	int Seq(int iSeq);       // (the view model's sequence by the contract's name)
+	bool Summon();           // (Le M where its player aims: false, no room)
+	void StopTyping();
+	void Advance();          // (typing done: the enter key; Le M out: the laptop goes — the fire button held or not)
+
+	int m_iSeqIndex[SEQ_COUNT];
+	bool m_bSeqLoaded;
+	float m_flEnterTime;     // (typed: the enter key comes down then, in its deploy sequence — Le M materialises)
