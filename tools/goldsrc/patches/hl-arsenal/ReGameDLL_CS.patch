@@ -0,0 +1,253 @@
+/*
+*	Half-Life arsenal: five Half-Life weapons bought and used in Counter-Strike, ported from the Half-Life SDK
+*	(python.cpp, crossbow.cpp, rpg.cpp, gauss.cpp, egon.cpp) onto this game's weapon classes.
+*
+*	Their ids follow the 32 of Counter-Strike: pev->weapons has 32 bits, so a player's Half-Life weapons reach the
+*	client by the HLWeapons message, and the client does not predict them (clientdata m_iId is 0 while one is held,
+*	its delta field has 5 bits). Their animations come from the server, their fire effects from the Half-Life events.
+*/
+#pragma once
+
+inline bool IsHLWeapon(int id) { return id >= WEAPON_HL_FIRST && id <= WEAPON_HL_LAST; }
+
+// The bit of a weapon in pev->weapons, none for the Half-Life weapons
+inline int WeaponBit(int id) { return (id >= 0 && id < 32) ? (1 << id) : 0; }
+
+// Their animations are sent whether or not the client predicts its weapons: it does not predict these
+class CHLWeapon: public CBasePlayerWeapon
+{
+public:
+	virtual void SendWeaponAnim(int iAnim, int skiplocal = 0) { CBasePlayerWeapon::SendWeaponAnim(iAnim, 0); }
+	virtual BOOL UseDecrement() { return TRUE; }
+};
+
+// (weights as Counter-Strike's: a pistol 7, a primary 25 to 30 — the heavier is switched to when bought)
+
+// .357 Magnum revolver: pistol slot
+#define HL_PYTHON_PRICE              900
+#define HL_PYTHON_MAX_CLIP           6
+#define HL_PYTHON_MAX_CARRY          36
+#define HL_PYTHON_AMMO_PRICE         60
+#define HL_PYTHON_AMMO_BUY           6
+#define HL_PYTHON_DAMAGE             65
+#define HL_PYTHON_MAX_SPEED          250.0f
+#define HL_PYTHON_WEIGHT             7
+
+// Crossbow: zoomed, an instant bolt; otherwise an explosive bolt in flight
+#define HL_CROSSBOW_PRICE            3000
+#define HL_CROSSBOW_MAX_CLIP         5
+#define HL_CROSSBOW_MAX_CARRY        30
+#define HL_CROSSBOW_AMMO_PRICE       150
+#define HL_CROSSBOW_AMMO_BUY         5
+#define HL_CROSSBOW_SNIPER_DAMAGE    120
+#define HL_CROSSBOW_BOLT_DAMAGE      50
+#define HL_CROSSBOW_BOLT_BLAST       40
+#define HL_CROSSBOW_MAX_SPEED        230.0f
+#define HL_CROSSBOW_WEIGHT           30
+
+// Rocket launcher, its rocket following the laser spot
+#define HL_RPG_PRICE                 4500
+#define HL_RPG_MAX_CLIP              1
+#define HL_RPG_MAX_CARRY             5
+#define HL_RPG_AMMO_PRICE            300
+#define HL_RPG_AMMO_BUY              1
+#define HL_RPG_DAMAGE                120
+#define HL_RPG_MAX_SPEED             200.0f
+#define HL_RPG_WEIGHT                30
+
+// Gauss (tau cannon): a primary shot, or a charged one that also pushes its shooter back
+#define HL_GAUSS_PRICE               4000
+#define HL_GAUSS_DEFAULT_GIVE        40
+#define HL_URANIUM_MAX_CARRY         100
+#define HL_URANIUM_AMMO_PRICE        200
+#define HL_URANIUM_AMMO_BUY          20
+#define HL_GAUSS_DAMAGE              20
+#define HL_GAUSS_MAX_CHARGE_DAMAGE   200
+#define HL_GAUSS_MAX_SPEED           220.0f
+#define HL_GAUSS_WEIGHT              30
+
+// Egon (gluon gun): a continuous beam
+#define HL_EGON_PRICE                5500
+#define HL_EGON_DEFAULT_GIVE         40
+#define HL_EGON_DAMAGE               12
+#define HL_EGON_MAX_SPEED            210.0f
+#define HL_EGON_WEIGHT               30
+
+class CHLPython: public CHLWeapon
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+	virtual int GetItemInfo(ItemInfo *p);
+	virtual BOOL Deploy();
+	virtual void Holster(int skiplocal = 0);
+	virtual float GetMaxSpeed() { return HL_PYTHON_MAX_SPEED; }
+	virtual int iItemSlot() { return PISTOL_SLOT; }
+	virtual void PrimaryAttack();
+	virtual void SecondaryAttack();
+	virtual void Reload();
+	virtual void WeaponIdle();
+	virtual BOOL IsPistol() { return TRUE; }
+
+private:
+	float m_flSoundTime;
+	unsigned short m_usFirePython;
+};
+
+class CHLCrossbow: public CHLWeapon
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+	virtual int GetItemInfo(ItemInfo *p);
+	virtual BOOL Deploy();
+	virtual void Holster(int skiplocal = 0);
+	virtual float GetMaxSpeed() { return HL_CROSSBOW_MAX_SPEED; }
+	virtual int iItemSlot() { return PRIMARY_WEAPON_SLOT; }
+	virtual void PrimaryAttack();
+	virtual void SecondaryAttack();
+	virtual void Reload();
+	virtual void WeaponIdle();
+
+private:
+	void FireBolt();
+	void FireSniperBolt();
+	unsigned short m_usCrossbow;
+	unsigned short m_usCrossbow2;
+};
+
+class CHLCrossbowBolt: public CBaseEntity
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+	virtual int Classify() { return CLASS_NONE; }
+
+	static CHLCrossbowBolt *BoltCreate();
+	void EXPORT BubbleThink();
+	void EXPORT BoltTouch(CBaseEntity *pOther);
+	void EXPORT ExplodeThink();
+};
+
+class CHLLaserSpot: public CBaseEntity
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+	virtual int ObjectCaps() { return FCAP_DONT_SAVE; }
+
+	static CHLLaserSpot *CreateSpot();
+	void Suspend(float flSuspendTime);
+	void EXPORT Revive();
+};
+
+class CHLRpg: public CHLWeapon
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+	virtual int GetItemInfo(ItemInfo *p);
+	virtual BOOL Deploy();
+	virtual BOOL CanHolster();
+	virtual void Holster(int skiplocal = 0);
+	virtual float GetMaxSpeed() { return HL_RPG_MAX_SPEED; }
+	virtual int iItemSlot() { return PRIMARY_WEAPON_SLOT; }
+	virtual void PrimaryAttack();
+	virtual void SecondaryAttack();
+	virtual void Reload();
+	virtual void WeaponIdle();
+
+	void UpdateSpot();
+
+	CHLLaserSpot *m_pSpot;
+	int m_fSpotActive;
+	int m_cActiveRockets;
+
+private:
+	unsigned short m_usRpg;
+};
+
+class CHLRpgRocket: public CBaseEntity
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+
+	static CHLRpgRocket *CreateRpgRocket(Vector vecOrigin, Vector vecAngles, CBaseEntity *pOwner, CHLRpg *pLauncher);
+	void EXPORT IgniteThink();
+	void EXPORT FollowThink();
+	void EXPORT RocketTouch(CBaseEntity *pOther);
+	void Explode(TraceResult *pTrace);
+
+private:
+	void Forget();
+	EntityHandle<CHLRpg> m_hLauncher;
+	int m_iTrail;
+	float m_flIgniteTime;
+};
+
+class CHLGauss: public CHLWeapon
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+	virtual int GetItemInfo(ItemInfo *p);
+	virtual BOOL Deploy();
+	virtual void Holster(int skiplocal = 0);
+	virtual float GetMaxSpeed() { return HL_GAUSS_MAX_SPEED; }
+	virtual int iItemSlot() { return PRIMARY_WEAPON_SLOT; }
+	virtual void PrimaryAttack();
+	virtual void SecondaryAttack();
+	virtual void WeaponIdle();
+
+private:
+	void StartFire();
+	void Fire(Vector vecOrigSrc, Vector vecDir, float flDamage);
+	float GetFullChargeTime() { return 1.5f; }
+
+	int m_fInAttack;
+	int m_fPrimaryFire;
+	int m_iSoundState;
+	float m_flStartCharge;
+	float m_flAmmoStartCharge;
+	float m_flNextAmmoBurn;
+	float m_flPlayAftershock;
+	unsigned short m_usGaussFire;
+	unsigned short m_usGaussSpin;
+};
+
+class CHLEgon: public CHLWeapon
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+	virtual int GetItemInfo(ItemInfo *p);
+	virtual BOOL Deploy();
+	virtual void Holster(int skiplocal = 0);
+	virtual float GetMaxSpeed() { return HL_EGON_MAX_SPEED; }
+	virtual int iItemSlot() { return PRIMARY_WEAPON_SLOT; }
+	virtual void PrimaryAttack();
+	virtual void WeaponIdle();
+
+private:
+	enum { FIRE_OFF, FIRE_CHARGE };
+	void Attack();
+	void Fire(const Vector &vecOrigSrc, const Vector &vecDir);
+	void EndAttack();
+	void CreateEffect();
+	void UpdateEffect(const Vector &startPoint, const Vector &endPoint, float timeBlend);
+	void DestroyEffect();
+	BOOL HasAmmo() { return m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] > 0; }
+	void UseAmmo(int count);
+
+	CBeam *m_pBeam;
+	CBeam *m_pNoise;
+	CSprite *m_pSprite;
+	int m_fireState;
+	float m_flAmmoUseTime;
+	float m_flDamageTime;
+	float m_flStartupTime;
+	float m_shakeTime;
+	unsigned short m_usEgonFire;
+	unsigned short m_usEgonStop;
+};
