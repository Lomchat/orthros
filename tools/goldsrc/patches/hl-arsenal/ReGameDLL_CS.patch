+// (whether charges its holder threw are lying around)
+bool CHLSatchel::HasCharges()
+{
+	if (!m_pPlayer)
+		return false;
+
+	CBaseEntity *pCharge = nullptr;
+	while ((pCharge = UTIL_FindEntityByClassname(pCharge, "monster_satchel")))
+	{
+		if (pCharge->pev->owner == m_pPlayer->edict() && !(pCharge->pev->flags & FL_KILLME))
+			return true;
+	}
+
+	return false;
+}
