+// ---------------------------------------------------------------------------------------------------------------------
+// The Pokemon
+
+// (its path on the bots' navigation mesh: no ladder; the crouch-only areas for the small one only)
+class PokemonPathCost
+{
+public:
+	PokemonPathCost(bool bTall) : m_bTall(bTall) {}
+
+	float operator()(CNavArea *area, CNavArea *fromArea, const CNavLadder *ladder)
+	{
+		if (!fromArea)
+			return 0.0f;
+
+		if (ladder)
+			return -1.0f;
+
+		if (m_bTall && (area->GetAttributes() & NAV_CROUCH))
+			return -1.0f;
+
+		float dist = (*area->GetCenter() - *fromArea->GetCenter()).Length();
+		float cost = dist + fromArea->GetCostSoFar();
+		if (area->GetAttributes() & NAV_JUMP)
+			cost += 2.0f * dist;
+
+		return cost;
+	}
+
+private:
+	bool m_bTall;
+};
