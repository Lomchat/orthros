+
+void CHLGauss::SecondaryAttack()
+{
+	// (no charging in the freeze period; a charge already going may finish)
+	if (m_fInAttack == 0 && !CanFire())
+		return;
+
+	if (m_pPlayer->pev->waterlevel == 3)
+	{
+		if (m_fInAttack != 0)
+		{
+			EMIT_SOUND_DYN(ENT(m_pPlayer->pev), CHAN_WEAPON, "weapons/electro4.wav", VOL_NORM, ATTN_NORM, 0, 80 + RANDOM_LONG(0, 0x3f));
+			SendWeaponAnim(GAUSS_IDLE);
+			m_fInAttack = 0;
+		}
+		else
+		{
+			PlayEmptySound();
+		}
+
+		m_flNextSecondaryAttack = m_flNextPrimaryAttack = GetNextAttackDelay(0.5f);
+		return;
+	}
+
+	if (m_fInAttack == 0)
+	{
+		if (m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] <= 0)
+		{
+			EMIT_SOUND(ENT(m_pPlayer->pev), CHAN_WEAPON, "weapons/357_cock1.wav", 0.8f, ATTN_NORM);
+			m_pPlayer->m_flNextAttack = UTIL_WeaponTimeBase() + 0.5f;
+			return;
+		}
+
+		m_fPrimaryFire = FALSE;
+		m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType]--; // (one to start the spin)
+		m_flNextAmmoBurn = gpGlobals->time;
+		m_pPlayer->m_iWeaponVolume = HL_GAUSS_PRIMARY_CHARGE_VOLUME;
+
+		SendWeaponAnim(GAUSS_SPINUP);
+		m_fInAttack = 1;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 0.5f;
+		m_flStartCharge = gpGlobals->time;
+		m_flAmmoStartCharge = gpGlobals->time + GetFullChargeTime();
+
+		PLAYBACK_EVENT_FULL(0, m_pPlayer->edict(), m_usGaussSpin, 0.0f, (float *)&g_vecZero, (float *)&g_vecZero, 0.0f, 0.0f, 110, 0, 0, 0);
+		m_iSoundState = SND_CHANGE_PITCH;
+	}
+	else if (m_fInAttack == 1)
+	{
+		if (m_flTimeWeaponIdle < UTIL_WeaponTimeBase())
+		{
+			SendWeaponAnim(GAUSS_SPIN);
+			m_fInAttack = 2;
+		}
+	}
+	else
+	{
+		// (charging eats one round every 0.1 s until full)
+		if (gpGlobals->time >= m_flNextAmmoBurn && m_flNextAmmoBurn != 1000)
+		{
+			m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType]--;
+			m_flNextAmmoBurn = gpGlobals->time + 0.1f;
+		}
+
+		if (m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] <= 0)
+		{
+			// (out of ammo: the gun fires)
+			StartFire();
+			m_fInAttack = 0;
+			m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 1.0f;
+			m_pPlayer->m_flNextAttack = UTIL_WeaponTimeBase() + 1.0f;
+			return;
+		}
+
+		if (gpGlobals->time >= m_flAmmoStartCharge)
+			m_flNextAmmoBurn = 1000; // (fully charged: no more ammo)
+
+		int pitch = int((gpGlobals->time - m_flStartCharge) * (150 / GetFullChargeTime()) + 100);
+		if (pitch > 250)
+			pitch = 250;
+
+		bool overcharge = m_flStartCharge < gpGlobals->time - 10.0f;
+		if (!overcharge)
+			PLAYBACK_EVENT_FULL(0, m_pPlayer->edict(), m_usGaussSpin, 0.0f, (float *)&g_vecZero, (float *)&g_vecZero, 0.0f, 0.0f, pitch, 0, (m_iSoundState == SND_CHANGE_PITCH) ? 1 : 0, 0);
+
+		m_iSoundState = SND_CHANGE_PITCH;
+		m_pPlayer->m_iWeaponVolume = HL_GAUSS_PRIMARY_CHARGE_VOLUME;
+
+		if (overcharge)
+		{
+			// (charged too long: it zaps its holder)
+			PLAYBACK_EVENT_FULL(0, m_pPlayer->edict(), m_usGaussSpin, 0.0f, (float *)&g_vecZero, (float *)&g_vecZero, 0.0f, 0.0f, pitch, 0, 0, 1);
+			EMIT_SOUND_DYN(ENT(m_pPlayer->pev), CHAN_WEAPON, "weapons/electro4.wav", VOL_NORM, ATTN_NORM, 0, 80 + RANDOM_LONG(0, 0x3f));
+			EMIT_SOUND_DYN(ENT(m_pPlayer->pev), CHAN_ITEM, "weapons/electro6.wav", VOL_NORM, ATTN_NORM, 0, 75 + RANDOM_LONG(0, 0x3f));
+
+			m_fInAttack = 0;
+			m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 1.0f;
+			m_pPlayer->m_flNextAttack = UTIL_WeaponTimeBase() + 1.0f;
+			SendWeaponAnim(GAUSS_IDLE);
+
+			CBasePlayer *pPlayer = m_pPlayer;
+			UTIL_ScreenFade(pPlayer, Vector(255, 128, 0), 2, 0.5f, 128, FFADE_IN);
+			pPlayer->TakeDamage(VARS(eoNullEntity), VARS(eoNullEntity), 50, DMG_SHOCK);
+			// (this weapon may be dropped now)
+			return;
+		}
+	}
+}
+
+void CHLGauss::StartFire()
+{
+	if (m_flStartCharge > gpGlobals->time)
+		m_flStartCharge = gpGlobals->time;
+
+	UTIL_MakeVectors(m_pPlayer->pev->v_angle + m_pPlayer->pev->punchangle);
+	Vector vecAiming = gpGlobals->v_forward;
+	Vector vecSrc = m_pPlayer->GetGunPosition();
+
+	float flDamage;
+	if (m_fPrimaryFire)
+		flDamage = HL_GAUSS_DAMAGE;
+	else if (gpGlobals->time - m_flStartCharge > GetFullChargeTime())
+		flDamage = HL_GAUSS_MAX_CHARGE_DAMAGE;
+	else
+		flDamage = HL_GAUSS_MAX_CHARGE_DAMAGE * ((gpGlobals->time - m_flStartCharge) / GetFullChargeTime());
+
+	if (m_fInAttack != 3)
+	{
+		// (a charged shot pushes its shooter back, up too: the multiplayer gauss jump)
+		if (!m_fPrimaryFire)
+			m_pPlayer->pev->velocity = m_pPlayer->pev->velocity - gpGlobals->v_forward * flDamage * 5.0f;
+
+		m_pPlayer->SetAnimation(PLAYER_ATTACK1);
+	}
+
+	m_flPlayAftershock = gpGlobals->time + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 0.3f, 0.8f);
+	Fire(vecSrc, vecAiming, flDamage);
+}
+
+void CHLGauss::Fire(Vector vecOrigSrc, Vector vecDir, float flDamage)
+{
+	m_pPlayer->m_iWeaponVolume = HL_GAUSS_PRIMARY_FIRE_VOLUME;
+
+	Vector vecSrc = vecOrigSrc;
+	Vector vecDest = vecSrc + vecDir * 8192.0f;
+	edict_t *pentIgnore = ENT(m_pPlayer->pev);
+	TraceResult tr, beam_tr;
+	int fHasPunched = 0;
+	int fFirstBeam = 1;
+	int nMaxHits = 10;
+
+	// (the firing event unreliable so that it is not delayed; a reliable one, a frame later, stops the spin sound)
+	PLAYBACK_EVENT_FULL(0, m_pPlayer->edict(), m_usGaussFire, 0.0f, m_pPlayer->pev->origin, m_pPlayer->pev->angles, flDamage, 0.0f, 0, 0, m_fPrimaryFire ? 1 : 0, 0);
+	PLAYBACK_EVENT_FULL(FEV_RELIABLE | FEV_GLOBAL, m_pPlayer->edict(), m_usGaussFire, 0.01f, m_pPlayer->pev->origin, m_pPlayer->pev->angles, 0.0f, 0.0f, 0, 0, 0, 1);
+
+	while (flDamage > 10 && nMaxHits > 0)
+	{
+		nMaxHits--;
+		UTIL_TraceLine(vecSrc, vecDest, dont_ignore_monsters, pentIgnore, &tr);
+
+		if (tr.fAllSolid)
+			break;
+
+		CBaseEntity *pEntity = CBaseEntity::Instance(tr.pHit);
+		if (!pEntity)
+			break;
+
+		if (fFirstBeam)
+		{
+			m_pPlayer->pev->effects |= EF_MUZZLEFLASH;
+			fFirstBeam = 0;
+		}
+
+		if (pEntity->pev->takedamage)
+		{
+			ClearMultiDamage();
+			if (pEntity->pev == m_pPlayer->pev)
+				tr.iHitgroup = 0;
+			pEntity->TraceAttack(m_pPlayer->pev, flDamage, vecDir, &tr, DMG_BULLET);
+			ApplyMultiDamage(m_pPlayer->pev, m_pPlayer->pev);
+		}
+
+		if (pEntity->ReflectGauss())
+		{
+			pentIgnore = nullptr;
+			float n = -DotProduct(tr.vecPlaneNormal, vecDir);
+
+			if (n < 0.5f) // (60 degrees: it reflects)
+			{
+				Vector r = 2.0 * tr.vecPlaneNormal * n + vecDir;
+				vecDir = r;
+				vecSrc = tr.vecEndPos + vecDir * 8.0f;
+				vecDest = vecSrc + vecDir * 8192.0f;
+
+				HL_RadiusDamage(tr.vecEndPos, pev, m_pPlayer->pev, flDamage * n, flDamage * n * 2.5f);
+
+				if (n == 0.0f)
+					n = 0.1f;
+
+				flDamage = flDamage * (1.0f - n);
+			}
+			else
+			{
+				// (one hole punch at most, by the charged shot only)
+				if (fHasPunched)
+					break;
+
+				fHasPunched = 1;
+
+				if (!m_fPrimaryFire)
+				{
+					UTIL_TraceLine(tr.vecEndPos + vecDir * 8, vecDest, dont_ignore_monsters, pentIgnore, &beam_tr);
+					if (!beam_tr.fAllSolid)
+					{
+						// (backwards to the exit point)
+						UTIL_TraceLine(beam_tr.vecEndPos, tr.vecEndPos, dont_ignore_monsters, pentIgnore, &beam_tr);
+
+						n = (beam_tr.vecEndPos - tr.vecEndPos).Length();
+						if (n < flDamage)
+						{
+							if (n == 0.0f)
+								n = 1.0f;
+
+							flDamage -= n;
+							HL_RadiusDamage(beam_tr.vecEndPos + vecDir * 8, pev, m_pPlayer->pev, flDamage, flDamage * 1.75f);
+							vecSrc = beam_tr.vecEndPos + vecDir;
+						}
+						else
+						{
+							flDamage = 0;
+						}
+					}
+					else
+					{
+						flDamage = 0;
+					}
+				}
+				else
+				{
+					flDamage = 0;
+				}
+			}
+		}
+		else
+		{
+			vecSrc = tr.vecEndPos + vecDir;
+			pentIgnore = ENT(pEntity->pev);
+		}
+	}
+}
+
+void CHLGauss::WeaponIdle()
+{
+	ResetEmptySound();
+
+	// (the aftershock static discharge)
+	if (m_flPlayAftershock != 0.0f && m_flPlayAftershock < gpGlobals->time)
+	{
+		static const char *sounds[] = { "weapons/electro4.wav", "weapons/electro5.wav", "weapons/electro6.wav" };
+		int i = RANDOM_LONG(0, 3);
+		if (i < 3)
+			EMIT_SOUND(ENT(m_pPlayer->pev), CHAN_WEAPON, sounds[i], RANDOM_FLOAT(0.7f, 0.8f), ATTN_NORM);
+
+		m_flPlayAftershock = 0.0f;
+	}
+
+	if (m_flTimeWeaponIdle > UTIL_WeaponTimeBase())
+		return;
+
+	if (m_fInAttack != 0)
+	{
+		StartFire();
+		m_fInAttack = 0;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 2.0f;
+		return;
+	}
+
+	int iAnim;
+	float flRand = RANDOM_FLOAT(0.0f, 1.0f);
+	if (flRand <= 0.5f)
+	{
+		iAnim = GAUSS_IDLE;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 10.0f, 15.0f);
+	}
+	else if (flRand <= 0.75f)
+	{
+		iAnim = GAUSS_IDLE2;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 10.0f, 15.0f);
+	}
+	else
+	{
+		iAnim = GAUSS_FIDGET;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 3.0f;
+	}
+
+	SendWeaponAnim(iAnim);
+}
