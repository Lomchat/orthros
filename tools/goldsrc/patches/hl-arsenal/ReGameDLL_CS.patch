+static void BUILD_Deny(CBasePlayer *pPlayer, int iReason)
+{
+	MESSAGE_BEGIN(MSG_ONE, gmsgBuildDeny, nullptr, pPlayer->pev);
+		WRITE_BYTE(iReason);
+	MESSAGE_END();
+}
+
+static void BUILD_WeaponAnim(CBasePlayer *pPlayer, int iAnim)
+{
+	pPlayer->pev->weaponanim = iAnim;
+	MESSAGE_BEGIN(MSG_ONE, SVC_WEAPONANIM, nullptr, pPlayer->pev);
+		WRITE_BYTE(iAnim);
