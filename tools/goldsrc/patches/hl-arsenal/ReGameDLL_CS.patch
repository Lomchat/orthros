+
+// Code rain around a standing spot (its feet): green columns of falling glyphs, and glyphs falling from above its head,
+// within flRadius of it and flHeight up
+static void PK_FxCodeRain(const Vector &vecFeet, float flRadius, float flHeight, int iColumns)
+{
+	float flStart = RANDOM_FLOAT(0.0f, 360.0f);
+	for (int i = 0; i < iColumns; i++)
+	{
+		float a = (flStart + (360.0f / iColumns) * (i + RANDOM_FLOAT(-0.3f, 0.3f))) * (M_PI / 180.0f);
+		float r = RANDOM_FLOAT(0.55f, 1.0f) * flRadius;
+		Vector pos = vecFeet + Vector(Q_cos(a) * r, Q_sin(a) * r, RANDOM_FLOAT(0.45f, 0.6f) * flHeight);
+		PK_FxAnimated(pos, s_iSprCodeRain, LEM_RAIN_SCALE + RANDOM_LONG(-1, 1), LEM_RAIN_FRAMERATE + RANDOM_LONG(-2, 2));
+	}
+
+	for (int i = 0; i < 2; i++)
+	{
+		float a = RANDOM_FLOAT(0.0f, 2.0f * M_PI);
+		float r = RANDOM_FLOAT(0.2f, 0.8f) * flRadius;
+		Vector pos = vecFeet + Vector(Q_cos(a) * r, Q_sin(a) * r, flHeight + RANDOM_FLOAT(4.0f, 16.0f));
+		PK_FxSpray(pos, Vector(0, 0, -1), s_iSprPixels, 5, 130, 18);
+	}
+}
+
+// A horizontal ring (a scan line) of thin green beams around a standing spot, flHeight up, for a tenth of a second
+static void PK_FxScanRing(const Vector &vecFeet, float flHeight, float flRadius, int iBrightness)
+{
+	Vector vecCentre = vecFeet + Vector(0, 0, flHeight);
+	float flTurn = RANDOM_FLOAT(0.0f, 2.0f * M_PI / LEM_SCAN_SIDES);
+	for (int i = 0; i < LEM_SCAN_SIDES; i++)
+	{
+		float a0 = flTurn + (2.0f * M_PI / LEM_SCAN_SIDES) * i;
+		float a1 = a0 + 2.0f * M_PI / LEM_SCAN_SIDES;
+		Vector p0 = vecCentre + Vector(Q_cos(a0) * flRadius, Q_sin(a0) * flRadius, 0);
+		Vector p1 = vecCentre + Vector(Q_cos(a1) * flRadius, Q_sin(a1) * flRadius, 0);
+		PK_FxBeam(p0, p1, g_sModelIndexLaser, 0, 0, 1, 8, 0, int(LEM_GREEN.x), int(LEM_GREEN.y), int(LEM_GREEN.z), iBrightness, 0);
+	}
+}
+
+// A glitch on a body: glitch.spr's shifted slices, once, quickly (~0.27 s), somewhere between its knees and its head
+static void PK_FxGlitch(CBaseEntity *pEntity)
+{
+	float flHeight = pEntity->pev->maxs.z - pEntity->pev->mins.z;
+	Vector pos = PK_Feet(pEntity) + Vector(RANDOM_FLOAT(-6, 6), RANDOM_FLOAT(-6, 6), RANDOM_FLOAT(0.3f, 0.85f) * flHeight);
+	PK_FxAnimated(pos, s_iSprGlitch, RANDOM_LONG(4, 7), 30);
+}
+
+// Pixels thrown off a point (additive pixels.spr bits, slowly falling once out)
+static void PK_FxPixels(const Vector &pos, const Vector &dir, int iCount, int iSpeed, int iNoise)
+{
+	PK_FxSpray(pos, dir, s_iSprPixels, iCount, iSpeed, iNoise);
+}
+
+// Hack: a wide stream of green code scrolling from the hand to its target (short of a player: a wide beam to his
+// chest would fill his screen), a bright core all the way, and two thin crackling strands around it
+static void PK_FxHackBeam(const Vector &vecSrc, const Vector &vecEnd, bool bOnPlayer)
+{
+	Vector vecDelta = vecEnd - vecSrc;
+	float flLen = vecDelta.Length();
+	if (flLen < 1.0f)
+		return;
+
+	Vector vecDir = vecDelta * (1.0f / flLen);
+	float flStream = bOnPlayer ? Q_max(flLen - clamp(0.2f * flLen, 12.0f, 28.0f), 0.0f) : flLen;
+	int iFrame = RANDOM_LONG(0, 7);
+
+	if (flStream > 4.0f)
+		PK_FxBeam(vecSrc, vecSrc + vecDir * flStream, s_iSprCodeBeam, iFrame, 100, 3, 45, 0, 60, 255, 110, 220, 90);
+
+	PK_FxBeam(vecSrc, vecEnd, s_iSprCodeBeam, (iFrame + 3) & 7, 100, 3, 14, 0, 190, 255, 200, 255, 140);
+
+	// (the engine's noise: about noise * length / 5000 units off the beam; ~4 units)
+	int iNoise = clamp(int(20000.0f / flLen), 30, 200);
+	for (int i = 0; i < 2; i++)
+	{
+		Vector vecJitter(RANDOM_FLOAT(-3, 3), RANDOM_FLOAT(-3, 3), RANDOM_FLOAT(-3, 3));
+		PK_FxBeam(vecSrc, vecEnd + vecJitter, g_sModelIndexLaser, 0, 0, 2, 6, iNoise, 40, 255, 80, 170, 0);
+	}
+}
