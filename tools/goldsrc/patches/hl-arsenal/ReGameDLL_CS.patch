+// Its Pokemon out (not dying nor going back), if any
+static CPokemon *PK_PokemonOf(CBasePlayer *pPlayer)
+{
+	CBaseEntity *pEntity = nullptr;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "monster_pokemon")))
+	{
+		CPokemon *pPokemon = static_cast<CPokemon *>(pEntity);
+		if (pPokemon->IsOut() && pPokemon->IsOwnedBy(pPlayer))
+			return pPokemon;
+	}
+
+	return nullptr;
+}
+
+// A ball of its in flight
+static bool PK_BallInFlight(CBasePlayer *pPlayer)
+{
+	CBaseEntity *pEntity = nullptr;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "pokeball")))
+	{
+		CPokeBall *pBall = static_cast<CPokeBall *>(pEntity);
+		if (pBall->IsOwnedBy(pPlayer) && !pBall->IsOpened() && !(pEntity->pev->flags & FL_KILLME))
+			return true;
+	}
