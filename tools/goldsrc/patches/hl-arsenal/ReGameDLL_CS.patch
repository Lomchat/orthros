--- /dev/null
+++ b/regamedll/dlls/hl_weapons.h
@@ -0,0 +1,646 @@
+/*
+*	Half-Life arsenal: the fourteen Half-Life weapons bought and used in Counter-Strike, ported from the Half-Life SDK
+*	(crowbar.cpp, glock.cpp, python.cpp, mp5.cpp, shotgun.cpp, crossbow.cpp, rpg.cpp, gauss.cpp, egon.cpp, hornetgun.cpp,
+*	hornet.cpp, handgrenade.cpp, satchel.cpp, tripmine.cpp, squeakgrenade.cpp) onto this game's weapon classes.
+*
+*	Their ids follow the 32 of Counter-Strike: pev->weapons has 32 bits, so a player's Half-Life weapons reach the
+*	client by the HLWeapons message, and the client does not predict them (clientdata m_iId is 0 while one is held,
+*	its delta field has 5 bits). Their animations come from the server, their fire effects from the Half-Life events.
+*
+*	Their numbers are Counter-Strike's scale, not Half-Life's (a player has 100 health and kevlar here): see the
+*	balance table of docs/browser-ports.md.
+*/
+#pragma once
+
+// (the arsenal's weapons past Counter-Strike's 32: Half-Life's, and Half Strike's Poke Balls and Le M's laptop
+// — pokemon.h — after them)
+inline bool IsHLWeapon(int id) { return id >= WEAPON_HL_FIRST && id <= WEAPON_COMPANION_LAST; }
+
+// The bit of a weapon in pev->weapons, none for the Half-Life weapons
+inline int WeaponBit(int id) { return (id >= 0 && id < 32) ? (1 << id) : 0; }
+
+// The share of a hit an armored player takes, as Counter-Strike's table in CBasePlayer::TakeDamage (1 for none)
+float HL_ArmorRatio(int id);
+
+// Buying a Half-Life weapon of the knife or grenade slots, and the MP5's grenades (client.cpp's menus and aliases)
+CBaseEntity *HL_BuyEquipment(CBasePlayer *pPlayer, WeaponIdType weaponID);
