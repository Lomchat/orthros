+	void EXPORT OpenThink();
+
+	bool IsOwnedBy(CBasePlayer *pPlayer) { return m_hOwner.IsValid() && m_hOwner == pPlayer; }
+	bool IsOpened() const { return m_bReleased; } // (done: its Pokemon out, or the ball back in hand)
+
+private:
