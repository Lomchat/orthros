+bool CHLHornet::IsEnemy(CBaseEntity *pOther)
+{
+	return HL_IsEnemyOf(m_iOwnerTeam, pOther, pev->owner ? CBaseEntity::Instance(pev->owner) : nullptr);
+}
+
+void CHLHornet::TrackTarget()
+{
+	StudioFrameAdvance();
+
+	if (gpGlobals->time > m_flStopAttack)
+	{
+		SetTouch(nullptr);
+		SetThink(&CBaseEntity::SUB_Remove);
+		pev->nextthink = gpGlobals->time + 0.1f;
+		return;
+	}
+
+	// (an enemy within 25 degrees of its heading, as Half-Life's)
+	if (!m_hEnemy.IsValid() || !IsEnemy(m_hEnemy))
+		m_hEnemy = HL_FindEnemy(this, m_iOwnerTeam, pev->owner ? CBaseEntity::Instance(pev->owner) : nullptr, 512, 0.9f);
+
+	if (m_hEnemy.IsValid() && FVisible(m_hEnemy))
+		m_vecEnemyLKP = m_hEnemy->BodyTarget(pev->origin);
+	else
+		m_vecEnemyLKP = m_vecEnemyLKP + pev->velocity * m_flFlySpeed * 0.1f;
+
+	Vector vecDirToEnemy = (m_vecEnemyLKP - pev->origin).Normalize();
+	Vector vecFlightDir = (pev->velocity.Length() < 0.1f) ? vecDirToEnemy : pev->velocity.Normalize();
+
+	// (how much it has to turn)
+	float flDelta = DotProduct(vecFlightDir, vecDirToEnemy);
+	if (flDelta < 0.5f)
+		Buzz();
+
+	if (flDelta <= 0 && m_iHornetType == HL_HORNET_TYPE_RED)
+		flDelta = 0.25f; // (no sharp turns for the red ones)
+
+	pev->velocity = (vecFlightDir + vecDirToEnemy).Normalize();
+
+	if (m_iHornetType == HL_HORNET_TYPE_RED)
+	{
+		pev->velocity = pev->velocity * (m_flFlySpeed * flDelta);
+		pev->nextthink = gpGlobals->time + RANDOM_FLOAT(0.1f, 0.3f);
+	}
+	else
+	{
+		pev->velocity = pev->velocity * m_flFlySpeed;
+		pev->nextthink = gpGlobals->time + 0.1f;
+	}
+
+	pev->angles = UTIL_VecToAngles(pev->velocity);
+	pev->solid = SOLID_BBOX;
+}
+
+void CHLHornet::TrackTouch(CBaseEntity *pOther)
+{
+	if (pOther->edict() == pev->owner || pOther->pev->modelindex == pev->modelindex)
+	{
+		pev->solid = SOLID_NOT;
+		return;
+	}
+
+	// (off the walls and the shooter's teammates: it stings enemies only)
+	if (!IsEnemy(pOther))
+	{
+		pev->velocity = pev->velocity.Normalize();
+		pev->velocity.x *= -1.0f;
+		pev->velocity.y *= -1.0f;
+		pev->origin = pev->origin + pev->velocity * 4.0f;
+		pev->velocity = pev->velocity * m_flFlySpeed;
+		return;
+	}
+
+	DieTouch(pOther);
+}
+
+void CHLHornet::DieTouch(CBaseEntity *pOther)
+{
+	if (pOther && pOther->pev->takedamage && pev->owner)
+	{
+		static const char *sounds[] = { "hornet/ag_hornethit1.wav", "hornet/ag_hornethit2.wav", "hornet/ag_hornethit3.wav" };
+		EMIT_SOUND(ENT(pev), CHAN_VOICE, sounds[RANDOM_LONG(0, 2)], VOL_NORM, ATTN_NORM);
+
+		TraceResult tr = UTIL_GetGlobalTrace();
+		entvars_t *pevOwner = VARS(pev->owner);
+
+		ClearMultiDamage();
+		pOther->TraceAttack(pevOwner, pev->dmg, pev->velocity.Normalize(), &tr, DMG_BULLET);
+		ApplyMultiDamage(pev, pevOwner);
+	}
+
+	// (invisible, its trail fading out)
+	pev->modelindex = 0;
+	pev->solid = SOLID_NOT;
+	SetTouch(nullptr);
+	SetThink(&CBaseEntity::SUB_Remove);
+	pev->nextthink = gpGlobals->time + 1.0f;
+}
