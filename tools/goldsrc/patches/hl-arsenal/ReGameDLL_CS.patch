+	PRECACHE_SOUND("weapons/g_bounce2.wav");
+	PRECACHE_SOUND("weapons/g_bounce3.wav");
+}
+
+// (set off by its owner's radio)
+void CHLSatchelCharge::Use(CBaseEntity *pActivator, CBaseEntity *pCaller, USE_TYPE useType, float value)
+{
+	SetThink(&CHLSatchelCharge::Detonate);
+	pev->nextthink = gpGlobals->time;
+}
+
+void CHLSatchelCharge::SatchelSlide(CBaseEntity *pOther)
+{
+	if (pOther->edict() == pev->owner)
+		return;
+
+	pev->gravity = 1; // (normal gravity now)
+
+	TraceResult tr;
+	UTIL_TraceLine(pev->origin, pev->origin - Vector(0, 0, 10), ignore_monsters, edict(), &tr);
+	if (tr.flFraction < 1.0f)
+	{
+		// (on the ground: it slows down)
+		pev->velocity = pev->velocity * 0.95f;
+		pev->avelocity = pev->avelocity * 0.9f;
+	}
+
+	if (!(pev->flags & FL_ONGROUND) && pev->velocity.Length2D() > 10.0f && pev->origin != m_lastBounceOrigin)
+	{
+		static const char *sounds[] = { "weapons/g_bounce1.wav", "weapons/g_bounce2.wav", "weapons/g_bounce3.wav" };
+		EMIT_SOUND(ENT(pev), CHAN_VOICE, sounds[RANDOM_LONG(0, 2)], VOL_NORM, ATTN_NORM);
+	}
+
+	m_lastBounceOrigin = pev->origin;
+}
+
+void CHLSatchelCharge::SatchelThink()
+{
+	pev->nextthink = gpGlobals->time + 0.1f;
+
+	// (gone with its owner, as Half-Life's)
+	CBaseEntity *pOwner = pev->owner ? CBaseEntity::Instance(pev->owner) : nullptr;
+	if (!IsInWorld() || !pOwner || !pOwner->IsPlayer() || !pOwner->IsAlive())
+	{
+		UTIL_Remove(this);
+		return;
+	}
+
+	if (pev->waterlevel == 3)
+	{
+		pev->movetype = MOVETYPE_FLY;
+		pev->velocity = pev->velocity * 0.8f;
+		pev->avelocity = pev->avelocity * 0.9f;
+		pev->velocity.z += 8;
+	}
+	else if (pev->waterlevel == 0)
+	{
+		pev->movetype = MOVETYPE_BOUNCE;
+	}
+	else
+	{
+		pev->velocity.z -= 8.0f;
+	}
+}
+
+void CHLSatchelCharge::Detonate()
+{
+	TraceResult tr;
+	Vector vecSpot = pev->origin + Vector(0, 0, 8);
+	UTIL_TraceLine(vecSpot, vecSpot + Vector(0, 0, -40), ignore_monsters, ENT(pev), &tr);
+
+	entvars_t *pevOwner = pev->owner ? VARS(pev->owner) : nullptr;
+	pev->model = iStringNull;
+	pev->solid = SOLID_NOT;
+	pev->effects |= EF_NODRAW;
+	HL_Explosion(this, &tr, pevOwner, pev->dmg, pev->dmg * 2.5f, int((pev->dmg - 50) * 0.6f));
+
+	SetTouch(nullptr);
+	SetThink(&CBaseEntity::SUB_Remove);
+	pev->nextthink = gpGlobals->time + 0.1f;
+}
