@@ -0,0 +1,4470 @@
+// Half-Life arsenal (hl_weapons.h): the Half-Life SDK's weapons on Counter-Strike's weapon classes. Their fire events
+// reach the shooter too (no FEV_NOTHOST: the client does not predict them); their timers are the decremented ones of
+// Counter-Strike's weapons, their own delays in game time. Their entities are named with MAKE_STRING_CLASS: the game
+// finds entities by classname in a table of its own, which a bare pev->classname does not enter.
+#include "precompiled.h"
+
+extern bool g_bClientPrintEnable; // (client.cpp)
+
+// (the Half-Life SDK's aim cones)
+static const Vector HL_CONE_SHOTGUN(0.0675f, 0.0675f, 0.0f);
+static const Vector HL_CONE_DOUBLESHOTGUN(0.09f, 0.06f, 0.0f);
+
+float HL_ArmorRatio(int id)
+{
+	switch (id)
+	{
+		case WEAPON_HL_CROWBAR:  return 1.7f;  // (as the knife)
+		case WEAPON_HL_GLOCK:    return 1.05f; // (as the Glock 18)
+		case WEAPON_HL_PYTHON:   return 1.5f;  // (as the Desert Eagle)
+		case WEAPON_HL_CROSSBOW: return 1.7f;  // (as the Scout)
+		case WEAPON_HL_GAUSS:
+		case WEAPON_HL_EGON:     return 1.5f;
+		default:                 return 1.0f;
+	}
+}
+
+bool CHLWeapon::CanFire()
+{
+	return !g_pGameRules->IsMultiplayer() || (m_pPlayer->m_bCanShoot && !g_pGameRules->IsFreezePeriod() && !m_pPlayer->m_bIsDefusing);
+}
+
+// Whether a player is an enemy of a team, for the weapons that choose their target (never their owner's own)
+static bool HL_IsEnemyOf(int iTeam, CBaseEntity *pEntity, CBaseEntity *pOwner)
+{
+	if (!pEntity || pEntity == pOwner || !pEntity->IsPlayer() || !pEntity->IsAlive())
+		return false;
+
+	CBasePlayer *pPlayer = static_cast<CBasePlayer *>(pEntity);
+	if (pPlayer->m_iTeam != CT && pPlayer->m_iTeam != TERRORIST)
+		return false;
+
+#ifdef REGAMEDLL_ADD
+	if (CSGameRules()->IsFreeForAll())
+		return true;
+#endif
+
+	return pPlayer->m_iTeam != iTeam;
+}
+
+static int HL_TeamOf(edict_t *pOwner)
+{
+	CBaseEntity *pEntity = pOwner ? CBaseEntity::Instance(pOwner) : nullptr;
+	return (pEntity && pEntity->IsPlayer()) ? static_cast<CBasePlayer *>(pEntity)->m_iTeam : UNASSIGNED;
+}
+
+// The nearest enemy player a hunter sees within a range, in its field of view (the cosine, on the horizontal plane)
+static CBaseEntity *HL_FindEnemy(CBaseEntity *pHunter, int iTeam, CBaseEntity *pOwner, float flRange, float flFieldOfView)
+{
+	UTIL_MakeVectors(pHunter->pev->angles);
+	Vector2D vecForward = gpGlobals->v_forward.Make2D().Normalize();
+
+	CBaseEntity *pBest = nullptr;
+	float flBest = flRange;
+
+	for (int i = 1; i <= gpGlobals->maxClients; i++)
+	{
+		CBasePlayer *pPlayer = UTIL_PlayerByIndex(i);
+		if (!UTIL_IsValidPlayer(pPlayer) || !HL_IsEnemyOf(iTeam, pPlayer, pOwner))
+			continue;
+
+		float flDist = (pPlayer->Center() - pHunter->pev->origin).Length();
+		if (flDist >= flBest)
+			continue;
+
+		Vector2D vecLOS = (pPlayer->pev->origin - pHunter->pev->origin).Make2D().Normalize();
+		if (DotProduct(vecLOS, vecForward) <= flFieldOfView)
+			continue;
+
+		if (!pHunter->FVisible(pPlayer))
+			continue;
+
+		pBest = pPlayer;
+		flBest = flDist;
+	}
+
+	return pBest;
+}
+
+// Half-Life's radius damage, through no wall (bodies do not shield, as in Counter-Strike). On players as a grenade's
+// (DMG_EXPLOSION: the kill counts, unlike the bomb's DMG_BLAST), and not on the attacker's teammates without friendly fire.
+static void HL_RadiusDamage(Vector vecSrc, entvars_t *pevInflictor, entvars_t *pevAttacker, float flDamage, float flRadius, int bitsDamageType = DMG_EXPLOSION)
+{
+	if (!pevAttacker)
+		pevAttacker = pevInflictor;
+
+	CBaseEntity *pAttacker = CBaseEntity::Instance(pevAttacker);
+	CBasePlayer *pAttackingPlayer = (pAttacker && pAttacker->IsPlayer()) ? static_cast<CBasePlayer *>(pAttacker) : nullptr;
+
+	float falloff = flRadius ? flDamage / flRadius : 1.0f;
+	bool bInWater = (UTIL_PointContents(vecSrc) == CONTENTS_WATER);
+	vecSrc.z += 1.0f; // (in case it lies on the ground)
+
+	CBaseEntity *pEntity = nullptr;
+	while ((pEntity = UTIL_FindEntityInSphere(pEntity, vecSrc, flRadius)))
+	{
+		if (pEntity->pev->takedamage == DAMAGE_NO)
+			continue;
+
+		// (blasts do not go into or out of water)
+		if (bInWater && pEntity->pev->waterlevel == 0)
+			continue;
+
+		if (!bInWater && pEntity->pev->waterlevel == 3)
+			continue;
+
+		if (pAttackingPlayer && pEntity->IsPlayer() && pEntity != pAttackingPlayer && !friendlyfire.value
+			&& g_pGameRules->PlayerRelationship(pAttackingPlayer, pEntity) == GR_TEAMMATE)
+			continue;
+
+		Vector vecSpot = pEntity->BodyTarget(vecSrc);
+		TraceResult tr;
+		UTIL_TraceLine(vecSrc, vecSpot, ignore_monsters, ENT(pevInflictor), &tr);
+		if (tr.flFraction != 1.0f && tr.pHit != pEntity->edict())
+			continue;
+
+		if (tr.fStartSolid)
+			tr.vecEndPos = vecSrc;
+
+		float flAdjustedDamage = flDamage - (vecSrc - tr.vecEndPos).Length() * falloff;
+		if (flAdjustedDamage < 1.0f)
+			continue;
+
+		pEntity->TakeDamage(pevInflictor, pevAttacker, flAdjustedDamage, bitsDamageType);
+	}
+}
+
+// An explosion at a point: the Half-Life fireball, its blast damage, a scorch mark
+static void HL_Explosion(CBaseEntity *pSource, TraceResult *pTrace, entvars_t *pevOwner, float flDamage, float flRadius, int iScale)
+{
+	Vector origin = pSource->pev->origin;
+	if (pTrace && pTrace->flFraction != 1.0f)
+		origin = pTrace->vecEndPos + pTrace->vecPlaneNormal * 8.0f; // (out of the wall a bit)
+
+	pSource->pev->origin = origin;
+	iScale = clamp(iScale, 1, 255);
+
+	int iContents = UTIL_PointContents(origin);
+	MESSAGE_BEGIN(MSG_PAS, SVC_TEMPENTITY, origin);
+		WRITE_BYTE(TE_EXPLOSION);
+		WRITE_COORD(origin.x);
+		WRITE_COORD(origin.y);
+		WRITE_COORD(origin.z);
+		WRITE_SHORT(iContents != CONTENTS_WATER ? g_sModelIndexFireball : g_sModelIndexWExplosion);
+		WRITE_BYTE(iScale); // scale * 10
+		WRITE_BYTE(15); // framerate
+		WRITE_BYTE(TE_EXPLFLAG_NONE);
+	MESSAGE_END();
+
+	pSource->pev->owner = nullptr; // (the blast traces must not skip the owner)
+	HL_RadiusDamage(origin, pSource->pev, pevOwner, flDamage, flRadius);
+
+	if (pTrace && pTrace->flFraction != 1.0f)
+		UTIL_DecalTrace(pTrace, RANDOM_LONG(0, 1) ? DECAL_SCORCH1 : DECAL_SCORCH2);
+}
+
+static void HL_SetZoom(CBasePlayer *pPlayer, int fov)
+{
+	pPlayer->m_iFOV = fov;
+	pPlayer->pev->fov = fov;
+}
+
+// A weapon's spread, still, moving faster than a walk, or in the air
+static float HL_Spread(CBasePlayer *pPlayer, float flStill, float flMoving, float flAir, float flWalkSpeed = 0.0f)
+{
+	if (!(pPlayer->pev->flags & FL_ONGROUND))
+		return flAir;
+
+	return pPlayer->pev->velocity.Length2D() > flWalkSpeed ? flMoving : flStill;
+}
+
+static void HL_SetViewModels(CBasePlayer *pPlayer, const char *szViewModel, const char *szWeaponModel)
+{
+	pPlayer->pev->viewmodel = ALLOC_STRING(szViewModel);
+	pPlayer->pev->weaponmodel = ALLOC_STRING(szWeaponModel);
+}
+
