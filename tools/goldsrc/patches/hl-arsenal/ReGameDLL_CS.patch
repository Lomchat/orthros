+		pev->owner = m_hOwner->edict();
+}
+
+void CHLSnarkGrenade::HuntThink()
+{
+	if (!IsInWorld())
+	{
+		SetTouch(nullptr);
+		UTIL_Remove(this);
+		return;
+	}
+
+	StudioFrameAdvance();
+	pev->nextthink = gpGlobals->time + 0.1f;
+
+	// (its time is up)
+	if (gpGlobals->time >= m_flDie)
+	{
+		g_vecAttackDir = pev->velocity.Normalize();
+		pev->health = -1;
+		Killed(pev, 0);
+		return;
+	}
+
+	// (float in the water)
+	if (pev->waterlevel != 0)
+	{
+		if (pev->movetype == MOVETYPE_BOUNCE)
+			pev->movetype = MOVETYPE_FLY;
+
+		pev->velocity = pev->velocity * 0.9f;
+		pev->velocity.z += 8.0f;
+	}
+	else if (pev->movetype == MOVETYPE_FLY)
+	{
+		pev->movetype = MOVETYPE_BOUNCE;
+	}
+
+	// (hunts at each bounce, at least every 2 s)
+	if (m_flNextHunt > gpGlobals->time)
+		return;
+
+	m_flNextHunt = gpGlobals->time + 2.0f;
+
+	if (!m_hEnemy.IsValid() || !HL_IsEnemyOf(m_iOwnerTeam, m_hEnemy, m_hOwner))
+		m_hEnemy = FindEnemy();
+
+	if (m_flDie - gpGlobals->time <= 0.5f && m_flDie - gpGlobals->time >= 0.3f)
+		EMIT_SOUND_DYN(ENT(pev), CHAN_VOICE, "squeek/sqk_die1.wav", VOL_NORM, ATTN_NORM, 0, 100 + RANDOM_LONG(0, 0x3F));
+
+	if (m_hEnemy.IsValid())
+	{
+		if (FVisible(m_hEnemy))
+			m_vecTarget = (m_hEnemy->EyePosition() - pev->origin).Normalize();
+
+		float flVel = pev->velocity.Length();
+		float flAdj = 50.0f / (flVel + 10.0f);
+		if (flAdj > 1.2f)
+			flAdj = 1.2f;
+
+		pev->velocity = pev->velocity * flAdj + m_vecTarget * 300.0f;
+	}
+
+	if (pev->flags & FL_ONGROUND)
+	{
+		pev->avelocity = Vector(0, 0, 0);
+	}
+	else if (pev->avelocity == Vector(0, 0, 0))
+	{
+		pev->avelocity.x = RANDOM_FLOAT(-100, 100);
+		pev->avelocity.z = RANDOM_FLOAT(-100, 100);
+	}
+
+	// (stuck: a random jump)
+	if ((pev->origin - m_posPrev).Length() < 1.0f)
+	{
+		pev->velocity.x = RANDOM_FLOAT(-100, 100);
+		pev->velocity.y = RANDOM_FLOAT(-100, 100);
+	}
+
+	m_posPrev = pev->origin;
+
+	pev->angles = UTIL_VecToAngles(pev->velocity);
+	pev->angles.z = 0;
+	pev->angles.x = 0;
+}
+
+void CHLSnarkGrenade::SuperBounceTouch(CBaseEntity *pOther)
+{
+	TraceResult tr = UTIL_GetGlobalTrace();
+
+	// (not its thrower until it has bounced once)
+	if (pev->owner && pOther->edict() == pev->owner)
+		return;
+
+	pev->owner = nullptr;
+	pev->angles.x = 0;
+	pev->angles.z = 0;
+
+	if (m_flNextHit > gpGlobals->time)
+		return;
+
+	// (higher pitched as it nears its end)
+	float flpitch = 155.0f - 60.0f * ((m_flDie - gpGlobals->time) / HL_SNARK_DETONATE_DELAY);
+
+	if (!(pOther->pev->flags & FL_WORLDBRUSH) && pOther->pev->takedamage && m_flNextBite < gpGlobals->time
+		&& tr.pHit == pOther->edict() && pOther->pev->modelindex != pev->modelindex && HL_IsEnemyOf(m_iOwnerTeam, pOther, m_hOwner))
+	{
+		// (a bite)
+		entvars_t *pevOwner = m_hOwner.IsValid() ? m_hOwner->pev : pev;
+		ClearMultiDamage();
+		pOther->TraceAttack(pevOwner, HL_SNARK_BITE_DAMAGE, gpGlobals->v_forward, &tr, DMG_SLASH);
+		ApplyMultiDamage(pev, pevOwner);
+
+		pev->dmg += HL_SNARK_POP_DAMAGE; // (more blast)
+		EMIT_SOUND_DYN(ENT(pev), CHAN_WEAPON, "squeek/sqk_deploy1.wav", VOL_NORM, ATTN_NORM, 0, int(flpitch));
+		m_flNextBite = gpGlobals->time + 0.5f;
+	}
+
+	m_flNextHit = gpGlobals->time + 0.1f;
+	m_flNextHunt = gpGlobals->time;
+
+	if (gpGlobals->time < m_flNextBounceSound)
+		return;
+
+	if (!(pev->flags & FL_ONGROUND))
+	{
+		static const char *sounds[] = { "squeek/sqk_hunt1.wav", "squeek/sqk_hunt2.wav", "squeek/sqk_hunt3.wav" };
+		EMIT_SOUND_DYN(ENT(pev), CHAN_VOICE, sounds[RANDOM_LONG(0, 2)], VOL_NORM, ATTN_NORM, 0, int(flpitch));
+	}
+
+	m_flNextBounceSound = gpGlobals->time + 0.5f;
+}
