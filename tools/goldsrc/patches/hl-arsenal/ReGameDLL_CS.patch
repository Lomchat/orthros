diff --git a/regamedll/dlls/wpn_shared/wpn_hl.cpp b/regamedll/dlls/wpn_shared/wpn_hl.cpp
new file mode 100644
index 0000000..16887f2
--- /dev/null
+++ b/regamedll/dlls/wpn_shared/wpn_hl.cpp
@@ -0,0 +1,1626 @@
+// Half-Life arsenal (hl_weapons.h): the Half-Life SDK's .357, crossbow, RPG, Gauss and Egon on Counter-Strike's
+// weapon classes. Their fire events reach the shooter too (no FEV_NOTHOST: the client does not predict them); their
+// timers are the decremented ones of Counter-Strike's weapons, their own delays in game time.
+#include "precompiled.h"
+
+// An explosion at a point: the Half-Life fireball, its blast damage, a scorch mark
+static void HL_Explosion(CBaseEntity *pSource, TraceResult *pTrace, entvars_t *pevOwner, float flDamage, float flRadius, int iScale)
+{
+	Vector origin = pSource->pev->origin;
+	if (pTrace && pTrace->flFraction != 1.0f)
+		origin = pTrace->vecEndPos + pTrace->vecPlaneNormal * 8.0f; // (out of the wall a bit)
+
+	int iContents = UTIL_PointContents(origin);
+	MESSAGE_BEGIN(MSG_PVS, SVC_TEMPENTITY, origin);
+		WRITE_BYTE(TE_EXPLOSION);
+		WRITE_COORD(origin.x);
+		WRITE_COORD(origin.y);
+		WRITE_COORD(origin.z);
+		WRITE_SHORT(iContents != CONTENTS_WATER ? g_sModelIndexFireball : g_sModelIndexWExplosion);
+		WRITE_BYTE(iScale); // scale * 10
+		WRITE_BYTE(15); // framerate
+		WRITE_BYTE(TE_EXPLFLAG_NONE);
+	MESSAGE_END();
+
+	pSource->pev->owner = nullptr; // (the blast traces must not skip the owner)
+	::RadiusDamage(origin, pSource->pev, pevOwner, flDamage, flRadius, CLASS_NONE, DMG_BLAST);
+
+	if (pTrace && pTrace->flFraction != 1.0f)
+		UTIL_DecalTrace(pTrace, RANDOM_LONG(0, 1) ? DECAL_SCORCH1 : DECAL_SCORCH2);
+}
+
+static void HL_SetZoom(CBasePlayer *pPlayer, int fov)
+{
+	pPlayer->m_iFOV = fov;
+	pPlayer->pev->fov = fov;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// .357 Magnum
+
+enum hl_python_e
+{
+	PYTHON_IDLE1 = 0,
+	PYTHON_FIDGET,
+	PYTHON_FIRE1,
+	PYTHON_RELOAD,
+	PYTHON_HOLSTER,
+	PYTHON_DRAW,
+	PYTHON_IDLE2,
+	PYTHON_IDLE3
+};
+
+LINK_ENTITY_TO_CLASS(weapon_357, CHLPython, CCSPlayerWeapon)
+
+void CHLPython::Spawn()
+{
+	pev->classname = MAKE_STRING("weapon_357");
+	Precache();
+	m_iId = WEAPON_HL_PYTHON;
+	SET_MODEL(edict(), "models/w_357.mdl");
+	m_iDefaultAmmo = HL_PYTHON_MAX_CLIP;
+	m_flSoundTime = 0.0f;
+	FallInit();
+	CBasePlayerWeapon::Spawn();
+}
+
+void CHLPython::Precache()
+{
+	PRECACHE_MODEL("models/v_357.mdl");
+	PRECACHE_MODEL("models/w_357.mdl");
+	PRECACHE_MODEL("models/p_357.mdl");
+
+	PRECACHE_SOUND("weapons/357_reload1.wav");
+	PRECACHE_SOUND("weapons/357_cock1.wav");
+	PRECACHE_SOUND("weapons/357_shot1.wav");
+	PRECACHE_SOUND("weapons/357_shot2.wav");
+
+	m_usFirePython = PRECACHE_EVENT(1, "events/python.sc");
+}
+
+int CHLPython::GetItemInfo(ItemInfo *p)
+{
+	p->pszName = STRING(pev->classname);
+	p->pszAmmo1 = "357";
+	p->iMaxAmmo1 = HL_PYTHON_MAX_CARRY;
+	p->pszAmmo2 = nullptr;
+	p->iMaxAmmo2 = -1;
+	p->iMaxClip = HL_PYTHON_MAX_CLIP;
+	p->iSlot = 1;
+	p->iPosition = 7;
+	p->iId = m_iId = WEAPON_HL_PYTHON;
+	p->iFlags = 0;
+	p->iWeight = HL_PYTHON_WEIGHT;
+	return 1;
+}
+
+BOOL CHLPython::Deploy()
+{
+	pev->body = 1; // (the multiplayer scope)
+	return DefaultDeploy("models/v_357.mdl", "models/p_357.mdl", PYTHON_DRAW, "onehanded", 0);
+}
+
+void CHLPython::Holster(int skiplocal)
+{
+	m_fInReload = FALSE;
+	HL_SetZoom(m_pPlayer, DEFAULT_FOV);
+	m_flSoundTime = 0.0f;
+	SendWeaponAnim(PYTHON_HOLSTER);
+}
+
+void CHLPython::SecondaryAttack()
+{
+	HL_SetZoom(m_pPlayer, m_pPlayer->m_iFOV != DEFAULT_FOV ? DEFAULT_FOV : 40);
+	m_flNextSecondaryAttack = UTIL_WeaponTimeBase() + 0.5f;
+}
+
+void CHLPython::PrimaryAttack()
+{
+	if (m_pPlayer->pev->waterlevel == 3)
+	{
+		PlayEmptySound();
+		m_flNextPrimaryAttack = UTIL_WeaponTimeBase() + 0.15f;
+		return;
+	}
+
+	if (m_iClip <= 0)
+	{
+		if (!m_fFireOnEmpty)
+			Reload();
+		else
+		{
+			PlayEmptySound();
+			m_flNextPrimaryAttack = UTIL_WeaponTimeBase() + 0.15f;
+		}
+		return;
+	}
+
+	m_pPlayer->m_iWeaponVolume = LOUD_GUN_VOLUME;
+	m_pPlayer->m_iWeaponFlash = BRIGHT_GUN_FLASH;
+	m_iClip--;
+	m_pPlayer->pev->effects |= EF_MUZZLEFLASH;
+	m_pPlayer->SetAnimation(PLAYER_ATTACK1);
+
+	UTIL_MakeVectors(m_pPlayer->pev->v_angle + m_pPlayer->pev->punchangle);
+	Vector vecSrc = m_pPlayer->GetGunPosition();
+	float flSpread = (m_pPlayer->pev->flags & FL_ONGROUND) ? (m_pPlayer->pev->velocity.Length2D() > 0 ? 0.04f : 0.01f) : 0.15f;
+	Vector vecDir = m_pPlayer->FireBullets3(vecSrc, gpGlobals->v_forward, flSpread, 8192, 2, BULLET_PLAYER_50AE, HL_PYTHON_DAMAGE, 0.86f, m_pPlayer->pev, true, m_pPlayer->random_seed);
+
+	PLAYBACK_EVENT_FULL(0, m_pPlayer->edict(), m_usFirePython, 0.0f, (float *)&g_vecZero, (float *)&g_vecZero, vecDir.x, vecDir.y, 0, 0, 0, 0);
+
+	m_flNextPrimaryAttack = GetNextAttackDelay(0.75f);
+	m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 10.0f, 15.0f);
+	m_pPlayer->pev->punchangle.x -= 4.0f;
+}
+
+void CHLPython::Reload()
+{
+	if (m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] <= 0 || m_iClip == HL_PYTHON_MAX_CLIP)
+		return;
+
+	HL_SetZoom(m_pPlayer, DEFAULT_FOV);
+	if (DefaultReload(HL_PYTHON_MAX_CLIP, PYTHON_RELOAD, 2.0f))
+	{
+		m_pPlayer->SetAnimation(PLAYER_RELOAD);
+		m_flSoundTime = gpGlobals->time + 1.5f;
+	}
+}
+
+void CHLPython::WeaponIdle()
+{
+	ResetEmptySound();
+
+	if (m_flSoundTime != 0.0f && m_flSoundTime <= gpGlobals->time)
+	{
+		EMIT_SOUND(ENT(m_pPlayer->pev), CHAN_WEAPON, "weapons/357_reload1.wav", RANDOM_FLOAT(0.8f, 0.9f), ATTN_NORM);
+		m_flSoundTime = 0.0f;
+	}
+
+	if (m_flTimeWeaponIdle > UTIL_WeaponTimeBase())
+		return;
+
+	int iAnim;
+	float flRand = UTIL_SharedRandomFloat(m_pPlayer->random_seed, 0.0f, 1.0f);
+	if (flRand <= 0.5f)
+	{
+		iAnim = PYTHON_IDLE1;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + (70.0f / 30.0f);
+	}
+	else if (flRand <= 0.7f)
+	{
+		iAnim = PYTHON_IDLE2;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + (60.0f / 30.0f);
+	}
+	else if (flRand <= 0.9f)
+	{
+		iAnim = PYTHON_IDLE3;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + (88.0f / 30.0f);
+	}
+	else
+	{
+		iAnim = PYTHON_FIDGET;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + (170.0f / 30.0f);
+	}
+	SendWeaponAnim(iAnim);
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Crossbow and its bolt
+
+#define HL_BOLT_AIR_VELOCITY   2000
+#define HL_BOLT_WATER_VELOCITY 1000
+
+LINK_ENTITY_TO_CLASS(hl_crossbow_bolt, CHLCrossbowBolt, CCSEntity)
+
+CHLCrossbowBolt *CHLCrossbowBolt::BoltCreate()
+{
+	CHLCrossbowBolt *pBolt = GetClassPtr<CCSEntity>((CHLCrossbowBolt *)nullptr);
+	pBolt->pev->classname = MAKE_STRING("hl_crossbow_bolt");
+	pBolt->Spawn();
+	return pBolt;
+}
+
+void CHLCrossbowBolt::Spawn()
+{
+	Precache();
+	pev->movetype = MOVETYPE_FLY;
+	pev->solid = SOLID_BBOX;
+	pev->gravity = 0.5f;
+
+	SET_MODEL(edict(), "models/crossbow_bolt.mdl");
+	UTIL_SetOrigin(pev, pev->origin);
+	UTIL_SetSize(pev, Vector(0, 0, 0), Vector(0, 0, 0));
+
+	SetTouch(&CHLCrossbowBolt::BoltTouch);
+	SetThink(&CHLCrossbowBolt::BubbleThink);
+	pev->nextthink = gpGlobals->time + 0.2f;
+}
