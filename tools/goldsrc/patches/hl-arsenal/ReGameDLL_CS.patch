+
+	int iMode = (pPlayer->m_bBuildMode ? 1 : 0) | (BUILD_On() ? 2 : 0);
+	if (iMode != pPlayer->m_iBuildModeSent)
+	{
+		MESSAGE_BEGIN(MSG_ONE, gmsgBuildMode, nullptr, pPlayer->pev);
+			WRITE_BYTE(iMode);
+		MESSAGE_END();
+		pPlayer->m_iBuildModeSent = iMode;
+	}
+}
