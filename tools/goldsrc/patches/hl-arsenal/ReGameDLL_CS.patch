+static void PK_ServerSpawn_f()
+{
+	if (CVAR_GET_FLOAT("sv_cheats") == 0.0f)
+	{
+		SERVER_PRINT("pk_spawn needs sv_cheats 1\n");
+		return;
+	}
+
+	int iSpecies = -1;
+	for (int i = 0; i < PK_NUM_SPECIES; i++)
+	{
+		if (CMD_ARGC() > 1 && !Q_stricmp(CMD_ARGV(1), g_PokemonInfo[i].name))
+			iSpecies = i;
+	}
+
+	CBasePlayer *pOwner = CMD_ARGC() > 2 ? PK_PlayerByArg(CMD_ARGV(2)) : nullptr;
+	if (iSpecies < 0 || !pOwner)
+	{
+		SERVER_PRINT("usage: pk_spawn <pikachu|charizard|blastoise> <owner name|#index> [<enemy name|#index> [near]] (living players on a side; near: out by the enemy)\n");
+		return;
+	}
+
+	CPokemon *pOld = PK_PokemonOf(pOwner);
+	if (pOld)
+		pOld->Vanish();
+
+	// (by its player, or by the enemy with "near")
+	CBasePlayer *pEnemy = CMD_ARGC() > 3 ? PK_PlayerByArg(CMD_ARGV(3)) : nullptr;
+	CBasePlayer *pBy = (pEnemy && CMD_ARGC() > 4 && !Q_stricmp(CMD_ARGV(4), "near")) ? pEnemy : pOwner;
+	Vector vecFwd;
+	UTIL_MakeVectorsPrivate(Vector(0, pBy->pev->v_angle.y, 0), vecFwd, nullptr, nullptr);
+	CPokemon *pPokemon = CPokemon::Create(iSpecies, pOwner, PK_Feet(pBy) + vecFwd * 96.0f + Vector(0, 0, 8), pBy->pev->v_angle.y + (pBy == pOwner ? 0.0f : 180.0f));
+	if (!pPokemon)
+	{
+		SERVER_PRINT("pk_spawn: no room by that player\n");
+		return;
+	}
+
+	if (pEnemy)
+		pPokemon->OnProvoked(pEnemy);
+
+	pPokemon->Report(nullptr);
+}
+
+static void PK_ServerInfo_f()
+{
+	CBaseEntity *pEntity = nullptr;
+	int count = 0;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "monster_pokemon")))
+	{
+		static_cast<CPokemon *>(pEntity)->Report(nullptr);
+		count++;
+	}
+
+	if (!count)
+		SERVER_PRINT("pk_info: no Pokemon\n");
+}
+
+static void PK_ServerClear_f()
+{
+	if (CVAR_GET_FLOAT("sv_cheats") != 0.0f)
+		PK_CleanUpMap();
+}
+
+void PK_RegisterServerCommands()
+{
+	ADD_SERVER_COMMAND("pk_spawn", PK_ServerSpawn_f);
+	ADD_SERVER_COMMAND("pk_info", PK_ServerInfo_f);
+	ADD_SERVER_COMMAND("pk_clear", PK_ServerClear_f);
+}
