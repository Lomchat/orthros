+
+void CHLCrossbow::FireSniperBolt()
+{
+	m_flNextPrimaryAttack = GetNextAttackDelay(0.75f);
+
+	if (m_iClip == 0)
+	{
+		PlayEmptySound();
+		return;
+	}
+
+	m_pPlayer->m_iWeaponVolume = QUIET_GUN_VOLUME;
+	m_iClip--;
+
+	PLAYBACK_EVENT_FULL(0, m_pPlayer->edict(), m_usCrossbow2, 0.0f, (float *)&g_vecZero, (float *)&g_vecZero, 0, 0, m_iClip, 0, 0, 0);
+	m_pPlayer->SetAnimation(PLAYER_ATTACK1);
+
+	UTIL_MakeVectors(m_pPlayer->pev->v_angle + m_pPlayer->pev->punchangle);
+	Vector vecSrc = m_pPlayer->GetGunPosition() - gpGlobals->v_up * 2.0f;
+	Vector vecDir = gpGlobals->v_forward;
+
+	TraceResult tr;
+	UTIL_TraceLine(vecSrc, vecSrc + vecDir * 8192, dont_ignore_monsters, m_pPlayer->edict(), &tr);
+	if (tr.pHit && tr.pHit->v.takedamage)
+	{
+		ClearMultiDamage();
+		CBaseEntity::Instance(tr.pHit)->TraceAttack(m_pPlayer->pev, HL_CROSSBOW_SNIPER_DAMAGE, vecDir, &tr, DMG_BULLET | DMG_NEVERGIB);
+		ApplyMultiDamage(pev, m_pPlayer->pev);
+	}
+
+	m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + (m_iClip ? 5.0f : 0.75f);
+}
+
+void CHLCrossbow::FireBolt()
+{
+	if (m_iClip == 0)
+	{
+		PlayEmptySound();
+		return;
+	}
+
+	m_pPlayer->m_iWeaponVolume = QUIET_GUN_VOLUME;
+	m_iClip--;
+
+	PLAYBACK_EVENT_FULL(0, m_pPlayer->edict(), m_usCrossbow, 0.0f, (float *)&g_vecZero, (float *)&g_vecZero, 0, 0, m_iClip, 0, 0, 0);
+	m_pPlayer->SetAnimation(PLAYER_ATTACK1);
+
+	Vector anglesAim = m_pPlayer->pev->v_angle + m_pPlayer->pev->punchangle;
+	UTIL_MakeVectors(anglesAim);
+	anglesAim.x = -anglesAim.x;
+
+	Vector vecSrc = m_pPlayer->GetGunPosition() - gpGlobals->v_up * 2.0f;
+	Vector vecDir = gpGlobals->v_forward;
+
+	CHLCrossbowBolt *pBolt = CHLCrossbowBolt::BoltCreate();
+	pBolt->pev->origin = vecSrc;
+	pBolt->pev->angles = anglesAim;
+	pBolt->pev->owner = m_pPlayer->edict();
+
+	float speed = (m_pPlayer->pev->waterlevel == 3) ? HL_BOLT_WATER_VELOCITY : HL_BOLT_AIR_VELOCITY;
+	pBolt->pev->velocity = vecDir * speed;
+	pBolt->pev->speed = speed;
+	pBolt->pev->avelocity.z = 10.0f;
+
+	m_flNextPrimaryAttack = GetNextAttackDelay(0.75f);
+	m_flNextSecondaryAttack = UTIL_WeaponTimeBase() + 0.75f;
+	m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + (m_iClip ? 5.0f : 0.75f);
+}
