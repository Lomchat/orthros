+void CPokeBallWeapon::Throw()
+{
+	// (thrown harder upwards than downwards, a softer lob than a grenade's)
+	Vector angThrow = m_pPlayer->pev->v_angle + m_pPlayer->pev->punchangle;
+	if (angThrow.x < 0.0f)
+		angThrow.x = -10.0f + angThrow.x * ((90.0f - 10.0f) / 90.0f);
+	else
+		angThrow.x = -10.0f + angThrow.x * ((90.0f + 10.0f) / 90.0f);
+
+	float flVel = (90.0f - angThrow.x) * 6.0f;
+	if (flVel > 800.0f)
+		flVel = 800.0f;
+
+	Vector vecFwd;
+	UTIL_MakeVectorsPrivate(angThrow, vecFwd, nullptr, nullptr);
+
+	// (out where the view model's ball leaves the hand, at the same spot of the screen and the same apparent size:
+	// v_pokeball's throw ends with its ball at view (forward 15.5, right 4.5, up 0.5), on the line of sight to here)
+	Vector vecViewFwd, vecViewRight, vecViewUp;
+	UTIL_MakeVectorsPrivate(m_pPlayer->pev->v_angle + m_pPlayer->pev->punchangle, vecViewFwd, vecViewRight, vecViewUp);
+	Vector vecEye = m_pPlayer->pev->origin + m_pPlayer->pev->view_ofs;
+	Vector vecSrc = vecEye + vecViewFwd * 34.0f + vecViewRight * 10.0f + vecViewUp * 1.0f;
+
+	// (not into a wall, nor into someone, in front of the face)
+	TraceResult tr;
+	UTIL_TraceLine(vecEye, vecSrc, dont_ignore_monsters, m_pPlayer->edict(), &tr);
+	if (tr.flFraction < 1.0f || tr.fStartSolid)
+	{
+		vecSrc = tr.vecEndPos - vecViewFwd * 5.0f;
+		UTIL_TraceLine(vecEye, vecSrc, dont_ignore_monsters, m_pPlayer->edict(), &tr);
+		if (tr.flFraction < 1.0f || tr.fStartSolid)
+			vecSrc = vecEye;
+	}
+
+	Vector vecThrow = vecFwd * flVel + m_pPlayer->pev->velocity;
+	CPokeBall::Launch(m_pPlayer, Species(), vecSrc, vecThrow);
+
+	EMIT_SOUND(ENT(m_pPlayer->pev), CHAN_WEAPON, "pokemon/ball_throw.wav", VOL_NORM, ATTN_NORM);
+	SendWeaponAnim(PKBALL_THROW);
+	m_pPlayer->SetAnimation(PLAYER_ATTACK1);
+}
+
+void CPokeBallWeapon::WeaponIdle()
+{
+	if (m_flReleaseThrow == 0.0f && m_flStartThrow)
+		m_flReleaseThrow = gpGlobals->time;
+
+	if (m_flTimeWeaponIdle > UTIL_WeaponTimeBase())
+		return;
+
+	if (m_flStartThrow)
+	{
+		m_flStartThrow = 0.0f;
+
+		// (someone else's ball came out meanwhile: kept)
+		if (PK_HasOut(m_pPlayer))
+		{
+			SendWeaponAnim(PKBALL_DRAW);
+			m_flReleaseThrow = -1.0f;
+			m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 1.0f;
+			return;
+		}
+
+		Throw();
+
+		// (positive: the next idle knows it was just thrown)
+		m_flReleaseThrow = gpGlobals->time;
+		m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType]--;
+		m_flTimeWeaponIdle = m_flNextSecondaryAttack = m_flNextPrimaryAttack = GetNextAttackDelay(0.6f);
+		return;
+	}
+	else if (m_flReleaseThrow > 0.0f)
+	{
+		// (just thrown: none left, or the ball came back)
+		if (!m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType])
+		{
+			RetireWeapon();
+			return;
+		}
+
+		SendWeaponAnim(PKBALL_DRAW);
+		m_flReleaseThrow = -1.0f;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 10.0f, 15.0f);
+		return;
+	}
+
+	if (m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType])
+	{
+		SendWeaponAnim(PKBALL_IDLE);
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 10.0f, 15.0f);
+	}
+}
