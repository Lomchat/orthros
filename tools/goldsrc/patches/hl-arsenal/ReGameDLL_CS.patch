+// commands
+
+bool BUILD_ClientCommand(CBasePlayer *pPlayer, const char *pcmd)
+{
+	if (FStrEq(pcmd, "build_mode"))
+	{
+		bool bOn = CMD_ARGC() > 1 ? Q_atoi(CMD_ARGV(1)) != 0 : !pPlayer->m_bBuildMode;
+
+		// (each one answered by a BuildMode, the state as it is then — the client counts its answers)
+		pPlayer->m_iBuildModeSent = -1;
+		if (!bOn)
+		{
+			BUILD_Leave(pPlayer, true);
+			return true;
+		}
+
+		int iReason = BUILD_Enter(pPlayer);
+		if (iReason != BUILD_OK)
+			BUILD_Deny(pPlayer, iReason);
+		return true;
+	}
+
+	if (FStrEq(pcmd, "build_place"))
+	{
+		int iPiece = CMD_ARGC() > 1 ? Q_atoi(CMD_ARGV(1)) : 0;
+		build_spot_t asked = {};
+		const build_spot_t *pAsked = nullptr;
+		int iTurns = 0;
+		if (CMD_ARGC() > 5)
+		{
+			asked.piece = iPiece;
+			asked.origin[0] = float(Q_atof(CMD_ARGV(2)));
+			asked.origin[1] = float(Q_atof(CMD_ARGV(3)));
+			asked.origin[2] = float(Q_atof(CMD_ARGV(4)));
+			asked.yaw = ((Q_atoi(CMD_ARGV(5)) % 360) + 360) % 360;
+			pAsked = &asked;
+			if (CMD_ARGC() > 6)
+				iTurns = Q_atoi(CMD_ARGV(6));
+		}
+		else if (CMD_ARGC() > 2)
+			iTurns = Q_atoi(CMD_ARGV(2));
+
+		BUILD_Place(pPlayer, iPiece, pAsked, iTurns);
+		return true;
+	}
+
+	if (FStrEq(pcmd, "build_give"))
+	{
+		if (CVAR_GET_FLOAT("sv_cheats") == 0.0f)
+		{
+			ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, "build_give needs sv_cheats 1\n");
+			return true;
+		}
+
+		int n = CMD_ARGC() > 1 ? Q_atoi(CMD_ARGV(1)) : 100;
+		pPlayer->m_iBricks = clamp(pPlayer->m_iBricks + n, 0, BUILD_MAX_BRICKS);
+		return true;
+	}
+
+	if (FStrEq(pcmd, "build_info"))
+	{
+		int iMine = 0, iAll = 0, iEntities = 0, iPiles = 0;
+		CBaseEntity *pEntity = nullptr;
+		while ((pEntity = UTIL_FindEntityByClassname(pEntity, "build_piece")))
+		{
+			CBuildPiece *pPiece = static_cast<CBuildPiece *>(pEntity);
+			iAll++;
+			iEntities += pPiece->Entities();
+			if (pPiece->IsOwnedBy(pPlayer))
+				iMine++;
+		}
+
+		pEntity = nullptr;
+		while ((pEntity = UTIL_FindEntityByClassname(pEntity, "build_bricks")))
+			iPiles++;
+
+		char line[256];
+		Q_snprintf(line, sizeof(line), "build: mp_build %d, bricks %d, build mode %d, pieces %d mine / %d all (%d entities), piles %d, edicts %d/%d\n",
+			int(build_enabled.value), pPlayer->m_iBricks, pPlayer->m_bBuildMode ? 1 : 0, iMine, iAll, iEntities, iPiles, NUMBER_OF_ENTITIES(), gpGlobals->maxEntities);
+		ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, line);
+		return true;
+	}
+
+	return false;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// build_test (the server console's, sv_cheats 1): place [piece] — every living player, bots too, builds where it looks
+// (its reason printed when refused); hurt <n> — every piece hurt by the world; status; clear
+
+static void BUILD_TestCommand()
+{
+	if (CVAR_GET_FLOAT("sv_cheats") == 0.0f)
+	{
+		SERVER_PRINT("build_test needs sv_cheats 1\n");
+		return;
+	}
+
+	const char *arg1 = CMD_ARGC() > 1 ? CMD_ARGV(1) : "status";
+	char line[256];
+
+	if (!Q_stricmp(arg1, "place"))
+	{
+		int iAsked = CMD_ARGC() > 2 ? Q_atoi(CMD_ARGV(2)) : -1;
+		for (int i = 1; i <= gpGlobals->maxClients; i++)
+		{
+			CBasePlayer *pPlayer = UTIL_PlayerByIndex(i);
+			if (!pPlayer || !pPlayer->IsAlive() || pPlayer->GetObserverMode() != OBS_NONE)
+				continue;
+
+			int iPiece = iAsked >= 0 ? iAsked % BUILD_PIECES : RANDOM_LONG(0, BUILD_PIECES - 1);
+			BuildTraceCtx ctx = { pPlayer->edict(), nullptr };
+			build_engine_t e = BUILD_Engine(&ctx);
+			build_spot_t spot;
+			BUILD_FindSpot(pPlayer, &e, iPiece, nullptr, 0, spot);
+
+			float eye[3], angles[3], feet;
+			BUILD_EyeOf(pPlayer, eye, angles, feet);
+			int iBricks = pPlayer->m_iBricks;
+			pPlayer->m_iBricks = BUILD_MAX_BRICKS;
+			int iReason = BUILD_Check(pPlayer, &e, spot, eye);
+			pPlayer->m_iBricks = iBricks;
+
+			CBuildPiece *pPiece = iReason == BUILD_OK ? CBuildPiece::Create(pPlayer, spot) : nullptr;
+			Q_snprintf(line, sizeof(line), "build_test: %s piece %d at %.0f %.0f %.0f yaw %d (eye %.0f %.0f %.0f view %.0f %.0f): %s %d\n",
+				STRING(pPlayer->pev->netname), iPiece, spot.origin[0], spot.origin[1], spot.origin[2], spot.yaw, eye[0], eye[1], eye[2], angles[0], angles[1],
+				pPiece ? "built #" : "refused, reason", pPiece ? pPiece->entindex() : iReason);
+			SERVER_PRINT(line);
+		}
+	}
+	else if (!Q_stricmp(arg1, "hurt"))
+	{
+		float flDamage = CMD_ARGC() > 2 ? float(Q_atof(CMD_ARGV(2))) : 100.0f;
+		CBaseEntity *pEntity = nullptr;
+		while ((pEntity = UTIL_FindEntityByClassname(pEntity, "build_piece")))
+		{
+			if (!(pEntity->pev->flags & FL_KILLME))
+				pEntity->TakeDamage(VARS(INDEXENT(0)), VARS(INDEXENT(0)), flDamage, DMG_GENERIC);
+		}
+	}
+	else if (!Q_stricmp(arg1, "clear"))
+	{
+		BUILD_CleanUpMap();
+	}
+	else if (!Q_stricmp(arg1, "rain"))
+	{
+		// (n drops on a grid of 64 units over the first living player: no two merge — the cap's check)
+		int n = CMD_ARGC() > 2 ? Q_atoi(CMD_ARGV(2)) : 150;
+		for (int i = 1; i <= gpGlobals->maxClients; i++)
+		{
+			CBasePlayer *pPlayer = UTIL_PlayerByIndex(i);
+			if (!pPlayer || !pPlayer->IsAlive())
+				continue;
+
+			for (int k = 0; k < n; k++)
+				CBrickPile::Drop(pPlayer->pev->origin + Vector(float((k % 16) * 64 - 512), float((k / 16) * 64 - 512), 0), BUILD_DROP);
+			break;
+		}
+	}
+	else if (!Q_stricmp(arg1, "boom"))
+	{
+		// (a grenade's blast — 100, radius 350, by the first living player — 48 units in front of every piece's middle)
+		CBasePlayer *pBy = nullptr;
+		for (int i = 1; i <= gpGlobals->maxClients && !pBy; i++)
+		{
+			CBasePlayer *pPlayer = UTIL_PlayerByIndex(i);
+			if (pPlayer && pPlayer->IsAlive())
+				pBy = pPlayer;
+		}
+
+		if (!pBy)
+			return;
+
+		CBaseEntity *pList[256];
+		int n = 0;
+		CBaseEntity *pEntity = nullptr;
+		while (n < int(ARRAYSIZE(pList)) && (pEntity = UTIL_FindEntityByClassname(pEntity, "build_piece")))
+		{
+			if (!(pEntity->pev->flags & FL_KILLME))
+				pList[n++] = pEntity;
+		}
+
+		for (int i = 0; i < n; i++)
+		{
+			CBuildPiece *pPiece = static_cast<CBuildPiece *>(pList[i]);
+			build_spot_t spot = {};
+			spot.piece = pPiece->Piece();
+			spot.yaw = pPiece->Yaw();
+			spot.origin[0] = pPiece->pev->origin.x;
+			spot.origin[1] = pPiece->pev->origin.y;
+			spot.origin[2] = pPiece->pev->origin.z;
+			build_box(spot.piece, spot.yaw, spot.origin, spot.mins, spot.maxs);
+			Vector vecMid((spot.mins[0] + spot.maxs[0]) / 2, (spot.mins[1] + spot.maxs[1]) / 2, (spot.mins[2] + spot.maxs[2]) / 2);
+			Vector vecAt = vecMid + Vector(0, 0, 48);
+			float flBefore = pPiece->pev->health;
+			::RadiusDamage(vecAt, pBy->pev, pBy->pev, 100, 350, CLASS_NONE, DMG_EXPLOSION);
+			Q_snprintf(line, sizeof(line), "build_test: boom on #%d piece %d: health %.0f -> %.0f\n", pPiece->entindex(), spot.piece, flBefore,
+				(pPiece->pev->flags & FL_KILLME) ? 0.0f : float(pPiece->pev->health));
+			SERVER_PRINT(line);
+		}
+	}
+	else
+	{
+		int iPieces = 0, iSteps = 0, iPiles = 0, iBricks = 0;
+		CBaseEntity *pEntity = nullptr;
+		while ((pEntity = UTIL_FindEntityByClassname(pEntity, "build_piece")))
+		{
+			if (pEntity->pev->flags & FL_KILLME)
+				continue;
+
+			CBuildPiece *pPiece = static_cast<CBuildPiece *>(pEntity);
+			iPieces++;
+			Q_snprintf(line, sizeof(line), "build_test: #%d piece %d at %.0f %.0f %.0f yaw %d health %.0f skin %d render %d/%.0f box %.0f %.0f %.0f .. %.0f %.0f %.0f entities %d\n",
+				pPiece->entindex(), pPiece->Piece(), pEntity->pev->origin.x, pEntity->pev->origin.y, pEntity->pev->origin.z, pPiece->Yaw(),
+				pEntity->pev->health, pEntity->pev->skin, pEntity->pev->rendermode, pEntity->pev->renderamt,
+				pEntity->pev->absmin.x, pEntity->pev->absmin.y, pEntity->pev->absmin.z, pEntity->pev->absmax.x, pEntity->pev->absmax.y, pEntity->pev->absmax.z,
+				pPiece->Entities());
+			SERVER_PRINT(line);
+		}
+
+		pEntity = nullptr;
+		while ((pEntity = UTIL_FindEntityByClassname(pEntity, "build_step")))
+		{
+			if (!(pEntity->pev->flags & FL_KILLME))
+				iSteps++;
+		}
+
+		pEntity = nullptr;
+		while ((pEntity = UTIL_FindEntityByClassname(pEntity, "build_bricks")))
+		{
+			if (pEntity->pev->flags & FL_KILLME)
+				continue;
+
+			iPiles++;
+			iBricks += static_cast<CBrickPile *>(pEntity)->m_iAmount;
+		}
+
+		Q_snprintf(line, sizeof(line), "build_test: mp_build %d mp_build_bricks %d, %d pieces, %d steps, %d piles (%d bricks), edicts %d/%d\n",
+			int(build_enabled.value), BUILD_StartBricks(), iPieces, iSteps, iPiles, iBricks, NUMBER_OF_ENTITIES(), gpGlobals->maxEntities);
+		SERVER_PRINT(line);
+
+		for (int i = 1; i <= gpGlobals->maxClients; i++)
+		{
+			CBasePlayer *pPlayer = UTIL_PlayerByIndex(i);
+			if (!pPlayer)
+				continue;
+
+			Q_snprintf(line, sizeof(line), "build_test: player %s bricks %d build mode %d\n", STRING(pPlayer->pev->netname), pPlayer->m_iBricks, pPlayer->m_bBuildMode ? 1 : 0);
+			SERVER_PRINT(line);
+		}
+	}
+}
diff --git a/regamedll/dlls/wpn_shared/build_grid.h b/regamedll/dlls/wpn_shared/build_grid.h
new file mode 100644
index 0000000..88d283d
--- /dev/null
+++ b/regamedll/dlls/wpn_shared/build_grid.h
@@ -0,0 +1,335 @@
+/*
+build_grid.h - Half Strike's building grid: where a piece goes from a player's view, and the checks of a spot.
+Shared, header-only, by the game (dlls/wpn_shared/build.cpp) and the client (cl_dll/arsenal_ui.cpp: the blueprint):
+the same function on both sides, the engine reached through callbacks only (no engine header here).
+
+The grid: tiles of BUILD_TILE (128) units, anchored to the world in x and y. In z, a cell's base is the ground under
+it (a trace down at its centre — the world, or a built piece: then that piece's levels), then levels of 128 over it.
+Pieces, each in its own frame (origin = the bottom centre of its cell; models and collision boxes match it):
+  wall   x -64..64, y -4..4, z 0..128          (yaw 0: along x; yaw 90: along y), on a tile edge
+  floor  x -64..64, y -64..64, z -4..4          (centred on the level's plane, as walls on their edge: a floor on top
+                                               of walls is level 1)
+  ramp   x -64..64, y -64..64, z 0..128        rising toward +x of its frame (yaw: the way it rises): 8 stairs of
+                                               16 x 16, step i: x -64+16i..-48+16i, z 16i..16i+16 (its underside
+                                               open: the visual's plane z = x + 56)
+  roof   x -64..64, y -64..64, z 0..64         a pyramid shell, apex (0, 0, 64); steps i = 0..3: half 56-16i,
+                                               z 16i..16i+16
+Ramps and roofs collide as those steps (build_step_box): solid boxes a player walks up. The numbers are the models'
+(tools/goldsrc/assets/pokemon/bricks.py, its PIECE CONTRACT).
+A slot (what may not be built twice): the same piece at the same origin (and, for a wall, the same axis).
+A piece is never built on the far side of what the view hit (a wall's grid line past a world wall, a floor or a roof
+rounded up over a ceiling): build_aim takes the nearer line or the lower level then, and build_world_blocked refuses a
+piece neither the aim point nor the eye reaches (the world and brush entities between them).
+*/
+#ifndef BUILD_GRID_H
+#define BUILD_GRID_H
+
+#include <math.h>
+
+#define BUILD_TILE        128
+#define BUILD_WALL_THICK  8
+#define BUILD_FLOOR_THICK 8
+#define BUILD_ROOF_HEIGHT 64
+#define BUILD_STEP        16
+#define BUILD_COST        10
+#define BUILD_REACH       ( 4 * BUILD_TILE )       // (the aim traced that far; a piece's centre at most that far + 64)
+#define BUILD_NOHIT       ( 1.5f * BUILD_TILE )    // (the aim at nothing: the point that far along it)
+#define BUILD_CLIP        34.0f                    // (the world check: the box shrunk by that much on its sides — x and
+                                                   // y: a piece may clip a quarter tile into world walls (and 2 units, a
+                                                   // face exactly there: touching), as the grid is not the map's;
+                                                   // build_reached keeps it from passing through them —...)
+#define BUILD_SHRINK      2.0f                     // (...by that much at its top...)
+#define BUILD_SINK        10.0f                    // (...and its bottom raised by that much: pieces rest on the ground)
+#define BUILD_MAX_BRICKS  999
+
+enum { BUILD_WALL, BUILD_FLOOR, BUILD_RAMP, BUILD_ROOF, BUILD_PIECES };
+
+// the steps of a piece (ramps 8, roofs 4; walls and floors: their box, 1)
+static inline int build_steps( int piece ) { return piece == BUILD_RAMP ? BUILD_TILE / BUILD_STEP : piece == BUILD_ROOF ? BUILD_ROOF_HEIGHT / BUILD_STEP : 1; }
+
+typedef struct
+{
+	int piece;
+	int yaw;          // degrees, 0/90/180/270 (walls: 0 or 90)
+	float origin[3];  // the bottom centre of the cell (walls: of the edge); integers
+	float mins[3], maxs[3]; // the whole piece's box, world (absolute)
+	int aimed;        // set by build_aim: aim (the view's hit, a unit back) and eye kept for build_world_blocked's
+	float aim[3], eye[3];   // reach check (spots made otherwise: aimed 0, no such check)
+} build_spot_t;
+
+// The engine, for build_aim / build_check: a line traced (world and brush entities, built pieces included — not
+// players; worldOnly: the world and brush entities alone), the fraction of it travelled and where it stopped; the start
+// inside a solid (a built piece too, without worldOnly): startsolid set.
+typedef struct
+{
+	void *ctx;
+	// returns the fraction (1: nothing hit), end filled, *startsolid set
+	float ( *trace )( void *ctx, const float *start, const float *end, int worldOnly, float *endpos, int *startsolid );
+	// optional (NULL: none): whether the last trace stopped on a built piece or one of its steps, and that piece's
+	// origin z (steps share their piece's origin) — a cell over a piece takes its levels (origin_z + n * 128)
+	int ( *piece )( void *ctx, float *origin_z );
+} build_engine_t;
+
+// the box of a piece at an origin and yaw (absolute)
+static inline void build_box( int piece, int yaw, const float *o, float *mins, float *maxs )
+{
+	float hx = BUILD_TILE / 2, hy = BUILD_TILE / 2, z0 = 0, z1 = BUILD_TILE;
+	if ( piece == BUILD_WALL )
+	{
+		if ( yaw % 180 == 0 ) hy = BUILD_WALL_THICK / 2;
+		else hx = BUILD_WALL_THICK / 2;
+	}
+	else if ( piece == BUILD_FLOOR ) { z0 = -BUILD_FLOOR_THICK / 2; z1 = BUILD_FLOOR_THICK / 2; }
+	else if ( piece == BUILD_ROOF ) z1 = BUILD_ROOF_HEIGHT;
+	mins[0] = o[0] - hx; maxs[0] = o[0] + hx;
+	mins[1] = o[1] - hy; maxs[1] = o[1] + hy;
+	mins[2] = o[2] + z0; maxs[2] = o[2] + z1;
+}
+
+// the i-th collision step of a piece (absolute): ramps' stairs (16 x 16 each, rising), roofs' nested slabs
+static inline void build_step_box( const build_spot_t *s, int i, float *mins, float *maxs )
+{
+	build_box( s->piece, s->yaw, s->origin, mins, maxs );
+	const float *o = s->origin;
+	if ( s->piece == BUILD_RAMP )
+	{
+		const float half = BUILD_TILE / 2, from = -half + i * BUILD_STEP, to = from + BUILD_STEP; // (along the way it rises)
+		mins[2] = o[2] + i * BUILD_STEP; maxs[2] = mins[2] + BUILD_STEP;
+		switch ((( s->yaw % 360 ) + 360 ) % 360 )
+		{
+		case 0:   mins[0] = o[0] + from; maxs[0] = o[0] + to; break;
+		case 90:  mins[1] = o[1] + from; maxs[1] = o[1] + to; break;
+		case 180: mins[0] = o[0] - to; maxs[0] = o[0] - from; break;
+		default:  mins[1] = o[1] - to; maxs[1] = o[1] - from; break;
+		}
+	}
+	else if ( s->piece == BUILD_ROOF )
+	{
+		const float half = BUILD_TILE / 2 - 8 - i * BUILD_STEP; // (56, 40, 24, 8)
+		mins[0] = o[0] - half; maxs[0] = o[0] + half;
+		mins[1] = o[1] - half; maxs[1] = o[1] + half;
+		mins[2] = o[2] + i * BUILD_STEP; maxs[2] = mins[2] + BUILD_STEP;
+	}
+}
+
+static inline int build_cell( float v ) { return (int)floorf( v / BUILD_TILE ); }
+
+// the base of a cell: the ground under the point (x, y), traced down from z (a solid start: fallback)
+static inline float build_base( const build_engine_t *e, float x, float y, float z, float fallback )
+{
+	float a[3] = { x, y, z }, b[3] = { x, y, z - 3 * BUILD_TILE }, end[3];
+	int startsolid = 0;
+	const float f = e->trace( e->ctx, a, b, 0, end, &startsolid );
+	if ( startsolid || f >= 1.0f )
+		return floorf( fallback + 0.5f );
+	float pz;
+	if ( e->piece && e->piece( e->ctx, &pz ))
+		return floorf( pz + floorf(( end[2] - pz + 8.0f ) / BUILD_TILE ) * BUILD_TILE + 0.5f ); // (on a piece: its levels)
+	return floorf( end[2] + 0.5f );
+}
+
+// the box build_world_blocked checks: the piece's, shrunk on its sides (by BUILD_CLIP: a wall's thickness to its middle
+// plane), its bottom raised (a floor: just over its top)
+static inline void build_check_box( const build_spot_t *s, float *lo, float *hi )
+{
+	for ( int k = 0; k < 2; k++ )
+	{
+		lo[k] = s->mins[k] + BUILD_CLIP; hi[k] = s->maxs[k] - BUILD_CLIP;
+		if ( lo[k] > hi[k] ) lo[k] = hi[k] = ( s->mins[k] + s->maxs[k] ) / 2;
+	}
+	lo[2] = s->mins[2] + BUILD_SINK; hi[2] = s->maxs[2] - BUILD_SHRINK;
+	if ( lo[2] > hi[2] ) lo[2] = hi[2] = s->maxs[2] + 1; // (a floor: just over its top, where it is stood on)
+}
+
+// whether the aim point or the eye reaches the piece (the nearest point of its check box), the world and brush
+// entities between them counted (worldOnly traces): no piece behind a wall or over a ceiling the view hit
+static inline int build_reached( const build_engine_t *e, const build_spot_t *s )
+{
+	float lo[3], hi[3], p[3];
+	build_check_box( s, lo, hi );
+	for ( int from = 0; from < 2; from++ )
+	{
+		const float *a = from ? s->eye : s->aim;
+		float d2 = 0;
+		for ( int k = 0; k < 3; k++ )
+		{
+			p[k] = a[k] < lo[k] ? lo[k] : a[k] > hi[k] ? hi[k] : a[k];
+			d2 += ( p[k] - a[k] ) * ( p[k] - a[k] );
+		}
+		if ( d2 < 1.0f )
+			return 1;
+		float end[3];
+		int startsolid = 0;
+		const float f = e->trace( e->ctx, a, p, 1, end, &startsolid );
+		if ( !startsolid && f >= 1.0f )
+			return 1;
+	}
+	return 0;
+}
+
+// the spot for an aim point (nearer: the wall's grid line one tile toward the eye, the level one lower)
+static inline void build_spot_at( const build_engine_t *e, const float *eye, const float *aim, float yawdeg, float feet, int piece, int turns, int nearer, build_spot_t *s )
+{
+	// (the player's facing, to the nearest quarter: 0 +x, 1 +y, 2 -x, 3 -y)
+	float yaw = fmodf( yawdeg, 360.0f );
+	if ( yaw < 0 ) yaw += 360;
+	const int facing = (int)floorf(( yaw + 45 ) / 90 ) & 3;
+	const int T = BUILD_TILE;
+	s->piece = piece;
+	float o[3];
+	if ( piece == BUILD_WALL )
+	{
+		// (across the facing — or along it, turned once —, on the grid line nearest the aim, in the aim's cell)
+		const int across = ( facing + turns ) & 1; // (0: across x — on a line x = n*128, along y; 1: across y)
+		const int ax = across, other = 1 - ax;
+		float line = floorf( aim[ax] / T + 0.5f ) * T;
+		if ( nearer )
+			line += ( eye[ax] < aim[ax] ? -T : T ) * nearer;
+		o[ax] = line;
+		o[other] = build_cell( aim[other] ) * T + T / 2;
+		// (its base: the ground of the cell on the player's side of the line)
+		float sample[2];
+		sample[ax] = line + ( eye[ax] >= line ? T / 2 : -T / 2 );
+		sample[other] = o[other];
+		const float base = build_base( e, sample[0], sample[1], eye[2], feet );
+		const int level = (int)floorf(( aim[2] - base ) / T );
+		o[2] = base + ( level > 0 ? level : 0 ) * T;
+		s->yaw = across ? 0 : 90; // (across x: the wall spans y, yaw 90)
+	}
+	else
+	{
+		o[0] = build_cell( aim[0] ) * T + T / 2;
+		o[1] = build_cell( aim[1] ) * T + T / 2;
+		const float base = build_base( e, o[0], o[1], eye[2], feet );
+		const float h = ( aim[2] - base ) / T;
+		// (ramps in the level aimed at; floors on a level line — the aim straight ahead: at the feet, at the top of a
+		// wall: over it —; roofs on the walls of the level aimed at)
+		int level = piece == BUILD_FLOOR ? (int)floorf( h + 0.25f ) : piece == BUILD_ROOF ? (int)floorf( h + 0.75f ) : (int)floorf( h );
+		if ( nearer )
+			level--;
+		o[2] = base + ( level > 0 ? level : 0 ) * T;
+		s->yaw = piece == BUILD_RAMP ? (( facing + turns ) & 3 ) * 90 : 0; // (floors and roofs: square, whichever way)
+	}
+	for ( int k = 0; k < 3; k++ ) { s->origin[k] = o[k]; s->aim[k] = aim[k]; s->eye[k] = eye[k]; }
+	s->aimed = 1;
+	build_box( piece, s->yaw, s->origin, s->mins, s->maxs );
+}
+
+static inline int build_world_blocked( const build_engine_t *e, const build_spot_t *s );
+
+// Where a piece goes: the view (eye, angles in degrees: pitch, yaw), the player's feet height, the piece and the
+// player's turns of it (R: 0..3). Always gives a spot (build_world_blocked says whether the world lets it be built).
+// A spot past what the view hit (not reached: build_reached) gives way to the nearer line or the lower level.
+static inline void build_aim( const build_engine_t *e, const float *eye, const float *angles, float feet, int piece, int turns, build_spot_t *s )
+{
+	const float pr = angles[0] * 3.14159265f / 180, yr = angles[1] * 3.14159265f / 180;
+	const float fwd[3] = { cosf( pr ) * cosf( yr ), cosf( pr ) * sinf( yr ), -sinf( pr ) };
+	float end[3], aim[3];
+	for ( int k = 0; k < 3; k++ ) end[k] = eye[k] + fwd[k] * BUILD_REACH;
+	int startsolid = 0;
+	const float f = e->trace( e->ctx, eye, end, 0, aim, &startsolid );
+	if ( f >= 1.0f || startsolid )
+		for ( int k = 0; k < 3; k++ ) aim[k] = eye[k] + fwd[k] * BUILD_NOHIT;
+	else
+		for ( int k = 0; k < 3; k++ ) aim[k] -= fwd[k]; // (a unit back: on the near side of what it hit)
+
+	build_spot_at( e, eye, aim, angles[1], feet, piece, turns, 0, s );
+	if ( !build_reached( e, s ))
+	{
+		build_spot_at( e, eye, aim, angles[1], feet, piece, turns, 1, s );
+		return;
+	}
+	// (the slot aimed at cuts into the map — a wall aimed at a map wall falls on its grid line, inside it —: the one a
+	// tile nearer, as Fortnite builds in front of what is aimed at, when the world lets it be built)
+	// (walls: up to 3 lines nearer, never past the player's own cell's line)
+	const int tries = piece == BUILD_WALL ? 3 : 1;
+	for ( int n = 1; n <= tries && build_world_blocked( e, s ); n++ )
+	{
+		build_spot_t nearer;
+		build_spot_at( e, eye, aim, angles[1], feet, piece, turns, n, &nearer );
+		if ( piece == BUILD_WALL )
+		{
+			const int ax = nearer.yaw ? 0 : 1; // (yaw 90: on a line x = n*128; yaw 0: on a line y = n*128)
+			if (( eye[ax] < aim[ax] ) ? nearer.origin[ax] < eye[ax] - BUILD_TILE : nearer.origin[ax] > eye[ax] + BUILD_TILE )
+				break;
+		}
+		if ( !build_world_blocked( e, &nearer ))
+			*s = nearer;
+	}
+}
+
+// whether two boxes overlap (by more than a unit)
+static inline int build_boxes_overlap( const float *amin, const float *amax, const float *bmin, const float *bmax )
+{
+	for ( int k = 0; k < 3; k++ )
+		if ( amin[k] >= bmax[k] - 1 || bmin[k] >= amax[k] - 1 )
+			return 0;
+	return 1;
+}
+
+// whether a box (a player's, absolute) cuts into a piece: its steps for ramps and roofs (a player in the empty part
+// over a ramp's low end does not block it), its box for the others
+static inline int build_overlaps_box( const build_spot_t *s, const float *mins, const float *maxs )
+{
+	const int n = build_steps( s->piece );
+	for ( int i = 0; i < n; i++ )
+	{
+		float lo[3], hi[3];
+		build_step_box( s, i, lo, hi );
+		if ( build_boxes_overlap( lo, hi, mins, maxs ))
+			return 1;
+	}
+	return 0;
+}
+
+// whether two spots are the same slot
+static inline int build_same_slot( const build_spot_t *a, int piece, int yaw, const float *origin )
+{
+	if ( a->piece != piece )
+		return 0;
+	for ( int k = 0; k < 3; k++ )
+		if ( fabsf( a->origin[k] - origin[k] ) > 2 )
+			return 0;
+	return piece != BUILD_WALL || ( a->yaw % 180 ) == ( yaw % 180 );
+}
+
+// in reach of the eye
+static inline int build_in_reach( const build_spot_t *s, const float *eye )
+{
+	float c[3], d2 = 0;
+	for ( int k = 0; k < 3; k++ ) { c[k] = ( s->mins[k] + s->maxs[k] ) / 2 - eye[k]; d2 += c[k] * c[k]; }
+	return d2 <= ( BUILD_REACH + 64.0f ) * ( BUILD_REACH + 64.0f );
+}
+
+// whether the world and brush entities (worldOnly traces; pieces are slots, players are checked apart) cut into the
+// piece's box, shrunk (build_check_box: pieces clip up to BUILD_CLIP into walls on their sides): its 12 edges and 4
+// diagonals traced; or (a spot from build_aim) whether the piece is on the far
+// side of them from the aim point and the eye (build_reached)
+static inline int build_world_blocked( const build_engine_t *e, const build_spot_t *s )
+{
+	float lo[3], hi[3];
+	build_check_box( s, lo, hi );
+	float c[8][3];
+	for ( int i = 0; i < 8; i++ )
+	{
+		c[i][0] = ( i & 1 ) ? hi[0] : lo[0];
+		c[i][1] = ( i & 2 ) ? hi[1] : lo[1];
+		c[i][2] = ( i & 4 ) ? hi[2] : lo[2];
+	}
+	static const int lines[16][2] = { { 0, 1 }, { 2, 3 }, { 4, 5 }, { 6, 7 }, { 0, 2 }, { 1, 3 }, { 4, 6 }, { 5, 7 },
+		{ 0, 4 }, { 1, 5 }, { 2, 6 }, { 3, 7 }, { 0, 7 }, { 1, 6 }, { 2, 5 }, { 3, 4 } };
+	for ( int i = 0; i < 16; i++ )
+	{
+		float end[3];
+		int startsolid = 0;
+		const float f = e->trace( e->ctx, c[lines[i][0]], c[lines[i][1]], 1, end, &startsolid );
+		if ( startsolid || f < 1.0f )
+			return 1;
+	}
+	return s->aimed == 1 && !build_reached( e, s );
+}
+
+// why a spot may not be built (the server's BuildDeny reasons); 0: it may
+enum { BUILD_OK, BUILD_NO_BRICKS, BUILD_BLOCKED, BUILD_TOO_FAR, BUILD_MY_CAP, BUILD_ALL_CAP, BUILD_DISABLED, BUILD_CANNOT };
+
+#endif // BUILD_GRID_H
