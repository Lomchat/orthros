+static void HL_ShowArsenalMenu(CBasePlayer *pPlayer)
+{
+	char text[192];
+	Q_snprintf(text, sizeof(text), "\\yHalf-Life arsenal\\w\n\n1. .357 Magnum ($%d)\n2. Crossbow ($%d)\n3. RPG ($%d)\n4. Gauss ($%d)\n5. Egon ($%d)\n\n0. Exit",
+		HL_PYTHON_PRICE, HL_CROSSBOW_PRICE, HL_RPG_PRICE, HL_GAUSS_PRICE, HL_EGON_PRICE);
+	ShowMenu(pPlayer, (MENU_KEY_1 | MENU_KEY_2 | MENU_KEY_3 | MENU_KEY_4 | MENU_KEY_5 | MENU_KEY_0), -1, FALSE, text);
+}
+
+static void HL_BuyArsenal(CBasePlayer *pPlayer, int iSlot)
+{
+	static const WeaponIdType weapons[] = { WEAPON_HL_PYTHON, WEAPON_HL_CROSSBOW, WEAPON_HL_RPG, WEAPON_HL_GAUSS, WEAPON_HL_EGON };
+	if (iSlot >= 1 && iSlot <= int(ARRAYSIZE(weapons)))
+		BuyWeaponByWeaponID(pPlayer, weapons[iSlot - 1]);
+}
