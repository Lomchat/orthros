+		pParent->TraceAttack(pevAttacker, flDamage, vecDir, ptr, bitsDamageType);
+}
+
+BOOL CBuildStep::TakeDamage(entvars_t *pevInflictor, entvars_t *pevAttacker, float flDamage, int bitsDamageType)
+{
