+// (a homing hornet, or a straight dart from one of eight points around the barrel)
+void CHLHornetGun::Fire(bool bDart)
+{
+	Reload();
+
+	if (m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] <= 0)
+		return;
+
+	UTIL_MakeVectors(m_pPlayer->pev->v_angle);
+	Vector vecSrc = m_pPlayer->GetGunPosition() + gpGlobals->v_forward * 16.0f + gpGlobals->v_right * 8.0f + gpGlobals->v_up * -12.0f;
+
+	if (bDart)
+	{
+		static const float phases[8][2] = { { 8, 0 }, { 8, 8 }, { 0, 8 }, { -8, 8 }, { -8, 0 }, { -8, -8 }, { 0, -8 }, { 8, -8 } };
+		const float *phase = phases[m_iFirePhase];
+		m_iFirePhase = (m_iFirePhase + 1) % 8;
+		vecSrc = vecSrc + gpGlobals->v_up * phase[0] + gpGlobals->v_right * phase[1];
+	}
+
+	CHLHornet *pHornet = GetClassPtr<CCSAnimating>((CHLHornet *)nullptr);
+	UTIL_SetOrigin(pHornet->pev, vecSrc);
+	pHornet->pev->angles = m_pPlayer->pev->v_angle;
+	pHornet->pev->owner = m_pPlayer->edict();
+	pHornet->Spawn();
+
+	if (bDart)
+	{
+		pHornet->pev->velocity = gpGlobals->v_forward * 1200.0f;
+		pHornet->pev->angles = UTIL_VecToAngles(pHornet->pev->velocity);
+		pHornet->SetThink(&CHLHornet::StartDart);
+	}
+	else
+	{
+		pHornet->pev->velocity = gpGlobals->v_forward * 300.0f;
+	}
+
+	m_flRechargeTime = gpGlobals->time + HL_HORNET_RECHARGE;
+	m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType]--;
+	m_pPlayer->m_iWeaponVolume = bDart ? NORMAL_GUN_VOLUME : QUIET_GUN_VOLUME;
+	m_pPlayer->m_iWeaponFlash = DIM_GUN_FLASH;
+
+	static const char *sounds[] = { "agrunt/ag_fire1.wav", "agrunt/ag_fire2.wav", "agrunt/ag_fire3.wav" };
+	EMIT_SOUND(ENT(m_pPlayer->pev), CHAN_WEAPON, sounds[RANDOM_LONG(0, 2)], VOL_NORM, ATTN_NORM);
+	SendWeaponAnim(HGUN_SHOOT);
+	m_pPlayer->SetAnimation(PLAYER_ATTACK1);
+
+	if (bDart)
+	{
+		m_flNextPrimaryAttack = m_flNextSecondaryAttack = UTIL_WeaponTimeBase() + 0.1f;
+	}
+	else
+	{
+		m_flNextPrimaryAttack = m_flNextPrimaryAttack + 0.25f;
+		if (m_flNextPrimaryAttack < UTIL_WeaponTimeBase())
+			m_flNextPrimaryAttack = UTIL_WeaponTimeBase() + 0.25f;
+	}
+
+	m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 10.0f, 15.0f);
+	m_pPlayer->pev->punchangle.x -= RANDOM_FLOAT(0.0f, 1.0f);
+}
+
+// (the hornets grow back)
+void CHLHornetGun::Reload()
+{
+	int &ammo = m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType];
+	while (ammo < HL_HORNET_MAX_CARRY && m_flRechargeTime < gpGlobals->time)
+	{
+		ammo++;
+		m_flRechargeTime += HL_HORNET_RECHARGE;
+	}
+}
+
+void CHLHornetGun::WeaponIdle()
+{
+	Reload();
+
+	if (m_flTimeWeaponIdle > UTIL_WeaponTimeBase())
+		return;
+
+	int iAnim;
+	float flRand = UTIL_SharedRandomFloat(m_pPlayer->random_seed, 0.0f, 1.0f);
+	if (flRand <= 0.75f)
+	{
+		iAnim = HGUN_IDLE1;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 30.0f / 16.0f * 2.0f;
+	}
+	else if (flRand <= 0.875f)
+	{
+		iAnim = HGUN_FIDGETSWAY;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 40.0f / 16.0f;
+	}
+	else
+	{
+		iAnim = HGUN_FIDGETSHAKE;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 35.0f / 16.0f;
+	}
+	SendWeaponAnim(iAnim);
+}
