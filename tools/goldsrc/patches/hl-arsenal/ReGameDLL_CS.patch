+
+// (set down in front, launched by its holder's look and speed)
+void CHLSqueak::PrimaryAttack()
+{
+	if (!m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType])
+		return;
+
+	UTIL_MakeVectors(Vector(0, m_pPlayer->pev->v_angle.y, m_pPlayer->pev->v_angle.z));
+	Vector forward = gpGlobals->v_forward;
+	UTIL_MakeVectors(m_pPlayer->pev->v_angle);
+
+	// (looking down: dropped at the feet; up: thrown forwards)
+	float flVel = (m_pPlayer->pev->v_angle.x <= 0) ? 1.0f : m_pPlayer->pev->v_angle.x / 90.0f;
+
+	Vector trace_origin = m_pPlayer->pev->origin;
+	if (m_pPlayer->pev->flags & FL_DUCKING)
+		trace_origin = trace_origin - Vector(0, 0, 1) * (flVel + 1.0f) * -18;
+
+	forward = forward * flVel + gpGlobals->v_forward * (1 - flVel);
+
+	TraceResult tr;
+	UTIL_TraceLine(trace_origin + forward * 24.0f, trace_origin + gpGlobals->v_forward * 60.0f, dont_ignore_monsters, nullptr, &tr);
+
+	if (tr.fAllSolid || tr.fStartSolid || tr.flFraction <= 0.25f)
+		return;
+
+	SendWeaponAnim(SQUEAK_THROW);
+	m_pPlayer->SetAnimation(PLAYER_ATTACK1);
+
+	CHLSnarkGrenade *pSnark = GetClassPtr<CCSAnimating>((CHLSnarkGrenade *)nullptr);
+	UTIL_SetOrigin(pSnark->pev, tr.vecEndPos);
+	pSnark->pev->angles = m_pPlayer->pev->v_angle;
+	pSnark->pev->owner = m_pPlayer->edict();
+	pSnark->Spawn();
+	pSnark->pev->velocity = forward * 200.0f + m_pPlayer->pev->velocity;
+
+	EMIT_SOUND_DYN(ENT(pev), CHAN_VOICE, RANDOM_LONG(0, 1) ? "squeek/sqk_hunt3.wav" : "squeek/sqk_hunt2.wav", VOL_NORM, ATTN_NORM, 0, 105);
+	m_pPlayer->m_iWeaponVolume = QUIET_GUN_VOLUME;
+
+	m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType]--;
+	m_fJustThrown = 1;
+	m_flNextPrimaryAttack = GetNextAttackDelay(0.3f);
+	m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 1.0f;
+}
+
+void CHLSqueak::WeaponIdle()
+{
+	if (m_flTimeWeaponIdle > UTIL_WeaponTimeBase())
+		return;
+
+	if (m_fJustThrown)
+	{
+		// (the next one, or none left)
+		m_fJustThrown = 0;
+
+		if (!m_pPlayer->m_rgAmmo[PrimaryAmmoIndex()])
+		{
+			RetireWeapon();
+			return;
+		}
+
+		SendWeaponAnim(SQUEAK_UP);
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 10.0f, 15.0f);
+		return;
+	}
+
+	int iAnim;
+	float flRand = UTIL_SharedRandomFloat(m_pPlayer->random_seed, 0.0f, 1.0f);
+	if (flRand <= 0.75f)
+	{
+		iAnim = SQUEAK_IDLE1;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 30.0f / 16.0f * 2.0f;
+	}
+	else if (flRand <= 0.875f)
+	{
+		iAnim = SQUEAK_FIDGETFIT;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 70.0f / 16.0f;
+	}
+	else
+	{
+		iAnim = SQUEAK_FIDGETNIP;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 80.0f / 16.0f;
+	}
+
+	SendWeaponAnim(iAnim);
+}
