+LINK_ENTITY_TO_CLASS(monster_tripmine, CHLTripmineGrenade, CCSAnimating)
+
+void CHLTripmineGrenade::Spawn()
+{
+	Precache();
+	MAKE_STRING_CLASS("monster_tripmine", pev);
+	pev->movetype = MOVETYPE_FLY;
+	pev->solid = SOLID_NOT;
+
+	SET_MODEL(edict(), "models/v_tripmine.mdl");
+	pev->frame = 0;
+	pev->body = 3;
+	pev->sequence = TRIPMINE_WORLD;
+	ResetSequenceInfo();
+	pev->framerate = 0;
+
+	UTIL_SetSize(pev, Vector(-8, -8, -8), Vector(8, 8, 8));
+	UTIL_SetOrigin(pev, pev->origin);
+
+	m_flPowerUp = gpGlobals->time + 2.5f;
+	SetThink(&CHLTripmineGrenade::PowerupThink);
+	pev->nextthink = gpGlobals->time + 0.2f;
+
+	pev->takedamage = DAMAGE_YES;
+	pev->dmg = HL_TRIPMINE_DAMAGE;
+	pev->health = 1; // (any damage sets it off)
+
+	m_pBeam = nullptr;
+	m_hOwner = nullptr;
+	m_pRealOwner = pev->owner;
+	m_iOwnerTeam = HL_TeamOf(pev->owner);
+
+	if (pev->owner)
+	{
+		EMIT_SOUND(ENT(pev), CHAN_VOICE, "weapons/mine_deploy.wav", VOL_NORM, ATTN_NORM);
+		EMIT_SOUND(ENT(pev), CHAN_BODY, "weapons/mine_charge.wav", 0.2f, ATTN_NORM); // (charging up)
+	}
+
+	UTIL_MakeAimVectors(pev->angles);
+	m_vecDir = gpGlobals->v_forward;
+	m_vecEnd = pev->origin + m_vecDir * 2048.0f;
+}
+
+void CHLTripmineGrenade::Precache()
+{
+	PRECACHE_MODEL("models/v_tripmine.mdl");
+	PRECACHE_MODEL("sprites/laserbeam.spr");
+	PRECACHE_SOUND("weapons/mine_deploy.wav");
+	PRECACHE_SOUND("weapons/mine_activate.wav");
+	PRECACHE_SOUND("weapons/mine_charge.wav");
+}
+
+// (waits until it holds to a wall, then arms after its charge-up)
+void CHLTripmineGrenade::PowerupThink()
+{
+	TraceResult tr;
+
+	if (!m_hOwner.IsValid())
+	{
+		// (what it sits on, its owner from now on: it moves, the mine goes)
+		edict_t *oldowner = pev->owner;
+		pev->owner = nullptr;
+		UTIL_TraceLine(pev->origin + m_vecDir * 8.0f, pev->origin - m_vecDir * 32.0f, dont_ignore_monsters, ENT(pev), &tr);
+
+		if (tr.fStartSolid || (oldowner && tr.pHit == oldowner))
+		{
+			pev->owner = oldowner;
+			m_flPowerUp += 0.1f;
+			pev->nextthink = gpGlobals->time + 0.1f;
+			return;
+		}
+
+		if (tr.flFraction < 1.0f)
+		{
+			pev->owner = tr.pHit;
+			m_hOwner = CBaseEntity::Instance(pev->owner);
+			m_posOwner = m_hOwner->pev->origin;
+			m_angleOwner = m_hOwner->pev->angles;
+		}
+		else
+		{
+			STOP_SOUND(ENT(pev), CHAN_VOICE, "weapons/mine_deploy.wav");
+			STOP_SOUND(ENT(pev), CHAN_BODY, "weapons/mine_charge.wav");
+			SetThink(&CBaseEntity::SUB_Remove);
+			pev->nextthink = gpGlobals->time + 0.1f;
+			KillBeam();
+			return;
+		}
+	}
+	else if (m_posOwner != m_hOwner->pev->origin || m_angleOwner != m_hOwner->pev->angles)
+	{
+		// (its wall moved: no mine)
+		STOP_SOUND(ENT(pev), CHAN_VOICE, "weapons/mine_deploy.wav");
+		STOP_SOUND(ENT(pev), CHAN_BODY, "weapons/mine_charge.wav");
+		SetThink(&CBaseEntity::SUB_Remove);
+		KillBeam();
+		pev->nextthink = gpGlobals->time + 0.1f;
+		return;
+	}
+
+	if (gpGlobals->time > m_flPowerUp)
+	{
+		// (armed: solid, and its beam on)
+		pev->solid = SOLID_BBOX;
+		UTIL_SetOrigin(pev, pev->origin);
+		MakeBeam();
+		EMIT_SOUND_DYN(ENT(pev), CHAN_VOICE, "weapons/mine_activate.wav", 0.5f, ATTN_NORM, 1, 75);
+	}
+
+	pev->nextthink = gpGlobals->time + 0.1f;
+}
+
+void CHLTripmineGrenade::KillBeam()
+{
+	if (m_pBeam)
+	{
+		UTIL_Remove(m_pBeam);
+		m_pBeam = nullptr;
+	}
+}
+
+void CHLTripmineGrenade::MakeBeam()
+{
+	TraceResult tr;
+	UTIL_TraceLine(pev->origin, m_vecEnd, dont_ignore_monsters, ENT(pev), &tr);
+	m_flBeamLength = tr.flFraction;
+
+	SetThink(&CHLTripmineGrenade::BeamBreakThink);
+	pev->nextthink = gpGlobals->time + 0.1f;
+
+	Vector vecTmpEnd = pev->origin + m_vecDir * 2048.0f * m_flBeamLength;
+
+	m_pBeam = CBeam::BeamCreate("sprites/laserbeam.spr", 10);
+	m_pBeam->pev->spawnflags |= SF_BEAM_TEMPORARY;
+	m_pBeam->PointEntInit(vecTmpEnd, entindex());
+	m_pBeam->SetColor(0, 214, 198);
+	m_pBeam->SetScrollRate(255);
+	m_pBeam->SetBrightness(64);
+}
+
+// (its owner's team walks through the beam)
+bool CHLTripmineGrenade::LetsThrough(CBaseEntity *pEntity)
+{
+	if (!pEntity || !pEntity->IsPlayer())
+		return false;
+
+#ifdef REGAMEDLL_ADD
+	if (CSGameRules()->IsFreeForAll())
+		return pEntity->edict() == m_pRealOwner;
+#endif
+
+	return static_cast<CBasePlayer *>(pEntity)->m_iTeam == m_iOwnerTeam;
+}
+
+void CHLTripmineGrenade::BeamBreakThink()
+{
+	bool bBlowup = false;
+
+	TraceResult tr;
+	gpGlobals->trace_flags = FTRACE_SIMPLEBOX;
+	UTIL_TraceLine(pev->origin, m_vecEnd, dont_ignore_monsters, ENT(pev), &tr);
+
+	if (!m_pBeam)
+		MakeBeam();
+
+	if (Q_fabs(m_flBeamLength - tr.flFraction) > 0.001f)
+	{
+		if (!LetsThrough(CBaseEntity::Instance(tr.pHit)))
+			bBlowup = true;
+	}
+	else if (!m_hOwner.IsValid() || m_posOwner != m_hOwner->pev->origin || m_angleOwner != m_hOwner->pev->angles)
+	{
+		// (its wall went or moved)
+		bBlowup = true;
+	}
+
+	if (bBlowup)
+	{
+		pev->owner = m_pRealOwner;
+		pev->health = 0;
+		Killed(VARS(pev->owner), GIB_NORMAL);
+		return;
+	}
+
+	pev->nextthink = gpGlobals->time + 0.1f;
+}
+
+BOOL CHLTripmineGrenade::TakeDamage(entvars_t *pevInflictor, entvars_t *pevAttacker, float flDamage, int bitsDamageType)
+{
+	if (gpGlobals->time < m_flPowerUp && flDamage < pev->health)
+	{
+		// (disarmed before it is ready)
+		SetThink(&CBaseEntity::SUB_Remove);
+		pev->nextthink = gpGlobals->time + 0.1f;
+		KillBeam();
+		return FALSE;
+	}
+
+	return CBaseAnimating::TakeDamage(pevInflictor, pevAttacker, flDamage, bitsDamageType);
+}
+
+void CHLTripmineGrenade::Killed(entvars_t *pevAttacker, int iGib)
+{
+	pev->takedamage = DAMAGE_NO;
+
+	// (the kill goes to whoever set it off by shooting it, otherwise to whom laid it)
+	pev->owner = (pevAttacker && (pevAttacker->flags & FL_CLIENT)) ? ENT(pevAttacker) : m_pRealOwner;
+
+	SetThink(&CHLTripmineGrenade::DelayDeathThink);
+	pev->nextthink = gpGlobals->time + RANDOM_FLOAT(0.1f, 0.3f);
+
