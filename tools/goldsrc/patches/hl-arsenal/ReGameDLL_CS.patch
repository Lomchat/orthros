+// ---------------------------------------------------------------------------------------------------------------------
+// pk_test (sv_cheats 1): pk_test <pikachu|charizard|blastoise|lem> [spawn|enemy [distance]]; pk_test clear; pk_test info;
+// pk_test hurt [n]
+// (no second word: the ball, or Le M's laptop, free)
+
+
+void CPokemon::Report(CBasePlayer *pTo)
+{
+	CBasePlayer *pOwner = Owner();
+	CBaseEntity *pEnemy = m_hEnemy;
+	char line[256];
+	Q_snprintf(line, sizeof(line), "#%d %s owner=%s team=%d hp=%d/%d state=%s enemy=%s nav=%s path=%d/%d pos=%.0f,%.0f,%.0f owner_dist=%.0f\n",
+		entindex(), PK_Info(m_iSpecies).name, pOwner ? STRING(pOwner->pev->netname) : "-", m_iTeam, int(pev->health), int(pev->max_health),
+		PK_StateNames[clamp(m_iState, 0, int(ARRAYSIZE(PK_StateNames)) - 1)],
+		pEnemy ? (pEnemy->IsPlayer() ? STRING(pEnemy->pev->netname) : STRING(pEnemy->pev->classname)) : "-",
+		TheNavAreaList.empty() ? "none" : "yes", m_path.IsValid() ? m_iPathIndex : 0, m_path.IsValid() ? m_path.GetSegmentCount() : 0,
+		pev->origin.x, pev->origin.y, pev->origin.z, pOwner ? (pOwner->pev->origin - pev->origin).Length() : 0.0f);
+	if (pTo)
+	{
+		size_t n = Q_strlen(line);
+		if (n > 0 && n + 24 < sizeof(line))
+			Q_snprintf(line + n - 1, sizeof(line) - n + 1, " you_dist=%.0f\n", (pTo->pev->origin - pev->origin).Length());
+
+		ClientPrint(pTo->pev, HUD_PRINTCONSOLE, line);
+	}
+	else
+		SERVER_PRINT(line);
+}
+
+void PK_TestCommand(CBasePlayer *pPlayer)
+{
+	if (CVAR_GET_FLOAT("sv_cheats") == 0.0f)
+	{
+		ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, "pk_test needs sv_cheats 1\n");
+		return;
+	}
+
+	const char *arg1 = CMD_ARGC() > 1 ? CMD_ARGV(1) : "";
+	const char *arg2 = CMD_ARGC() > 2 ? CMD_ARGV(2) : "";
+
+	if (!Q_stricmp(arg1, "clear"))
+	{
+		PK_CleanUpMap();
+		return;
+	}
+
+	if (!Q_stricmp(arg1, "info"))
+	{
+		CBaseEntity *pEntity = nullptr;
+		while ((pEntity = UTIL_FindEntityByClassname(pEntity, "monster_pokemon")))
+			static_cast<CPokemon *>(pEntity)->Report(pPlayer);
+
+		return;
+	}
+
+	// (pk_test hurt <n>: n damage from the world to every companion, yours included, in your sight — checks the hurt,
+	// flinch, death and Le M's pixel dissolve without a fight)
+	if (!Q_stricmp(arg1, "hurt"))
+	{
+		float flDamage = arg2[0] ? Q_atof(arg2) : 50.0f;
+		int iHurt = 0;
+		CBaseEntity *pEntity = nullptr;
+		while ((pEntity = UTIL_FindEntityByClassname(pEntity, "monster_pokemon")))
+		{
+			TraceResult trSee;
+			UTIL_TraceLine(pPlayer->EyePosition(), pEntity->Center(), ignore_monsters, pPlayer->edict(), &trSee);
+			if (trSee.flFraction < 1.0f || !pEntity->IsAlive())
+				continue;
+
+			if (pEntity->TakeDamage(nullptr, nullptr, flDamage, DMG_GENERIC))
+				iHurt++;
+		}
+
+		ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, UTIL_VarArgs("pk_test: %d companion(s) hurt by %.0f\n", iHurt, flDamage));
+		return;
+	}
+
+	int iSpecies = -1;
+	for (int i = 0; i < PK_NUM_SPECIES; i++)
+	{
+		if (!Q_stricmp(arg1, g_PokemonInfo[i].key) || !Q_stricmp(arg1, g_PokemonInfo[i].name))
+			iSpecies = i;
+	}
+
+	if (iSpecies < 0)
+	{
+		ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, "usage: pk_test <pikachu|charizard|blastoise|lem> [spawn|enemy [distance]] | pk_test clear | pk_test info | pk_test hurt [n]\n");
+		return;
+	}
+
+	if (!PK_PlayerPlaying(pPlayer))
+		return;
+
+	Vector vecFwd;
+	UTIL_MakeVectorsPrivate(pPlayer->pev->v_angle, vecFwd, nullptr, nullptr);
+	TraceResult tr;
+	UTIL_TraceLine(pPlayer->EyePosition(), pPlayer->EyePosition() + vecFwd * 160.0f, ignore_monsters, pPlayer->edict(), &tr);
+	Vector vecSpot = tr.vecEndPos - vecFwd * 24.0f;
+
+	// (a Pokemon for the nearest enemy player — a bot — in front of you, set on you)
+	if (!Q_stricmp(arg2, "enemy"))
+	{
+		CBasePlayer *pBest = nullptr;
+		float flBest = 1e9f;
+		for (int i = 1; i <= gpGlobals->maxClients; i++)
+		{
+			CBasePlayer *pOther = UTIL_PlayerByIndex(i);
+			if (!PK_PlayerPlaying(pOther) || pOther == pPlayer || (pOther->m_iTeam == pPlayer->m_iTeam && !PK_FreeForAll()) || PK_PokemonOf(pOther))
+				continue;
+
+			float flDist = (pOther->pev->origin - pPlayer->pev->origin).Length();
+			if (flDist < flBest)
+			{
+				flBest = flDist;
+				pBest = pOther;
+			}
+		}
+
+		if (!pBest)
+		{
+			ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, "pk_test: no enemy player without a companion (add a bot: bot_add)\n");
+			return;
+		}
+
+		// (pk_test <species> enemy <distance>: that far from you — along your aim, else the first clear direction
+		// around you every 15 degrees, level —, facing you: checks the companions' reach)
+		float flYaw = pPlayer->pev->v_angle.y + 180.0f;
+		const char *arg3 = CMD_ARGC() > 3 ? CMD_ARGV(3) : "";
+		float flWant = arg3[0] ? clamp(float(Q_atof(arg3)), 48.0f, 2000.0f) : 0.0f;
+		if (flWant > 0.0f)
+		{
+			Vector vecEye = pPlayer->EyePosition();
+			float flBest = 0.0f;
+			for (int i = 0; i < 25 && flBest < flWant; i++)
+			{
+				Vector vecDir = vecFwd;
+				if (i > 0)
+				{
+					float a = (pPlayer->pev->v_angle.y + 15.0f * (i - 1)) * float(M_PI / 180.0);
+					vecDir = Vector(Q_cos(a), Q_sin(a), 0.0f);
+				}
+
+				TraceResult trFar;
+				UTIL_TraceLine(vecEye, vecEye + vecDir * (flWant + 24.0f), ignore_monsters, pPlayer->edict(), &trFar);
+				float flGot = (flWant + 24.0f) * trFar.flFraction - 24.0f;
+				if (flGot > flBest)
+				{
+					flBest = flGot;
+					vecSpot = vecEye + vecDir * flGot;
+					flYaw = UTIL_VecToYaw(-vecDir);
+				}
+			}
+
+			ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, UTIL_VarArgs("pk_test: enemy spot %.0f units away (asked %.0f)\n", flBest, flWant));
+		}
+
+		CPokemon *pPokemon = CPokemon::Create(iSpecies, pBest, vecSpot, flYaw);
+		if (!pPokemon)
+			ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, "pk_test: no room there\n");
+		else
+			pPokemon->OnProvoked(pPlayer);
+
+		return;
+	}
+
+	if (PK_HasOut(pPlayer) || PK_BallCarried(pPlayer))
+	{
+		ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, "pk_test: you already have a ball, a laptop or a companion out (pk_test clear)\n");
+		return;
+	}
+
+	// (your own, out at once in front of you)
+	if (!Q_stricmp(arg2, "spawn"))
+	{
+		if (!CPokemon::Create(iSpecies, pPlayer, vecSpot, pPlayer->pev->v_angle.y))
+			ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, "pk_test: no room there\n");
+
+		return;
+	}
+
+	// (the ball, or the laptop, free)
+	pPlayer->GiveNamedItem(PK_Info(iSpecies).weaponName);
+}
+
+// The server console's: pk_spawn <species> <owner> [enemy] (players by a part of their name, or #index);
+// pk_info; pk_clear — for tests with bots on a dedicated server
+static CBasePlayer *PK_PlayerByArg(const char *arg)
+{
+	if (!arg || !arg[0])
+		return nullptr;
+
+	if (arg[0] == '#')
+	{
+		CBasePlayer *pPlayer = UTIL_PlayerByIndex(Q_atoi(arg + 1));
+		return PK_PlayerPlaying(pPlayer) ? pPlayer : nullptr;
+	}
+
+	for (int i = 1; i <= gpGlobals->maxClients; i++)
+	{
+		CBasePlayer *pPlayer = UTIL_PlayerByIndex(i);
+		if (!PK_PlayerPlaying(pPlayer))
+			continue;
+
+		char name[64], want[64];
+		Q_strlcpy(name, STRING(pPlayer->pev->netname));
+		Q_strlcpy(want, arg);
+		Q_strlwr(name);
+		Q_strlwr(want);
+		if (Q_strstr(name, want))
+			return pPlayer;
+	}
+
+	return nullptr;
+}
+
+static void PK_ServerSpawn_f()
+{
+	if (CVAR_GET_FLOAT("sv_cheats") == 0.0f)
+	{
+		SERVER_PRINT("pk_spawn needs sv_cheats 1\n");
+		return;
+	}
+
+	int iSpecies = -1;
+	for (int i = 0; i < PK_NUM_SPECIES; i++)
+	{
+		if (CMD_ARGC() > 1 && (!Q_stricmp(CMD_ARGV(1), g_PokemonInfo[i].key) || !Q_stricmp(CMD_ARGV(1), g_PokemonInfo[i].name)))
+			iSpecies = i;
+	}
+
+	CBasePlayer *pOwner = CMD_ARGC() > 2 ? PK_PlayerByArg(CMD_ARGV(2)) : nullptr;
+	if (iSpecies < 0 || !pOwner)
+	{
+		SERVER_PRINT("usage: pk_spawn <pikachu|charizard|blastoise|lem> <owner name|#index> [<enemy name|#index> [near]] (living players on a side; near: out by the enemy)\n");
+		return;
+	}
+
+	CPokemon *pOld = PK_PokemonOf(pOwner);
+	if (pOld)
+		pOld->Vanish();
+
+	// (by its player, or by the enemy with "near")
+	CBasePlayer *pEnemy = CMD_ARGC() > 3 ? PK_PlayerByArg(CMD_ARGV(3)) : nullptr;
+	CBasePlayer *pBy = (pEnemy && CMD_ARGC() > 4 && !Q_stricmp(CMD_ARGV(4), "near")) ? pEnemy : pOwner;
+	Vector vecFwd;
+	UTIL_MakeVectorsPrivate(Vector(0, pBy->pev->v_angle.y, 0), vecFwd, nullptr, nullptr);
+	CPokemon *pPokemon = CPokemon::Create(iSpecies, pOwner, PK_Feet(pBy) + vecFwd * 96.0f + Vector(0, 0, 8), pBy->pev->v_angle.y + (pBy == pOwner ? 0.0f : 180.0f));
+	if (!pPokemon)
+	{
+		SERVER_PRINT("pk_spawn: no room by that player\n");
+		return;
+	}
+
+	if (pEnemy)
+		pPokemon->OnProvoked(pEnemy);
+
+	pPokemon->Report(nullptr);
+}
+
+static void PK_ServerInfo_f()
+{
+	CBaseEntity *pEntity = nullptr;
+	int count = 0;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "monster_pokemon")))
+	{
+		static_cast<CPokemon *>(pEntity)->Report(nullptr);
+		count++;
+	}
+
+	if (!count)
+		SERVER_PRINT("pk_info: no Pokemon\n");
+}
+
+static void PK_ServerClear_f()
+{
+	if (CVAR_GET_FLOAT("sv_cheats") != 0.0f)
+		PK_CleanUpMap();
+}
+
+void PK_RegisterServerCommands()
+{
+	ADD_SERVER_COMMAND("pk_spawn", PK_ServerSpawn_f);
+	ADD_SERVER_COMMAND("pk_info", PK_ServerInfo_f);
+	ADD_SERVER_COMMAND("pk_clear", PK_ServerClear_f);
+}
