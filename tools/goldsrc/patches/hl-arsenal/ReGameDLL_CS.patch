+void CHLGlock::GlockFire(float flSpread, float flCycleTime, bool bAimed)
+{
+	if (m_iClip <= 0)
+	{
+		if (m_fFireOnEmpty)
+		{
+			PlayEmptySound();
+			m_flNextPrimaryAttack = GetNextAttackDelay(0.2f);
+		}
+
+		return;
+	}
+
+	m_iClip--;
+	m_pPlayer->pev->effects |= EF_MUZZLEFLASH;
+	m_pPlayer->SetAnimation(PLAYER_ATTACK1);
+	m_pPlayer->m_iWeaponVolume = NORMAL_GUN_VOLUME;
+	m_pPlayer->m_iWeaponFlash = NORMAL_GUN_FLASH;
+
+	UTIL_MakeVectors(m_pPlayer->pev->v_angle + m_pPlayer->pev->punchangle);
+	Vector vecSrc = m_pPlayer->GetGunPosition();
+	Vector vecDir = m_pPlayer->FireBullets3(vecSrc, gpGlobals->v_forward, flSpread, 8192, 1, BULLET_PLAYER_9MM, HL_GLOCK_DAMAGE, 0.75f, m_pPlayer->pev, true, m_pPlayer->random_seed);
+
+	PLAYBACK_EVENT_FULL(0, m_pPlayer->edict(), bAimed ? m_usFireGlock1 : m_usFireGlock2, 0.0f, (float *)&g_vecZero, (float *)&g_vecZero, vecDir.x, vecDir.y, 0, 0, m_iClip == 0, 0);
+
+	m_flNextPrimaryAttack = m_flNextSecondaryAttack = GetNextAttackDelay(flCycleTime);
+	m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 10.0f, 15.0f);
+	m_pPlayer->pev->punchangle.x -= bAimed ? 1.0f : 1.5f;
+}
+
+void CHLGlock::Reload()
+{
+	if (m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] <= 0 || m_iClip == HL_GLOCK_MAX_CLIP)
+		return;
+
+	if (DefaultReload(HL_GLOCK_MAX_CLIP, m_iClip == 0 ? GLOCK_RELOAD : GLOCK_RELOAD_NOT_EMPTY, 1.5f))
+	{
+		m_pPlayer->SetAnimation(PLAYER_RELOAD);
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 10.0f, 15.0f);
+	}
+}
+
+void CHLGlock::WeaponIdle()
+{
+	ResetEmptySound();
+
+	if (m_flTimeWeaponIdle > UTIL_WeaponTimeBase() || m_iClip == 0)
+		return;
+
+	int iAnim;
+	float flRand = UTIL_SharedRandomFloat(m_pPlayer->random_seed, 0.0f, 1.0f);
+	if (flRand <= 0.3f)
+	{
+		iAnim = GLOCK_IDLE3;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 49.0f / 16.0f;
+	}
+	else if (flRand <= 0.6f)
+	{
+		iAnim = GLOCK_IDLE1;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 60.0f / 16.0f;
+	}
+	else
+	{
+		iAnim = GLOCK_IDLE2;
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 40.0f / 16.0f;
+	}
+
+	SendWeaponAnim(iAnim);
+}
