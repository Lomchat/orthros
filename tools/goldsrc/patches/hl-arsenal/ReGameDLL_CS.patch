+int CHLSatchel::AddToPlayer(CBasePlayer *pPlayer)
+{
+	int bResult = CBasePlayerWeapon::AddToPlayer(pPlayer);
+	m_chargeReady = HasCharges() ? SATCHEL_READY : SATCHEL_IDLE;
+	return bResult;
+}
