diff --git a/regamedll/dlls/wpn_shared/build.cpp b/regamedll/dlls/wpn_shared/build.cpp
new file mode 100644
index 0000000..cc9e72c
--- /dev/null
+++ b/regamedll/dlls/wpn_shared/build.cpp
@@ -0,0 +1,1561 @@
+// Half Strike r11: bricks and Fortnite-style building (build.h). The grid — where a piece goes from a player's view and
+// the checks of a spot — is build_grid.h, shared with the client's blueprint: the server runs the same build_aim from
+// its own view of the player, never trusting a client's coordinates beyond the spot the server itself finds.
+
+#include "precompiled.h"
+
+cvar_t build_enabled = { "mp_build", "1", FCVAR_SERVER, 1.0f, nullptr };
+cvar_t build_start_bricks  = { "mp_build_bricks", "0", FCVAR_SERVER, 0.0f, nullptr };
+
+int gmsgBricks = 0;
+int gmsgBuildMode = 0;
+int gmsgBuildDeny = 0;
+
+static const char *const BUILD_Models[BUILD_PIECES] =
+{
+	"models/build/wall.mdl",
+	"models/build/floor.mdl",
+	"models/build/ramp.mdl",
+	"models/build/roof.mdl",
+};
+
+// (precached optional — "!": a missing file is no client's fatal error)
+static const char *const BUILD_ModelsOptional[BUILD_PIECES] =
+{
+	"!models/build/wall.mdl",
+	"!models/build/floor.mdl",
+	"!models/build/ramp.mdl",
+	"!models/build/roof.mdl",
+};
+
+#define BUILD_VIEW_MODEL  "models/build/v_build.mdl"
+#define BUILD_PILE_MODEL  "models/build/brick_pile.mdl"
+#define BUILD_GIBS_MODEL  "models/build/gibs_brick.mdl"
+
+// v_build's sequences (the assets' contract)
+enum { BUILD_VSEQ_IDLE = 0, BUILD_VSEQ_DRAW, BUILD_VSEQ_PLACE };
+
+static int s_iGibsModel = 0;
+static int s_iBuildRound = 1;   // (a new round: every player's bricks to the start value again)
+
+static inline bool BUILD_On() { return build_enabled.value != 0.0f; }
+
+static int BUILD_StartBricks()
+{
+	return clamp(int(build_start_bricks.value), 0, BUILD_MAX_BRICKS);
+}
+
+static void BUILD_TestCommand();
+
+void BUILD_RegisterCvars()
+{
+	CVAR_REGISTER(&build_enabled);
+	CVAR_REGISTER(&build_start_bricks);
+	ADD_SERVER_COMMAND("build_test", BUILD_TestCommand);
+}
+
+void BUILD_RegisterMessages()
+{
+	gmsgBricks    = REG_USER_MSG("Bricks", 3);
+	gmsgBuildMode = REG_USER_MSG("BuildMode", 1);
+	gmsgBuildDeny = REG_USER_MSG("BuildDeny", 1);
+}
+
+static void BUILD_ForgetPiles();
+
+void BUILD_Precache()
+{
+	BUILD_ForgetPiles(); // (a new map: the last one's piles are gone)
+	for (int i = 0; i < BUILD_PIECES; i++)
+		PRECACHE_MODEL(BUILD_ModelsOptional[i]);
+
+	PRECACHE_MODEL("!" BUILD_VIEW_MODEL);
+	PRECACHE_MODEL("!" BUILD_PILE_MODEL);
+	s_iGibsModel = PRECACHE_MODEL("!" BUILD_GIBS_MODEL);
+
+	PRECACHE_SOUND("build/pickup.wav");
+	PRECACHE_SOUND("build/place.wav");
+	PRECACHE_SOUND("build/build_loop.wav");
+	PRECACHE_SOUND("build/hit1.wav");
+	PRECACHE_SOUND("build/hit2.wav");
+	PRECACHE_SOUND("build/hit3.wav");
+	PRECACHE_SOUND("build/break1.wav");
+	PRECACHE_SOUND("build/break2.wav");
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// traces: the grid's engine (build_grid.h's build_engine_t)
+
+bool BUILD_IsPiece(const edict_t *pEdict)
+{
+	if (!pEdict || pEdict->free || !pEdict->pvPrivateData)
+		return false;
+
+	const char *name = STRING(pEdict->v.classname);
+	return name && (!Q_strcmp(name, "build_piece") || !Q_strcmp(name, "build_step"));
+}
+
+struct BuildTraceCtx
+{
+	edict_t *pIgnore;    // (the player: never hit)
+	edict_t *pLastHit;   // (what the last trace stopped on)
+};
+
+// A line through players, monsters and anything else but the world, brush entities and built pieces (worldOnly: the
+// world and brush entities — doors, func_wall, breakables — alone), as the client's grid trace; its fraction, end,
+// whether it started in a solid (the world, a brush entity, or without worldOnly a built piece)
+static float BUILD_TraceLine(BuildTraceCtx *ctx, const Vector &vecStart, const Vector &vecEnd, bool bWorldOnly, Vector &vecHit, bool &bStartSolid)
+{
+	TraceResult tr;
+	edict_t *pIgnore = ctx->pIgnore;
+	Vector vecFrom = vecStart;
+	const float flTotal = (vecEnd - vecStart).Length();
+
+	ctx->pLastHit = nullptr;
+	bStartSolid = false;
+	vecHit = vecEnd;
+
+	for (int i = 0; i < 8; i++)
+	{
+		UTIL_TraceLine(vecFrom, vecEnd, bWorldOnly ? ignore_monsters : dont_ignore_monsters, pIgnore, &tr);
+		if (i == 0 && (tr.fStartSolid || tr.fAllSolid))
+		{
+			// (inside the world, a brush entity or a piece: the start is in a solid; inside another entity: the trace
+			// starts again past it)
+			if (!tr.pHit || ENTINDEX(tr.pHit) == 0 || VARS(tr.pHit)->solid == SOLID_BSP || (!bWorldOnly && BUILD_IsPiece(tr.pHit)))
+			{
+				bStartSolid = true;
+				vecHit = vecStart;
+				ctx->pLastHit = tr.pHit;
+				return 0.0f;
+			}
+		}
+
+		if (tr.flFraction >= 1.0f || !tr.pHit)
+			break;
+
+		edict_t *pHit = tr.pHit;
+		const bool bWorld = (ENTINDEX(pHit) == 0);
+		const bool bTakes = bWorld || pHit->v.solid == SOLID_BSP || (!bWorldOnly && BUILD_IsPiece(pHit));
+		if (bTakes)
+		{
+			vecHit = tr.vecEndPos;
+			ctx->pLastHit = pHit;
+			return flTotal > 0.0f ? clamp(float((tr.vecEndPos - vecStart).Length() / flTotal), 0.0f, 0.999f) : 0.0f;
+		}
+
+		// (through it: on from where it was met, past it)
+		vecFrom = tr.vecEndPos;
+		pIgnore = pHit;
+	}
+
+	return 1.0f;
+}
+
+static float BUILD_EngineTrace(void *ctx, const float *start, const float *end, int worldOnly, float *endpos, int *startsolid)
+{
+	Vector vecHit;
+	bool bStartSolid;
+	float f = BUILD_TraceLine((BuildTraceCtx *)ctx, Vector(start[0], start[1], start[2]), Vector(end[0], end[1], end[2]), worldOnly != 0, vecHit, bStartSolid);
+	endpos[0] = vecHit.x;
+	endpos[1] = vecHit.y;
+	endpos[2] = vecHit.z;
+	*startsolid = bStartSolid ? 1 : 0;
+	return f;
+}
+
+static int BUILD_EnginePiece(void *ctx, float *origin_z)
+{
+	edict_t *pHit = ((BuildTraceCtx *)ctx)->pLastHit;
+	if (!BUILD_IsPiece(pHit))
+		return 0;
+
+	*origin_z = pHit->v.origin.z;
+	return 1;
+}
+
+static build_engine_t BUILD_Engine(BuildTraceCtx *ctx)
+{
+	build_engine_t e;
+	e.ctx = ctx;
+	e.trace = BUILD_EngineTrace;
+	e.piece = BUILD_EnginePiece;
+	return e;
+}
+
+CBaseEntity *BUILD_PieceOnLine(const Vector &vecSrc, const Vector &vecEnd, edict_t *pIgnore)
+{
+	BuildTraceCtx ctx = { pIgnore, nullptr };
+	Vector vecHit;
+	bool bStartSolid;
+	if (BUILD_TraceLine(&ctx, vecSrc, vecEnd, false, vecHit, bStartSolid) >= 1.0f || !BUILD_IsPiece(ctx.pLastHit))
+		return nullptr;
+
+	CBaseEntity *pHit = CBaseEntity::Instance(ctx.pLastHit);
+	if (pHit && FClassnameIs(pHit->pev, "build_step"))
+		return static_cast<CBuildStep *>(pHit)->Parent();
+
+	return pHit;
+}
+
+void BUILD_TraceLineSolid(const Vector &vecStart, const Vector &vecEnd, edict_t *pIgnore, TraceResult *ptr)
+{
+	UTIL_TraceLine(vecStart, vecEnd, ignore_monsters, pIgnore, ptr);
+	if (ptr->fStartSolid || ptr->fAllSolid)
+		return;
+
+	// (a piece before what that met: the line stops there)
+	BuildTraceCtx ctx = { pIgnore, nullptr };
+	Vector vecHit;
+	bool bStartSolid;
+	BUILD_TraceLine(&ctx, vecStart, ptr->vecEndPos, false, vecHit, bStartSolid);
+	if (!BUILD_IsPiece(ctx.pLastHit))
+		return;
+
+	const float flTotal = (vecEnd - vecStart).Length();
+	ptr->pHit = ctx.pLastHit;
+	ptr->vecEndPos = vecHit;
+	ptr->flFraction = flTotal > 0.0f ? clamp(float((vecHit - vecStart).Length() / flTotal), 0.0f, 0.999f) : 0.0f;
+	ptr->vecPlaneNormal = flTotal > 0.0f ? (vecStart - vecEnd) / flTotal : Vector(0, 0, 1);
+	if (bStartSolid)
+	{
+		ptr->fStartSolid = TRUE;
+		ptr->flFraction = 0.0f;
+	}
+}
+
+bool BUILD_PieceVisible(edict_t *pEdict, unsigned char *pSet)
+{
+	if (pEdict->v.solid != SOLID_BBOX || !FClassnameIs(&pEdict->v, "build_piece"))
+		return false;
+
+	CBuildPiece *pPiece = static_cast<CBuildPiece *>(CBaseEntity::Instance(pEdict));
+	return pPiece && pPiece->StepVisible(pSet);
+}
+
+bool CBuildPiece::StepVisible(unsigned char *pSet) const
+{
+	for (int i = 0; i < m_iNumSteps; i++)
+	{
+		CBaseEntity *pStep = m_hSteps[i];
+		if (pStep && ENGINE_CHECK_VISIBILITY(pStep->edict(), pSet))
+			return true;
+	}
+	return false;
+}
+
+float BUILD_BlastDistance(CBaseEntity *pEntity, const Vector &vecSrc, float flDefault)
+{
+	if (!BUILD_IsPiece(pEntity))
+		return flDefault;
+
+	// (a piece: its nearest point, whatever its size)
+	Vector d;
+	for (int k = 0; k < 3; k++)
+	{
+		float v = vecSrc[k];
+		d[k] = v < pEntity->pev->absmin[k] ? pEntity->pev->absmin[k] - v : v > pEntity->pev->absmax[k] ? v - pEntity->pev->absmax[k] : 0.0f;
+	}
+	return d.Length();
+}
+
+bool BUILD_BlastShielded(CBaseEntity *pEntity, const Vector &vecSrc, const Vector &vecSpot, edict_t *pInflictor)
+{
+	if (!pEntity || BUILD_IsPiece(pEntity) || !(pEntity->pev->flags & (FL_CLIENT | FL_FAKECLIENT | FL_MONSTER)))
+		return false;
+
+	CBaseEntity *pPiece = BUILD_PieceOnLine(vecSrc, vecSpot, pInflictor);
+	return pPiece != nullptr;
+}
