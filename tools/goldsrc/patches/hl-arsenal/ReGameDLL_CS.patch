+
+static bool BUILD_CanPlay(CBasePlayer *pPlayer)
+{
+	return pPlayer->IsAlive() && pPlayer->GetObserverMode() == OBS_NONE && (pPlayer->m_iTeam == TERRORIST || pPlayer->m_iTeam == CT)
+		&& !pPlayer->IsBot();
+}
+
+static void BUILD_Leave(CBasePlayer *pPlayer, bool bRedeploy)
+{
+	if (!pPlayer->m_bBuildMode)
+		return;
+
+	pPlayer->m_bBuildMode = false;
+	pPlayer->m_pBuildItem = nullptr;
+
+	if (!bRedeploy)
+		return;
+
+	if (pPlayer->m_pActiveItem && pPlayer->IsAlive())
+	{
+		pPlayer->m_pActiveItem->Deploy();
+		pPlayer->m_pActiveItem->UpdateItemInfo();
+		pPlayer->ResetMaxSpeed();
+	}
+	else
+	{
+		pPlayer->pev->viewmodel = iStringNull;
+		pPlayer->pev->weaponmodel = iStringNull;
+	}
+}
+
+static int BUILD_Enter(CBasePlayer *pPlayer)
+{
+	if (!BUILD_On())
+		return BUILD_DISABLED;
+
+	if (!BUILD_CanPlay(pPlayer) || pPlayer->m_pTank)
+		return BUILD_CANNOT;
+
+	if (pPlayer->m_bBuildMode)
+		return BUILD_OK;
+
+	CBasePlayerItem *pItem = pPlayer->m_pActiveItem;
+	if (pItem && !pItem->CanHolster())
+		return BUILD_CANNOT;
+
+	if (pPlayer->m_bIsDefusing)
+		return BUILD_CANNOT;
+
+	if (pItem)
+		pItem->Holster();
+
+	// (a drawn shield down, the zoom off — and the speed they gave)
+	if (pItem && pItem->IsWeapon())
+		static_cast<CBasePlayerWeapon *>(pItem)->m_iWeaponState &= ~WPNSTATE_SHIELD_DRAWN;
+	if (pPlayer->m_bShieldDrawn)
+	{
+		pPlayer->m_bShieldDrawn = false;
+		pPlayer->UpdateShieldCrosshair(true);
+	}
+
+	pPlayer->m_bBuildMode = true;
+	pPlayer->m_pBuildItem = pItem;
+	pPlayer->m_iFOV = pPlayer->m_iLastZoom = DEFAULT_FOV;
+	pPlayer->pev->fov = DEFAULT_FOV;
+	pPlayer->m_bResumeZoom = false;
+	pPlayer->ResetMaxSpeed();
+	pPlayer->pev->viewmodel = MAKE_STRING(BUILD_VIEW_MODEL);
+	pPlayer->pev->weaponmodel = iStringNull;
+	BUILD_WeaponAnim(pPlayer, BUILD_VSEQ_DRAW);
+	pPlayer->m_flNextBuild = Q_max(pPlayer->m_flNextBuild, gpGlobals->time + 0.2f);
+	return BUILD_OK;
+}
+
+// (a new round or a spawn in build mode — a survivor keeps its weapon, never deployed again by Spawn —: back to it)
+static void BUILD_LeaveForRound(CBasePlayer *pPlayer)
+{
+	if (!pPlayer->m_bBuildMode)
+		return;
+
+	pPlayer->m_bBuildMode = false;
+	pPlayer->m_pBuildItem = nullptr;
+	if (pPlayer->m_pActiveItem)
+	{
+		pPlayer->m_pActiveItem->Deploy();
+		pPlayer->m_pActiveItem->UpdateItemInfo();
+	}
+	else
+	{
+		pPlayer->pev->viewmodel = iStringNull;
+		pPlayer->pev->weaponmodel = iStringNull;
+	}
+}
+
+void BUILD_PlayerSpawn(CBasePlayer *pPlayer)
+{
+	BUILD_LeaveForRound(pPlayer);
+	pPlayer->m_bBuildMode = false;
+	pPlayer->m_pBuildItem = nullptr;
+	pPlayer->m_flNextBuild = 0;
+
+	if (pPlayer->m_iBricksRound != s_iBuildRound)
+	{
+		pPlayer->m_iBricks = BUILD_StartBricks();
+		pPlayer->m_iBricksRound = s_iBuildRound;
+	}
+}
+
+// a player just put at its spawn spot (mid-round: joining, a forced respawn): the pieces it would be stuck in break
+void BUILD_PlayerSpawned(CBasePlayer *pPlayer)
+{
+	// (not a client just connected: ClientPutInServer spawns it at a spawn spot, then makes it a spectator)
+	if (pPlayer->m_bJustConnected || (pPlayer->m_iTeam != TERRORIST && pPlayer->m_iTeam != CT))
+		return;
+
+	const Vector vecMins = pPlayer->pev->origin + VEC_HULL_MIN, vecMaxs = pPlayer->pev->origin + VEC_HULL_MAX + Vector(0, 0, 1);
+	CBaseEntity *pEntity = nullptr;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "build_piece")))
+	{
+		if (pEntity->pev->flags & FL_KILLME)
+			continue;
+
+		CBuildPiece *pPiece = static_cast<CBuildPiece *>(pEntity);
+		build_spot_t spot = {};
+		spot.piece = pPiece->Piece();
+		spot.yaw = pPiece->Yaw();
+		spot.origin[0] = pEntity->pev->origin.x;
+		spot.origin[1] = pEntity->pev->origin.y;
+		spot.origin[2] = pEntity->pev->origin.z;
+		build_box(spot.piece, spot.yaw, spot.origin, spot.mins, spot.maxs);
+		if (build_overlaps_box(&spot, vecMins, vecMaxs))
+			pPiece->Destroy();
+	}
+}
+
+void BUILD_PlayerKilled(CBasePlayer *pPlayer)
+{
+	BUILD_Leave(pPlayer, false);
+}
+
+void BUILD_PlayerNewRound(CBasePlayer *pPlayer)
+{
+	BUILD_LeaveForRound(pPlayer);
+	pPlayer->m_iBricks = BUILD_StartBricks();
+	pPlayer->m_iBricksRound = s_iBuildRound;
+}
+
+bool BUILD_PlayerItemFrame(CBasePlayer *pPlayer)
+{
+	if (!pPlayer->m_bBuildMode)
+		return false;
+
+	// (out of it: building off, dead, or another weapon in hand — bought, picked —: that one stays)
+	if (!BUILD_On() || !BUILD_CanPlay(pPlayer) || pPlayer->m_pActiveItem != pPlayer->m_pBuildItem)
+	{
+		BUILD_Leave(pPlayer, BUILD_CanPlay(pPlayer) && pPlayer->m_pActiveItem == pPlayer->m_pBuildItem);
+		return false;
+	}
+
+	if (!FStrEq(STRING(pPlayer->pev->viewmodel), BUILD_VIEW_MODEL))
+		pPlayer->pev->viewmodel = MAKE_STRING(BUILD_VIEW_MODEL);
+
+	pPlayer->pev->weaponmodel = iStringNull;
+	return true;
+}
+
+bool BUILD_LeaveForWeapon(CBasePlayer *pPlayer, CBasePlayerItem *pNext)
+{
+	if (!pPlayer->m_bBuildMode)
+		return false;
+
+	BUILD_Leave(pPlayer, !pNext || pNext == pPlayer->m_pActiveItem);
+	return true;
+}
