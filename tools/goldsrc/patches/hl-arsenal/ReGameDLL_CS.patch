+void CPokeBallWeapon::PrimaryAttack()
+{
+	if (m_flStartThrow || m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] <= 0 || !CanFire())
+		return;
+
+	// (one Pokemon at a time)
+	if (PK_HasOut(m_pPlayer))
+	{
+		PK_CenterPrint(m_pPlayer, "Your Pokemon is already out");
+		m_flNextPrimaryAttack = GetNextAttackDelay(1.0f);
+		return;
+	}
+
+	// (the wind-up, held while the button is)
+	m_flStartThrow = gpGlobals->time;
+	m_flReleaseThrow = 0.0f;
+	SendWeaponAnim(PKBALL_PINPULL);
+	m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 0.4f;
+}
