+void BUILD_PlayerUpdateClient(CBasePlayer *pPlayer, bool bInitHUD)
+{
+	if (bInitHUD)
+	{
+		pPlayer->m_iBricksSent = -1;
+		pPlayer->m_iBuildModeSent = -1;
+		return;
+	}
+
+	if (pPlayer->IsBot())
+		return;
+
+	if (pPlayer->m_iBricks != pPlayer->m_iBricksSent || pPlayer->m_iBricksPicked > 0)
+	{
+		MESSAGE_BEGIN(MSG_ONE, gmsgBricks, nullptr, pPlayer->pev);
+			WRITE_SHORT(pPlayer->m_iBricks);
