+CBaseEntity *PK_BuyBall(CBasePlayer *pPlayer, WeaponIdType weaponID)
+{
+	if (!pPlayer->CanPlayerBuy(true) || pPlayer->IsBot())
+		return nullptr;
+
+	const PokemonInfo &info = PK_Info(weaponID - WEAPON_PK_FIRST);
+
+	if (PK_BallCarried(pPlayer))
+	{
+		PK_CenterPrint(pPlayer, "You already carry a Poke Ball");
+		return nullptr;
+	}
+
+	if (PK_HasOut(pPlayer))
+	{
+		PK_CenterPrint(pPlayer, "Your Pokemon is already out");
+		return nullptr;
+	}
+
+	if (pPlayer->m_iAccount < info.price)
+	{
+		if (g_bClientPrintEnable)
+		{
+			ClientPrint(pPlayer->pev, HUD_PRINTCENTER, "#Not_Enough_Money");
+			BlinkAccount(pPlayer);
+		}
+
+		return nullptr;
+	}
+
+	CBaseEntity *pEntity = pPlayer->GiveNamedItem(info.weaponName);
+	pPlayer->AddAccount(-info.price, RT_PLAYER_BOUGHT_SOMETHING);
+
+	if (TheTutor)
+		TheTutor->OnEvent(EVENT_PLAYER_BOUGHT_SOMETHING, pPlayer);
+
+	return pEntity;
+}
+
+void PK_OnPlayerAttack(CBasePlayer *pPlayer)
+{
+	CPokemon *pPokemon = PK_PokemonOf(pPlayer);
+	if (pPokemon)
+		pPokemon->OnOwnerAttack();
+}
+
+void PK_OnPlayerHurt(CBasePlayer *pVictim, entvars_t *pevInflictor, entvars_t *pevAttacker)
+{
+	if (!pevAttacker)
+		return;
+
+	CPokemon *pPokemon = PK_PokemonOf(pVictim);
+	if (!pPokemon)
+		return;
+
+	// (an enemy Pokemon's attack: that Pokemon, else the attacker)
+	CBaseEntity *pInflictor = pevInflictor ? CBaseEntity::Instance(pevInflictor) : nullptr;
+	CBaseEntity *pAggressor = (pInflictor && PK_IsPokemon(pInflictor->pev)) ? pInflictor : CBaseEntity::Instance(pevAttacker);
+	pPokemon->OnProvoked(pAggressor);
+}
+
+void PK_SendAllTo(CBasePlayer *pPlayer)
+{
+	if (!pPlayer || pPlayer->IsBot())
+		return;
+
+	CBaseEntity *pEntity = nullptr;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "monster_pokemon")))
+	{
+		CPokemon *pPokemon = static_cast<CPokemon *>(pEntity);
+		if (pPokemon->IsOut() && !(pEntity->pev->flags & FL_KILLME))
+			pPokemon->SendHealth(pPlayer->edict());
+	}
+}
