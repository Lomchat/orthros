+static void HL_ShowCategoryMenu(CBasePlayer *pPlayer, int iCategory)
+{
+	const HLBuyCategory &category = HL_BuyCategories[iCategory];
+	char text[512];
+	Q_snprintf(text, sizeof(text), "\\yHalf-Life arsenal: %s\\w\n\n", category.title);
