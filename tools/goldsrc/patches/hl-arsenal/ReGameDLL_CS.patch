diff --git a/regamedll/dlls/build.h b/regamedll/dlls/build.h
new file mode 100644
index 0000000..76928cd
--- /dev/null
+++ b/regamedll/dlls/build.h
@@ -0,0 +1,173 @@
+/*
+*	Half Strike r11: bricks and Fortnite-style building (wpn_shared/build.cpp; the grid: wpn_shared/build_grid.h, shared
+*	with the client's blueprint).
+*
+*	Bricks: one count per player (0..BUILD_MAX_BRICKS), set to mp_build_bricks at each new round (and at a player's
+*	first spawn). A bullet impact on the world or a brush entity (not a player, a Pokemon nor a built piece) drops a pile
+*	of BUILD_DROP bricks on the ground below it, a little towards the shooter: once per shot and surface (FireBullets3:
+*	its first brush hit; a shotgun's pellets: once per brush entity hit by the blast); an explosion near a brush surface
+*	drops one pile. Piles merge (one per BUILD_PILE_MERGE units, up to BUILD_PILE_MAX bricks), vanish after
+*	BUILD_PILE_LIFE s, at most BUILD_PILE_CAP of them (the oldest goes); humans pick them up by walking over them.
+*	Nothing drops and nothing is built with mp_build 0.
+*
+*	Building: the client asks `build_mode 0|1` (the weapon holstered, v_build in hand, the weapon's frame skipped) and
+*	`build_place <piece> <ox> <oy> <oz> <yaw> [turns]`; the server recomputes the spot (build_aim from its own view),
+*	checks it (reach, world, players and Pokemon, slot, caps, bricks) and builds (BUILD_COST bricks) or answers BuildDeny.
+*	Pieces (build_piece) grow in BUILD_GROW_TIME from a third of their health; ramps and roofs collide as steps
+*	(build_step, invisible, their damage routed to the piece). Every damage hurts them (blasts twice), except a
+*	teammate's (and its builder's own) without mp_friendlyfire; three skins by damage; destroyed: brick debris, sound,
+*	gone with its steps. All removed at each new round. Per player BUILD_PLAYER_CAP pieces, BUILD_GLOBAL_CAP in all, and
+*	BUILD_EDICT_MARGIN edicts always left free (and, for pieces, room for every pile; a new pile is not dropped past it).
+*
+*	Messages: Bricks (short count, byte picked up — 0: another change), BuildMode (byte: 1 in build mode, 2 building on),
+*	BuildDeny (byte: build_grid.h's reason).
+*/
+#pragma once
+
+#include "wpn_shared/build_grid.h"
+
+#define BUILD_DROP          5       // bricks per impact
+#define BUILD_PILE_MERGE    48.0f   // a drop this close to a pile joins it
+#define BUILD_PILE_MAX      250     // bricks in a pile at most (the Bricks message's byte)
+#define BUILD_PILE_LIFE     60.0f
+#define BUILD_PILE_CAP      120
+#define BUILD_HEALTH        300.0f  // every piece, grown
+#define BUILD_GROW_TIME     0.4f
+#define BUILD_PLAYER_CAP    60
+#define BUILD_GLOBAL_CAP    400
+// build entities (pieces and steps) at most: the client's prediction keeps MAX_PHYSENTS 600 - maxclients physents (568
+// at 32 players; map brush entities first, the rest dropped), so pieces and steps stay well under it
+#define BUILD_ENTITY_CAP    420
+#define BUILD_STEP_SEND     1024.0f // steps (invisible: prediction only) sent within that distance of a client
+#define BUILD_EDICT_MARGIN  150     // edicts left free for the game (pieces: also room for BUILD_PILE_CAP piles)
+#define BUILD_PLACE_DELAY   0.08f   // between two pieces of a player (the client's held fire: 0.12 s)
+#define BUILD_BLAST_FACTOR  2.0f    // explosions hurt pieces that much more
+
+extern cvar_t build_enabled;   // mp_build
+extern cvar_t build_start_bricks;    // mp_build_bricks
+
+extern int gmsgBricks;
+extern int gmsgBuildMode;
+extern int gmsgBuildDeny;
+
+void BUILD_RegisterCvars();
+void BUILD_RegisterMessages();
+void BUILD_Precache();
+
+// The player's state (player.cpp): spawned, killed, a new round, its frame (true: in build mode, the weapon's frame
+// skipped), its client data (the messages), a weapon picked (true: it was in build mode, the weapon is back in hand)
+void BUILD_PlayerSpawn(CBasePlayer *pPlayer);
+void BUILD_PlayerSpawned(CBasePlayer *pPlayer);   // (at its spawn spot: pieces it would be stuck in break)
+void BUILD_PlayerKilled(CBasePlayer *pPlayer);
+void BUILD_PlayerNewRound(CBasePlayer *pPlayer);
+bool BUILD_PlayerItemFrame(CBasePlayer *pPlayer);
+void BUILD_PlayerUpdateClient(CBasePlayer *pPlayer, bool bInitHUD);
+bool BUILD_LeaveForWeapon(CBasePlayer *pPlayer, CBasePlayerItem *pNext);
+inline bool BUILD_InMode(const CBasePlayer *pPlayer) { return pPlayer->m_bBuildMode; }
+
+// build_mode, build_place, build_give (client.cpp's commands): true if it was one
+bool BUILD_ClientCommand(CBasePlayer *pPlayer, const char *pcmd);
+
+// Removes every piece and pile (a new round)
+void BUILD_CleanUpMap();
+
+// Impacts: a bullet's on a surface (its trace), an explosion's (its centre and radius)
+void BUILD_BulletImpact(entvars_t *pevAttacker, const Vector &vecSrc, TraceResult *ptr);
+// (a shot of several pellets: once per brush entity, those already met in pHits[iHits], up to iMax)
+void BUILD_ImpactOnce(entvars_t *pevAttacker, const Vector &vecSrc, TraceResult *ptr, edict_t **pHits, int &iHits, int iMax);
+void BUILD_ExplosionImpact(entvars_t *pevAttacker, const Vector &vecSrc, float flRadius, float flDamage);
+
+// A piece or one of its steps
+bool BUILD_IsPiece(const edict_t *pEdict);
+inline bool BUILD_IsPiece(CBaseEntity *pEntity) { return pEntity && BUILD_IsPiece(pEntity->edict()); }
+
+// A line as UTIL_TraceLine's ignore_monsters (the world, brush entities) that stops on built pieces too
+void BUILD_TraceLineSolid(const Vector &vecStart, const Vector &vecEnd, edict_t *pIgnore, TraceResult *ptr);
+
+// Whether a piece (a ramp's or a roof's own box is only its first step) is seen through one of its other steps
+bool BUILD_PieceVisible(edict_t *pEdict, unsigned char *pSet);
+
+// The built piece (its own entity, a step's routed to it) a line from vecSrc to vecEnd meets first, through players and
+// monsters (pIgnore: skipped too), before the world; null: none
+CBaseEntity *BUILD_PieceOnLine(const Vector &vecSrc, const Vector &vecEnd, edict_t *pIgnore);
+
+// A blast's distance to an entity (a piece: its nearest point) and whether a piece shields the entity from it
+float BUILD_BlastDistance(CBaseEntity *pEntity, const Vector &vecSrc, float flDefault);
+bool BUILD_BlastShielded(CBaseEntity *pEntity, const Vector &vecSrc, const Vector &vecSpot, edict_t *pInflictor);
+
+class CBuildPiece: public CBaseEntity
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+	virtual int ObjectCaps() { return FCAP_DONT_SAVE; }
+	virtual int Classify() { return CLASS_NONE; }
+	virtual int BloodColor() { return DONT_BLEED; }
+	virtual BOOL IsAlive() { return FALSE; }
+	virtual void TraceAttack(entvars_t *pevAttacker, float flDamage, Vector vecDir, TraceResult *ptr, int bitsDamageType);
+	virtual BOOL TakeDamage(entvars_t *pevInflictor, entvars_t *pevAttacker, float flDamage, int bitsDamageType);
+
+	static CBuildPiece *Create(CBasePlayer *pOwner, const build_spot_t &spot);
+	void EXPORT GrowThink();
+
+	void Destroy();
+	void Vanish();               // removed at once with its steps (a new round)
+	bool IsOwnedBy(CBasePlayer *pPlayer) const { return m_hOwner.IsValid() && m_hOwner.Get() == pPlayer->edict(); }
+	int Piece() const { return m_iPiece; }
+	int Yaw() const { return m_iYaw; }
+	int Entities() const { return 1 + m_iNumSteps; }
+	bool StepVisible(unsigned char *pSet) const;
+
+	void Chips(const Vector &vecPos, const Vector &vecDir);   // a hit's brick chips and sound
+
+private:
+	float GrownFraction() const;
+	void UpdateHealth();
+
+	EntityHandle<CBasePlayer> m_hOwner;
+	int m_iTeam;
+	int m_iPiece;
+	int m_iYaw;
+	float m_flBornTime;
+	float m_flDamage;            // taken so far
+	bool m_bGrowing;
+	bool m_bDestroyed;
+	EHANDLE m_hSteps[8];
+	int m_iNumSteps;
+	float m_flLastHitTime;       // (a blast: once per inflictor and frame, through every step of a ramp)
+	edict_t *m_pLastInflictor;
+	float m_flLastHitDamage;
+	float m_flNextHitSound;
+	float m_flNextChips;
+};
+
+class CBuildStep: public CBaseEntity
+{
+public:
+	virtual void Spawn();
+	virtual int ObjectCaps() { return FCAP_DONT_SAVE; }
+	virtual int Classify() { return CLASS_NONE; }
+	virtual int BloodColor() { return DONT_BLEED; }
+	virtual BOOL IsAlive() { return FALSE; }
+	virtual void TraceAttack(entvars_t *pevAttacker, float flDamage, Vector vecDir, TraceResult *ptr, int bitsDamageType);
+	virtual BOOL TakeDamage(entvars_t *pevInflictor, entvars_t *pevAttacker, float flDamage, int bitsDamageType);
+
+	CBuildPiece *Parent() const;
+	EHANDLE m_hParent;
+};
+
+class CBrickPile: public CBaseEntity
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+	virtual int ObjectCaps() { return FCAP_DONT_SAVE; }
+	virtual void Touch(CBaseEntity *pOther);
+	void EXPORT ExpireThink();
+
+	static void Drop(const Vector &vecGround, int iAmount);
+	void SetAmount(int iAmount);
+
+	int m_iAmount;
+	float m_flBornTime;
+};
