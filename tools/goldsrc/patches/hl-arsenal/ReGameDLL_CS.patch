+
+// (whether charges its holder threw are lying around)
+bool CHLSatchel::HasCharges()
+{
+	if (!m_pPlayer)
+		return false;
+
+	CBaseEntity *pCharge = nullptr;
+	while ((pCharge = UTIL_FindEntityByClassname(pCharge, "monster_satchel")))
+	{
+		if (pCharge->pev->owner == m_pPlayer->edict() && !(pCharge->pev->flags & FL_KILLME))
+			return true;
+	}
+
+	return false;
+}
+
+int CHLSatchel::AddToPlayer(CBasePlayer *pPlayer)
+{
+	int bResult = CBasePlayerWeapon::AddToPlayer(pPlayer);
+	m_chargeReady = HasCharges() ? SATCHEL_READY : SATCHEL_IDLE;
+	return bResult;
+}
+
+BOOL CHLSatchel::CanDeploy()
+{
+	return m_pPlayer->m_rgAmmo[PrimaryAmmoIndex()] > 0 || HasCharges();
+}
+
+BOOL CHLSatchel::Deploy()
+{
+	m_chargeReady = HasCharges() ? SATCHEL_READY : SATCHEL_IDLE;
+	m_pPlayer->m_flNextAttack = UTIL_WeaponTimeBase() + 1.0f;
+
+	BOOL result;
+	if (m_chargeReady == SATCHEL_READY)
+		result = DefaultDeploy("models/v_satchel_radio.mdl", "models/p_satchel_radio.mdl", SATCHEL_RADIO_DRAW, "c4", 0);
+	else
+		result = DefaultDeploy("models/v_satchel.mdl", "models/p_satchel.mdl", SATCHEL_DRAW, "grenade", 0);
+
+	if (result)
+		m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 2.0f;
+
+	return result;
+}
+
+void CHLSatchel::Holster(int skiplocal)
+{
+	m_pPlayer->m_flNextAttack = UTIL_WeaponTimeBase() + 0.5f;
+	EMIT_SOUND(ENT(m_pPlayer->pev), CHAN_WEAPON, "common/null.wav", VOL_NORM, ATTN_NORM);
+
+	if (!m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] && !HasCharges())
+	{
+		DestroyItem();
+		return;
+	}
+
+	SendWeaponAnim(m_chargeReady == SATCHEL_READY ? SATCHEL_RADIO_HOLSTER : SATCHEL_DROP);
+}
+
+// (as Half-Life's: the click sets off the charges once one is thrown, or throws; the right click throws another)
+void CHLSatchel::PrimaryAttack()
+{
+	if (m_chargeReady == SATCHEL_READY)
+		Detonate();
+	else if (m_chargeReady != SATCHEL_RELOAD)
+		Throw();
+}
+
+void CHLSatchel::SecondaryAttack()
+{
+	if (m_chargeReady != SATCHEL_RELOAD)
+		Throw();
+}
+
+// (the radio sets off every charge of its holder)
+void CHLSatchel::Detonate()
+{
+	if (m_chargeReady != SATCHEL_READY)
+		return;
+
+	SendWeaponAnim(SATCHEL_RADIO_FIRE);
+
+	edict_t *pPlayer = m_pPlayer->edict();
+	CBaseEntity *pCharge = nullptr;
+	while ((pCharge = UTIL_FindEntityByClassname(pCharge, "monster_satchel")))
+	{
+		if (pCharge->pev->owner == pPlayer)
+			pCharge->Use(m_pPlayer, m_pPlayer, USE_ON, 0);
+	}
+
+	m_chargeReady = SATCHEL_RELOAD;
+	m_flNextPrimaryAttack = GetNextAttackDelay(0.5f);
+	m_flNextSecondaryAttack = UTIL_WeaponTimeBase() + 0.5f;
+	m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + 0.5f;
+}
+
+void CHLSatchel::Throw()
+{
+	if (!m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType])
+		return;
+
+	UTIL_MakeVectors(m_pPlayer->pev->v_angle);
+	Vector vecThrow = gpGlobals->v_forward * 274 + m_pPlayer->pev->velocity;
+
+	CHLSatchelCharge *pCharge = GetClassPtr<CCSAnimating>((CHLSatchelCharge *)nullptr);
+	UTIL_SetOrigin(pCharge->pev, m_pPlayer->pev->origin);
+	pCharge->pev->owner = m_pPlayer->edict();
+	pCharge->Spawn();
+	pCharge->pev->velocity = vecThrow;
+	pCharge->pev->avelocity.y = 400;
+
+	HL_SetViewModels(m_pPlayer, "models/v_satchel_radio.mdl", "models/p_satchel_radio.mdl");
+	Q_strlcpy(m_pPlayer->m_szAnimExtention, "c4");
+	SendWeaponAnim(SATCHEL_RADIO_DRAW);
+	m_pPlayer->SetAnimation(PLAYER_ATTACK1);
+
+	m_chargeReady = SATCHEL_READY;
+	m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType]--;
+	m_flNextPrimaryAttack = GetNextAttackDelay(1.0f);
+	m_flNextSecondaryAttack = UTIL_WeaponTimeBase() + 0.5f;
+}
+
+void CHLSatchel::WeaponIdle()
+{
+	if (m_flTimeWeaponIdle > UTIL_WeaponTimeBase())
+		return;
+
+	switch (m_chargeReady)
+	{
+		case SATCHEL_IDLE:
+			SendWeaponAnim(SATCHEL_FIDGET1);
+			break;
+
+		case SATCHEL_READY:
+			SendWeaponAnim(SATCHEL_RADIO_FIDGET1);
+			break;
+
+		case SATCHEL_RELOAD:
+		{
+			// (set off: the next charge, or none left)
+			if (!m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType])
+			{
+				m_chargeReady = SATCHEL_IDLE;
+				RetireWeapon();
+				return;
+			}
+
+			HL_SetViewModels(m_pPlayer, "models/v_satchel.mdl", "models/p_satchel.mdl");
+			Q_strlcpy(m_pPlayer->m_szAnimExtention, "grenade");
+			SendWeaponAnim(SATCHEL_DRAW);
+
+			m_flNextPrimaryAttack = GetNextAttackDelay(0.5f);
+			m_flNextSecondaryAttack = UTIL_WeaponTimeBase() + 0.5f;
+			m_chargeReady = SATCHEL_IDLE;
+			break;
+		}
+	}
+
+	m_flTimeWeaponIdle = UTIL_WeaponTimeBase() + UTIL_SharedRandomFloat(m_pPlayer->random_seed, 10.0f, 15.0f);
+}
