+// ---------------------------------------------------------------------------------------------------------------------
+// Buying, and the round restart
+
+CBaseEntity *HL_BuyEquipment(CBasePlayer *pPlayer, WeaponIdType weaponID)
+{
+	if (!pPlayer->CanPlayerBuy(true))
+		return nullptr;
+
+	WeaponInfoStruct *info = GetWeaponInfo(weaponID);
+	if (!info || !info->entityName)
+		return nullptr;
+
+	// (the crowbar once; the others as many as can be carried)
+	if (!info->ammoName2)
+	{
+		if (pPlayer->HasNamedPlayerItem(info->entityName))
+		{
+			if (g_bClientPrintEnable)
+				ClientPrint(pPlayer->pev, HUD_PRINTCENTER, "#Cstrike_Already_Own_Weapon");
+
+			return nullptr;
+		}
+	}
+	else
+	{
+		int iAmmo = CBasePlayer::GetAmmoIndex(info->ammoName2);
+		if (iAmmo >= 0 && pPlayer->m_rgAmmo[iAmmo] >= info->maxRounds)
+		{
+			if (g_bClientPrintEnable)
+				ClientPrint(pPlayer->pev, HUD_PRINTCENTER, "#Cannot_Carry_Anymore");
+
+			return nullptr;
+		}
+	}
+
+	if (pPlayer->m_iAccount < info->cost)
+	{
+		if (g_bClientPrintEnable)
+		{
+			ClientPrint(pPlayer->pev, HUD_PRINTCENTER, "#Not_Enough_Money");
+			BlinkAccount(pPlayer);
+		}
+
+		return nullptr;
+	}
+
+	CBaseEntity *pEntity = pPlayer->GiveNamedItem(info->entityName);
+	pPlayer->AddAccount(-info->cost, RT_PLAYER_BOUGHT_SOMETHING);
+
+	if (TheTutor)
+		TheTutor->OnEvent(EVENT_PLAYER_BOUGHT_SOMETHING, pPlayer);
+
+	return pEntity;
+}
+
+// (the MP5's: for its owner only)
+bool HL_BuyARGrenade(CBasePlayer *pPlayer)
+{
+	if (!pPlayer->CanPlayerBuy(true))
+		return false;
+
+	if (!pPlayer->HasNamedPlayerItem("weapon_9mmAR"))
+	{
+		if (g_bClientPrintEnable)
+			ClientPrint(pPlayer->pev, HUD_PRINTCENTER, "The MP5 grenades need the MP5");
+
+		return false;
+	}
+
+	if (pPlayer->AmmoInventory(CBasePlayer::GetAmmoIndex("ARgrenades")) >= HL_ARGRENADE_MAX_CARRY)
+	{
+		if (g_bClientPrintEnable)
+			ClientPrint(pPlayer->pev, HUD_PRINTCENTER, "#Cannot_Carry_Anymore");
+
+		return false;
+	}
+
+	if (pPlayer->m_iAccount < HL_ARGRENADE_PRICE)
+	{
+		if (g_bClientPrintEnable)
+		{
+			ClientPrint(pPlayer->pev, HUD_PRINTCENTER, "#Not_Enough_Money");
+			BlinkAccount(pPlayer);
+		}
+
+		return false;
+	}
+
+	pPlayer->GiveAmmo(1, "ARgrenades", HL_ARGRENADE_MAX_CARRY);
+	EMIT_SOUND(ENT(pPlayer->pev), CHAN_ITEM, "items/9mmclip1.wav", VOL_NORM, ATTN_NORM);
+	pPlayer->AddAccount(-HL_ARGRENADE_PRICE, RT_PLAYER_BOUGHT_SOMETHING);
+	return true;
+}
+
+void HL_CleanUpMap()
+{
+	CBaseEntity *pEntity = nullptr;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "rpg_rocket")))
+	{
+		static_cast<CHLRpgRocket *>(pEntity)->Forget();
+		UTIL_Remove(pEntity);
+	}
+
+	pEntity = nullptr;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "monster_tripmine")))
+	{
+		static_cast<CHLTripmineGrenade *>(pEntity)->KillBeam();
+		UTIL_Remove(pEntity);
+	}
+
+	UTIL_RemoveOther("hl_grenade");
+	UTIL_RemoveOther("monster_satchel");
+	UTIL_RemoveOther("monster_snark");
+	UTIL_RemoveOther("hornet");
+	UTIL_RemoveOther("crossbow_bolt");
+}
