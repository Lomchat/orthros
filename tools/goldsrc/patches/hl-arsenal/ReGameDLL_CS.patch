+		WRITE_BYTE(TE_BEAMFOLLOW);
+		WRITE_SHORT(entindex());
+		WRITE_SHORT(m_iTrail);
+		WRITE_BYTE(10); // life
+		WRITE_BYTE(2);  // width
+		if (m_iHornetType == HL_HORNET_TYPE_RED)
+		{
+			WRITE_BYTE(179); // r, g, b
+			WRITE_BYTE(39);
+			WRITE_BYTE(14);
+		}
+		else
+		{
+			WRITE_BYTE(255);
+			WRITE_BYTE(128);
+			WRITE_BYTE(0);
+		}
+		WRITE_BYTE(128); // brightness
+	MESSAGE_END();
+}
