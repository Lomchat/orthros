+LINK_ENTITY_TO_CLASS(build_piece, CBuildPiece, CCSEntity)
+LINK_ENTITY_TO_CLASS(build_step, CBuildStep, CCSEntity)
+
+void CBuildPiece::Precache()
+{
+	for (int i = 0; i < BUILD_PIECES; i++)
+		PRECACHE_MODEL(BUILD_ModelsOptional[i]);
+}
+
+void CBuildPiece::Spawn()
+{
+	Precache();
+	MAKE_STRING_CLASS("build_piece", pev);
+	pev->movetype = MOVETYPE_NONE;
+	pev->solid = SOLID_BBOX;
+	pev->takedamage = DAMAGE_YES;
+	pev->max_health = BUILD_HEALTH;
+	pev->health = BUILD_HEALTH / 3.0f;
+}
+
+CBuildPiece *CBuildPiece::Create(CBasePlayer *pOwner, const build_spot_t &spot)
+{
+	CBuildPiece *pPiece = GetClassPtr<CCSEntity>((CBuildPiece *)nullptr);
+	if (!pPiece)
+		return nullptr;
+
+	pPiece->Spawn();
+	entvars_t *pev = pPiece->pev;
+
+	pPiece->m_hOwner = pOwner;
+	pPiece->m_iTeam = pOwner ? pOwner->m_iTeam : UNASSIGNED;
+	pPiece->m_iPiece = spot.piece;
+	pPiece->m_iYaw = spot.yaw;
+	pPiece->m_flBornTime = gpGlobals->time;
+	pPiece->m_flDamage = 0;
+	pPiece->m_bGrowing = true;
+	pPiece->m_bDestroyed = false;
+	pPiece->m_iNumSteps = 0;
+	pPiece->m_flLastHitTime = -1;
+	pPiece->m_pLastInflictor = nullptr;
+	pPiece->m_flLastHitDamage = 0;
+	pPiece->m_flNextHitSound = 0;
+	pPiece->m_flNextChips = 0;
+
+	const Vector vecOrigin(spot.origin[0], spot.origin[1], spot.origin[2]);
+	SET_MODEL(ENT(pev), BUILD_Models[spot.piece]);
+	pev->angles = Vector(0, float(spot.yaw), 0);
+	pev->iuser1 = spot.piece;
+	pev->skin = 0;
+	UTIL_SetOrigin(pev, vecOrigin);
+
+	// (its own box: the first step — the whole box for a wall or a floor)
+	float lo[3], hi[3];
+	build_step_box(&spot, 0, lo, hi);
+	UTIL_SetSize(pev, Vector(lo[0], lo[1], lo[2]) - vecOrigin, Vector(hi[0], hi[1], hi[2]) - vecOrigin);
+
+	// (growing: see-through, then whole; the model's "build" sequence if it has one)
+	pev->rendermode = kRenderTransTexture;
+	pev->renderamt = 90;
+	studiohdr_t *pStudio = (studiohdr_t *)GET_MODEL_PTR(ENT(pev));
+	if (pStudio && pStudio->numseq > 1)
+	{
+		pev->sequence = 1;
+		pev->frame = 0;
+		pev->framerate = 1.0f;
+		pev->animtime = gpGlobals->time;
+	}
+
+	// (the invisible steps of a ramp or a roof, their damage routed to it)
+	const int n = Q_min(build_steps(spot.piece), int(ARRAYSIZE(pPiece->m_hSteps)) + 1);
+	for (int i = 1; i < n; i++)
+	{
+		CBuildStep *pStep = GetClassPtr<CCSEntity>((CBuildStep *)nullptr);
+		if (!pStep)
+			break;
+
+		pStep->Spawn();
+		pStep->m_hParent = pPiece;
+		SET_MODEL(ENT(pStep->pev), BUILD_Models[spot.piece]);
+		pStep->pev->effects |= EF_NODRAW;
+		pStep->pev->angles = pev->angles;
+		UTIL_SetOrigin(pStep->pev, vecOrigin);
+		build_step_box(&spot, i, lo, hi);
+		UTIL_SetSize(pStep->pev, Vector(lo[0], lo[1], lo[2]) - vecOrigin, Vector(hi[0], hi[1], hi[2]) - vecOrigin);
+		pPiece->m_hSteps[pPiece->m_iNumSteps++] = pStep;
+	}
+
+	EMIT_SOUND_DYN(ENT(pev), CHAN_ITEM, "build/place.wav", VOL_NORM, ATTN_NORM, 0, PITCH_NORM + RANDOM_LONG(-3, 3));
+	EMIT_SOUND_DYN(ENT(pev), CHAN_BODY, "build/build_loop.wav", 0.8f, ATTN_NORM, 0, PITCH_NORM);
+
+	pPiece->UpdateHealth();
+	pPiece->SetThink(&CBuildPiece::GrowThink);
+	pev->nextthink = gpGlobals->time + 0.05f;
+	return pPiece;
+}
+
+float CBuildPiece::GrownFraction() const
+{
+	return clamp(float((gpGlobals->time - m_flBornTime) / BUILD_GROW_TIME), 0.0f, 1.0f);
+}
+
+void CBuildPiece::UpdateHealth()
+{
+	const float f = m_bGrowing ? GrownFraction() : 1.0f;
+	pev->health = BUILD_HEALTH * (1.0f + 2.0f * f) / 3.0f - m_flDamage;
+
+	// (its cracks by the damage taken)
+	const float flTaken = m_flDamage / BUILD_HEALTH;
+	pev->skin = flTaken < 1.0f / 3.0f ? 0 : flTaken < 2.0f / 3.0f ? 1 : 2;
+}
+
+void CBuildPiece::GrowThink()
+{
+	if (m_bDestroyed)
+		return;
+
+	const float f = GrownFraction();
+	pev->renderamt = 90 + int(165 * f);
+	UpdateHealth();
+
+	if (f >= 1.0f)
+	{
+		m_bGrowing = false;
+		pev->rendermode = kRenderNormal;
+		pev->renderamt = 255;
+		pev->sequence = 0;
+		pev->framerate = 0;
+		pev->frame = 0;
+		pev->animtime = gpGlobals->time;
+		UpdateHealth();
+		SetThink(nullptr);
+		return;
+	}
+
+	pev->nextthink = gpGlobals->time + 0.05f;
+}
+
+void CBuildPiece::Chips(const Vector &vecPos, const Vector &vecDir)
+{
+	if (gpGlobals->time >= m_flNextChips && s_iGibsModel)
+	{
+		m_flNextChips = gpGlobals->time + 0.1f;
+		Vector vecVel = vecDir * -60.0f;
+		MESSAGE_BEGIN(MSG_PVS, SVC_TEMPENTITY, vecPos);
+			WRITE_BYTE(TE_BREAKMODEL);
+			WRITE_COORD(vecPos.x);
+			WRITE_COORD(vecPos.y);
+			WRITE_COORD(vecPos.z);
+			WRITE_COORD(4);
+			WRITE_COORD(4);
+			WRITE_COORD(4);
+			WRITE_COORD(vecVel.x);
+			WRITE_COORD(vecVel.y);
+			WRITE_COORD(vecVel.z);
+			WRITE_BYTE(6);    // random velocity (x10)
+			WRITE_SHORT(s_iGibsModel);
+			WRITE_BYTE(2);    // count
+			WRITE_BYTE(8);    // life (x0.1 s)
+			WRITE_BYTE(BREAK_CONCRETE);
+		MESSAGE_END();
+	}
+
+	if (gpGlobals->time >= m_flNextHitSound)
+	{
+		m_flNextHitSound = gpGlobals->time + 0.15f;
+		static const char *const sounds[] = { "build/hit1.wav", "build/hit2.wav", "build/hit3.wav" };
+		EMIT_SOUND_DYN(ENT(pev), CHAN_BODY, sounds[RANDOM_LONG(0, 2)], 0.7f, ATTN_NORM, 0, PITCH_NORM + RANDOM_LONG(-5, 5));
+	}
+}
+
+void CBuildPiece::TraceAttack(entvars_t *pevAttacker, float flDamage, Vector vecDir, TraceResult *ptr, int bitsDamageType)
+{
+	if (m_bDestroyed)
+		return;
+
+	if (ptr)
+		Chips(ptr->vecEndPos - vecDir * 2.0f, vecDir);
+
+	CBaseEntity::TraceAttack(pevAttacker, flDamage, vecDir, ptr, bitsDamageType);
+}
+
+BOOL CBuildPiece::TakeDamage(entvars_t *pevInflictor, entvars_t *pevAttacker, float flDamage, int bitsDamageType)
+{
+	if (m_bDestroyed || pev->takedamage == DAMAGE_NO || flDamage <= 0.0f)
+		return FALSE;
+
+	// (a teammate's only with friendly fire; its builder may always break their own — the owner's choice: a misplaced
+	// piece is shot away)
+	CBaseEntity *pAttacker = pevAttacker ? CBaseEntity::Instance(pevAttacker) : nullptr;
+	if (pAttacker && pAttacker->IsPlayer() && friendlyfire.value == 0.0f)
+	{
+		CBasePlayer *pPlayer = static_cast<CBasePlayer *>(pAttacker);
+		if (!IsOwnedBy(pPlayer) && !CSGameRules()->IsFreeForAll() && m_iTeam != UNASSIGNED && pPlayer->m_iTeam == m_iTeam)
+			return FALSE;
+	}
+
+	if (bitsDamageType & (DMG_BLAST | DMG_EXPLOSION))
+		flDamage *= BUILD_BLAST_FACTOR;
+
+	// (an area damage meets a ramp's every step: once per inflictor and frame, the most of them)
+	if (!(bitsDamageType & (DMG_BULLET | DMG_CLUB | DMG_SLASH)) && pevInflictor)
+	{
+		if (m_flLastHitTime == gpGlobals->time && m_pLastInflictor == ENT(pevInflictor))
+		{
+			if (flDamage <= m_flLastHitDamage)
+				return FALSE;
+
+			float flMore = flDamage - m_flLastHitDamage;
+			m_flLastHitDamage = flDamage;
+			flDamage = flMore;
+		}
+		else
+		{
+			m_flLastHitTime = gpGlobals->time;
+			m_pLastInflictor = ENT(pevInflictor);
+			m_flLastHitDamage = flDamage;
+		}
+	}
+
+	m_flDamage += flDamage;
+	UpdateHealth();
+
+	if (!(bitsDamageType & (DMG_BULLET | DMG_CLUB | DMG_SLASH)) && gpGlobals->time >= m_flNextHitSound)
+	{
+		m_flNextHitSound = gpGlobals->time + 0.15f;
+		static const char *const sounds[] = { "build/hit1.wav", "build/hit2.wav", "build/hit3.wav" };
+		EMIT_SOUND_DYN(ENT(pev), CHAN_BODY, sounds[RANDOM_LONG(0, 2)], 0.8f, ATTN_NORM, 0, PITCH_NORM + RANDOM_LONG(-5, 5));
+	}
+
+	if (pev->health <= 0.0f)
+		Destroy();
+
+	return TRUE;
+}
+
+// What rested on a piece (a pile, a dropped weapon) falls with it
+static void BUILD_WakeResting(const Vector &vecMins, const Vector &vecMaxs, CBuildPiece *pPiece, EHANDLE *pSteps, int iNumSteps)
+{
+	CBaseEntity *pList[64];
+	int n = UTIL_EntitiesInBox(pList, ARRAYSIZE(pList), vecMins - Vector(1, 1, 1), vecMaxs + Vector(1, 1, 24), 0);
+	for (int i = 0; i < n; i++)
+	{
+		entvars_t *pevOther = pList[i]->pev;
+		if (!pevOther->groundentity || (pevOther->flags & FL_CLIENT))
+			continue;
+
+		bool bOurs = (pevOther->groundentity == pPiece->edict());
+		for (int k = 0; !bOurs && k < iNumSteps; k++)
+			bOurs = pSteps[k].IsValid() && pevOther->groundentity == pSteps[k].Get();
+
+		if (!bOurs)
+			continue;
+
+		pevOther->flags &= ~FL_ONGROUND;
+		pevOther->groundentity = nullptr;
+	}
+}
+
+void CBuildPiece::Destroy()
+{
+	if (m_bDestroyed)
+		return;
+
+	m_bDestroyed = true;
+
+	build_spot_t spot = {};
+	spot.piece = m_iPiece;
+	spot.yaw = m_iYaw;
+	spot.origin[0] = pev->origin.x;
+	spot.origin[1] = pev->origin.y;
+	spot.origin[2] = pev->origin.z;
+	build_box(m_iPiece, m_iYaw, spot.origin, spot.mins, spot.maxs);
+	Vector vecMins(spot.mins[0], spot.mins[1], spot.mins[2]), vecMaxs(spot.maxs[0], spot.maxs[1], spot.maxs[2]);
+	Vector vecCenter = (vecMins + vecMaxs) * 0.5f, vecSize = vecMaxs - vecMins;
+
+	if (s_iGibsModel)
+	{
+		static const int counts[BUILD_PIECES] = { 14, 12, 16, 12 };
+		MESSAGE_BEGIN(MSG_PVS, SVC_TEMPENTITY, vecCenter);
+			WRITE_BYTE(TE_BREAKMODEL);
+			WRITE_COORD(vecCenter.x);
+			WRITE_COORD(vecCenter.y);
+			WRITE_COORD(vecCenter.z);
+			WRITE_COORD(vecSize.x);
+			WRITE_COORD(vecSize.y);
+			WRITE_COORD(vecSize.z);
+			WRITE_COORD(0);
+			WRITE_COORD(0);
+			WRITE_COORD(40);
+			WRITE_BYTE(12);   // random velocity (x10)
+			WRITE_SHORT(s_iGibsModel);
+			WRITE_BYTE(counts[clamp(m_iPiece, 0, BUILD_PIECES - 1)]);
+			WRITE_BYTE(25);   // life (x0.1 s)
+			WRITE_BYTE(BREAK_CONCRETE);
+		MESSAGE_END();
+	}
+
+	// (the sound from a point entity's place: the piece itself is gone this frame)
+	UTIL_EmitAmbientSound(ENT(0), vecCenter, RANDOM_LONG(0, 1) ? "build/break1.wav" : "build/break2.wav", VOL_NORM, ATTN_NORM, 0, PITCH_NORM + RANDOM_LONG(-5, 5));
+
+	BUILD_WakeResting(vecMins, vecMaxs, this, m_hSteps, m_iNumSteps);
+	Vanish();
+}
+
+void CBuildPiece::Vanish()
+{
+	m_bDestroyed = true;
+	pev->takedamage = DAMAGE_NO;
+
+	for (int i = 0; i < m_iNumSteps; i++)
+	{
+		CBaseEntity *pStep = m_hSteps[i];
+		if (!pStep)
+			continue;
+
+		pStep->pev->solid = SOLID_NOT;
+		pStep->pev->takedamage = DAMAGE_NO;
+		UTIL_SetOrigin(pStep->pev, pStep->pev->origin);
+		UTIL_Remove(pStep);
+	}
+
+	m_iNumSteps = 0;
+	pev->solid = SOLID_NOT;
+	UTIL_SetOrigin(pev, pev->origin);
+	SetThink(nullptr);
+	UTIL_Remove(this);
+}
+
+void CBuildStep::Spawn()
+{
+	MAKE_STRING_CLASS("build_step", pev);
+	pev->movetype = MOVETYPE_NONE;
+	pev->solid = SOLID_BBOX;
+	pev->takedamage = DAMAGE_YES;
+	pev->health = 1;
+}
+
+CBuildPiece *CBuildStep::Parent() const
+{
+	CBaseEntity *pParent = m_hParent;
