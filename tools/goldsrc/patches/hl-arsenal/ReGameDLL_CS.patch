+
+// Where a flash of this half-size is drawn near pos: a sprite is depth-tested, so the floor under it would cut it flat
+// (and a ceiling over it): its centre at least its half-size (and flMinHeight) above the floor, under the ceiling when
+// there is room for it
+static Vector PK_FlashSpot(const Vector &pos, float flHalf, float flMinHeight, edict_t *pIgnore)
+{
+	float flLift = Q_max(flHalf, flMinHeight);
+	Vector vecSpot = pos;
+
+	TraceResult tr;
+	UTIL_TraceLine(pos + Vector(0, 0, 1), pos - Vector(0, 0, flLift), ignore_monsters, pIgnore, &tr);
+	if (tr.fStartSolid)
+		return pos;
+
+	float flFloor = (tr.flFraction < 1.0f) ? tr.vecEndPos.z : pos.z - flLift;
+	vecSpot.z = Q_max(pos.z, flFloor + flLift);
+
+	UTIL_TraceLine(Vector(pos.x, pos.y, flFloor + 1.0f), Vector(pos.x, pos.y, vecSpot.z + flHalf), ignore_monsters, pIgnore, &tr);
+	if (tr.flFraction < 1.0f && !tr.fStartSolid)
+		vecSpot.z = Q_max(flFloor + Q_min(flLift, 0.5f * (tr.vecEndPos.z - flFloor)), Q_min(vecSpot.z, tr.vecEndPos.z - flHalf));
+
+	return vecSpot;
+}
