+	if (pOther->pev->takedamage)
+	{
+		TraceResult tr = UTIL_GetGlobalTrace();
+		entvars_t *pevOwner = VARS(pev->owner);
+
+		ClearMultiDamage();
+		pOther->TraceAttack(pevOwner, HL_CROSSBOW_BOLT_DAMAGE, pev->velocity.Normalize(), &tr, DMG_BULLET | DMG_NEVERGIB);
+		ApplyMultiDamage(pev, pevOwner);
+
+		pev->velocity = Vector(0, 0, 0);
+		EMIT_SOUND(ENT(pev), CHAN_BODY, RANDOM_LONG(0, 1) ? "weapons/xbow_hitbod2.wav" : "weapons/xbow_hitbod1.wav", VOL_NORM, ATTN_NORM);
+	}
+	else
+	{
+		EMIT_SOUND_DYN(ENT(pev), CHAN_BODY, "weapons/xbow_hit1.wav", RANDOM_FLOAT(0.95f, 1.0f), ATTN_NORM, 0, 98 + RANDOM_LONG(0, 7));
+
+		if (UTIL_PointContents(pev->origin) != CONTENTS_WATER)
+			UTIL_Sparks(pev->origin);
+	}
+
+	// (the multiplayer bolt explodes where it lands)
+	SetThink(&CHLCrossbowBolt::ExplodeThink);
+	pev->nextthink = gpGlobals->time + 0.1f;
+}
+
+void CHLCrossbowBolt::BubbleThink()
+{
+	pev->nextthink = gpGlobals->time + 0.1f;
+
+	if (pev->waterlevel == 0)
+		return;
+
+	UTIL_BubbleTrail(pev->origin - pev->velocity * 0.1f, pev->origin, 1);
+}
+
+void CHLCrossbowBolt::ExplodeThink()
+{
+	entvars_t *pevOwner = pev->owner ? VARS(pev->owner) : nullptr;
+	HL_Explosion(this, nullptr, pevOwner, HL_CROSSBOW_BOLT_BLAST, 128, 10);
+	UTIL_Remove(this);
+}
