+// ---------------------------------------------------------------------------------------------------------------------
+// The ball thrown
+
+LINK_ENTITY_TO_CLASS(pokeball, CPokeBall, CCSAnimating)
+
+void CPokeBall::Spawn()
+{
+	Precache();
+	MAKE_STRING_CLASS("pokeball", pev);
+	pev->movetype = MOVETYPE_BOUNCE;
+	pev->solid = SOLID_BBOX;
+
+	SET_MODEL(edict(), "models/pokemon/w_pokeball.mdl");
+	UTIL_SetSize(pev, g_vecZero, g_vecZero);
+
+	pev->gravity = 0.6f;
+	pev->friction = 0.6f;
+	m_iSpecies = PK_PIKACHU;
+	m_iTeam = UNASSIGNED;
+	m_flOpenTime = gpGlobals->time + PK_BALL_OPEN_TIME;
+	m_flReleaseTime = 0.0f;
+	m_flRemoveTime = 0.0f;
+	m_flNextBounceSound = 0.0f;
+	m_flYaw = 0.0f;
+	m_bLanded = false;
+	m_bResting = false;
+	m_bOpened = false;
+	m_bReleased = false;
+}
+
+void CPokeBall::Precache()
+{
+	PRECACHE_MODEL("models/pokemon/w_pokeball.mdl");
+	PRECACHE_SOUND("pokemon/ball_bounce.wav");
+	PRECACHE_SOUND("pokemon/ball_open.wav");
+	PRECACHE_SOUND("pokemon/ball_return.wav");
+	s_iSprFlash = PRECACHE_MODEL("sprites/pokemon/flash.spr");
+}
+
+// (w_pokeball: 0 idle, 1 wobble, 2 open — origin on the floor under the ball —, 3 fly — origin at its centre)
+void CPokeBall::SetSequenceByName(const char *pszName, int iDefault)
+{
+	int seq = LookupSequence(pszName);
+	pev->sequence = seq >= 0 ? seq : iDefault;
+	pev->frame = 0;
+	ResetSequenceInfo();
+}
+
+CPokeBall *CPokeBall::Launch(CBasePlayer *pOwner, int iSpecies, const Vector &vecSrc, const Vector &vecVelocity)
+{
+	CPokeBall *pBall = GetClassPtr<CCSAnimating>((CPokeBall *)nullptr);
+	pBall->Spawn();
+	UTIL_SetOrigin(pBall->pev, vecSrc);
+	pBall->pev->velocity = vecVelocity;
+	pBall->pev->angles = Vector(0, pOwner->pev->v_angle.y, 0);
+	pBall->pev->avelocity = Vector(-540, 0, 0); // (rolls forward)
+	pBall->pev->owner = pOwner->edict();         // (does not hit its thrower)
+	pBall->pev->skin = iSpecies;
+
+	pBall->m_hOwner = pOwner;
+	pBall->m_iSpecies = iSpecies;
+	pBall->m_iTeam = pOwner->m_iTeam;
+
+	// (tumbles about its centre in the air)
+	pBall->SetSequenceByName("fly", 3);
+
+	pBall->SetTouch(&CPokeBall::BounceTouch);
+	pBall->SetThink(&CPokeBall::FlyThink);
+	pBall->pev->nextthink = gpGlobals->time + 0.1f;
+	return pBall;
+}
+
+void CPokeBall::BounceTouch(CBaseEntity *pOther)
+{
+	if (pOther->edict() == pev->owner)
+		return;
+
+	float flSpeed = pev->velocity.Length();
+	if (flSpeed > 60.0f && gpGlobals->time >= m_flNextBounceSound)
+	{
+		EMIT_SOUND_DYN(ENT(pev), CHAN_VOICE, "pokemon/ball_bounce.wav", clamp(flSpeed / 500.0f, 0.25f, 0.9f), ATTN_NORM, 0, 95 + RANDOM_LONG(0, 12));
+		m_flNextBounceSound = gpGlobals->time + 0.15f;
+	}
+
+	// (loses its momentum quickly, and its spin on the ground)
+	pev->velocity = pev->velocity * 0.6f;
+	if (pev->flags & FL_ONGROUND)
+	{
+		pev->velocity = pev->velocity * 0.7f;
+		pev->avelocity = pev->avelocity * 0.5f;
+	}
+}
+
+// On the ground for the first time: upright, the floor-origin sequences from now on
+void CPokeBall::Land()
+{
+	m_bLanded = true;
+	pev->angles.x = 0.0f;
+	pev->angles.z = 0.0f;
+	pev->avelocity = g_vecZero;
+	SetSequenceByName("idle", 0);
+}
+
+void CPokeBall::FlyThink()
+{
+	pev->nextthink = gpGlobals->time + 0.1f;
+	StudioFrameAdvance();
+
+	if (!IsInWorld())
+	{
+		GiveBack();
+		UTIL_Remove(this);
+		return;
+	}
+
+	// (its thrower gone, dead or on the other side: it fizzles)
+	CBasePlayer *pOwner = m_hOwner;
+	if (!PK_PlayerPlaying(pOwner) || pOwner->m_iTeam != m_iTeam)
+	{
+		PK_FxFlash(pev->origin, 3, 120, 0.0f, edict());
+		UTIL_Remove(this);
+		return;
+	}
+
+	if (pev->waterlevel != 0)
+		pev->velocity = pev->velocity * 0.5f;
+
+	if (!m_bLanded && (pev->flags & FL_ONGROUND))
+		Land();
+
+	// (at rest: it wobbles, then opens)
+	if (m_bResting)
+	{
+		pev->velocity = g_vecZero;
+		if (gpGlobals->time >= m_flOpenTime)
+			Open();
+
+		return;
+	}
+
+	if (m_bLanded && (pev->flags & FL_ONGROUND) && pev->velocity.Length() < 30.0f)
+	{
+		m_bResting = true;
+		SetTouch(nullptr);
+		pev->velocity = g_vecZero;
+		pev->avelocity = g_vecZero;
+		SetSequenceByName("wobble", 1);
+		m_flOpenTime = gpGlobals->time + PK_BALL_WOBBLE_TIME;
+		return;
+	}
+
+	// (still rolling or in the air after a while: it opens at once)
+	if (gpGlobals->time >= m_flOpenTime)
+		Open();
+}
+
+// The ball opens; its Pokemon comes out a moment later, the lid at its widest (Release)
+void CPokeBall::Open()
+{
+	m_bOpened = true;
+	SetTouch(nullptr);
+	pev->velocity = g_vecZero;
+	pev->avelocity = g_vecZero;
+	pev->movetype = MOVETYPE_NONE;
+	pev->solid = SOLID_NOT;
+
+	CBasePlayer *pOwner = m_hOwner;
+	Vector vecDir = pev->origin - pOwner->pev->origin;
+	vecDir.z = 0.0f;
+	m_flYaw = vecDir.Length() > 1.0f ? UTIL_VecToYaw(vecDir) : pOwner->pev->v_angle.y;
+
+	// (the lid opens away from its thrower, its light towards him)
+	pev->angles = Vector(0, m_flYaw + 180.0f, 0);
+
+	// (on the floor: the open sequence's origin is under the ball)
+	TraceResult tr;
+	UTIL_TraceLine(pev->origin + Vector(0, 0, 2), pev->origin - Vector(0, 0, 8), ignore_monsters, edict(), &tr);
+	if (tr.flFraction < 1.0f && !tr.fStartSolid)
+		UTIL_SetOrigin(pev, tr.vecEndPos);
+
+	SetSequenceByName("open", 2);
+	EMIT_SOUND(ENT(pev), CHAN_VOICE, "pokemon/ball_open.wav", VOL_NORM, ATTN_NORM);
+
+	m_flReleaseTime = gpGlobals->time + PK_BALL_RELEASE_DELAY;
+	m_flRemoveTime = m_flReleaseTime + PK_BALL_KEEP_TIME;
+	pev->rendermode = kRenderNormal;
+	pev->renderamt = 255;
+	SetThink(&CPokeBall::OpenThink);
+	pev->nextthink = gpGlobals->time + 0.05f;
+}
+
+// Its Pokemon out where there is room (a little ahead of the ball, away from its thrower), or the ball goes back
+void CPokeBall::Release()
+{
+	m_bReleased = true;
+
+	CBasePlayer *pOwner = m_hOwner;
+	if (!PK_PlayerPlaying(pOwner) || pOwner->m_iTeam != m_iTeam)
+	{
+		PK_FxFlash(pev->origin, 3, 120, 0.0f, edict());
+		m_flRemoveTime = Q_min(m_flRemoveTime, gpGlobals->time + 0.2f);
+		return;
+	}
+
+	// (the light coming out: centred at its Pokemon's mid-height at least, clear of the floor)
+	PK_FxFlash(pev->origin, PK_FLASH_SCALE, PK_FLASH_BRIGHTNESS, Q_max(PK_FLASH_MIN_HEIGHT, 0.5f * PK_Info(m_iSpecies).maxs.z), edict());
+	PK_FxLight(pev->origin + Vector(0, 0, 24), 20, 255, 255, 240, 4, 60);
+
+	Vector vecFwd;
+	UTIL_MakeVectorsPrivate(Vector(0, m_flYaw, 0), vecFwd, nullptr, nullptr);
+	Vector vecNear = pev->origin;
+	TraceResult tr;
+	UTIL_TraceLine(pev->origin + Vector(0, 0, 4), pev->origin + Vector(0, 0, 4) + vecFwd * PK_BALL_RELEASE_AHEAD, ignore_monsters, edict(), &tr);
+	if (tr.flFraction >= 1.0f && !tr.fStartSolid)
+		vecNear = pev->origin + vecFwd * PK_BALL_RELEASE_AHEAD;
+
+	if (!CPokemon::Create(m_iSpecies, pOwner, vecNear, m_flYaw) && (vecNear == pev->origin || !CPokemon::Create(m_iSpecies, pOwner, pev->origin, m_flYaw)))
+	{
+		// (no room: back into its thrower's hand)
+		EMIT_SOUND(ENT(pev), CHAN_ITEM, "pokemon/ball_return.wav", VOL_NORM, ATTN_NORM);
+		PK_FxLight(pev->origin + Vector(0, 0, 16), 12, 255, 60, 40, 3, 60);
+		PK_FxReturnFlash(pev->origin, 0.3f, PK_FLASH_MIN_HEIGHT, edict());
+		GiveBack();
+		m_flRemoveTime = Q_min(m_flRemoveTime, gpGlobals->time + 0.3f);
+	}
+}
+
+void CPokeBall::OpenThink()
+{
+	StudioFrameAdvance();
+	pev->nextthink = gpGlobals->time + 0.05f;
+
+	if (!m_bReleased && gpGlobals->time >= m_flReleaseTime - 0.001f)
+		Release();
+
+	// (fades in its last tenths)
+	float flLeft = m_flRemoveTime - gpGlobals->time;
+	if (m_bReleased && flLeft <= 0.0f)
+	{
+		UTIL_Remove(this);
+		return;
+	}
+
+	if (m_bReleased && flLeft < 0.2f)
+	{
+		pev->rendermode = kRenderTransTexture;
+		pev->renderamt = clamp(flLeft / 0.2f * 255.0f, 0.0f, 255.0f);
+	}
+}
+
+void CPokeBall::GiveBack()
+{
+	CBasePlayer *pOwner = m_hOwner;
+	if (!PK_PlayerPlaying(pOwner) || pOwner->m_iTeam != m_iTeam || PK_BallCarried(pOwner))
+		return;
+
+	const PokemonInfo &info = PK_Info(m_iSpecies);
+	if (pOwner->HasNamedPlayerItem(info.weaponName))
+		pOwner->GiveAmmo(1, (char *)info.ammoName, PK_BALL_MAX_CARRY);
+	else
+		pOwner->GiveNamedItem(info.weaponName);
+
+	char msg[96];
+	Q_snprintf(msg, sizeof(msg), "No room for %s: the ball came back", info.name);
+	PK_CenterPrint(pOwner, msg);
+}
