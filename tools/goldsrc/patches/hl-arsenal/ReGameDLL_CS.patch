+	for (CBasePlayerItem *pItem = pPlayer->m_rgpPlayerItems[GRENADE_SLOT]; pItem; pItem = pItem->m_pNext)
+	{
+		if (IsCompanionItem(pItem->m_iId) && pPlayer->m_rgAmmo[pItem->PrimaryAmmoIndex()] > 0)
