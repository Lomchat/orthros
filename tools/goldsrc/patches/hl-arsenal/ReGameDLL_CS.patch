+// pk_test (sv_cheats 1): pk_test <pikachu|charizard|blastoise> [spawn|enemy]; pk_test clear; pk_test info
+
+
+void CPokemon::Report(CBasePlayer *pTo)
+{
+	CBasePlayer *pOwner = Owner();
+	CBaseEntity *pEnemy = m_hEnemy;
+	char line[256];
+	Q_snprintf(line, sizeof(line), "#%d %s owner=%s team=%d hp=%d/%d state=%s enemy=%s nav=%s path=%d/%d pos=%.0f,%.0f,%.0f owner_dist=%.0f\n",
+		entindex(), PK_Info(m_iSpecies).name, pOwner ? STRING(pOwner->pev->netname) : "-", m_iTeam, int(pev->health), int(pev->max_health),
+		PK_StateNames[clamp(m_iState, 0, int(ARRAYSIZE(PK_StateNames)) - 1)],
+		pEnemy ? (pEnemy->IsPlayer() ? STRING(pEnemy->pev->netname) : STRING(pEnemy->pev->classname)) : "-",
+		TheNavAreaList.empty() ? "none" : "yes", m_path.IsValid() ? m_iPathIndex : 0, m_path.IsValid() ? m_path.GetSegmentCount() : 0,
+		pev->origin.x, pev->origin.y, pev->origin.z, pOwner ? (pOwner->pev->origin - pev->origin).Length() : 0.0f);
+	if (pTo)
+		ClientPrint(pTo->pev, HUD_PRINTCONSOLE, line);
+	else
+		SERVER_PRINT(line);
+}
+
+void PK_TestCommand(CBasePlayer *pPlayer)
+{
+	if (CVAR_GET_FLOAT("sv_cheats") == 0.0f)
+	{
+		ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, "pk_test needs sv_cheats 1\n");
+		return;
+	}
+
+	const char *arg1 = CMD_ARGC() > 1 ? CMD_ARGV(1) : "";
+	const char *arg2 = CMD_ARGC() > 2 ? CMD_ARGV(2) : "";
+
+	if (!Q_stricmp(arg1, "clear"))
+	{
+		PK_CleanUpMap();
+		return;
+	}
+
+	if (!Q_stricmp(arg1, "info"))
+	{
+		CBaseEntity *pEntity = nullptr;
+		while ((pEntity = UTIL_FindEntityByClassname(pEntity, "monster_pokemon")))
+			static_cast<CPokemon *>(pEntity)->Report(pPlayer);
+
+		return;
+	}
+
+	int iSpecies = -1;
+	for (int i = 0; i < PK_NUM_SPECIES; i++)
+	{
+		if (!Q_stricmp(arg1, g_PokemonInfo[i].name))
+			iSpecies = i;
+	}
+
+	if (iSpecies < 0)
+	{
+		ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, "usage: pk_test <pikachu|charizard|blastoise> [spawn|enemy] | pk_test clear | pk_test info\n");
+		return;
+	}
+
+	if (!PK_PlayerPlaying(pPlayer))
+		return;
+
+	Vector vecFwd;
+	UTIL_MakeVectorsPrivate(pPlayer->pev->v_angle, vecFwd, nullptr, nullptr);
+	TraceResult tr;
+	UTIL_TraceLine(pPlayer->EyePosition(), pPlayer->EyePosition() + vecFwd * 160.0f, ignore_monsters, pPlayer->edict(), &tr);
+	Vector vecSpot = tr.vecEndPos - vecFwd * 24.0f;
+
+	// (a Pokemon for the nearest enemy player — a bot — in front of you, set on you)
+	if (!Q_stricmp(arg2, "enemy"))
+	{
+		CBasePlayer *pBest = nullptr;
+		float flBest = 1e9f;
+		for (int i = 1; i <= gpGlobals->maxClients; i++)
+		{
+			CBasePlayer *pOther = UTIL_PlayerByIndex(i);
+			if (!PK_PlayerPlaying(pOther) || pOther == pPlayer || (pOther->m_iTeam == pPlayer->m_iTeam && !PK_FreeForAll()) || PK_PokemonOf(pOther))
+				continue;
+
+			float flDist = (pOther->pev->origin - pPlayer->pev->origin).Length();
+			if (flDist < flBest)
+			{
+				flBest = flDist;
+				pBest = pOther;
+			}
+		}
+
+		if (!pBest)
+		{
+			ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, "pk_test: no enemy player without a Pokemon (add a bot: bot_add)\n");
+			return;
+		}
+
+		CPokemon *pPokemon = CPokemon::Create(iSpecies, pBest, vecSpot, pPlayer->pev->v_angle.y + 180.0f);
+		if (!pPokemon)
+			ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, "pk_test: no room there\n");
+		else
+			pPokemon->OnProvoked(pPlayer);
+
+		return;
+	}
+
+	if (PK_HasOut(pPlayer) || PK_BallCarried(pPlayer))
+	{
+		ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, "pk_test: you already have a ball or a Pokemon (pk_test clear)\n");
+		return;
+	}
+
+	// (your own, out at once in front of you)
+	if (!Q_stricmp(arg2, "spawn"))
+	{
+		if (!CPokemon::Create(iSpecies, pPlayer, vecSpot, pPlayer->pev->v_angle.y))
+			ClientPrint(pPlayer->pev, HUD_PRINTCONSOLE, "pk_test: no room there\n");
+
+		return;
+	}
+
+	// (the ball, free)
+	pPlayer->GiveNamedItem(PK_Info(iSpecies).weaponName);
+}
+
+// The server console's: pk_spawn <species> <owner> [enemy] (players by a part of their name, or #index);
+// pk_info; pk_clear — for tests with bots on a dedicated server
+static CBasePlayer *PK_PlayerByArg(const char *arg)
+{
+	if (!arg || !arg[0])
+		return nullptr;
+
+	if (arg[0] == '#')
+	{
+		CBasePlayer *pPlayer = UTIL_PlayerByIndex(Q_atoi(arg + 1));
+		return PK_PlayerPlaying(pPlayer) ? pPlayer : nullptr;
+	}
+
+	for (int i = 1; i <= gpGlobals->maxClients; i++)
+	{
+		CBasePlayer *pPlayer = UTIL_PlayerByIndex(i);
+		if (!PK_PlayerPlaying(pPlayer))
+			continue;
+
+		char name[64], want[64];
+		Q_strlcpy(name, STRING(pPlayer->pev->netname));
+		Q_strlcpy(want, arg);
+		Q_strlwr(name);
+		Q_strlwr(want);
+		if (Q_strstr(name, want))
+			return pPlayer;
+	}
+
+	return nullptr;
+}
