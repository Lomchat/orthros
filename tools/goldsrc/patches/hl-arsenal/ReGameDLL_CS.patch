+*	thrown like the Half-Life hand grenade; the ball opens and its Pokemon (monster_pokemon) comes out, follows its
+*	player, and charges the enemy its player shoots at or that hurts its player or itself, with its own attack.
+*
+*	Their ids follow the Half-Life arsenal's (weapontype.h): IsHLWeapon covers them too, so they reach the client by the
+*	HLWeapons message, are not predicted, and bots neither buy nor pick them up.
+*
+*	The client draws the health bars from the PokeHP message: short entity index (two bytes, low first), byte health
+*	percent (0: gone), byte species (0 Pikachu, 1 Charizard, 2 Blastoise), byte team (1 T, 2 CT, 0 none), byte owner
+*	player index. Sent to all on spawn, at each change of the percent and at death or removal, and to each client at its
+*	HUD reset (all Pokemon out).
+*
+*	The models, sprites and sounds are Half Strike's own (the asset generator), under models/pokemon, sprites/pokemon
+*	and sound/pokemon.
+*/
+#pragma once
+
+enum PokemonSpecies
+{
+	PK_PIKACHU = 0,
+	PK_CHARIZARD,
+	PK_BLASTOISE,
+	PK_NUM_SPECIES
+};
+
+#define PK_PIKACHU_PRICE    1000
+#define PK_CHARIZARD_PRICE  1400
+#define PK_BLASTOISE_PRICE  1300
+#define PK_BALL_MAX_CARRY   1
+#define PK_BALL_WEIGHT      1
+#define PK_BALL_MAX_SPEED   250.0f
+
+// The share of a Pokemon's hit an armored player takes (Counter-Strike's ratio: 0.5 times this)
+#define PK_ARMOR_RATIO      1.4f
+
+inline bool IsPokeBall(int id) { return id >= WEAPON_PK_FIRST && id <= WEAPON_PK_LAST; }
+
+// Whether an entity is a Pokemon (its attacks are inflicted by it, credited to its player)
+bool PK_IsPokemon(entvars_t *pev);
+
+// Buying a ball (client.cpp's BuyWeaponByWeaponID): one ball carried, one Pokemon out
+CBaseEntity *PK_BuyBall(CBasePlayer *pPlayer, WeaponIdType weaponID);
+
+// Player events (player.cpp): it fired; it was hurt; its HUD was reset
+void PK_OnPlayerAttack(CBasePlayer *pPlayer);
+void PK_OnPlayerHurt(CBasePlayer *pVictim, entvars_t *pevInflictor, entvars_t *pevAttacker);
+void PK_SendAllTo(CBasePlayer *pPlayer);
+
+// Removes every ball and Pokemon, at each round restart
+void PK_CleanUpMap();
+
+// "pk_test" (a player's), "pk_spawn", "pk_info", "pk_clear" (the server console's): cheats only (sv_cheats 1)
+void PK_TestCommand(CBasePlayer *pPlayer);
+void PK_RegisterServerCommands();
+
+// The ball in hand
+class CPokeBallWeapon: public CHLWeapon
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+	virtual int GetItemInfo(ItemInfo *p);
+	virtual BOOL Deploy();
+	virtual BOOL CanHolster() { return m_flStartThrow == 0; }
+	virtual void Holster(int skiplocal = 0);
+	virtual BOOL CanDrop() { return FALSE; }
+	virtual float GetMaxSpeed() { return PK_BALL_MAX_SPEED; }
+	virtual int iItemSlot() { return GRENADE_SLOT; }
+	virtual void PrimaryAttack();
+	virtual void WeaponIdle();
+
+private:
+	int Species() const;
+	void Throw();
+};
+
+// The ball thrown: it bounces, comes to rest or opens on its own after a while
+class CPokeBall: public CBaseAnimating
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+	virtual int ObjectCaps() { return FCAP_DONT_SAVE; }
+
+	static CPokeBall *Launch(CBasePlayer *pOwner, int iSpecies, const Vector &vecSrc, const Vector &vecVelocity);
+	void EXPORT BounceTouch(CBaseEntity *pOther);
+	void EXPORT FlyThink();
+	void EXPORT OpenThink();
+
+	bool IsOwnedBy(CBasePlayer *pPlayer) { return m_hOwner.IsValid() && m_hOwner == pPlayer; }
+	bool IsOpened() const { return m_bReleased; } // (done: its Pokemon out, or the ball back in hand)
+
+private:
+	void Land();
+	void Open();
+	void Release();
+	void GiveBack();
+	void SetSequenceByName(const char *pszName, int iDefault);
+
+	EntityHandle<CBasePlayer> m_hOwner;
+	int m_iSpecies;
+	int m_iTeam;
+	float m_flOpenTime;     // (opens at the latest then; once at rest, after its wobble)
+	float m_flReleaseTime;  // (its Pokemon comes out then, the lid at its widest)
+	float m_flRemoveTime;
+	float m_flNextBounceSound;
+	float m_flYaw;          // (from its thrower towards the ball)
+	bool m_bLanded;         // (touched the ground: the floor-origin sequences from then on)
+	bool m_bResting;        // (wobbling, about to open)
+	bool m_bOpened;         // (the lid opening)
+	bool m_bReleased;       // (its Pokemon out, or the ball back in hand)
+};
+
+// A Pokemon's ongoing effect on a victim: Charizard's burn (Pikachu's slow is the victim's own: m_flPokeSlowUntil)
+struct PokemonAffliction
+{
+	EHANDLE hVictim;
+	float flUntil;
+	float flNext;
+};
+
+#define PK_MAX_AFFLICTED 8
+
+class CPokemon: public CBaseMonster
+{
+public:
+	virtual void Spawn();
+	virtual void Precache();
+	virtual int ObjectCaps() { return FCAP_DONT_SAVE; }
+	virtual int Classify() { return CLASS_NONE; }
+	virtual BOOL IsAlive() { return pev->deadflag == DEAD_NO && m_iState != STATE_DYING && m_iState != STATE_RETURNING; }
+	virtual int BloodColor() { return m_bloodColor; }
+	virtual void TraceAttack(entvars_t *pevAttacker, float flDamage, Vector vecDir, TraceResult *ptr, int bitsDamageType);
+	virtual BOOL TakeDamage(entvars_t *pevInflictor, entvars_t *pevAttacker, float flDamage, int bitsDamageType);
+	virtual void Killed(entvars_t *pevAttacker, int iGib);
+
+	// Out of a ball near a spot (none: no room there)
+	static CPokemon *Create(int iSpecies, CBasePlayer *pOwner, const Vector &vecNear, float flYaw);
+
+	void EXPORT LiveThink();
+	void EXPORT DeadThink();
+	void EXPORT ReturnThink();
+
+	CBasePlayer *Owner() const;
+	bool IsOut() const { return m_iState != STATE_DYING && m_iState != STATE_RETURNING; }
+	bool IsOwnedBy(CBasePlayer *pPlayer) const { return m_hOwner.IsValid() && m_hOwner.Get() == pPlayer->edict(); }
+	bool IsEnemy(CBaseEntity *pEntity);
+	int Species() const { return m_iSpecies; }
+
+	void OnOwnerAttack();
+	void OnProvoked(CBaseEntity *pAggressor);
+	void GoBack();          // back into its ball (its player gone, dead or on the other side)
+	void Vanish();          // removed at once (round restart)
+	void SendHealth(edict_t *pTo);  // PokeHP, to one or all (null)
+	void Report(CBasePlayer *pTo);  // pk_test info (null: the server console)
+
+	enum State
+	{
+		STATE_SPAWNING = 0,
+		STATE_FOLLOW,
+		STATE_CHASE,
+		STATE_ATTACK,
+		STATE_VICTORY,
+		STATE_DYING,
+		STATE_RETURNING
+	};
+
+	enum Sequence
+	{
+		SEQ_IDLE = 0,
+		SEQ_WALK,
+		SEQ_RUN,
+		SEQ_ATTACK,
+		SEQ_FLINCH,
+		SEQ_DIE,
+		SEQ_SPAWN,
+		SEQ_VICTORY,
+		SEQ_COUNT
+	};
+
+private:
+	void StartLife();
+	void LoadSequences();
+	void SetSeq(int iSeq, float flFrameRate, bool bRestart);
+	void SetState(int iState);
+	bool StartVictory();    // its target down by its hand: a short celebration (false: none due)
+	bool FindRoom(const Vector &vecNear, Vector &vecOut);
+	bool TeleportToOwner(CBasePlayer *pOwner);
+	void Flash(const Vector &vecPos, int r, int g, int b);
+
+	// targets
+	void SetEnemy(CBaseEntity *pEnemy);
+	CBaseEntity *FindAimTarget(CBasePlayer *pOwner);
+	bool CanSee(CBaseEntity *pEntity);
+	bool CheckEnemy();
+	bool CanBeHurtBy(CBaseEntity *pAttacker);
+
+	// movement
+	void Follow(CBasePlayer *pOwner, float dt);
+	void Chase(float dt);
+	float MoveTo(const Vector &vecGoal, float flSpeed, float flStopDist, float dt);
+	float Step(float flYaw, float flDist, const Vector &vecPoint, float flSpeed, bool &bLeapt);
+	bool TryJumpOrDrop(float flYaw, const Vector &vecGoal, float flSpeed);
+	bool EdgeStep(float flYaw, float flStep);
+	bool DirectlyReachable(const Vector &vecGoal);
+	bool NextWaypoint(const Vector &vecGoal, Vector &vecPoint);
+	void TurnTowards(float flYaw, float dt, float flRate);
+	void NoteProgress(bool bWantMove);
+	void UpdateAnimation(float flSpeed);
+
+	// attacks
+	Vector AttackOrigin(int iAttachment);
+	void StartAttack();
+	void UpdateAttack();
+	void FireThunderbolt();
+	void FireHydroPump();
+	void FlameTick();
+	void FlameEffects();
+	void DealDamage(CBaseEntity *pVictim, float flDamage, int bitsDamageType);
+	void Afflict(CBaseEntity *pVictim, float flUntil, float flFirstTick);
+	void UpdateAfflictions();
+	void ClearAfflictions();
+
+	int m_iSpecies;
+	int m_iState;
+	int m_iTeam;
+	EntityHandle<CBasePlayer> m_hOwner;
+
+	int m_iSeq[SEQ_COUNT];
+	float m_flSeqDuration[SEQ_COUNT];
+	float m_flSeqGroundSpeed[SEQ_COUNT];
+	int m_iCurSeq;
+
+	float m_flLastThink;
+	float m_flStateEnd;
+	float m_flEnemySeen;
+	float m_flEnemySince;
+	float m_flNextAimCheck;
+	float m_flNextAttack;
+	float m_flAttackStart;
+	float m_flAttackHit;
+	float m_flAttackEnd;
+	float m_flStreamEnd;
+	float m_flNextFlameTick;
+	float m_flNextFlameFx;
+	bool m_bAttackFired;
+	bool m_bKilledEnemy;
+	float m_flFlinchEnd;
+	float m_flNextFlinch;
+	float m_flKnockbackEnd;
+	float m_flSlowEnd;
+	float m_flAirborneEnd;
+	bool m_bFollowMoving;
+	float m_flStuckTime;
+	float m_flStuckCheck;
+	Vector m_vecStuckPos;
+	float m_flNextTeleport;
+	float m_flStepDist;
+	float m_flNextIdleSound;
+	float m_flNextBattleCry;
+	float m_flGlowEnd;
+	float m_flDeathTime;
+	int m_iHealthSent;
+	float m_flSpeedNow;
+
+	CNavPath m_path;
+	int m_iPathIndex;
+	Vector m_vecPathGoal;
+	Vector m_vecWaypoint;
+	float m_flNextRepath;
+
+	PokemonAffliction m_afflicted[PK_MAX_AFFLICTED];
+};
