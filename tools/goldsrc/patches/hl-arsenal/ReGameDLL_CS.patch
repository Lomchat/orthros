+}
+
+void BUILD_CleanUpMap()
+{
+	s_iBuildRound++;
+
+	CBaseEntity *pEntity = nullptr;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "build_piece")))
+		static_cast<CBuildPiece *>(pEntity)->Vanish();
+
+	pEntity = nullptr;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "build_step")))
+	{
+		pEntity->pev->solid = SOLID_NOT;
+		UTIL_SetOrigin(pEntity->pev, pEntity->pev->origin);
+		UTIL_Remove(pEntity);
+	}
+
+	UTIL_RemoveOther("build_bricks");
+	BUILD_ForgetPiles();
+}
