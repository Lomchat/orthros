+	p->iMaxAmmo1 = HL_URANIUM_MAX_CARRY;
+	p->pszAmmo2 = nullptr;
+	p->iMaxAmmo2 = -1;
+	p->iMaxClip = WEAPON_NOCLIP;
+	p->iSlot = 0;
+	p->iPosition = 22;
+	p->iId = m_iId = WEAPON_HL_EGON;
+	p->iFlags = 0;
