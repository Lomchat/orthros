+
+// A ball of its in flight
+static bool PK_BallInFlight(CBasePlayer *pPlayer)
+{
+	CBaseEntity *pEntity = nullptr;
+	while ((pEntity = UTIL_FindEntityByClassname(pEntity, "pokeball")))
+	{
+		CPokeBall *pBall = static_cast<CPokeBall *>(pEntity);
+		if (pBall->IsOwnedBy(pPlayer) && !pBall->IsOpened() && !(pEntity->pev->flags & FL_KILLME))
+			return true;
+	}
+
+	return false;
