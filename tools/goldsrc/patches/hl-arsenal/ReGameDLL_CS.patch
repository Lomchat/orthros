+void CHLHandGrenade::PrimaryAttack()
+{
+	// (the pin pulled: it cooks from now on)
+	if (!m_flStartThrow && m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] > 0)
+	{
+		m_flStartThrow = gpGlobals->time;
+		m_flReleaseThrow = 0.0f;
