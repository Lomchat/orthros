+// ---------------------------------------------------------------------------------------------------------------------
+// Le M's effects: green code (coderain.spr columns, pixels.spr bits, codebeam.spr beams)
+
+// An effect sprite played once at its own pace, additive, no light nor sound (TE_EXPLOSION, drawn 10 units up)
+static void PK_FxAnimated(const Vector &pos, int iSprite, int iScale, int iFrameRate)
+{
