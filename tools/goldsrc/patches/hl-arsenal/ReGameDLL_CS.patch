+CHLGrenade *CHLGrenade::ShootTimed(entvars_t *pevOwner, Vector vecStart, Vector vecVelocity, float time)
+{
+	CHLGrenade *pGrenade = GetClassPtr<CCSAnimating>((CHLGrenade *)nullptr);
+	pGrenade->Spawn();
+	UTIL_SetOrigin(pGrenade->pev, vecStart);
+	pGrenade->pev->velocity = vecVelocity;
+	pGrenade->pev->angles = UTIL_VecToAngles(pGrenade->pev->velocity);
+	pGrenade->pev->owner = ENT(pevOwner);
+
+	pGrenade->SetTouch(&CHLGrenade::BounceTouch);
+	pGrenade->pev->dmgtime = gpGlobals->time + time;
+	pGrenade->SetThink(&CHLGrenade::TumbleThink);
+	pGrenade->pev->nextthink = gpGlobals->time + 0.1f;
+	if (time < 0.1f)
+	{
+		pGrenade->pev->nextthink = gpGlobals->time;
+		pGrenade->pev->velocity = Vector(0, 0, 0);
+	}
+
+	SET_MODEL(pGrenade->edict(), "models/w_grenade.mdl");
+	pGrenade->pev->sequence = RANDOM_LONG(3, 6);
+	pGrenade->ResetSequenceInfo();
+	pGrenade->pev->framerate = 1.0f;
+
+	pGrenade->pev->gravity = 0.5f;
+	pGrenade->pev->friction = 0.8f;
+	pGrenade->pev->dmg = HL_HANDGRENADE_DAMAGE;
+	return pGrenade;
+}
+
+CHLGrenade *CHLGrenade::ShootContact(entvars_t *pevOwner, Vector vecStart, Vector vecVelocity)
+{
+	CHLGrenade *pGrenade = GetClassPtr<CCSAnimating>((CHLGrenade *)nullptr);
+	pGrenade->Spawn();
+	pGrenade->pev->gravity = 0.5f; // (aerodynamic)
+	UTIL_SetOrigin(pGrenade->pev, vecStart);
+	pGrenade->pev->velocity = vecVelocity;
+	pGrenade->pev->angles = UTIL_VecToAngles(pGrenade->pev->velocity);
+	pGrenade->pev->owner = ENT(pevOwner);
+
+	pGrenade->SetThink(&CHLGrenade::FlyThink);
+	pGrenade->pev->nextthink = gpGlobals->time;
+	pGrenade->pev->avelocity.x = RANDOM_FLOAT(-100, -500);
+	pGrenade->SetTouch(&CHLGrenade::ExplodeTouch);
+	pGrenade->pev->dmg = HL_ARGRENADE_DAMAGE;
+	return pGrenade;
+}
+
+void CHLGrenade::BounceTouch(CBaseEntity *pOther)
+{
+	if (pOther->edict() == pev->owner)
+		return;
+
+	// (a knock on whom it hits in flight)
+	if (m_flNextHit < gpGlobals->time && pev->velocity.Length() > 100 && pev->owner)
+	{
+		entvars_t *pevOwner = VARS(pev->owner);
+		TraceResult tr = UTIL_GetGlobalTrace();
+		ClearMultiDamage();
+		pOther->TraceAttack(pevOwner, 1, gpGlobals->v_forward, &tr, DMG_CLUB);
+		ApplyMultiDamage(pev, pevOwner);
+		m_flNextHit = gpGlobals->time + 1.0f;
+	}
+
+	if (pev->flags & FL_ONGROUND)
+	{
+		pev->velocity = pev->velocity * 0.8f;
+		pev->sequence = 1;
+		ResetSequenceInfo();
+	}
+	else
+	{
+		static const char *sounds[] = { "weapons/grenade_hit1.wav", "weapons/grenade_hit2.wav", "weapons/grenade_hit3.wav" };
+		EMIT_SOUND(ENT(pev), CHAN_VOICE, sounds[RANDOM_LONG(0, 2)], 0.25f, ATTN_NORM);
+	}
+
+	pev->framerate = pev->velocity.Length() / 200.0f;
+	if (pev->framerate > 1.0f)
+	{
+		pev->framerate = 1.0f;
+	}
+	else if (pev->framerate < 0.5f)
+	{
+		pev->framerate = 0.0f;
+		pev->frame = 0.0f;
+	}
+}
+
+void CHLGrenade::ExplodeTouch(CBaseEntity *pOther)
+{
+	TraceResult tr;
+	Vector vecSpot = pev->origin - pev->velocity.Normalize() * 32;
+	UTIL_TraceLine(vecSpot, vecSpot + pev->velocity.Normalize() * 64, ignore_monsters, ENT(pev), &tr);
+	Explode(&tr);
+}
+
+void CHLGrenade::TumbleThink()
+{
+	if (!IsInWorld())
+	{
+		UTIL_Remove(this);
+		return;
+	}
+
+	StudioFrameAdvance();
+	pev->nextthink = gpGlobals->time + 0.1f;
+
+	if (pev->dmgtime <= gpGlobals->time)
+		SetThink(&CHLGrenade::Detonate);
+
+	if (pev->waterlevel != 0)
+	{
+		pev->velocity = pev->velocity * 0.5f;
+		pev->framerate = 0.2f;
+	}
+}
+
+void CHLGrenade::FlyThink()
+{
+	if (!IsInWorld())
+	{
+		UTIL_Remove(this);
+		return;
+	}
+
+	pev->nextthink = gpGlobals->time + 0.2f;
+
+	if (pev->waterlevel != 0)
+		pev->velocity = pev->velocity * 0.5f;
+}
+
+void CHLGrenade::Detonate()
+{
+	TraceResult tr;
+	Vector vecSpot = pev->origin + Vector(0, 0, 8);
+	UTIL_TraceLine(vecSpot, vecSpot + Vector(0, 0, -40), ignore_monsters, ENT(pev), &tr);
+	Explode(&tr);
+}
+
+void CHLGrenade::Explode(TraceResult *pTrace)
+{
+	pev->model = iStringNull; // (invisible)
+	pev->solid = SOLID_NOT;
+	pev->takedamage = DAMAGE_NO;
+
+	entvars_t *pevOwner = pev->owner ? VARS(pev->owner) : nullptr;
+	HL_Explosion(this, pTrace, pevOwner, pev->dmg, pev->dmg * 2.5f, int((pev->dmg - 50) * 0.6f));
+
+	static const char *sounds[] = { "weapons/debris1.wav", "weapons/debris2.wav", "weapons/debris3.wav" };
+	EMIT_SOUND(ENT(pev), CHAN_VOICE, sounds[RANDOM_LONG(0, 2)], 0.55f, ATTN_NORM);
+
+	pev->effects |= EF_NODRAW;
+	pev->velocity = g_vecZero;
+	SetTouch(nullptr);
+	SetThink(&CHLGrenade::Smoke);
+	pev->nextthink = gpGlobals->time + 0.3f;
+}
+
+void CHLGrenade::Smoke()
+{
+	if (UTIL_PointContents(pev->origin) == CONTENTS_WATER)
+	{
+		UTIL_Bubbles(pev->origin - Vector(64, 64, 64), pev->origin + Vector(64, 64, 64), 100);
+	}
+	else
+	{
+		MESSAGE_BEGIN(MSG_PVS, SVC_TEMPENTITY, pev->origin);
+			WRITE_BYTE(TE_SMOKE);
+			WRITE_COORD(pev->origin.x);
+			WRITE_COORD(pev->origin.y);
+			WRITE_COORD(pev->origin.z);
+			WRITE_SHORT(g_sModelIndexSmoke);
+			WRITE_BYTE(clamp(int((pev->dmg - 50) * 0.8f), 1, 255)); // scale * 10
+			WRITE_BYTE(12); // framerate
+		MESSAGE_END();
+	}
+
+	UTIL_Remove(this);
+}
