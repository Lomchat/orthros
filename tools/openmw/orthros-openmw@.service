[Unit]
Description=Orthros OpenMW multiplayer (%i)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/srv/orthros
EnvironmentFile=-/etc/orthros-openmw.env
ExecStart=/usr/local/bin/node /srv/orthros/tools/openmw/server.mjs %i
# (always: a gateway whose container was stopped from outside — every container of the host stopped at once on 2026-10-29 — exits
# cleanly; on-failure left the four down. A `systemctl stop` is never restarted.)
Restart=always
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
