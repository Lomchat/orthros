+#ifdef __EMSCRIPTEN__
+    void LuaState::orthrosCompileFactory(const VFS::Path::Normalized& path, const std::string& source)
+    {
+        // The source as the body of a vararg function, its first line kept on line 1 (error lines unchanged). The
+        // function's only possible upvalue is the factory's local _ENV: one fresh per call, so each instance and the
+        // closures it makes share their own environment, as with a main chunk loaded anew; sol::set_environment finds
+        // it by its name, _ENV. Compiled only after the source compiled as itself, so no source that is invalid alone
+        // runs; one that compiles only alone keeps its bytecode re-read per instance (no factory recorded).
+        std::string wrapped;
+        wrapped.reserve(source.size() + 64);
+        wrapped.append("local _ENV = ...; return function(...) ");
+        wrapped.append(source);
+        wrapped.append("\nend");
+        sol::load_result factory = mSol.load(wrapped, path.value(), sol::load_mode::text);
+        if (!factory.valid())
+        {
+            Log(Debug::Warning) << "Orthros: " << path.value()
+                                << " not compiled as a factory, its bytecode re-read per instance (OPENMW_ORTHROS_LUACHUNKS)";
+            return;
+        }
+        mOrthrosFactories[path] = sol::main_function(factory.get<sol::function>());
+    }
+
+    bool LuaState::orthrosInstantiate(const VFS::Path::Normalized& path, sol::function& out)
+    {
+        if (!orthrosChunkFactories())
+            return false;
+        auto it = mOrthrosFactories.find(path);
+        if (it == mOrthrosFactories.end())
+            return false;
+        lua_State* L = mSol.lua_state();
+        // Pushed on the main state, as lua_load did; when this is a `require` run from a coroutine, the main state's
+        // LUA_MINSTACK guarantee belongs to the C function that is running, not to us: make room (else the undump).
+        if (!lua_checkstack(L, 3))
+            return false;
+        // factory(_G): the new closure's _ENV starts at the globals, as lua_load sets a loaded chunk's first upvalue.
+        // The factory runs a few instructions on the main state: a memory error, or the instruction watchdog
+        // (countHook) firing there instead of in the script's first instructions, fails the script's start with the
+        // same "Lua error" as before.
+        const int top = lua_gettop(L);
+        sol::stack::push(L, it->second);
+        lua_pushglobaltable(L);
+        if (lua_pcall(L, 1, 1, 0) != LUA_OK)
+        {
+            std::string message = lua_isstring(L, -1) ? lua_tostring(L, -1) : "error in a script factory";
+            lua_settop(L, top);
+            throw std::runtime_error("Lua error: " + message);
+        }
+        out = sol::stack::pop<sol::function>(L);
+        lua_settop(L, top);
+        return true;
+    }
+#endif
+
+    bool orthrosChunkFactories()
+    {
+#ifdef __EMSCRIPTEN__
+        static const bool on = [] {
+            const char* const value = std::getenv("OPENMW_ORTHROS_LUACHUNKS");
+            const bool off = value != nullptr && std::strcmp(value, "0") == 0;
+            Log(Debug::Info) << "Orthros: Lua scripts met again "
+                             << (off ? "re-read from their bytecode, as before (OPENMW_ORTHROS_LUACHUNKS=0)"
+                                     : "instantiated from a function compiled once per path");
+            return !off;
+        }();
+        return on;
+#else
+        return false;
+#endif
+    }
