+    /// Orthros (texahead.patch): OPENMW_ORTHROS_TEXAHEAD (absent: on; 0: off), read once.
+    bool orthrosTexAhead()
+    {
+        static const bool on = [] {
+            const char* v = std::getenv("OPENMW_ORTHROS_TEXAHEAD");
+            return v == nullptr || std::string_view(v) != "0";
+        }();
+        return on;
+    }
+
+    /// Orthros (texahead.patch): what the uploads ahead spent in the frame that reloads (EmscriptenLoop::reloadUpdated
+    /// runs before the frame: one frame number per tick).
+    struct OrthrosAheadTick
+    {
+        unsigned int mFrame = ~0u;
+        double mMs = 0;
+    };
+
+    /// Orthros (texahead.patch): at most this many ms of uploads ahead in one tick; past it, the rest of the tick's
+    /// textures are left to their next draw (the previous path). A tick that reloads a large set never adds more than
+    /// this to its decode, and the reloads' pacing (their decoded bytes, ImageManager::reloadImage's return) is
+    /// unchanged: no light copy stays longer.
+    constexpr double sOrthrosAheadTickMs = 8.0;
+
+    /// Orthros (texahead.patch): `image` was just updated in place (ImageManager::reloadImage, between frames, on the
+    /// thread that renders: a light copy replaced by the file itself). Its textures that hold an older upload are
+    /// uploaded again now, as their next apply would have, instead of by the first draw that shows them: shown, that
+    /// is this frame's draw anyway — the same work, a little earlier —; not shown (behind the camera, under a roof),
+    /// a later draw used to upload them all at once (the local map's first render of a cell drew a dozen such
+    /// textures, 25 MB, in one frame; a camera turn the same). Within sOrthrosAheadTickMs a tick. A texture never
+    /// uploaded is left to the incremental compile or its first draw, as before. A texture alive but never drawn
+    /// again (only an expiring cache holds it) is uploaded too: it had a GL object already, the cost is its upload
+    /// once, inside the tick's cap. Requires: called between frames on the GL thread (EmscriptenLoop::tick calls
+    /// reloadUpdated before viewer->advance/frame — keep it there).
+    void orthrosUploadAhead(osgViewer::Viewer& viewer, osg::Image& image, OrthrosAheadTick& tick)
+    {
+        std::vector<osg::ref_ptr<osg::Texture2D>> textures;
+        osg::orthrosTexture2DsOfImage(&image, textures);
+        if (textures.empty())
+            return;
+        osg::GraphicsContext* gc = viewer.getCamera()->getGraphicsContext();
+        osg::State* state = gc != nullptr ? gc->getState() : nullptr;
+        if (state == nullptr || viewer.getFrameStamp() == nullptr)
+            return;
+        const unsigned int frame = viewer.getFrameStamp()->getFrameNumber();
+        if (tick.mFrame != frame)
+        {
+            tick.mFrame = frame;
+            tick.mMs = 0;
+        }
+        const unsigned int contextID = state->getContextID();
+        const double start = emscripten_get_now();
+        int uploaded = 0, deferred = 0;
+        double bytes = 0;
+        for (const osg::ref_ptr<osg::Texture2D>& texture : textures)
+        {
+            if (texture->getImage() != &image || texture->getSubloadCallback() != nullptr
+                || texture->getTextureObject(contextID) == nullptr
+                || texture->getModifiedCount(contextID) == image.getModifiedCount())
+                continue;
+            if (tick.mMs + (emscripten_get_now() - start) >= sOrthrosAheadTickMs)
+            {
+                ++deferred; // (its next draw uploads it, as before)
+                continue;
+            }
+            texture->apply(*state);
+            ++uploaded;
+            bytes += image.getTotalSizeInBytesIncludingMipmaps();
+        }
+        if (uploaded == 0 && deferred == 0)
+            return;
+        // (the texture unit's binding changed behind the State's back: its next apply binds again)
+        if (uploaded != 0)
+            state->haveAppliedTextureAttribute(state->getActiveTextureUnit(), osg::StateAttribute::TEXTURE);
+        const double ms = emscripten_get_now() - start;
+        tick.mMs += ms;
+        // clang-format off
+        EM_ASM({
+            var s = globalThis.__orthrosTexAhead || (globalThis.__orthrosTexAhead = { textures: 0, bytes: 0, deferred: 0, ms: 0, max: 0, maxTick: 0 });
+            s.textures += $0; s.bytes += $1; s.deferred += $2; s.ms += $3;
+            if ($3 > s.max) s.max = $3;
+            if ($4 > s.maxTick) s.maxTick = $4;
+        }, uploaded, bytes, deferred, ms, tick.mMs);
+        // clang-format on
+    }
+}
+#endif
