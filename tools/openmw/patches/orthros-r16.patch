+    /// Orthros (texahead.patch): the Texture2Ds alive that hold `image` (appended to `out`, each referenced); none when
+    /// OPENMW_ORTHROS_TEXAHEAD=0. Thread-safe.
+    void orthrosTexture2DsOfImage(const Image* image, std::vector<ref_ptr<Texture2D>>& out)
+    {
+        if (!orthrosTexAheadOn() || image == nullptr)
+            return;
+        // (the observers copied under the registry's lock, locked after it: the lock held as briefly as can be)
+        std::vector<observer_ptr<Texture2D>> observers;
+        {
+            OrthrosTextureRegistry& registry = orthrosRegistry();
+            const std::lock_guard<std::mutex> lock(registry.mMutex);
+            auto [it, end] = registry.mClients.equal_range(image);
+            for (; it != end; ++it)
+                observers.push_back(it->second.mObserver);
+        }
+        for (const observer_ptr<Texture2D>& observer : observers)
+        {
+            ref_ptr<Texture2D> texture;
+            if (observer.lock(texture))
+                out.push_back(std::move(texture));
+        }
+    }
+}
