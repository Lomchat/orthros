+    struct OrthrosTextureClient
+    {
+        // (only compared: the entry leaves the registry wherever the texture lets go of its image — setImage, the
+        // destructor through it, apply's unref of the image data, copyTexImage2D)
+        const osg::Texture2D* mTexture;
+        osg::observer_ptr<osg::Texture2D> mObserver;
+    };
+
+    struct OrthrosTextureRegistry
+    {
+        std::mutex mMutex;
+        std::unordered_multimap<const osg::Image*, OrthrosTextureClient> mClients;
+    };
+
+    // (never destroyed: a texture released during static destruction still finds it)
+    OrthrosTextureRegistry& orthrosRegistry()
+    {
+        static OrthrosTextureRegistry* registry = [] {
+            OrthrosTextureRegistry* created = new OrthrosTextureRegistry;
+            created->mClients.reserve(16384); // (no rehash under the lock while a session's textures come and go)
+            return created;
+        }();
+        return *registry;
+    }
+
+    void orthrosForget(const osg::Image* image, const osg::Texture2D* texture)
+    {
+        OrthrosTextureRegistry& registry = orthrosRegistry();
+        const std::lock_guard<std::mutex> lock(registry.mMutex);
+        // (the texture's entry, and any whose texture is gone: an entry left by a path that missed it never stays to
+        // be taken for a new texture allocated at the same address)
+        auto [it, end] = registry.mClients.equal_range(image);
+        while (it != end)
+        {
+            if (it->second.mTexture == texture || !it->second.mObserver.valid())
+                it = registry.mClients.erase(it);
+            else
+                ++it;
+        }
+    }
+}
