+    void orthrosCellRanges(const MWWorld::ESMStore& store, const ESM::Cell& cell, bool refs, bool land,
+        std::vector<VFS::OrthrosRange>& out)
+    {
+        if (refs)
+            for (const ESM::ESM_Context& context : cell.mContextList)
+                if (!context.filename.empty())
+                    out.push_back(orthrosContextRange(context));
