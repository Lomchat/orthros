+        {
+            const ESM::Land* record = store.get<ESM::Land>().search(cell.getGridX(), cell.getGridY());
+            VFS::OrthrosRange range;
+            if (record != nullptr && record->mDataTypes != 0 && orthrosLandRange(*record, range))
+                out.push_back(std::move(range));
+        }
+    }
