+    /// Orthros (orthros-r13.patch): loading the saved game `filepath` loads the references of every cell it has a state
+    /// of (WorldModel::readRecord: CellStore::load, one cell after the other), read from the content files as they are
+    /// once the content is loaded (their light copies zeroed those details): the ranges of those cells fetched together
+    /// first — one pass over the save's record headers, each CSTA's cell id —, then one wait (bounded). Not learned as
+    /// a place's (the label's kind is none of them). Nothing off the web build, without the hooks, or on any error
+    /// (the load reads them one by one, as before).
+    void orthrosReadSavedCells(const std::filesystem::path& filepath)
+    {
+#ifdef __EMSCRIPTEN__
+        if (!VFS::orthrosReadAheadHooked())
+            return;
+        try
+        {
+            const MWWorld::ESMStore& store = *MWBase::Environment::get().getESMStore();
+            ESM::ESMReader reader;
+            reader.open(filepath);
+            std::vector<VFS::OrthrosRange> ranges;
+            while (reader.hasMoreRecs())
+            {
+                const ESM::NAME n = reader.getRecName();
+                reader.getRecHeader();
+                if (n.toInt() == ESM::REC_CSTA)
+                    if (const ESM::Cell* cell = store.get<ESM::Cell>().search(reader.getCellId()))
+                        MWRender::orthrosCellRanges(store, *cell, true, false, ranges);
+                reader.skipRecord();
+            }
+            if (VFS::orthrosWillReadRanges(ranges, "cells:save") > 0)
+                VFS::orthrosReadWait(15000);
+        }
+        catch (const std::exception& e)
+        {
+            Log(Debug::Warning) << "Orthros: the saved game's cells not read ahead: " << e.what();
+        }
+#else
+        (void)filepath;
+#endif
+    }
+}
