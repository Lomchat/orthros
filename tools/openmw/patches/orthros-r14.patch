diff --git a/openmw/apps/openmw/mwlua/mainthread.hpp b/openmw/apps/openmw/mwlua/mainthread.hpp
new file mode 100644
index 0000000..22ee05b
--- /dev/null
+++ b/openmw/apps/openmw/mwlua/mainthread.hpp
@@ -0,0 +1,186 @@
+#ifndef OPENMW_MWLUA_MAINTHREAD_H
+#define OPENMW_MWLUA_MAINTHREAD_H
+
+// Orthros (OPENMW_ORTHROS_LUATHREAD): Lua bindings' calls that must run on the page's thread on the web.
+//
+// LuaManager::update() may run on the Lua thread (mwlua/worker.cpp), in parallel with the frame's cull and draw. On the
+// desktop a few bindings call engine subsystems directly from there (OpenAL Soft being thread safe); on the web some of
+// them live in the page's JavaScript (the OpenAL library, its EM_JS extensions, the engine's EM_ASM hooks), which a Web
+// Worker does not have, and a few others mutate state the frame's cull reads (MyGUI's message boxes and cursor, the
+// post-processor's technique list). Those calls go through a queue of their own — not Emscripten's system proxy
+// queue, which the page's thread serves wherever it waits on a lock (mid-cull included, and inside a proxied task that
+// does not serve it again) — that the page's thread runs only in Worker::finishUpdate, after the frame's drawing, in
+// call order: exactly where the inline update() ran them.
+//   mainThreadPost(f): f queued, the Lua thread goes on (calls whose result Lua does not read: play, stop, show).
+//   onMainThread(f):   f queued and waited for (its result returned, its exception thrown again on the Lua thread);
+//                      being behind the calls posted before it, it sees their effects as inline.
+// On the page's thread itself (the switch at 0, synchronizedUpdate, the menu) and off the web: f called directly.
+
+#include <chrono>
+#include <condition_variable>
+#include <deque>
+#include <exception>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <type_traits>
+#include <utility>
+
+#include <components/debug/debuglog.hpp>
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten/threading.h>
+#endif
+
+namespace MWLua
+{
+    class MainThreadCalls
+    {
+    public:
+        static MainThreadCalls& get()
+        {
+            static MainThreadCalls sCalls;
+            return sCalls;
+        }
+
+        // True on a thread that must queue its calls (the Lua thread, on the web).
+        static bool mustQueue()
+        {
+#ifdef __EMSCRIPTEN__
+            return !emscripten_is_main_runtime_thread();
+#else
+            return false;
+#endif
+        }
+
+        void post(std::function<void()> call)
+        {
+            {
+                std::lock_guard<std::mutex> lk(mMutex);
+                mCalls.push_back(std::move(call));
+            }
+            mCV.notify_all();
+        }
+
+        // The Lua thread: `call` run on the page's thread, waited for.
+        void runAndWait(const std::function<void()>& call)
+        {
+            bool done = false;
+            post([&] {
+                runOne(call);
+                std::lock_guard<std::mutex> lk(mMutex);
+                done = true;
+            });
+            std::unique_lock<std::mutex> lk(mMutex);
+            mCV.wait(lk, [&] { return done; });
+        }
+
+        // The page's thread: runs the queued calls, in order, until finished() is true with none pending (whoever
+        // makes it true calls wake() after). A posted call's exception is logged: it has nobody to be thrown to.
+        // onIdle() is called after each `slice` spent waiting with nothing to do.
+        template <class Finished, class OnIdle, class Rep, class Period>
+        void serveUntil(Finished&& finished, OnIdle&& onIdle, std::chrono::duration<Rep, Period> slice)
+        {
+            std::unique_lock<std::mutex> lk(mMutex);
+            while (true)
+            {
+                if (!mCalls.empty())
+                {
+                    std::function<void()> call = std::move(mCalls.front());
+                    mCalls.pop_front();
+                    lk.unlock();
+                    runOne(call);
+                    mCV.notify_all(); // a runAndWait's done set
+                    lk.lock();
+                    continue;
+                }
+                if (finished())
+                    return;
+                if (mCV.wait_for(lk, slice) == std::cv_status::timeout && mCalls.empty() && !finished())
+                {
+                    lk.unlock();
+                    onIdle();
+                    lk.lock();
+                }
+            }
+        }
+
+        // The page's thread: runs whatever is queued now.
+        void drain()
+        {
+            serveUntil([] { return true; }, [] {}, std::chrono::milliseconds(1));
+        }
+
+        // After serveUntil's condition became true.
+        void wake()
+        {
+            {
+                std::lock_guard<std::mutex> lk(mMutex);
+            }
+            mCV.notify_all();
+        }
+
+    private:
+        static void runOne(const std::function<void()>& call)
+        {
+            try
+            {
+                call();
+            }
+            catch (const std::exception& e)
+            {
+                Log(Debug::Error) << "Lua: a call queued for the page's thread failed: " << e.what();
+            }
+            catch (...)
+            {
+                Log(Debug::Error) << "Lua: a call queued for the page's thread failed (non-C++ exception)";
+            }
+        }
+
+        std::mutex mMutex;
+        std::condition_variable mCV;
+        std::deque<std::function<void()>> mCalls;
+    };
+
+    // f run on the page's thread after the frame's drawing (see above), the caller going on: f must own what it uses.
+    template <class F>
+    void mainThreadPost(F&& f)
+    {
+        if (!MainThreadCalls::mustQueue())
+        {
+            f();
+            return;
+        }
+        MainThreadCalls::get().post(std::function<void()>(std::forward<F>(f)));
+    }
+
+    // f run on the page's thread and waited for: its result returned, its exception thrown again here.
+    template <class F>
+    auto onMainThread(F&& f) -> std::decay_t<std::invoke_result_t<F&>>
+    {
+        using Result = std::decay_t<std::invoke_result_t<F&>>;
+        if (!MainThreadCalls::mustQueue())
+            return static_cast<Result>(f());
+        std::exception_ptr error;
+        std::conditional_t<std::is_void_v<Result>, bool, std::optional<Result>> result{};
+        MainThreadCalls::get().runAndWait([&] {
+            try
+            {
+                if constexpr (std::is_void_v<Result>)
+                    f();
+                else
+                    result.emplace(f());
+            }
+            catch (...)
+            {
+                error = std::current_exception();
+            }
+        });
+        if (error)
+            std::rethrow_exception(error);
+        if constexpr (!std::is_void_v<Result>)
+            return std::move(*result);
+    }
+}
+
+#endif // OPENMW_MWLUA_MAINTHREAD_H
