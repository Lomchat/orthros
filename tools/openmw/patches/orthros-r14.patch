+    // the library's order and results: EINVAL for an unknown clock, Date.now() for the realtime one, the monotonic
+    // clock for the others (nowIsMonotonic: always with performance.now())
+    if (!checkWasiClock(clk_id)) return orthrosClockOrig_clock_time_get(clk_id, ignored_precision, ptime);
+    if (clk_id === 0 /* __WASI_CLOCKID_REALTIME */) now = _emscripten_date_now();
+    else if (nowIsMonotonic) now = _emscripten_get_now();
+    else return orthrosClockOrig_clock_time_get(clk_id, ignored_precision, ptime);
+    var nsec = Math.round(now * 1000 * 1000);
+    if (!(nsec >= 0 && nsec < 18446744073709551616)) {
