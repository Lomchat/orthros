+  addToLibrary(kept);
+})();
+
+addToLibrary({
+  // undefined until chosen (the first call once the runtime is initialized); then the page's time origin, kept (on),
+  // or null ("0").
+  $orthrosClockOrigin: undefined,
+  $orthrosClockOrigin__deps: ['$ENV',
+#if PTHREADS
