+    }
+    kept['$orthrosClockOrig_' + name] = lib[name];
+    kept['$orthrosClockOrig_' + name + '__deps'] = lib[name + '__deps'] || [];
+    kept[name + '__deps'] = (lib[name + '__deps'] || []).concat(['$orthrosClockOrig_' + name, '$orthrosClockOrigin']);
