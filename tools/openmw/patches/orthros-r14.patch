+      HEAP64[ptime / 8] = BigInt(nsec);
+      return 0;
+    }
+    var i = ptime / 4, heap = orthrosClockHeapU32;
+    // (the toolchain reads every HEAPxx of library code as (growMemViews(), HEAPxx): the current view)
+    if (i + 2 > heap.length) heap = orthrosClockHeapU32 = HEAPU32;
+    var hi = Math.floor(nsec / 4294967296);
+    heap[i] = nsec - hi * 4294967296;
+    heap[i + 1] = hi;
+    return 0;
+  },
+});
