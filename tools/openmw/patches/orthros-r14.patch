+    // the glue's view of the heap for clock_time_get (see the header); an empty one until the first write
+    var orthrosClockHeapU32 = new Uint32Array(0);
+    var orthrosClockChoose = () => {
+      if (!runtimeInitialized) return orthrosClockOrigin;
+      var off;
