+    std::size_t ImageManager::reloadImage(VFS::Path::NormalizedView path)
+    {
+        if (Misc::getFileExtension(path.value()) != "dds")
+            return 0;
+        osg::ref_ptr<osg::Object> obj = mCache->getRefFromObjectCache(path);
+        if (!obj)
+            return 0;
+        osg::ref_ptr<osg::Image> image(static_cast<osg::Image*>(obj.get()));
+        if (image == mWarningImage)
+        {
+            // (shared by every image that failed: never updated in place; the next load reads the new file)
+            mCache->removeFromObjectCache(path.value());
+            return 0;
+        }
+        // Decoded exactly as a first load, then the cached object (the one the textures hold) put back in the cache
+        mCache->removeFromObjectCache(path.value());
+        osg::ref_ptr<osg::Image> fresh = getImage(path);
+        mCache->addEntryToObjectCache(std::string(path.value()), image);
+        if (fresh == mWarningImage || !fresh->data() || !fresh->isDataContiguous())
+            return 0;
+        const std::size_t size = fresh->getTotalSizeInBytesIncludingMipmaps();
+        unsigned char* data = new unsigned char[size];
+        std::memcpy(data, fresh->data(), size);
+        // setImage() frees the old data, drops the old mipmap offsets and marks the image modified (dirty())
+        image->setImage(fresh->s(), fresh->t(), fresh->r(), fresh->getInternalTextureFormat(), fresh->getPixelFormat(),
+            fresh->getDataType(), data, osg::Image::USE_NEW_DELETE, fresh->getPacking(), fresh->getRowLength());
+        image->setMipmapLevels(fresh->getMipmapLevels());
+        image->setOrigin(fresh->getOrigin());
+        image->dirty();
+        return size;
+    }
+
