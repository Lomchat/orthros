+// Orthros (tools/openmw/patches/orthros-r1.patch). A file of the engine's file system replaced by the page (a
+// texture's light copy by the file itself): its cached image is read again and updated in place, between frames, a few
+// at a time (g_orthrosReloadBudget decoded bytes a frame, at least one file) — EmscriptenLoop::reloadUpdated.
+// `path`: within a data folder (textures/tx_a.dds) or in the engine's file system (/mwdata/Data Files/Textures/tx_a.dds),
+// any case or separator. Returns 1 when queued (a DDS file), 0 otherwise. Progress: globalThis.__orthrosTexReloads.
+namespace
+{
+    std::mutex g_orthrosUpdatedMutex;
+    std::deque<std::string> g_orthrosUpdated;
+    constexpr std::size_t g_orthrosReloadBudget = std::size_t(4) << 20;
+}
+extern "C" EMSCRIPTEN_KEEPALIVE int orthros_file_updated(const char* path)
+{
+    if (!path)
+        return 0;
+    std::string name = VFS::Path::Normalized(std::string_view(path)).value();
+    if (Misc::getFileExtension(name) != "dds")
+        return 0;
+    std::lock_guard<std::mutex> lock(g_orthrosUpdatedMutex);
+    if (std::find(g_orthrosUpdated.begin(), g_orthrosUpdated.end(), name) == g_orthrosUpdated.end())
+        g_orthrosUpdated.push_back(std::move(name));
+    return 1;
+}
+
+// Orthros: the rendering's view distance (game units), as the Lua camera.setViewDistance(): applied at the next frame,
+// not saved in the settings (Options' "viewing distance" applies the setting's again). Returns 1 when applied, 0 before
+// the game's main loop or for a distance that is not a positive finite number.
+extern "C" EMSCRIPTEN_KEEPALIVE int orthros_set_view_distance(float distance)
+{
+    if (!g_emArg || !std::isfinite(distance) || !(distance > 0.f))
+        return 0;
+    MWRender::RenderingManager* rendering = MWBase::Environment::get().getWorld()->getRenderingManager();
+    if (!rendering)
+        return 0;
+    rendering->setViewDistance(distance, true);
+    return 1;
+}
