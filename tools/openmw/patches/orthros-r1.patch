+        // Orthros: the images of the files orthros_file_updated() named, read again, within the frame's budget
+        static void reloadUpdated(OMW::Engine* self)
+        {
+            std::size_t spent = 0;
+            int updated = 0, skipped = 0;
+            std::size_t pending = 0;
+            while (true)
+            {
+                std::string path;
+                {
+                    std::lock_guard<std::mutex> lock(g_orthrosUpdatedMutex);
+                    pending = g_orthrosUpdated.size();
+                    if (pending == 0 || spent >= g_orthrosReloadBudget)
+                        break;
+                    path = std::move(g_orthrosUpdated.front());
+                    g_orthrosUpdated.pop_front();
+                    --pending;
+                }
+                // A path of the engine's file system names the file of a data folder: its leading folders off until
+                // the VFS knows it (/mwdata/data files/textures/a.dds -> textures/a.dds)
+                std::string_view rest = path;
+                while (!rest.empty() && !self->mVFS->exists(VFS::Path::Normalized(rest)))
+                {
+                    const std::size_t slash = rest.find('/');
+                    rest = slash == std::string_view::npos ? std::string_view() : rest.substr(slash + 1);
+                }
+                std::size_t bytes = 0;
+                try
+                {
+                    if (!rest.empty())
+                        bytes = self->mResourceSystem->getImageManager()->reloadImage(VFS::Path::Normalized(rest));
+                }
+                catch (const std::exception& e)
+                {
+                    Log(Debug::Error) << "orthros_file_updated: " << path << ": " << e.what();
+                }
+                if (bytes)
+                    ++updated;
+                else
+                    ++skipped;
+                spent += bytes;
+            }
+            if (updated || skipped)
+            {
+                // clang-format off
+                EM_ASM({
+                    var s = globalThis.__orthrosTexReloads || (globalThis.__orthrosTexReloads = { updated: 0, skipped: 0, bytes: 0, pending: 0 });
+                    s.updated += $0;
+                    s.skipped += $1;
+                    s.bytes += $2;
+                    s.pending = $3;
+                }, updated, skipped, static_cast<double>(spent), static_cast<int>(pending));
+                // clang-format on
+            }
+        }
