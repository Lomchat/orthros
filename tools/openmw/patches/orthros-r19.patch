+                case GL_BGR: *dst++ = src[2]; *dst++ = src[1]; *dst++ = src[0]; break;
+                case GL_BGRA: *dst++ = src[2]; *dst++ = src[1]; *dst++ = src[0]; *dst++ = src[3]; break;
+                case GL_RED: *dst++ = src[0]; break;
+                case GL_ALPHA: *dst++ = src[3]; break;
+                default: *dst++ = src[0]; *dst++ = src[1]; break; // (GL_RG)
+            }
+        }
+    }
