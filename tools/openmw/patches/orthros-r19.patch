+#ifdef __EMSCRIPTEN__
+// Orthros (screenshot.patch): WebGL2's readPixels accepts only GL_RGBA/GL_UNSIGNED_BYTE on a normalized colour buffer
+// (plus the one implementation-chosen pair of GL_IMPLEMENTATION_COLOR_READ_FORMAT/TYPE); another unsigned byte format
