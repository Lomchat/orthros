+namespace
+{
+    struct OrthrosDrawThreadCounters
+    {
+        std::mutex mMutex;
+        std::condition_variable mChanged; // (a frame dispatched or swapped, a job queued or run)
+        unsigned long long mDispatched = 0;
+        unsigned long long mSwapped = 0;
+        std::deque<osg::ref_ptr<osg::GraphicsOperation>> mJobs;
+        bool mJobRunning = false;
+        // statistics: the page thread's waits for the draw thread (the end of the frame's dynamic draw), ms
+        double mDynWaitMs = 0;
+        double mDynWaitMax = 0;
+        double mQuiesceMs = 0;
+        unsigned mQuiesces = 0;
+        unsigned mFrames = 0;
+        unsigned mJobsRun = 0;
+        double mJobsMs = 0;
+        // frames drawn before pending jobs (a frame dispatched waits for no job queued before it, at most once: the
+        // jobs then run first), and the jobs' ms before a frame the page waited for vs. between frames
+        unsigned mJobsDeferred = 0;
+        bool mJobsYielded = false;
+        // the window's size when each frame was dispatched (the page thread), its drawing buffer sized at its draw
+        int mSizes[64][2] = {};
+        // the graphics thread's time on each frame, ms: from the later of its gate's exit and the end of the frame's
+        // culls to its swap (a frame's first draws can overlap the culls of its other cameras: a lower bound).
+        // Appended by the graphics thread, handed to the page (__omwDrawThread.drawMs) with the statistics above.
+        double mCulledTimes[64] = {};
+        double mGateExit = 0;
+        std::vector<float> mDrawMs;
+        // the frames' timeline (emscripten_get_now ms; __omwDrawThread.tlPage / tlDraw, page time): the page thread's
+        // [seq, dispatch, culls' end, wait start, wait end] (its own), the graphics thread's [seq, start of the pump
+        // that drew it, gate exit, culls' end, dynamic draw done (the page released), swap, completions]
+        std::vector<double> mPageTl;
+        std::vector<double> mDrawTl;
+        double mPumpT0 = 0;      // (the graphics thread's: its current pump's start)
+        double mCompletedAt = 0; // (the frame drawn: when its last dynamic object was drawn, OrthrosEndOfDynamicDrawBlock)
+        unsigned mCompletions = 0;
+    };
+
+    // The page thread's wait for the frame's dynamic objects (osg::EndOfDynamicDrawBlock), the moment it ends noted
+    // (the graphics thread, Renderer::draw: at the draw's start when the frame has no DYNAMIC drawable or state set)
+    struct OrthrosEndOfDynamicDrawBlock : public osg::EndOfDynamicDrawBlock
+    {
+        explicit OrthrosEndOfDynamicDrawBlock(unsigned int count) : osg::EndOfDynamicDrawBlock(count) {}
+        void completed(osg::State* state) override;
+    };
+
+    OrthrosDrawThreadCounters& orthrosDrawThreadCounters()
+    {
+        static OrthrosDrawThreadCounters* counters = new OrthrosDrawThreadCounters; // (never destroyed: threads)
+        return *counters;
+    }
+
+    // Set once the graphics thread made its context current (OrthrosGraphicsThread::run, before it returns to its event
+    // loop). Creating a WebGL context on a worker waits for a task of the page thread's event loop
+    // (Chromium creates the context provider there), and the page thread does not return to its event loop during the
+    // engine's synchronous boot (main() -> Engine::go(), loading screens included): a page thread waiting for the
+    // graphics thread's draws then would wait for ever. So the context is made before main() runs, on the worker that
+    // runs the graphics thread (wasm-build/orthros-gl.js, orthrosDrawWorker; handed to the graphics thread below,
+    // orthros_drawthread_claim), and startThreading() waits for this flag (or the failure's) before it returns: the
+    // boot's loading screens draw on the graphics thread, their program compiles (OPENMW_ORTHROS_PRECOMPILE) and
+    // incremental uploads with them, as on the page's thread. renderingTraversals() still draws nothing until it is set
+    // (no wait for frames that cannot come: a context made otherwise — no context made before main() — needs the end of
+    // the boot).
+    std::atomic<bool> sOrthrosContextReady{ false };
+    // Set instead when the graphics thread could not make its context (no WebGL2 on a worker's OffscreenCanvas):
+    // renderingTraversals() then ends the session with the page's fatal notice (never a draw without a context).
+    std::atomic<bool> sOrthrosContextFailed{ false };
+    // Set when startThreading() started a graphics thread for DrawThreadPerContext (the session's model: never
+    // changed after, setThreadingModel below).
+    std::atomic<bool> sOrthrosDrawThreadInUse{ false };
+
+    // The graphics thread (set before its context is ready, so before any wake: the page thread dispatches no frame and
+    // queues no job until then), a pump task proxied to it and not run yet (one at most), and the pump's counts
+    // (published with the statistics: __omwDrawThread.wakes / pumps / pumpFrames)
+    std::atomic<pthread_t> sOrthrosDrawPthread{ 0 };
+    std::atomic<bool> sOrthrosPumpQueued{ false };
+    std::atomic<unsigned> sOrthrosWakes{ 0 };
+    std::atomic<unsigned> sOrthrosPumps{ 0 };
+    // the pumps' own time (start to stop, ms), the pumps that ran no operation, and the delay of the next turn (from
+    // its MessageChannel post to the pump it runs, ms: total and max) — __omwDrawThread.pumpMs / emptyPumps / turnMs /
+    // turnMax / turnRuns
+    std::atomic<double> sOrthrosPumpMs{ 0 };
+    std::atomic<unsigned> sOrthrosEmptyPumps{ 0 };
+    std::atomic<double> sOrthrosTurnMs{ 0 };
+    std::atomic<double> sOrthrosTurnMax{ 0 };
+    std::atomic<unsigned> sOrthrosTurnRuns{ 0 };
+    // a wake could not reach the graphics thread (emscripten_proxy_async refused: the thread is gone): the session
+    // ends with the page's notice — renderingTraversals dispatches no more frames, no job is queued
+    std::atomic<bool> sOrthrosWakeFailed{ false };
+
+    // The frames' timeline (tlPage / tlDraw below) is a measuring probe: recorded and published only with
+    // OPENMW_ORTHROS_DTTIMELINE=1 (tools/openmw/perf.mjs asks for it), read once. Off, a frame costs no insert and no
+    // array is kept on the page.
+    bool orthrosTimelineOn()
+    {
+        static const bool on = [] {
+            const char* v = getenv("OPENMW_ORTHROS_DTTIMELINE");
+            return v != nullptr && v[0] == '1';
+        }();
+        return on;
+    }
+
+    // (the page thread's own: set by renderingTraversals from a frame's dispatch to the end of its culls) Inside that
+    // window the graphics thread may be blocked in Renderer::draw's queue on this very thread's cull, so a job queued
+    // from there and waited for would never run: orthrosDrawThreadRun refuses a waited job then.
+    thread_local bool tOrthrosInCull = false;
+
+    // (the graphics thread, a task of its event loop: Emscripten's mailbox) the pump: OrthrosGraphicsThread::pump below.
+    // The only place that clears the queued flag — before the pump looks at the work: a wake after this point proxies
+    // another task, one before it is seen by this pump. (The pump's next turn, a MessageChannel task, leaves the flag
+    // alone: a task proxied meanwhile is still on its way.)
+    void orthrosPumpTask(void*)
+    {
+        sOrthrosPumpQueued.store(false);
+        orthros_drawthread_pump_js();
+    }
+
+    // (any thread) the graphics thread has work — a frame dispatched, a job queued, the page's kick: one pump task
+    // proxied to it, unless one is queued and not run yet. Never waits: the proxied task reaches the worker through
+    // Atomics.waitAsync (Emscripten's mailbox), no step of the page's event loop — a page thread then waiting for the
+    // draw thread does not deadlock. False when the task could not be proxied (sOrthrosWakeFailed set).
+    bool orthrosDrawThreadWake()
+    {
+        const pthread_t thread = sOrthrosDrawPthread.load();
+        if (thread == 0 || sOrthrosPumpQueued.exchange(true))
+            return true;
+        ++sOrthrosWakes;
+        if (!emscripten_proxy_async(emscripten_proxy_get_system_queue(), thread, orthrosPumpTask, nullptr))
+        {
+            sOrthrosPumpQueued.store(false);
+            if (!sOrthrosWakeFailed.exchange(true))
+                OSG_FATAL << "Orthros: the draw thread could not be woken (emscripten_proxy_async failed): the session ends"
+                          << std::endl;
+            return false;
+        }
+        return true;
+    }
+
+    // (the graphics thread, before each frame's draws) the jobs handed meanwhile run, until a frame is dispatched.
+    // Never waits: pass() is false when there is nothing to do (no frame dispatched, no job) — the graphics thread then
+    // returns to its event loop until a wake (OrthrosGraphicsThread::pump)
+    struct OrthrosFrameGate : public osg::GraphicsOperation
+    {
+        OrthrosFrameGate() : osg::GraphicsOperation("OrthrosFrameGate", true) {}
+        // (only a stock GraphicsThread's OperationThread::run calls this — OrthrosGraphicsThread::pump calls pass(),
+        // startThreading always installs it: never expected. r8v's blocking wait then, rather than a busy loop.)
+        void operator()(osg::GraphicsContext* context) override
+        {
+            static std::atomic<bool> told{ false };
+            if (!told.exchange(true))
+                OSG_WARN << "Orthros: the frame gate runs outside OrthrosGraphicsThread::pump: it blocks between frames"
+                         << std::endl;
+            OrthrosDrawThreadCounters& c = orthrosDrawThreadCounters();
+            while (!pass(context))
+            {
+                std::unique_lock<std::mutex> lock(c.mMutex);
+                if (c.mDispatched == c.mSwapped && c.mJobs.empty())
+                    c.mChanged.wait(lock);
+            }
+        }
+        bool pass(osg::GraphicsContext* context)
+        {
+            OrthrosDrawThreadCounters& c = orthrosDrawThreadCounters();
+            std::unique_lock<std::mutex> lock(c.mMutex);
+            while (true)
+            {
+                // (a frame dispatched first: the page thread waits for its dynamic draw, _endDynamicDrawBlock — the
+                // jobs queued meanwhile run after its swap, at the next pass here; once only: a page dispatching faster
+                // than this thread draws would starve them, so jobs passed over once run before the next frame)
+                if (c.mDispatched > c.mSwapped && (c.mJobs.empty() || !c.mJobsYielded))
+                {
+                    if (!c.mJobs.empty())
+                    {
+                        c.mJobsYielded = true;
+                        ++c.mJobsDeferred;
+                    }
+                    break;
+                }
+                if (!c.mJobs.empty())
+                {
+                    c.mJobsYielded = false;
+                    double ms = 0;
+                    {
+                        osg::ref_ptr<osg::GraphicsOperation> job = std::move(c.mJobs.front());
+                        c.mJobs.pop_front();
+                        c.mJobRunning = true;
+                        lock.unlock();
+                        const double t0 = emscripten_get_now();
+                        (*job)(context);
+                        ms = emscripten_get_now() - t0;
+                    }
+                    lock.lock();
+                    c.mJobRunning = false;
+                    ++c.mJobsRun;
+                    c.mJobsMs += ms;
+                    c.mChanged.notify_all();
+                    continue;
+                }
+                // (nothing to do: the newest frame held back posted if the page showed the previous one meanwhile —
+                // orthros_drawthread_kick wakes this thread then —, and back to the event loop)
+                lock.unlock();
+                orthros_drawthread_flush_held();
+                lock.lock();
+                if (c.mDispatched > c.mSwapped || !c.mJobs.empty())
+                    continue;
+                return false;
+            }
+            c.mGateExit = emscripten_get_now();
+            c.mCompletedAt = 0;
+            c.mCompletions = 0;
+            const int width = c.mSizes[c.mSwapped % 64][0], height = c.mSizes[c.mSwapped % 64][1];
+            lock.unlock();
+            orthros_drawthread_resize(width, height);
+            return true;
+        }
+    };
+
+    // SwapBuffersOperation, then the frame counted as swapped (the graphics thread)
+    struct OrthrosCountedSwap : public osg::GraphicsOperation
+    {
+        OrthrosCountedSwap() : osg::GraphicsOperation("OrthrosCountedSwap", true) {}
+        void operator()(osg::GraphicsContext* context) override
+        {
+            if (context)
+            {
+                context->swapBuffersImplementation();
+                context->clear();
+            }
+            const double now = emscripten_get_now();
+            OrthrosDrawThreadCounters& c = orthrosDrawThreadCounters();
+            {
+                std::lock_guard<std::mutex> lock(c.mMutex);
+                const double culled = c.mCulledTimes[c.mSwapped % 64];
+                const double start = culled > c.mGateExit ? culled : c.mGateExit;
+                if (c.mDrawMs.size() < 4096) c.mDrawMs.push_back(static_cast<float>(now - start));
+                if (orthrosTimelineOn() && c.mDrawTl.size() < 7 * 4096)
+                    c.mDrawTl.insert(c.mDrawTl.end(), { static_cast<double>(c.mSwapped + 1), c.mPumpT0, c.mGateExit,
+                        culled, c.mCompletedAt, now, static_cast<double>(c.mCompletions) });
+                ++c.mSwapped;
+            }
+            c.mChanged.notify_all();
+        }
+    };
+
+    // The graphics thread of DrawThreadPerContext on the web: event-driven (the file's head). run() makes the context
+    // current, says so (startThreading's wait), then returns to the worker's event loop for good
+    // (emscripten_exit_with_live_runtime: the pthread stays, isRunning() stays true; no C++ object alive across it).
+    // Each pump() — a task of that event loop — runs the thread's operation queue as OperationThread::run would (the
+    // gate, the frame's draws, the swap, and any operation added to the queue, in order), but stops at the gate when
+    // it has nothing to do, and after one frame swapped: the next frame's operations run in the worker's next task
+    // (orthros_drawthread_defer), so the worker returns to its event loop between any two frames and Chrome frees the
+    // bitmaps the page has replaced. A frame dispatched while this thread draws the previous one waits for that turn
+    // only (no frame of latency added). Operations run with no queue lock held, as in OperationThread::run.
+    class OrthrosGraphicsThread : public osg::GraphicsThread
+    {
+    public:
+        void run() override
+        {
+            bool ready = false;
+            {
+                osg::GraphicsContext* context = dynamic_cast<osg::GraphicsContext*>(getParent());
+                if (context)
+                {
+                    context->makeCurrent();
+                    context->getState()->initializeExtensionProcs();
+                }
+                // (makeCurrent's failure is ignored, as GraphicsThread::run does: a context current on this thread is
+                // the proof it was made)
+                ready = emscripten_webgl_get_current_context() != 0;
+                if (ready && !orthros_drawthread_event_setup())
+                {
+                    // (never here in Chrome: orthros-gl.js gives no draw thread without Atomics.waitAsync)
+                    OSG_FATAL << "Orthros: no Atomics.waitAsync for the draw thread's wakes" << std::endl;
+                    ready = false;
+                }
+                if (ready)
+                    sOrthrosDrawPthread.store(pthread_self());
+                (ready ? sOrthrosContextReady : sOrthrosContextFailed).store(true);
+                OrthrosDrawThreadCounters& c = orthrosDrawThreadCounters();
