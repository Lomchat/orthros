+// Orthros (drawthread.patch, OPENMW_ORTHROS_DRAWTHREAD; the engine selects DrawThreadPerContext with it, and only with
+// it, on the web — this file only reacts to that threading model). The web build's graphics thread owns its own WebGL
+// context (an OffscreenCanvas of the pthread, components/sdlutil/sdlgraphicswindow.cpp) and the page thread has none
+// once threading started: stopThreading() cannot hand the context back to the page thread and a new graphics thread
+// would be a new pthread with an empty context. So, with DrawThreadPerContext on the web:
+// - stopThreading() only waits until every frame the page thread dispatched has been drawn and swapped and every
+//   draw-thread job (below) has run (nothing in flight while its caller changes shared state, the reason OpenMW calls
+//   it), the graphics thread kept; startThreading() is then a no-op (_threadsRunning stays true);
+// - the graphics thread waits between frames in a gate of its own (OrthrosFrameGate, before the frame's draws) and not
+//   in the Renderer's draw queue: there it runs the jobs the page thread hands it (orthrosDrawThreadRun: WebGL work
+//   between frames — the uploads ahead, the global map's read), at once, a frame dispatched or not; a page thread
+//   waiting for a job never waits for a frame it has not dispatched. (A GraphicsContext::add operation, after the swap
+//   in the graphics thread's queue, would wait for the next frame.)
+// - the graphics thread is event-driven (OrthrosGraphicsThread, below): once its context is current it returns to its
+//   worker's event loop (emscripten_exit_with_live_runtime) and never blocks there between frames; its operations
+//   (the gate, the frame's draws, the swap) run in tasks — a frame dispatched, a job queued or the page's kick wakes it
+//   with one task proxied to it (orthrosDrawThreadWake: emscripten_proxy_async on the system queue, from any thread,
+//   through Atomics.waitAsync on the worker: no step of the page's event loop), and each task draws at most one frame,
+//   the next frame's in the worker's next task (a MessageChannel self-post: no timer clamp). A task may still block
+//   inside, as the draws wait for the frame's culls. Why: Chrome releases a transferred ImageBitmap's GPU memory through
+//   a task on the worker that made it — a worker that never returns to its event loop leaks every frame it posts
+//   (~4 MB each at 1280x800).
+// The threading model is fixed for the session (setThreadingModel) and the web build never destroys its viewer
+// (~Viewer's close would cancel a graphics thread that is never in its loop).
+
+// (the page thread) the draw thread's worker, made before main() with its WebGL2 context (wasm-build/orthros-gl.js:
+// Module.orthrosDrawWorker): 1 when ready and its context's attributes are the page context's
+// (components/sdlutil/sdlgraphicswindow.cpp compared them); 0 — none asked for, -1 — not made (refused, or no
+// answer), -2 — attributes that differ
+// clang-format off
+EM_JS(int, orthros_drawthread_prepared, (), {
+    var p = Module['orthrosDrawWorker'];
+    if (!p || !p.worker) return p && p.state == 'failed' ? -1 : 0;
+    if (p.state != 'ready') return -1;
+    if (p.claimed) return -3;
+    return p.compatible === false ? -2 : 1;
+});
+
+// (the page thread) that worker handed to the next pthread made: the pool's next one (Emscripten 6.0.1's
+// PThread.getNewWorker takes the last of unusedWorkers); 1 when handed
+EM_JS(int, orthros_drawthread_claim, (), {
+    var p = Module['orthrosDrawWorker'];
+    if (!p || !p.worker || p.claimed || p.state != 'ready') return 0;
+    p.claimed = true;
+    PThread.unusedWorkers.push(p.worker);
+    return 1;
+});
+
+// (the page thread) that worker not used: its context lost (its memory freed), the worker given to the pool — or, not
+// ready (its preparation failed or never answered), ended: a worker never handed to the pool
+EM_JS(void, orthros_drawthread_release, (), {
+    var p = Module['orthrosDrawWorker'];
+    if (!p || !p.worker || p.claimed) return;
+    p.claimed = true;
+    try { p.worker.postMessage({ orthrosDrawRelease: 1 }); } catch (e) {}
+    if (p.state == 'ready') PThread.unusedWorkers.push(p.worker);
+    else { try { p.worker.terminate(); } catch (e) {} }
+});
+
+// (the graphics thread, at its gate's exit for a frame) the drawing buffer sized for that frame before its draws: the
+// size of the window when the page thread dispatched it (a resize takes effect on the frame culled with it, as the
+// page canvas resized synchronously by SDL does without the draw thread). Resizing clears the buffer: nothing drawn yet.
+EM_JS(void, orthros_drawthread_resize, (int width, int height), {
+    var s = globalThis.__omwDrawThreadGL;
+    if (!s || width <= 0 || height <= 0) return;
+    if (s.canvas.width !== width) s.canvas.width = width;
+    if (s.canvas.height !== height) s.canvas.height = height;
+});
+
+// (the graphics thread, its gate with nothing to do) the newest frame held back while the page had not shown the previous one
+// (components/sdlutil/sdlgraphicswindow.cpp, orthros_drawthread_present) posted as soon as the page has shown it — the
+// page shows the newest frame drawn, as the page's canvas shows the last frame drawn in a task without the draw thread
+EM_JS(void, orthros_drawthread_flush_held, (), {
+    var s = globalThis.__omwDrawThreadGL;
+    if (s && s.held && s.flushHeld) s.flushHeld();
+});
+
+// (the page thread) the session ended with the page's fatal notice (play/index.html's fatalOverlay: it stops the engine's
+// main loop, at each call — none before the boot's end —, and shows its panel once): the draw thread has no context.
+// Not the engine's quit (the viewer's done): the page restarts on a quit — a reload, the same failure again, for ever.
+EM_JS(void, orthros_drawthread_fatal, (), {
+    try {
+        if (typeof fatalOverlay === 'function')
+            fatalOverlay('Graphics unavailable', 'This browser could not draw the game on a worker thread. '
+                + 'Reload with ?omwenv=OPENMW_ORTHROS_DRAWTHREAD=0 to draw it on the page.');
+    } catch (e) {}
+});
+
+// (the graphics thread, once its context is current, before it returns to its event loop) its pump's JavaScript side:
+// pump() runs orthros_drawthread_pump (a task proxied to this thread, or the next turn below) — a crash inside (a trap,
+// an abort) told to the page as the thread's crash: its notice (components/sdlutil/sdlgraphicswindow.cpp's `crashed`)
+// and Emscripten's crashed-thread flag, which unwinds the page thread out of its waits for this thread (a task run from
+// the mailbox's promise or a MessageChannel never reaches the worker's own crash path); defer() — the pump again in
+// the worker's next task (a MessageChannel self-post: no timer clamp), one outstanding at most; busy() — a frame drawn
+// in this task already (its next turn pending). Anything thrown out of a pump — a trap, an abort, an exception, even
+// an 'unwind' (this thread never unwinds out of a pump: its pump state would stay "in a pump" and every later frame
+// wait for ever) — is the thread's crash. 0 when Emscripten's mailbox has no Atomics.waitAsync (polyfilled: a task
+// proxied to this thread would be relayed through the page thread's event loop, which a page thread waiting for this
+// thread never reaches — wasm-build/orthros-gl.js checks it first, the session then draws on the page)
+EM_JS(int, orthros_drawthread_event_setup, (), {
+    if (typeof waitAsyncPolyfilled != 'undefined' && waitAsyncPolyfilled) return 0;
+    if (globalThis.__omwDrawThreadTurn) return 1;
+    var t = globalThis.__omwDrawThreadTurn = { posted: false, again: false, turns: 0, pumps: 0, inPump: false };
+    t.pump = function() {
+        t.pumps++;
+        t.inPump = true;
+        try {
+            _orthros_drawthread_pump();
+        } catch (e) {
+            var s = globalThis.__omwDrawThreadGL;
+            var what = e === 'unwind' ? 'unwound out of a pump' : ((e && (e.message || e)) || 'error');
+            try { if (s && s.crashed) s.crashed(what); } catch (x) {}
+            try { if (typeof __emscripten_thread_crashed === 'function') __emscripten_thread_crashed(); } catch (x) {}
+            throw e;
+        } finally {
+            t.inPump = false;
+        }
+    };
+    var channel = new MessageChannel();
+    channel.port1.onmessage = function() {
+        t.posted = false;
+        t.turns++;
+        if (t.again) {
+            t.again = false;
+            t.pump();
+        }
+    };
+    t.defer = function() {
+        t.again = true;
+        if (!t.posted) {
+            t.posted = true;
+            channel.port2.postMessage(0);
+        }
+    };
+    return 1;
+});
+
+EM_JS(void, orthros_drawthread_pump_js, (), {
+    var t = globalThis.__omwDrawThreadTurn;
+    if (t) t.pump();
+});
+
+EM_JS(int, orthros_drawthread_turn_busy, (), {
+    var t = globalThis.__omwDrawThreadTurn;
+    return t && t.posted ? 1 : 0;
+});
+
+EM_JS(void, orthros_drawthread_defer, (), {
+    var t = globalThis.__omwDrawThreadTurn;
+    if (t) t.defer();
+});
+// clang-format on
