+{
+    // the bytes per pixel of an unsigned byte format converted from RGBA here, 0 if not converted
+    unsigned int orthrosChannelsFromRGBA(GLenum format)
+    {
+        switch (format)
+        {
+            case GL_RGB: case GL_BGR: return 3;
+            case GL_BGRA: return 4;
+            case GL_RED: case GL_ALPHA: return 1;
+#ifdef GL_RG
+            case GL_RG: return 2;
+#endif
+            default: return 0;
+        }
+    }
