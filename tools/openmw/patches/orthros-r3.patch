+        osg::ref_ptr<WorkItem> held(item);
+        {
+            std::unique_lock<std::mutex> lock(mMutex);
+            const auto found = std::find_if(
+                mQueue.begin(), mQueue.end(), [&](const osg::ref_ptr<WorkItem>& queued) { return queued == item; });
+            if (found == mQueue.end())
+                return;
+            mQueue.erase(found);
+        }
+        item->mCooperativeQueue = nullptr;
+        while (!item->doWorkSlice(std::chrono::steady_clock::time_point::max()))
+        {
+        }
+        item->signalDone();
+    }
