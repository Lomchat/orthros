+    void WorkQueue::runCooperative(double budgetMs)
+    {
+        if (!mCooperative)
+            return;
+        const auto deadline = std::chrono::steady_clock::now()
+            + std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+                std::chrono::duration<double, std::milli>(budgetMs));
+        do
+        {
+            osg::ref_ptr<WorkItem> item;
+            {
+                std::unique_lock<std::mutex> lock(mMutex);
+                if (mQueue.empty())
+                    return;
+                item = std::move(mQueue.front());
+                mQueue.pop_front();
+            }
+            // (the item off the queue while it runs: its work may queue others, or wait for others, finishNow)
+            item->mCooperativeQueue = nullptr;
+            const bool done = item->doWorkSlice(deadline);
+            if (done)
+            {
+                item->signalDone();
+                continue;
+            }
+            // (part done: first again at the next frame, waitTillDone() still finishing it if asked)
+            item->mCooperativeQueue = this;
+            std::unique_lock<std::mutex> lock(mMutex);
+            mQueue.push_front(std::move(item));
+            return;
+        } while (std::chrono::steady_clock::now() < deadline);
+    }
