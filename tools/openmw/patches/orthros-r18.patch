+namespace
+{
+    // (the frame's start, under orthros_jspi_enter: the debug asks since the last frame — omw_debug_coe, then
+    // omw_debug_teleport —, each one's time told to the page: globalThis.orthrosDebugRan[kind] = [start, end])
+    void orthrosRunDebugAsks()
+    {
+        if (!g_debugAsks.mCoe && !g_debugAsks.mTeleport)
+            return;
+        // (a COE is a load: in a plain frame, put off to the next one, promising — orthros_jspi_defer)
+        if (g_debugAsks.mCoe && orthros_jspi_defer())
+            return;
+        const OrthrosDebugAsks asks = g_debugAsks;
+        g_debugAsks = OrthrosDebugAsks{};
+        // (the page's clock — emscripten_get_now() is the epoch's in a build with threads)
+        const auto pageNow = [] { return EM_ASM_DOUBLE({ return performance.now(); }); };
+        const auto ran = [](const char* kind, double start) {
+            // clang-format off
+            // (no comma in the script: the macro's arguments)
+            EM_ASM({
+                var ran = globalThis.orthrosDebugRan || (globalThis.orthrosDebugRan = {});
+                var span = Array.of($1); span.push(performance.now()); ran[UTF8ToString($0)] = span;
+            }, kind, start);
+            // clang-format on
+        };
+        if (asks.mCoe)
+        {
+            const double start = pageNow();
+            orthrosDebugCoe(asks.mX, asks.mY);
+            ran("coe", start);
+        }
+        if (asks.mTeleport)
+        {
+            const double start = pageNow();
+            auto world = MWBase::Environment::get().getWorld();
+            MWWorld::Ptr p = world->getPlayerPtr();
