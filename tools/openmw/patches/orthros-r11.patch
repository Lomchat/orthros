@@ -222,6 +222,8 @@ ninja apps/openmw/CMakeFiles/openmw.dir/main.cpp.o
   -lopenal \
   `# Orthros (orthros-r9.patch): the OpenAL library's per-frame costs on the page's thread (wasm-build/orthros-openal.js)` \
   --js-library "$ROOT/wasm-build/orthros-openal.js" \
+  `# Orthros (orthros-r11.patch): the WebGL glue's per-call costs (wasm-build/orthros-gl.js; ENV OPENMW_ORTHROS_GLGLUE=0: off)` \
+  --js-library "$ROOT/wasm-build/orthros-gl.js" \
   --use-port=sdl2 --use-port=freetype --use-port=harfbuzz --use-port=libpng \
   --use-port=libjpeg --use-port=zlib --use-port=ogg --use-port=vorbis \
   -sALLOW_MEMORY_GROWTH=1 -sMAX_WEBGL_VERSION=2 -sMIN_WEBGL_VERSION=2 -sFULL_ES3=1 \
diff --git a/wasm-build/orthros-gl.js b/wasm-build/orthros-gl.js
new file mode 100644
index 0000000..8a718c3
--- /dev/null
+++ b/wasm-build/orthros-gl.js
@@ -0,0 +1,237 @@
+// Orthros (orthros-r11.patch): per-call costs of Emscripten's WebGL glue (src/lib/libwebgl.js, libwebgl2.js and
+// libint53.js, Emscripten 6.0.1) in this MEMORY64 + pthreads + ALLOW_MEMORY_GROWTH + FULL_ES3 build, found in OpenMW
+// frames (Seyda Neen, tier mid: ~5,800 WebGL calls a frame; growMemViews 1.6 %, bigintToI53Checked 1.4 %, the
+// getParameter of glBindVertexArray 0.75 %, the client-side array checks of every draw 0.4 % of the engine's busy
+// time). Linked after the system libraries (--js-library, link-openmw.sh): its entries replace theirs of the same name,
+// whose __sig and __deps stay (deps are only added to).
+//
+// Switch: ENV.OPENMW_ORTHROS_GLGLUE, read once, when the first WebGL context is registered (the page fills ENV in
+// preRun, before main() creates the context). "0": every replaced entry runs the library's own body, kept below as
+// orthrosGLOrig_<name>; absent or anything else: the paths below. Same WebGL calls with the same arguments either way.
+//
+// - Heap reads. With growable shared memory every HEAPxx access is (growMemViews(), HEAPxx), and growMemViews reads
+//   wasmMemory.buffer, a getter: glUniformMatrix3fv did it 9 times a matrix, glUniform1fv/1iv once an element. A view
+//   of a SharedArrayBuffer stays valid when the memory grows (a shared buffer is never detached: growth gives a longer
+//   one), so the glue keeps its own views and takes the current one only when a call reaches past their end. Small
+//   uploads still go through the pool's views (miniTempWebGL*Buffers), larger ones through a view of the heap: the
+//   WebGL overloads of before (the garbage-free ones with a heap offset stay off, as the link chose: crbug.com/324992397).
+// - glBindVertexArray asked WebGL for the VAO's element array buffer (getParameter(ELEMENT_ARRAY_BUFFER_BINDING), one a
+//   VAO bind: all ~390 getParameter a frame, from osg::Drawable::draw) to keep FULL_ES3's mirror of it,
+//   GLctx.currentElementArrayBufferBinding. The glue records that binding per VAO where WebGL changes it:
+//   glBindBuffer(GL_ELEMENT_ARRAY_BUFFER), glDeleteVertexArrays of the bound VAO (WebGL reverts to the default one) and
+//   glDrawElements' client-side index path (it leaves null bound). The mirror is the recorded buffer's .name | 0, as
+//   it was the returned one's: a deleted buffer has name 0 whether WebGL still returns it or null. A buffer's first
+//   bind to that target is checked once with getParameter (WebGL refuses a buffer already used as other data).
+// - FULL_ES3's client-side vertex arrays: glDrawArrays/glDrawElements looped over every attribute (16) to find enabled
+//   client-side ones. The glue counts them where they change (glVertexAttrib[I]Pointer, gl{En,Dis}ableVertexAttribArray);
+//   with none, a draw with an element array buffer bound (or glDrawArrays) is the WebGL call alone.
+// - bigintToI53Checked (every pointer argument): two BigInt-Number comparisons, then the conversion. The conversion now
+//   comes first; the comparisons only run for a result at or past +-2^53 (same result; ~2.5x faster in V8).
+
+(() => {
+  // The library's own bodies, kept under $orthrosGLOrig_<name> (no __sig: they take the arguments already converted).
+  // The replaced entries' deps gain their kept body, the switch and the helper they call.
+  const lib = LibraryManager.library;
+  const kept = {};
+  for (const [name, helper] of [
+    ['glUniform1fv', '$orthrosGLFloats'], ['glUniform2fv', '$orthrosGLFloats'],
+    ['glUniform3fv', '$orthrosGLFloats'], ['glUniform4fv', '$orthrosGLFloats'],
+    ['glUniform1iv', '$orthrosGLInts'], ['glUniform2iv', '$orthrosGLInts'],
+    ['glUniform3iv', '$orthrosGLInts'], ['glUniform4iv', '$orthrosGLInts'],
+    ['glUniformMatrix2fv', '$orthrosGLFloats'], ['glUniformMatrix3fv', '$orthrosGLFloats'],
+    ['glUniformMatrix4fv', '$orthrosGLFloats'],
+    ['glBufferSubData'], ['glBindBuffer'], ['glBindVertexArray'], ['glDeleteVertexArrays'],
+    ['glVertexAttribPointer'], ['glVertexAttribIPointer'], ['glEnableVertexAttribArray'], ['glDisableVertexAttribArray'],
+    ['glDrawArrays'], ['glDrawElements'],
+  ]) {
+    const sym = 'emscripten_' + name;
+    if (typeof lib[sym] != 'function') throw new Error(`orthros-gl.js: no library function ${sym}`);
+    kept['$orthrosGLOrig_' + name] = lib[sym];
+    kept['$orthrosGLOrig_' + name + '__deps'] = lib[sym + '__deps'] || [];
+    kept[sym + '__deps'] = (lib[sym + '__deps'] || []).concat(
+      ['$orthrosGLOrig_' + name, '$orthrosGLGlue'], helper ? [helper] : []);
+  }
+  addToLibrary(kept);
+})();
+
+addToLibrary({
+  // undefined until the first context is registered, then true (on) or false ("0").
+  $orthrosGLGlue: undefined,
+  $orthrosGLGlue__deps: ['$GL', '$ENV'],
+  $orthrosGLGlue__postset: `
+    var orthrosGLHeapU8 = new Uint8Array(0), orthrosGLHeap32 = new Int32Array(0), orthrosGLHeapF32 = new Float32Array(0);
+    var orthrosGLRegisterContext = GL.registerContext;
+    GL.registerContext = (ctx, webGLContextAttributes) => {
+      if (orthrosGLGlue === undefined) orthrosGLGlue = ENV['OPENMW_ORTHROS_GLGLUE'] !== '0';
+      var handle = orthrosGLRegisterContext(ctx, webGLContextAttributes);
+      // enabled client-side attributes (clientBuffers[i].enabled && .clientside), kept by the entries below
+      if (handle) GL.contexts[handle].orthrosClientAttribs = 0;
+      return handle;
+    };
+  `,
+
+  // n (> 0) floats at byte address value: the pool's view of that length filled from the heap, or a view of the heap
+  // above the pool's size (as the library's glUniform*fv do).
+  $orthrosGLFloats__deps: ['$orthrosGLGlue', '$miniTempWebGLFloatBuffers'],
+  $orthrosGLFloats: (value, n) => {
+    var src = value / 4, heap = orthrosGLHeapF32;
+    if (src + n > heap.length) heap = orthrosGLHeapF32 = HEAPF32;
+    if (n <= 288) {
+      var view = miniTempWebGLFloatBuffers[n];
+      for (var i = 0; i < n; ++i) view[i] = heap[src + i];
+      return view;
+    }
+    return heap.subarray(src, src + n);
+  },
+  $orthrosGLInts__deps: ['$orthrosGLGlue', '$miniTempWebGLIntBuffers'],
+  $orthrosGLInts: (value, n) => {
+    var src = value / 4, heap = orthrosGLHeap32;
+    if (src + n > heap.length) heap = orthrosGLHeap32 = HEAP32;
+    if (n <= 288) {
+      var view = miniTempWebGLIntBuffers[n];
+      for (var i = 0; i < n; ++i) view[i] = heap[src + i];
+      return view;
+    }
+    return heap.subarray(src, src + n);
+  },
+
+  // count <= 0 keeps the library's body (its errors and exceptions as they were).
+  emscripten_glUniform1fv: (location, count, value) => {
+    if (!orthrosGLGlue || count <= 0) return orthrosGLOrig_glUniform1fv(location, count, value);
+    GLctx.uniform1fv(webglGetUniformLocation(location), orthrosGLFloats(value, count));
+  },
+  emscripten_glUniform2fv: (location, count, value) => {
+    if (!orthrosGLGlue || count <= 0) return orthrosGLOrig_glUniform2fv(location, count, value);
+    GLctx.uniform2fv(webglGetUniformLocation(location), orthrosGLFloats(value, count * 2));
+  },
+  emscripten_glUniform3fv: (location, count, value) => {
+    if (!orthrosGLGlue || count <= 0) return orthrosGLOrig_glUniform3fv(location, count, value);
+    GLctx.uniform3fv(webglGetUniformLocation(location), orthrosGLFloats(value, count * 3));
+  },
+  emscripten_glUniform4fv: (location, count, value) => {
+    if (!orthrosGLGlue || count <= 0) return orthrosGLOrig_glUniform4fv(location, count, value);
+    GLctx.uniform4fv(webglGetUniformLocation(location), orthrosGLFloats(value, count * 4));
+  },
+  emscripten_glUniform1iv: (location, count, value) => {
+    if (!orthrosGLGlue || count <= 0) return orthrosGLOrig_glUniform1iv(location, count, value);
+    GLctx.uniform1iv(webglGetUniformLocation(location), orthrosGLInts(value, count));
+  },
+  emscripten_glUniform2iv: (location, count, value) => {
+    if (!orthrosGLGlue || count <= 0) return orthrosGLOrig_glUniform2iv(location, count, value);
+    GLctx.uniform2iv(webglGetUniformLocation(location), orthrosGLInts(value, count * 2));
+  },
+  emscripten_glUniform3iv: (location, count, value) => {
+    if (!orthrosGLGlue || count <= 0) return orthrosGLOrig_glUniform3iv(location, count, value);
+    GLctx.uniform3iv(webglGetUniformLocation(location), orthrosGLInts(value, count * 3));
+  },
+  emscripten_glUniform4iv: (location, count, value) => {
+    if (!orthrosGLGlue || count <= 0) return orthrosGLOrig_glUniform4iv(location, count, value);
+    GLctx.uniform4iv(webglGetUniformLocation(location), orthrosGLInts(value, count * 4));
+  },
+  emscripten_glUniformMatrix2fv: (location, count, transpose, value) => {
+    if (!orthrosGLGlue || count <= 0) return orthrosGLOrig_glUniformMatrix2fv(location, count, transpose, value);
+    GLctx.uniformMatrix2fv(webglGetUniformLocation(location), !!transpose, orthrosGLFloats(value, count * 4));
+  },
+  emscripten_glUniformMatrix3fv: (location, count, transpose, value) => {
+    if (!orthrosGLGlue || count <= 0) return orthrosGLOrig_glUniformMatrix3fv(location, count, transpose, value);
+    GLctx.uniformMatrix3fv(webglGetUniformLocation(location), !!transpose, orthrosGLFloats(value, count * 9));
+  },
+  emscripten_glUniformMatrix4fv: (location, count, transpose, value) => {
+    if (!orthrosGLGlue || count <= 0) return orthrosGLOrig_glUniformMatrix4fv(location, count, transpose, value);
+    GLctx.uniformMatrix4fv(webglGetUniformLocation(location), !!transpose, orthrosGLFloats(value, count * 16));
+  },
+  // the WebGL 1 overload, as webglBufferSubData's (a view of the bytes)
+  emscripten_glBufferSubData: (target, offset, size, data) => {
+    if (!orthrosGLGlue) return orthrosGLOrig_glBufferSubData(target, offset, size, data);
+    var heap = orthrosGLHeapU8;
+    if (data + size > heap.length) heap = orthrosGLHeapU8 = HEAPU8;
+    GLctx.bufferSubData(target, offset, heap.subarray(data, data + size));
+  },
+
+  // The element array buffer binding of each VAO: vao.orthrosIbo, the default VAO's GLctx.orthrosIbo; the bound VAO:
+  // GLctx.orthrosVao (null: the default one).
+  emscripten_glBindBuffer: (target, buffer) => {
+    orthrosGLOrig_glBindBuffer(target, buffer);
+    if (orthrosGLGlue && target == 0x8893 /*GL_ELEMENT_ARRAY_BUFFER*/) {
+      // what the library bound (it creates the buffer of an unknown nonzero name)
+      var b = GL.buffers[buffer] || null;
+      if (b && !b.orthrosElementArray) {
+        var bound = GLctx.getParameter(0x8895 /*GL_ELEMENT_ARRAY_BUFFER_BINDING*/);
+        if (bound === b) b.orthrosElementArray = true; // WebGL's type for it now: binding it there again succeeds
+        else b = bound;
+      }
+      (GLctx.orthrosVao || GLctx).orthrosIbo = b;
+    }
+  },
+  emscripten_glBindVertexArray: (vao) => {
+    if (!orthrosGLGlue) return orthrosGLOrig_glBindVertexArray(vao);
+    var v = GL.vaos[vao];
+    GLctx.bindVertexArray(v);
+    GLctx.orthrosVao = v || null;
+    var ibo = (v || GLctx).orthrosIbo;
+    GLctx.currentElementArrayBufferBinding = ibo ? (ibo.name | 0) : 0;
+  },
+  emscripten_glDeleteVertexArrays: (n, vaos) => {
+    if (orthrosGLGlue && GLctx.orthrosVao) {
+      for (var i = 0; i < n; i++) {
+        if (GL.vaos[HEAP32[(vaos + i * 4) / 4]] === GLctx.orthrosVao) GLctx.orthrosVao = null;
+      }
+    }
+    orthrosGLOrig_glDeleteVertexArrays(n, vaos);
+  },
+
+  emscripten_glVertexAttribPointer: (index, size, type, normalized, stride, ptr) => {
+    if (!orthrosGLGlue) return orthrosGLOrig_glVertexAttribPointer(index, size, type, normalized, stride, ptr);
+    var context = GL.currentContext, cb = context.clientBuffers[index], was = !!(cb && cb.clientside && cb.enabled);
+    orthrosGLOrig_glVertexAttribPointer(index, size, type, normalized, stride, ptr);
+    if (!!(cb.clientside && cb.enabled) !== was) context.orthrosClientAttribs += was ? -1 : 1;
+  },
+  emscripten_glVertexAttribIPointer: (index, size, type, stride, ptr) => {
+    if (!orthrosGLGlue) return orthrosGLOrig_glVertexAttribIPointer(index, size, type, stride, ptr);
+    var context = GL.currentContext, cb = context.clientBuffers[index], was = !!(cb && cb.clientside && cb.enabled);
+    orthrosGLOrig_glVertexAttribIPointer(index, size, type, stride, ptr);
+    if (!!(cb.clientside && cb.enabled) !== was) context.orthrosClientAttribs += was ? -1 : 1;
+  },
+  emscripten_glEnableVertexAttribArray: (index) => {
+    if (!orthrosGLGlue) return orthrosGLOrig_glEnableVertexAttribArray(index);
+    var context = GL.currentContext, cb = context.clientBuffers[index];
+    if (cb && cb.clientside && !cb.enabled) context.orthrosClientAttribs++;
+    orthrosGLOrig_glEnableVertexAttribArray(index);
+  },
+  emscripten_glDisableVertexAttribArray: (index) => {
+    if (!orthrosGLGlue) return orthrosGLOrig_glDisableVertexAttribArray(index);
+    var context = GL.currentContext, cb = context.clientBuffers[index];
+    if (cb && cb.clientside && cb.enabled) context.orthrosClientAttribs--;
+    orthrosGLOrig_glDisableVertexAttribArray(index);
+  },
+  emscripten_glDrawArrays: (mode, first, count) => {
+    if (orthrosGLGlue && !GL.currentContext.orthrosClientAttribs) {
+      GLctx.drawArrays(mode, first, count);
+      return;
+    }
+    orthrosGLOrig_glDrawArrays(mode, first, count);
+  },
+  emscripten_glDrawElements: (mode, count, type, indices) => {
+    if (!orthrosGLGlue) return orthrosGLOrig_glDrawElements(mode, count, type, indices);
+    if (GLctx.currentElementArrayBufferBinding) {
+      if (!GL.currentContext.orthrosClientAttribs) {
+        GLctx.drawElements(mode, count, type, indices);
+        return;
+      }
+      orthrosGLOrig_glDrawElements(mode, count, type, indices);
+      return;
+    }
+    // the client-side index path: a temporary index buffer is bound, null after the draw
+    orthrosGLOrig_glDrawElements(mode, count, type, indices);
+    (GLctx.orthrosVao || GLctx).orthrosIbo = null;
+  },
+
+  $bigintToI53Checked__deps: ['$INT53_MAX', '$INT53_MIN', '$orthrosGLGlue'],
+  $bigintToI53Checked: (num) => {
+    if (orthrosGLGlue) {
+      var n = Number(num);
+      if (n > -9007199254740992 && n < 9007199254740992) return n;
+    }
+    return (num < INT53_MIN || num > INT53_MAX) ? NaN : Number(num);
+  },
+});
