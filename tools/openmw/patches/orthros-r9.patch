diff --git a/wasm-build/build-deps.sh b/wasm-build/build-deps.sh
index e304e69..3609bd9 100755
--- a/wasm-build/build-deps.sh
+++ b/wasm-build/build-deps.sh
@@ -234,7 +234,10 @@ build_lua() {
   cd "$SRC/lua-5.4.7/src"
   rm -f ./*.o
   # Compile every core/lib .c except the standalone driver (lua.c) and compiler (luac.c).
-  for c in *.c; do case "$c" in lua.c|luac.c) ;; *) emcc $CFLAGS_COMMON -c "$c" -o "${c%.c}.o";; esac; done
+  # Orthros (orthros-r9.patch): LUA_COMPAT_MATHLIB keeps math.atan2, pow, cosh, sinh, tanh, frexp, ldexp and log10,
+  # which desktop OpenMW's LuaJIT has and mods call (UI Modes' NPC turning: math.atan2 every frame of a dialogue —
+  # a Lua error each frame without it). Only lmathlib.c reads the macro.
+  for c in *.c; do case "$c" in lua.c|luac.c) ;; *) emcc $CFLAGS_COMMON -DLUA_COMPAT_MATHLIB -c "$c" -o "${c%.c}.o";; esac; done
   emar rcs "$DW/lib/liblua.a" $(ls *.o | grep -vE '^(lua|luac)\.o$')
   cp -f lua.h luaconf.h lualib.h lauxlib.h ../src/lua.hpp "$DW/include/" 2>/dev/null || \
     cp -f lua.h luaconf.h lualib.h lauxlib.h "$DW/include/"
