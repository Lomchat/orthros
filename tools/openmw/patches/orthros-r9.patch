diff --git a/wasm-build/orthros-openal.js b/wasm-build/orthros-openal.js
new file mode 100644
index 0000000..0c28134
--- /dev/null
+++ b/wasm-build/orthros-openal.js
@@ -0,0 +1,130 @@
+// Orthros (orthros-r9.patch): two costs of Emscripten's OpenAL (src/lib/libopenal.js, Emscripten 6.0.1) on the page's
+// thread, found in OpenMW frames (Orthros' tools/openmw/perf.mjs --profile, Seyda Neen: AL.updateSourceSpace ~5 % of
+// the engine's busy time, alBufferData ~2 %). Linked after the system library (--js-library, link-openmw.sh): its
+// entries replace the library's own of the same name.
+//
+// - The listener. Every alListener* call (OpenMW sets the position and the orientation each frame) ran
+//   AL.updateSourceSpace on every source that has a panner, which reads six AudioParams and may write them. A source in
+//   world coordinates (not AL_SOURCE_RELATIVE) does not move with the listener: WebAudio places it, and its panner
+//   was set when its own position or direction changed (setSourceParam, initSourcePanner). Only its Doppler shift
+//   depends on the listener: those sources now get that alone, computed as updateSourceSpace computes it. Relative
+//   sources go through updateSourceSpace as before.
+// - alBufferData. Its conversion loops read the heap through growMemViews() at every sample (the growable shared
+//   memory's check, wasmMemory.buffer's getter each time). The heap view is taken once a call. The 16- and 32-bit
+//   views are indexed by division, not `>>`, which wraps a pointer past 2 GiB under MEMORY64.
+addToLibrary({
+  $AL__postset: `
+    AL.orthrosSourceDoppler = (src) => {
+      var listener = src.context.listener;
+      var posX = src.position[0], posY = src.position[1], posZ = src.position[2];
+      var lPosX = listener.position[0], lPosY = listener.position[1], lPosZ = listener.position[2];
+      var oldShift = src.dopplerShift;
+      var velX = src.velocity[0], velY = src.velocity[1], velZ = src.velocity[2];
+      var lVelX = listener.velocity[0], lVelY = listener.velocity[1], lVelZ = listener.velocity[2];
+      if (posX === lPosX && posY === lPosY && posZ === lPosZ
+        || velX === lVelX && velY === lVelY && velZ === lVelZ) {
+        src.dopplerShift = 1.0;
+      } else {
+        var speedOfSound = src.context.speedOfSound;
+        var dopplerFactor = src.context.dopplerFactor;
+        var slX = lPosX - posX, slY = lPosY - posY, slZ = lPosZ - posZ;
+        var magSl = Math.sqrt(slX * slX + slY * slY + slZ * slZ);
+        var vls = (slX * lVelX + slY * lVelY + slZ * lVelZ) / magSl;
+        var vss = (slX * velX + slY * velY + slZ * velZ) / magSl;
+        vls = Math.min(vls, speedOfSound / dopplerFactor);
+        vss = Math.min(vss, speedOfSound / dopplerFactor);
+        src.dopplerShift = (speedOfSound - dopplerFactor * vls) / (speedOfSound - dopplerFactor * vss);
+      }
+      if (src.dopplerShift !== oldShift) {
+        AL.updateSourceRate(src);
+      }
+    };
+    AL.updateListenerSpace = (ctx) => {
+      var listener = ctx.audioCtx.listener;
+      if (listener.positionX) {
+        listener.positionX.value = ctx.listener.position[0];
+        listener.positionY.value = ctx.listener.position[1];
+        listener.positionZ.value = ctx.listener.position[2];
+      } else {
+        listener.setPosition(ctx.listener.position[0], ctx.listener.position[1], ctx.listener.position[2]);
+      }
+      if (listener.forwardX) {
+        listener.forwardX.value = ctx.listener.direction[0];
+        listener.forwardY.value = ctx.listener.direction[1];
+        listener.forwardZ.value = ctx.listener.direction[2];
+        listener.upX.value = ctx.listener.up[0];
+        listener.upY.value = ctx.listener.up[1];
+        listener.upZ.value = ctx.listener.up[2];
+      } else {
+        listener.setOrientation(
+          ctx.listener.direction[0], ctx.listener.direction[1], ctx.listener.direction[2],
+          ctx.listener.up[0], ctx.listener.up[1], ctx.listener.up[2]);
+      }
+      for (var i in ctx.sources) {
+        var src = ctx.sources[i];
+        if (!src.panner) continue;
+        if (src.relative) AL.updateSourceSpace(src);
+        else AL.orthrosSourceDoppler(src);
+      }
+    };
+  `,
+
+  alBufferData: (bufferId, format, pData, size, freq) => {
+    if (!AL.currentCtx) {
+      return;
+    }
+    var buf = AL.buffers[bufferId];
+    if (!buf || freq <= 0) {
+      AL.currentCtx.err = {{{ cDefs.AL_INVALID_VALUE }}};
+      return;
+    }
+    // [channels, bytes a sample] of the formats the library takes
+    var layout = {
+      0x1100 /* AL_FORMAT_MONO8 */: [1, 1], 0x1101 /* AL_FORMAT_MONO16 */: [1, 2],
+      0x1102 /* AL_FORMAT_STEREO8 */: [2, 1], 0x1103 /* AL_FORMAT_STEREO16 */: [2, 2],
+      0x10010 /* AL_FORMAT_MONO_FLOAT32 */: [1, 4], 0x10011 /* AL_FORMAT_STEREO_FLOAT32 */: [2, 4],
+    }[format];
+    if (!layout) {
+      AL.currentCtx.err = {{{ cDefs.AL_INVALID_VALUE }}};
+      return;
+    }
+    var channels = layout[0], bytes = layout[1];
+    var frames = Math.floor(size / (channels * bytes)), count = frames * channels;
+    var audioBuf = null;
+    try {
+      if (size > 0) {
+        audioBuf = AL.currentCtx.audioCtx.createBuffer(channels, frames, freq);
+        var out0 = audioBuf.getChannelData(0), out1 = channels === 2 ? audioBuf.getChannelData(1) : null, i, k;
+        if (bytes === 1) {
+          var u8 = HEAPU8.subarray(pData, pData + count);
+          if (!out1) for (i = 0; i < frames; ++i) out0[i] = u8[i] * 0.0078125 /* 1/128 */ - 1.0;
+          else for (i = 0, k = 0; i < frames; ++i, k += 2) {
+            out0[i] = u8[k] * 0.0078125 - 1.0;
+            out1[i] = u8[k + 1] * 0.0078125 - 1.0;
+          }
+        } else if (bytes === 2) {
+          var s16 = HEAP16.subarray(pData / 2, pData / 2 + count);
+          if (!out1) for (i = 0; i < frames; ++i) out0[i] = s16[i] * 0.000030517578125 /* 1/32768 */;
+          else for (i = 0, k = 0; i < frames; ++i, k += 2) {
+            out0[i] = s16[k] * 0.000030517578125;
+            out1[i] = s16[k + 1] * 0.000030517578125;
+          }
+        } else {
+          var f32 = HEAPF32.subarray(pData / 4, pData / 4 + count);
+          if (!out1) out0.set(f32);
+          else for (i = 0, k = 0; i < frames; ++i, k += 2) {
+            out0[i] = f32[k];
+            out1[i] = f32[k + 1];
+          }
+        }
+      }
+      buf.bytesPerSample = bytes;
+      buf.channels = channels;
+      buf.length = frames;
+      buf.frequency = freq;
+      buf.audioBuf = audioBuf;
+    } catch (e) {
+      AL.currentCtx.err = {{{ cDefs.AL_INVALID_VALUE }}};
+    }
+  },
+});
