+        std::erase_if(pending->second, [&](const VFS::Path::Normalized& model) { return mSceneManager->orthrosTemplateReady(model); });
+        if (!pending->second.empty())
+            return false;
+        mOrthrosPending.erase(pending);
+        return true;
+    }
