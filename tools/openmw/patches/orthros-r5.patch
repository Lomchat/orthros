+            return true;
+        Nif::NIFFilePtr file;
+        try
+        {
+            file = mNifFileManager->get(path);
+        }
+        catch (const std::exception&)
+        {
+            return true; // (getTemplate reports it)
+        }
+        // (every texture the file names, each asked: the missing ones all on their way at once)
+        bool ready = true;
+        for (const auto& record : file->mRecords)
+        {
+            if (!record || record->mRecordType != Nif::RC_NiSourceTexture)
+                continue;
+            const auto* texture = static_cast<const Nif::NiSourceTexture*>(record.get());
+            if (!texture->mExternal || texture->mFile.empty())
+                continue;
+            const VFS::Path::Normalized image
+                = Misc::ResourceHelpers::correctTexturePath(VFS::Path::toNormalized(texture->mFile), *mVFS);
+            if (!mImageManager->orthrosCached(image) && !mVFS->orthrosDataReady(image))
+                ready = false;
+        }
+        return ready;
+    }
