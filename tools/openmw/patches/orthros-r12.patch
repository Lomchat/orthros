+void Program::PerContextProgram::orthrosApplyValue(OrthrosUniformSlot& s, const Uniform& uniform) const
+{
+    // Orthros (orthros-r12.patch): a changed uniform (another one, or the same one set() again) often carries the bytes
+    // its location already holds — the normal matrix of a draw like the last one, a material's colours, a light count:
+    // 724 of ~1,600 glUniform* a frame at Seyda Neen (mid tier). A program's uniform storage changes only through a
+    // glUniform* while it is current — each of them made here (one slot a location; linkProgram registers base names
+    // only) or followed by resetAppliedUniforms (debugdraw's own) — or through a relink; both make the slots anew,
+    // their records not valid. So the call last made here, made again (same GL API type, element count and bytes),
+    // would set the elements it covers to the values they hold: skipped. The words compared as 32-bit integers, not
+    // floats (-0 and +0 differ, a NaN equals its own bits), as GL holds them. Not recorded (valid false, the call
+    // always made): 64-bit types (GL_DOUBLE, GL_INT64_ARB, GL_UNSIGNED_INT64_ARB), no array, no element, more than 16
+    // words, an array shorter than the call reads.
+    const Uniform::Type uniformType = uniform.getType();
+    const unsigned int num = uniform.getNumElements();
+    const void* data = 0;
+    unsigned int size = 0;
+    switch (Uniform::getInternalArrayType(uniformType))
+    {
+    case GL_FLOAT:
+        if (const FloatArray* array = uniform.getFloatArray()) { size = array->getNumElements(); data = array->getDataPointer(); }
+        break;
+    case GL_INT:
+        if (const IntArray* array = uniform.getIntArray()) { size = array->getNumElements(); data = array->getDataPointer(); }
+        break;
+    case GL_UNSIGNED_INT:
+        if (const UIntArray* array = uniform.getUIntArray()) { size = array->getNumElements(); data = array->getDataPointer(); }
+        break;
+    default:
+        break;
+    }
+    // (num checked before the product: no overflow)
+    const unsigned int words = (num >= 1 && num <= 16) ? num * static_cast<unsigned int>(Uniform::getTypeNumComponents(uniformType)) : 0;
+    if (data && words >= 1 && words <= 16 && size >= words)
+    {
+        const Uniform::Type type = Uniform::getGlApiType(uniformType);
+        const unsigned char* bytes = static_cast<const unsigned char*>(data);
+        bool same = s.valid && s.type == type && s.num == num && s.words == words;
+        for (unsigned int i = 0; same && i < words; ++i)
+        {
+            GLuint word;
+            memcpy(&word, bytes + i * sizeof(GLuint), sizeof(GLuint));
+            same = word == s.value[i];
+        }
+        if (same)
+        {
+            s.uniform = &uniform;
+            s.modifiedCount = uniform.getModifiedCount();
+            return;
+        }
+        memcpy(s.value, bytes, words * sizeof(GLuint));
+        s.type = type;
+        s.num = num;
+        s.words = words;
+        s.valid = true;
+    }
+    else
+    {
+        s.valid = false;
+    }
+    uniform.apply(_extensions.get(), s.location);
+    s.uniform = &uniform;
+    s.modifiedCount = uniform.getModifiedCount();
+}
