+            p.compiled = $0; p.ms = $1; p.finishCompiled = $2; p.finishMs = $3; p.left = $4; p.withDefines = $5;
+            p.passes = $6; p.registered = $7; p.unapplied = $8; p.lateBefore = $9; p.lateOld = $10; p.lateNew = $11;
+            p.skippedDying = $12; p.offThread = $13; p.appliedAfter = $14;
+        }, r.compiled, r.ms, r.finishCompiled, r.finishMs, r.left, r.withDefines, r.passes, (int)r.serials.size(),
