+    void PostProcessor::orthrosPrecompile(const std::shared_ptr<Fx::Technique>& technique)
+    {
+        // Orthros (OPENMW_ORTHROS_FXPROGRAMS): a technique a Lua script loads (postprocessing.load) and enables later,
+        // e.g. at the first sprint, had its programs compiled and linked at the first frame drawing it - a frame of
+        // several hundred milliseconds on WebGL. Its passes' programs (the ones prepareStateSet will give: Fx::Pass
+        // keeps them) go to the incremental compile operation now, which compiles them on this (GL) thread within its
+        // per-frame budget, or all at once under the loading screen. Linking a program draws nothing. "0": compiled at
+        // the first draw, as before.
+        if (!technique || !Fx::Pass::orthrosKeepsPrograms() || !technique->isValid()
+            || technique->getGLSLVersion() > mGLSLVersion)
+            return;
+        osgUtil::IncrementalCompileOperation* ico = mViewer->getIncrementalCompileOperation();
+        if (!ico)
+            return;
+        osg::ref_ptr<osg::Group> group = new osg::Group;
+        const std::string name = technique->getName();
+        for (const auto& pass : technique->getPasses())
+        {
+            osg::ref_ptr<osg::Group> node = new osg::Group;
+            node->getOrCreateStateSet()->setAttribute(pass->getProgram(name));
+            group->addChild(node);
+        }
+        osgUtil::StateToCompile stateToCompile(osgUtil::GLObjectsVisitor::COMPILE_STATE_ATTRIBUTES, nullptr);
+        group->accept(stateToCompile);
+        if (stateToCompile.empty())
+            return;
+        osg::ref_ptr<osgUtil::IncrementalCompileOperation::CompileSet> compileSet
+            = new osgUtil::IncrementalCompileOperation::CompileSet(group);
+        compileSet->buildCompileMap(ico->getContextSet(), stateToCompile);
+        ico->add(compileSet.get(), false);
+    }
