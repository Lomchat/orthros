+    struct OrthrosProgramRegistry
+    {
+        std::recursive_mutex mutex;
+        unsigned long long nextSerial = 1;
+        std::unordered_map<const Program*, unsigned long long> serials;
+        std::map<unsigned long long, const Program*> bySerial;
+        // (GL thread only, under the mutex) compiled by a pass and not applied by a draw since
+        std::unordered_set<const Program*> precompiledUnapplied;
+        // (its size, read by Program::apply without the lock)
+        std::atomic<size_t> unappliedSize{ 0 };
+        // the serial given last when the latest Finish pass ran (0: none yet)
+        unsigned long long finishSerial = 0;
+        // counters (published to the page)
+        unsigned int compiled = 0, finishCompiled = 0, passes = 0, offThread = 0;
+        double ms = 0.0, finishMs = 0.0;
+        int left = 0, withDefines = 0, skippedDying = 0;
+        unsigned int lateBefore = 0, lateOld = 0, lateNew = 0, appliedAfter = 0;
+        std::thread::id glThread;
+        bool glThreadKnown = false;
+    };
+
+    OrthrosProgramRegistry& orthrosProgramRegistry()
+    {
+        // (never destroyed: Programs may outlive static destruction order)
+        static OrthrosProgramRegistry* registry = new OrthrosProgramRegistry;
+        return *registry;
+    }
+
+    void orthrosNoteThread(OrthrosProgramRegistry& r)
+    {
+        // (a counter only: a Program made or destroyed off the GL thread, e.g. by Lua's GC; safe, see above)
+        if (r.glThreadKnown && std::this_thread::get_id() != r.glThread) ++r.offThread;
+    }
+
+    void orthrosRegisterProgram(const Program* program)
+    {
+        if (!osg::orthrosPrecompileEnabled()) return;
+        OrthrosProgramRegistry& r = orthrosProgramRegistry();
+        std::lock_guard<std::recursive_mutex> lock(r.mutex);
+        orthrosNoteThread(r);
+        const unsigned long long serial = r.nextSerial++;
+        r.serials[program] = serial;
+        r.bySerial[serial] = program;
+    }
+
+    void orthrosUnregisterProgram(const Program* program)
+    {
+        if (!osg::orthrosPrecompileEnabled()) return;
+        OrthrosProgramRegistry& r = orthrosProgramRegistry();
+        std::lock_guard<std::recursive_mutex> lock(r.mutex);
+        orthrosNoteThread(r);
+        auto it = r.serials.find(program);
+        if (it != r.serials.end())
+        {
+            r.bySerial.erase(it->second);
+            r.serials.erase(it);
+        }
+        r.precompiledUnapplied.erase(program);
+        r.unappliedSize.store(r.precompiledUnapplied.size(), std::memory_order_relaxed);
+    }
