+// Orthros (OPENMW_ORTHROS_STATEGRAPHS; absent or anything but "0": on, read once): the cull's StateGraph tree keeps a
+// graph left without leaves for fewer than sOrthrosStateGraphKeep prunes in a row instead of erasing it at the first.
+// OSG's prune() at the end of every cull erases each graph whose subtree drew nothing, so a StateSet seen every other
+// cull -- r11's light list StateSets alternate between two a list, one an update's parity -- or an object culled for a
+// frame had its graph deleted and made again: a map erase, a destructor, an allocation and a map insert each time
+// (~0.1 ms a frame in Vanilla+). The draw never walks the tree (RenderBin's StateGraph lists hold the graphs given
+// leaves this cull, in the order the cull gave them, as before), and a kept graph reached again by find_or_insert takes
+// a new one's state (orthrosRevive), so the same leaves are drawn with the same states in the same order. A kept graph
+// holds its StateSet (ref_ptr) until it is erased: at most sOrthrosStateGraphKeep prunes of the same tree later -- the
+// tree of one camera (a render-to-texture camera's is pruned only when that camera is culled), not frames. A graph
+// whose StateSet nothing else references any more (its node unloaded) is erased at once: find_or_insert can never be
+// given that StateSet again, so keeping it would only hold the StateSet and its textures. "0": OSG's prune.
+static const unsigned int sOrthrosStateGraphKeep = 3;
+
+static bool orthrosReadStateGraphsSwitch()
+{
+    const char* value = getenv("OPENMW_ORTHROS_STATEGRAPHS");
+    const bool enabled = !(value && strcmp(value, "0") == 0);
+    if (enabled)
+    {
+        OSG_NOTICE << "Orthros: StateGraphs kept through " << sOrthrosStateGraphKeep << " prunes without leaves: on" << std::endl;
+    }
+    else
+    {
+        OSG_NOTICE << "Orthros: StateGraphs kept through prunes without leaves: off (OPENMW_ORTHROS_STATEGRAPHS=0)" << std::endl;
+    }
+    return enabled;
+}
+
+static bool orthrosStateGraphsEnabled()
+{
+    static const bool enabled = orthrosReadStateGraphsSwitch();
+    return enabled;
+}
+
+bool StateGraph::orthrosPrune(unsigned int keep)
+{
+    bool live = !_leaves.empty();
+    ChildList::iterator citr=_children.begin();
+    while(citr!=_children.end())
+    {
+        StateGraph* child = citr->second.get();
+        if (child->orthrosPrune(keep))
+        {
+            child->_orthrosIdlePrunes = 0;
+            live = true;
+            ++citr;
+        }
+        else if (++child->_orthrosIdlePrunes >= keep
+                 || (child->_stateset.valid() && child->_stateset->referenceCount() == 1))
+        {
+            ChildList::iterator ditr= citr++;
+            _children.erase(ditr);
+        }
+        else ++citr;
+    }
+    return live;
+}
+
