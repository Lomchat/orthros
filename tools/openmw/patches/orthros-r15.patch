+namespace osg
+{
+    /** Orthros: OPENMW_ORTHROS_PRECOMPILE read once (the page sets ENV before the engine starts); absent = on, 0 = off,
+     * off as well with OPENMW_WORKQUEUE_THREADED. Off: no Program is registered, nothing is precompiled. */
+    bool orthrosPrecompileEnabled()
+    {
+        static const bool enabled = orthrosReadPrecompileSwitch();
+        return enabled;
+    }
+
+    /** Orthros (OPENMW_ORTHROS_PRECOMPILE): compiles and links, on the State's context, the Programs that a draw would
+     * compile at its first apply: those with shaders whose per-context program is not linked yet (and not tried: a
+     * failed link is not tried again, as at a draw), in registration order. Only a program none of whose imported
+     * defines (#pragma import_defines / requires) is current in the State, so that the per-context program made is
+     * the one a draw without those defines selects; a program drawn with them (FORCE_OPAQUE, DISTORTION) is still
+     * compiled at its draw. budgetMs < 0: all of them; otherwise none is started once budgetMs have passed (one that
+     * has started runs to its end). finish: the pass at the first frame after a loading (counted apart; programs
+     * registered after it and compiled at a draw count as lateNew). Must run on the context's thread, between draws
+     * (compiling and linking leave the current program alone). Returns the number compiled. Not declared in an OSG
+     * header (the caller declares it), so that the change touches no header. */
+    unsigned int orthrosCompileUnlinkedPrograms(State& state, double budgetMs, bool finish)
+    {
+        if (!orthrosPrecompileEnabled()) return 0;
+        const GLExtensions* extensions = state.get<GLExtensions>();
+        if (!extensions || !extensions->isGlslSupported) return 0;
+        const Timer_t start = Timer::instance()->tick();
+        unsigned int compiled = 0;
+        int notStarted = 0, passedOver = 0;
+        OrthrosProgramRegistry& r = orthrosProgramRegistry();
+        std::lock_guard<std::recursive_mutex> lock(r.mutex);
+        r.glThread = std::this_thread::get_id();
+        r.glThreadKnown = true;
+        std::vector<std::pair<unsigned long long, const Program*>> order(r.bySerial.begin(), r.bySerial.end());
+        for (const auto& entry : order)
+        {
+            const Program* program = entry.second;
+            // (still registered: not destroyed by a compile of this pass)
+            auto it = r.serials.find(program);
+            if (it == r.serials.end() || it->second != entry.first) continue;
+            if (program->getNumShaders() == 0) continue;
+            // (multiview programs: built by the engine but never drawn in WebGL — no OVR_multiview2 — and not valid
+            // GLSL ES; compiling them ahead only logged a failure)
+            bool multiview = false;
+            for (unsigned int i = 0; i < program->getNumShaders() && !multiview; ++i)
+                multiview = program->getShader(i) && program->getShader(i)->getName().find("multiview") != std::string::npos;
+            if (multiview) continue;
+            if (program->referenceCount() <= 0)
+            {
+                ++r.skippedDying;
+                continue;
+            }
+            // (the program's imported defines are the union of its shaders': an empty string for it is an empty
+            // string for each of them, so the per-context shaders compiled are the ones that draw will use too)
+            if (!program->getShaderDefines().empty() && !state.getDefineString(program->getShaderDefines()).empty())
+            {
+                ++passedOver;
+                continue;
+            }
+            const Program::PerContextProgram* pcp = program->getPCP(state);
+            if (!pcp || !pcp->needsLink()) continue;
+            if (budgetMs >= 0 && Timer::instance()->delta_m(start, Timer::instance()->tick()) >= budgetMs)
+            {
+                ++notStarted;
+                continue;
+            }
+            program->compileGLObjects(state);
+            r.precompiledUnapplied.insert(program);
+            ++compiled;
+        }
+        r.unappliedSize.store(r.precompiledUnapplied.size(), std::memory_order_relaxed);
+        const double ms = Timer::instance()->delta_m(start, Timer::instance()->tick());
+        ++r.passes;
+        r.compiled += compiled;
+        r.ms += ms;
+        if (finish)
+        {
+            r.finishCompiled += compiled;
+            r.finishMs += ms;
+            r.finishSerial = r.nextSerial;
+        }
+        r.left = notStarted;
+        r.withDefines = passedOver;
+        orthrosPublish(r);
+        return compiled;
+    }
