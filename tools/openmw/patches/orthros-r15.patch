+    // Program::apply: the program drawn compiled by a pass (counted once), or compiled at this draw after all (late:
+    // before any Finish pass, or registered before the latest one — a define variant, a relink, a program the pass
+    // passed over — or registered since).
+    inline void orthrosNoteApply(const Program* program, bool late)
+    {
+        if (!osg::orthrosPrecompileEnabled()) return;
+        OrthrosProgramRegistry& r = orthrosProgramRegistry();
+        // (the usual case, a draw of a linked program once every precompiled one has been drawn: one atomic read)
