+    void LuaState::orthrosVerifyLoaded(
+        const sol::table& loaded, const std::map<std::string, sol::main_object>& packages, const std::string& envName)
+    {
+        // The previous code's table, rebuilt beside `loaded`: the same sets in the same order, with the previous
+        // code's own loader test made now; a loader's result is taken from `loaded` (a loader runs once per sandbox).
+        // Then both tables compared entry by entry (raw equality, both ways), and the kept common list checked against
+        // mCommonPackages (names, values, loader tests). So this checks the keys, the plain values and which packages
+        // are taken as loaders -- not a loader's result itself (a loader runs once): that, and the loaders' call order
+        // and arguments, are what the native harness (round 14, luainst.cpp) compares. Diagnosis only: it logs from
+        // the Lua thread; never in a measured run.
+        std::uint64_t diffs = 0;
+        auto differ = [&](const std::string& what) {
+            ++diffs;
+            Log(Debug::Error) << "Orthros: OPENMW_ORTHROS_LUAINST verify: " << envName << ": " << what;
+        };
+        if (!mOrthrosCommon)
+            orthrosBuildCommon(); // (dropped by an addCommonPackage during this sandbox's loaders)
+        const std::vector<OrthrosCommonPackage>& common = *mOrthrosCommon;
+        if (common.size() != mCommonPackages.size())
+            differ("common package count");
+        auto kept = common.begin();
+        for (const auto& [name, package] : mCommonPackages)
+        {
+            if (kept == common.end())
+                break;
+            const bool loader = package.is<sol::function>();
+            if (!kept->mKey.is<std::string>() || kept->mKey.as<std::string>() != name)
+                differ("common package name " + name);
+            if (loader != kept->mLoader.has_value())
+                differ("loader test of " + name);
+            kept->mValue.push();
+            package.push();
+            const bool sameValue = lua_rawequal(mSol.lua_state(), -1, -2) != 0;
+            lua_pop(mSol.lua_state(), 2);
+            if (!sameValue)
+                differ("common package value " + name);
+            ++kept;
+        }
+        sol::table reference(mSol, sol::create);
+        auto expected = [&](const std::string& name, const sol::object& package) -> sol::object {
+            if (package.is<sol::function>())
+                return loaded.raw_get<sol::object>(name);
+            return package;
+        };
+        for (const auto& [name, package] : mCommonPackages)
+            reference[name] = expected(name, package);
+        for (const auto& [name, package] : packages)
+            reference[name] = expected(name, package);
+        lua_State* L = mSol.lua_state();
+        std::uint64_t inReference = 0, inLoaded = 0;
+        auto count = [&](const sol::table& t, const sol::table& other, std::uint64_t& n, const char* side) {
+            t.push();
+            lua_pushnil(L);
+            while (lua_next(L, -2) != 0)
+            {
+                ++n;
+                other.push();
+                lua_pushvalue(L, -3);
+                lua_rawget(L, -2);
+                const bool same = lua_rawequal(L, -1, -3) != 0;
+                std::string key = lua_type(L, -4) == LUA_TSTRING ? lua_tostring(L, -4) : "(not a string)";
+                lua_pop(L, 3); // (other's value, other, the value: the key stays for lua_next)
+                if (!same)
+                    differ(std::string(side) + " entry " + key);
+            }
+            lua_pop(L, 1);
+        };
+        count(reference, loaded, inReference, "previous code's");
+        count(loaded, reference, inLoaded, "new");
+        if (inReference != inLoaded)
+            differ("entry counts");
+        ++mOrthrosVerifySandboxes;
+        mOrthrosVerifyEntries += inLoaded;
+        mOrthrosVerifyDiffs += diffs;
+        const std::uint64_t n = mOrthrosVerifySandboxes;
+        if (n <= 3 || n % 250 == 0 || diffs != 0)
+            Log(Debug::Info) << "Orthros: OPENMW_ORTHROS_LUAINST verify: " << n << " sandboxes, "
+                             << mOrthrosVerifyEntries << " entries compared, " << mOrthrosVerifyDiffs
+                             << " differences (last: " << envName << ", " << inLoaded << " entries)";
+    }
