+    struct ObjectPaging::OrthrosKeptRefs
+    {
+        using Refs = std::map<ESM::RefNum, PagedCellRef>;
+        static constexpr std::size_t kMaxChunks = 256;
+        static constexpr std::size_t kMaxRefs = 262144; // (about 25 MB at most)
+        struct Entry
+        {
+            Refs mRefs;
+            std::list<ChunkId>::iterator mOrder;
+            bool mFromFiles; // (listed by orthrosChunkFiles(), not chunkReady())
+        };
+        std::mutex mMutex;
+        std::map<ChunkId, Entry> mByChunk;
+        std::list<ChunkId> mOrder; // (oldest first)
+        std::size_t mRefs = 0;
+        std::uint64_t mKept = 0, mTaken = 0, mRead = 0, mDropped = 0, mChecked = 0, mCheckedFromFiles = 0,
+                      mDiffer = 0, mBuilds = 0;
+
+        void eraseLocked(std::map<ChunkId, Entry>::iterator it)
+        {
+            mRefs -= it->second.mRefs.size();
+            mOrder.erase(it->second.mOrder);
+            mByChunk.erase(it);
+        }
+
+        void keep(const ChunkId& id, Refs&& refs, bool fromFiles)
+        {
+            const std::lock_guard lock(mMutex);
+            if (const auto found = mByChunk.find(id); found != mByChunk.end())
+                eraseLocked(found); // (listed again: the same references, read anew)
+            if (refs.size() > kMaxRefs)
+            {
+                ++mDropped;
+                return;
+            }
+            while (!mOrder.empty() && (mByChunk.size() >= kMaxChunks || mRefs + refs.size() > kMaxRefs))
+            {
+                eraseLocked(mByChunk.find(mOrder.front()));
+                ++mDropped;
+            }
+            mOrder.push_back(id);
+            mRefs += refs.size();
+            mByChunk.emplace(id, Entry{ std::move(refs), std::prev(mOrder.end()), fromFiles });
+            ++mKept;
+        }
+
+        bool take(const ChunkId& id, Refs& refs, bool& fromFiles)
+        {
+            const std::lock_guard lock(mMutex);
+            const auto found = mByChunk.find(id);
+            if (found == mByChunk.end())
+            {
+                ++mRead;
+                return false;
+            }
+            fromFiles = found->second.mFromFiles;
+            Refs taken = std::move(found->second.mRefs);
+            found->second.mRefs = Refs();
+            mOrder.erase(found->second.mOrder);
+            mRefs -= taken.size();
+            mByChunk.erase(found);
+            refs = std::move(taken);
+            ++mTaken;
+            return true;
+        }
+
+        void check(const Refs& kept, const Refs& read, bool fromFiles)
+        {
+            const std::lock_guard lock(mMutex);
+            ++mChecked;
+            if (fromFiles)
+                ++mCheckedFromFiles;
+            bool same = kept.size() == read.size();
+            for (auto a = kept.begin(), b = read.begin(); same && a != kept.end(); ++a, ++b)
+                same = a->first == b->first && orthrosSameRef(a->second, b->second);
+            if (!same && ++mDiffer <= 5)
+                Log(Debug::Warning) << "Orthros: chunk references check: the references kept differ from those read ("
+                                    << kept.size() << " kept, " << read.size() << " read)";
+        }
+
+        void built()
+        {
+            const std::lock_guard lock(mMutex);
+            if (++mBuilds % 256 == 0)
+                Log(Debug::Info) << "Orthros: chunk references: " << mBuilds << " chunks built, " << mTaken
+                                 << " from their listing, " << mRead << " read, " << mKept << " kept, " << mDropped
+                                 << " dropped, " << mByChunk.size() << " held (" << mRefs << " references), "
+                                 << mChecked << " checked (" << mCheckedFromFiles << " listed by orthrosChunkFiles), "
+                                 << mDiffer << " different";
+        }
+
+        void clear()
+        {
+            const std::lock_guard lock(mMutex);
+            mByChunk.clear();
+            mOrder.clear();
+            mRefs = 0;
+        }
+    };
