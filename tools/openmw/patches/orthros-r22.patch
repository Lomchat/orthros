+    void LuaState::orthrosBuildCommon()
+    {
+        // (the previous code's test and conversion: maybeRunLoader's package.is<sol::function>() and the
+        // sol::protected_function that call() was given, made from package.as<sol::function>())
+        // (a new list, never the one in use changed: a loop over the previous one keeps it alive)
+        auto common = std::make_shared<std::vector<OrthrosCommonPackage>>();
+        common->reserve(mCommonPackages.size());
+        for (const auto& [name, package] : mCommonPackages)
+        {
+            OrthrosCommonPackage& p = common->emplace_back();
+            p.mName = name;
+            p.mKey = sol::make_object(mSol, name);
+            p.mValue = package;
+            if (package.is<sol::function>())
+                p.mLoader = sol::protected_function(package.as<sol::function>());
+        }
+        mOrthrosCommon = std::move(common);
+    }
