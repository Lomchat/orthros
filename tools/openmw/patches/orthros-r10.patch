+    // per armor type the best rating, per clothing type the most valuable (two rings), per weapon type (ammo too) the
+    // best damage. Not every item of the record: a merchant's stock (its restocking items, count < 0) would bring dozens
+    // of meshes and their textures into the load it never shows — but kept among the candidates, as autoEquip ranks
+    // them with the rest. Levelled lists left out (drawn later).
+    void orthrosNpcRecordModels(
+        const ESM::NPC& npc, const MWWorld::ESMStore& store, std::vector<std::string_view>& models)
+    {
+        const bool female = (npc.mFlags & ESM::NPC::Female) != 0;
+        const auto addParts = [&](const std::vector<ESM::PartReference>& parts) {
+            for (const ESM::PartReference& partRef : parts)
+            {
+                const ESM::RefId& partname = (female && !partRef.mFemale.empty()) || (!female && partRef.mMale.empty())
+                    ? partRef.mFemale
+                    : partRef.mMale;
+                const ESM::BodyPart* part = store.get<ESM::BodyPart>().search(partname);
+                if (part != nullptr && !part->mModel.getOriginal().empty())
+                    models.push_back(part->mModel.getOriginal());
+            }
+        };
+        std::map<int32_t, const ESM::Armor*> armor;
+        std::map<int32_t, std::vector<const ESM::Clothing*>> clothing;
+        std::map<int32_t, std::pair<int, const ESM::Weapon*>> weapons;
+        for (const ESM::ContItem& item : npc.mInventory.mList)
+        {
+            if (const ESM::Clothing* c = store.get<ESM::Clothing>().search(item.mItem))
+            {
+                std::vector<const ESM::Clothing*>& best = clothing[c->mData.mType];
+                best.push_back(c);
+                std::stable_sort(best.begin(), best.end(),
+                    [](const ESM::Clothing* a, const ESM::Clothing* b) { return a->mData.mValue > b->mData.mValue; });
+                best.resize(std::min<size_t>(best.size(), c->mData.mType == ESM::Clothing::Ring ? 2 : 1));
+            }
+            else if (const ESM::Armor* a = store.get<ESM::Armor>().search(item.mItem))
+            {
+                const ESM::Armor*& best = armor[a->mData.mType];
+                if (best == nullptr || a->mData.mArmor > best->mData.mArmor)
+                    best = a;
+            }
+            else if (const ESM::Weapon* w = store.get<ESM::Weapon>().search(item.mItem);
+                     w != nullptr && !w->mModel.getOriginal().empty())
+            {
+                const int damage = std::max({ w->mData.mChop[1], w->mData.mSlash[1], w->mData.mThrust[1] });
+                const auto it = weapons.find(w->mData.mType);
+                if (it == weapons.end() || damage > it->second.first)
+                    weapons[w->mData.mType] = { damage, w };
+            }
+        }
+        for (const auto& entry : armor)
+            addParts(entry.second->mParts.mParts);
+        for (const auto& entry : clothing)
+            for (const ESM::Clothing* c : entry.second)
+                addParts(c->mParts.mParts);
+        for (const auto& entry : weapons)
+            models.push_back(entry.second.second->mModel.getOriginal());
+    }
