+    void Scene::orthrosReadAhead(std::span<CellStore* const> cells, std::string_view place)
+    {
+#ifdef __EMSCRIPTEN__
+        if (cells.empty() || !VFS::orthrosReadAheadHooked())
+            return;
+        Resource::SceneManager& sceneManager = *mRendering.getResourceSystem()->getSceneManager();
+        const VFS::Manager& vfs = *sceneManager.getVFS();
+        // (the models as CellPreloader's ListModelsVisitor lists them — an NPC's equipped parts only once its
+        // inventory exists: before, what its record carries, orthrosNpcRecordModels)
+        const MWWorld::ESMStore& store = *MWBase::Environment::get().getESMStore();
+        std::vector<std::string_view> models;
+        std::vector<VFS::Path::Normalized> landTextures;
+        Terrain::World* terrain = mRendering.getTerrain();
+        for (CellStore* cell : cells)
+        {
+            cell->forEachConst([&](const ConstPtr& ptr) {
+                ptr.getClass().getModelsToPreload(ptr, models);
+                if (ptr.getType() == ESM::NPC::sRecordId && ptr.getRefData().getCustomData() == nullptr)
+                    orthrosNpcRecordModels(*ptr.get<ESM::NPC>()->mBase, store, models);
+                return true;
+            });
+            if (terrain != nullptr && cell->getCell()->isExterior())
+                terrain->getStorage()->orthrosLandTextures(cell->getCell()->getExteriorCellLocation(), landTextures);
+        }
+        std::sort(models.begin(), models.end());
+        models.erase(std::unique(models.begin(), models.end()), models.end());
+        // (each corrected as PreloadItem::preloadMesh does: the actor's x*.nif, and its .kf beside it)
+        std::vector<VFS::Path::Normalized> files;
+        constexpr VFS::Path::ExtensionView nif("nif");
+        constexpr VFS::Path::ExtensionView kf("kf");
+        for (const std::string_view model : models)
+        {
+            try
+            {
+                VFS::Path::Normalized mesh = Misc::ResourceHelpers::correctMeshPath(VFS::Path::Normalized(model));
+                mesh = Misc::ResourceHelpers::correctActorModelPath(mesh, &vfs);
+                if (!vfs.exists(mesh))
+                    continue;
+                if (Misc::getFileName(mesh).starts_with('x') && mesh.extension() == nif)
+                {
+                    VFS::Path::Normalized kfname = mesh;
+                    kfname.changeExtension(kf);
+                    if (vfs.exists(kfname))
+                        files.push_back(std::move(kfname));
+                }
+                files.push_back(std::move(mesh));
+            }
+            catch (const std::exception&)
+            {
+                // (the load reports it)
+            }
+        }
+        sceneManager.orthrosPrefetch(files, landTextures, place);
+#else
+        (void)cells;
+        (void)place;
+#endif
+    }
