+    void Storage::orthrosLandTextures(ESM::ExteriorCellLocation cellLocation, std::vector<VFS::Path::Normalized>& out)
+    {
+        if (ESM::isEsm4Ext(cellLocation.mWorldspace))
+            return;
+        const osg::ref_ptr<const LandObject> land = getLand(cellLocation);
+        std::set<UniqueTextureId> ids;
+        for (std::size_t y = 0; y < ESM::Land::LAND_TEXTURE_SIZE; ++y)
+            for (std::size_t x = 0; x < ESM::Land::LAND_TEXTURE_SIZE; ++x)
+                ids.insert(getTextureIdAt(land.get(), x, y));
+        for (const UniqueTextureId& id : ids)
+        {
+            Terrain::LayerInfo info = getLayerInfo(getTextureName(id));
+            out.push_back(std::move(info.mDiffuseMap));
+            if (!info.mNormalMap.empty())
+                out.push_back(std::move(info.mNormalMap));
+        }
+    }
