+    void SceneManager::orthrosPrefetch(std::span<const VFS::Path::Normalized> files,
+        std::span<const VFS::Path::Normalized> landTextures, std::string_view place)
+    {
+#ifdef __EMSCRIPTEN__
+        // (each wait bounded: past it the reads left wait one by one, as before; measured, 340 serial reads at a
+        // 90 ms round trip and 1.8 MB/s — 37 s — come in a few seconds fetched together)
+        constexpr double waitMs = 15000;
+        if (!VFS::orthrosReadAheadHooked())
+            return;
+        const auto start = std::chrono::steady_clock::now();
+        constexpr VFS::Path::ExtensionView nif("nif");
+        std::set<VFS::Path::Normalized, std::less<>> seen;
+        std::vector<VFS::Path::Normalized> wanted;
+        std::vector<VFS::Path::Normalized> nifs;
+        for (const auto& file : files)
+        {
+            if (!seen.insert(file).second || !mVFS->exists(file))
+                continue;
+            if (file.extension() == nif)
+            {
+                if (mCache->getRefFromObjectCache(file))
+                    continue; // (built already: its files read before)
+                nifs.push_back(file);
+            }
+            wanted.push_back(file);
+        }
+        const std::string meshesLabel = "meshes:" + std::string(place);
+        const std::size_t meshesMissing = mVFS->orthrosWillRead(wanted, meshesLabel);
+        const bool meshesHere = meshesMissing == 0 || VFS::orthrosReadWait(waitMs);
+        const auto meshesDone = std::chrono::steady_clock::now();
+
+        // (now local: each NIF parsed — kept by the NIF cache for getTemplate and the collision shapes — and the
+        // textures it names asked, those loaded already left out)
+        std::vector<VFS::Path::Normalized> textures;
+        for (const auto& file : nifs)
+            orthrosTexturesOf(file, textures);
+        std::erase_if(textures,
+            [&](const VFS::Path::Normalized& image) { return !seen.insert(image).second || mImageManager->orthrosCached(image); });
+        std::vector<VFS::Path::Normalized> land;
+        for (const auto& image : landTextures)
+            if (seen.insert(image).second && mVFS->exists(image) && !mImageManager->orthrosCached(image))
+                land.push_back(image);
+        const std::size_t texturesMissing = mVFS->orthrosWillRead(textures, "textures:" + std::string(place))
+            + mVFS->orthrosWillRead(land, "terrain:" + std::string(place));
+        const bool texturesHere = texturesMissing == 0 || VFS::orthrosReadWait(waitMs);
+        const auto ms = [](auto d) { return std::chrono::duration_cast<std::chrono::milliseconds>(d).count(); };
+        Log(Debug::Info) << "Orthros read-ahead " << place << ": " << wanted.size() << " meshes (" << meshesMissing
+                         << " fetched" << (meshesHere ? "" : ", timed out") << ") " << ms(meshesDone - start)
+                         << " ms, " << textures.size() << " textures + " << land.size() << " land (" << texturesMissing
+                         << " fetched" << (texturesHere ? "" : ", timed out") << ") "
+                         << ms(std::chrono::steady_clock::now() - meshesDone) << " ms";
+#else
+        (void)files;
+        (void)landTextures;
+        (void)place;
+#endif
     }
 
