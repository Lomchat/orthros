+    bool Manager::orthrosDataHere(VFS::Path::NormalizedView name) const
+    {
+#ifdef __EMSCRIPTEN__
+        const auto found = mIndex.find(name);
+        std::string path;
+        std::uint64_t offset = 0;
+        std::uint64_t size = 0;
+        if (found == mIndex.end() || !found->second->orthrosRange(path, offset, size))
+            return true;
+        // (the page's answer, 1 here, 0 not; a page without the hook, or one that fails: 0)
+        // clang-format off
+        return EM_ASM_INT({
+            var f = globalThis.orthrosRangeHere;
+            try { return f ? (f(UTF8ToString($0), $1, $2) ? 1 : 0) : 0; } catch (e) { return 0; }
+        }, path.c_str(), static_cast<double>(offset), size == ~std::uint64_t{ 0 } ? -1.0 : static_cast<double>(size)) != 0;
+        // clang-format on
+#else
+        (void)name;
+        return false;
+#endif
+    }
+
